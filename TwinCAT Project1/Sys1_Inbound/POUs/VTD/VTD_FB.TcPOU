// 
{region "VFD - SEW MOVIPRO, MOVIKIT Positioning Drive, speed mode (200)"}
    // Adapted from the former G120/SinaSpeed region. The state machine above still
    // commands the motor exactly as before:
    //   VTD_Control.Motor_UP / Motor_Down = direction
    //   VTD_Control.Motor_Speed           = speed in % (0..120), 100 % = VTD_Settings.SEW_Speed_At_100pct
    // This region converts those commands to MOVIKIT speed mode (200), SEW manual 33959862, 8.1.4.
    // ASSUMPTION (verify on the first test): a positive speed setpoint moves the VTD up.
    // If not, correct the direction of rotation in MOVISUITE, not here.

    //SETPOINT (signed, user units)
    IF VTD_Control.Motor_UP AND NOT VTD_Control.Motor_Down THEN
        rSpeedSetpoint := UINT_TO_REAL(MIN(VTD_Control.Motor_Speed, 120))
                          * INT_TO_REAL(VTD_Settings.SEW_Speed_At_100pct) / 100.0;
    ELSIF VTD_Control.Motor_Down AND NOT VTD_Control.Motor_UP THEN
        rSpeedSetpoint := -1.0 * UINT_TO_REAL(MIN(VTD_Control.Motor_Speed, 120))
                          * INT_TO_REAL(VTD_Settings.SEW_Speed_At_100pct) / 100.0;
    ELSE
        rSpeedSetpoint := 0.0;
    END_IF
    MainSetpoint := REAL_TO_INT(LIMIT(-32767.0, rSpeedSetpoint, 32767.0));

    T_Setpoint_Delay(IN := MainSetpoint <> 0,
                     PT := T#0MS);

    IF T_Setpoint_Delay.Q THEN
        MainSetpoint1 := MainSetpoint;
    ELSE
        MainSetpoint1 := 0;
    END_IF

    //Acceleration: same load/weight ranges as before, as a factor in %
    diPalletWeight := 0;
    IF System_no >= 1 AND System_no <= 2 THEN // Control.VTD_Order_Table is ARRAY[1..2]
        diPalletWeight := INT_TO_DINT(Control.VTD_Order_Table.Pallet_Weight);
    END_IF

    IF VTD_Control.Pallet_Loaded = 0 AND VTD_Control.Shuttle_Loaded = 0 THEN
        rAccelerationFactor_pct := 60.0;
    ELSIF diPalletWeight > 0 AND diPalletWeight <= UINT_TO_DINT(VTD_Settings.Weight_Range_1) THEN
        rAccelerationFactor_pct := UINT_TO_REAL(VTD_Settings.Acc_Range_1);
    ELSIF diPalletWeight > UINT_TO_DINT(VTD_Settings.Weight_Range_1)
        AND diPalletWeight <= UINT_TO_DINT(VTD_Settings.Weight_Range_2) THEN
        rAccelerationFactor_pct := UINT_TO_REAL(VTD_Settings.Acc_Range_2);
    ELSIF diPalletWeight > UINT_TO_DINT(VTD_Settings.Weight_Range_2)
        AND diPalletWeight <= UINT_TO_DINT(VTD_Settings.Weight_Range_3) THEN
        rAccelerationFactor_pct := UINT_TO_REAL(VTD_Settings.Acc_Range_3);
    ELSE
        rAccelerationFactor_pct := 100.0;
    END_IF

    uiDriveRamp := REAL_TO_UINT(LIMIT(0.0,
                                      rAccelerationFactor_pct * UINT_TO_REAL(VTD_Settings.SEW_Ramp_At_100pct) / 100.0,
                                      65535.0));

    //ENABLE / START
    bDriveMoveRequest := (VTD_Control.Motor_UP XOR VTD_Control.Motor_Down) AND MainSetpoint1 <> 0;

    // Keep the enable until the motor has stopped, so a normal stop (start = 0)
    // decelerates with the PO 4 ramp before the brake is applied.
    // Safety_OK or a VTD error removes the enable immediately (FCB 14 emergency stop ramp).
    bDriveEnable := Safety_OK AND NOT VTD_Control.Error
                    AND (bDriveMoveRequest OR VTD_Control.Motor.stStatus.bMotorTurning);

    bDriveFaultReset := VTD_Control.Instruction.Reset OR System_Control.Reset_All OR HMI_Reset;

    fbSewDrive(i_stProcessInput := VTD_Control.Motor.stProcessInput,
               i_bEnable := bDriveEnable,
               i_bStart := bDriveMoveRequest AND bDriveEnable,
               i_bJogPositive := FALSE,
               i_bJogNegative := FALSE,
               i_bFaultReset := bDriveFaultReset,
               i_eMode := E_SEW_MovikitMode.Speed,
               i_iSpeedSetpoint := MainSetpoint1,
               i_uiAcceleration := uiDriveRamp,
               i_uiDeceleration := uiDriveRamp,
               i_diTargetPosition := 0);

    VTD_Control.Motor.aProcessOutput := fbSewDrive.q_aProcessOutput;
    VTD_Control.Motor.stStatus := fbSewDrive.q_stStatus;

    //VFD error code: 16#FFFF = communication, otherwise PI 3 (fault * 256 + subfault)
    IF NOT fbSewDrive.q_stStatus.bCommunicationOk THEN
        VTD_Control.VFD_Error := 16#FFFF;
    ELSIF fbSewDrive.q_stStatus.bError THEN
        VTD_Control.VFD_Error := VTD_Control.Motor.stProcessInput.aWord[3];
    ELSE
        VTD_Control.VFD_Error := 0;
    END_IF

    // TODO: VTD_Control.LinearEnc [mm] from fbSewDrive.q_stStatus.diActualPosition (DL50 via PI 7/8)
    //       once the MOVISUITE user units of the position are confirmed.
{endregion}
// 
