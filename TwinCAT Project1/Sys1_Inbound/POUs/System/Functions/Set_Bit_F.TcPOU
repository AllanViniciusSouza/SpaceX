<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Set_Bit_F" Id="{aedeb09c-f1da-484a-814b-f14b895e9511}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION Set_Bit_F : BOOL
VAR_INPUT
    BIT_Number : UINT;
    Bit_Value : BOOL := TRUE; // Default preserves existing set-only callers.
END_VAR
VAR_IN_OUT
    Variavel : WORD; // Existing interface name retained for compatibility.
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Source: Reference_Project/Set_Bit_F.scl.
// FALSE leaves the word unchanged, matching the Siemens set-only behavior.
Set_Bit_F := FALSE;
IF BIT_Number > UINT#15 THEN
    RETURN;
END_IF;
IF Bit_Value THEN
    Variavel := Variavel OR SHL(WORD#1, BIT_Number);
END_IF;
Set_Bit_F := TRUE;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>