<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="ByteArrayToString" Id="{9672cd47-b4e0-43b0-a33b-59cb61754666}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION ByteArrayToString : STRING(254)
VAR_INPUT
    Lenght : INT; // Reference spelling retained for named callers.
    ByteArray : ARRAY[0..1024] OF BYTE;
END_VAR
VAR_OUTPUT
    ByteArrayToString_1 : STRING(254);
    ByteArrayToString_2 : STRING(254);
    ByteArrayToString_3 : STRING(254);
    ByteArrayToString_4 : STRING(254);
    ByteArrayToString_5 : STRING(254);
    Truncated : BOOL;
END_VAR
VAR
    windows : ARRAY[0..5] OF STRING(254);
    window : INT;
    cursor : INT;
    first : INT;
    last : INT;
    count : INT;
    size : INT;
    skipLF : BOOL;
    value : BYTE;
END_VAR
]]></Declaration>
    <Implementation><ST><![CDATA[// Six overlapping ASCII windows beginning at bytes 0,100,...,500.
// Bound input length and output capacity; no pointer copying or unbounded loops.
size := LIMIT(0, Lenght, 1025);
Truncated := (Lenght < 0) OR (Lenght > 1025) OR (size > 764);
FOR window := 0 TO 5 DO
    windows[window] := '';
    count := 0;
    skipLF := FALSE;
    first := window * 100;
    last := MIN(size - 1, first + 254);
    IF window = 5 THEN last := MIN(size - 1, 763); END_IF;
    FOR cursor := first TO last DO
        value := ByteArray[cursor];
        IF skipLF THEN
            skipLF := FALSE;
        ELSIF value <> 0 THEN
            // Match the source's removal of CRLF pairs, without removing lone CR/LF.
            IF (value = 13) AND (cursor < last) THEN
                IF ByteArray[cursor + 1] = 10 THEN skipLF := TRUE; END_IF;
            END_IF;
            IF NOT skipLF THEN
                IF count < 254 THEN
                    windows[window][count] := value;
                    count := count + 1;
                    windows[window][count] := 0;
                ELSE
                    Truncated := TRUE;
                END_IF;
            END_IF;
        END_IF;
    END_FOR;
END_FOR;
ByteArrayToString := windows[0];
ByteArrayToString_1 := windows[1];
ByteArrayToString_2 := windows[2];
ByteArrayToString_3 := windows[3];
ByteArrayToString_4 := windows[4];
ByteArrayToString_5 := windows[5];
]]></ST></Implementation>
  </POU>
</TcPlcObject>
