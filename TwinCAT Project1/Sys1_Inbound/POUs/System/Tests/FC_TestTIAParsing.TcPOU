<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="FC_TestTIAParsing" Id="{9ae4661f-4dd3-44c7-be86-8aa49de2d9cc}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION FC_TestTIAParsing : DWORD
VAR
    valid : BOOL;
    booleanValue : BOOL;
    integerValue : INT;
    longValue : DINT;
    buffer : ARRAY[0..1024] OF BYTE;
    result : STRING(254);
    window1 : STRING(254);
    truncated : BOOL;
    i : INT;
END_VAR
]]></Declaration>
    <Implementation><ST><![CDATA[// Run only in an isolated test PLC. Zero means all checks passed.
// Each set bit identifies the corresponding assertion below.
FC_TestTIAParsing := DWORD#0;
IF RemovePlusSign('+42') <> '42' THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 0); END_IF;
IF RemovePlusSign('4+2') <> '4+2' THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 1); END_IF;
booleanValue := FindBoolField(FieldName := 'x', JsonStr := '{"x": false, "y": true}', Valid => valid);
IF booleanValue OR NOT valid THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 2); END_IF;
booleanValue := FindBoolField(FieldName := 'x', JsonStr := '{"y":true}', Valid => valid);
IF booleanValue OR valid THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 3); END_IF;
booleanValue := FindBoolField(FieldName := 'x', JsonStr := '{"x" :$T true$R$N}', Valid => valid);
IF NOT booleanValue OR NOT valid THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 4); END_IF;
integerValue := FindIntField(FieldName := 'x', JsonStr := '{"x":32767}', Valid => valid);
IF NOT valid OR (integerValue <> 32767) THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 5); END_IF;
integerValue := FindIntField(FieldName := 'x', JsonStr := '{"x":-32768}', Valid => valid);
IF NOT valid OR (integerValue <> -32768) THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 6); END_IF;
integerValue := FindIntField(FieldName := 'x', JsonStr := '{"x":32768}', Valid => valid);
IF valid OR (integerValue <> -9999) THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 7); END_IF;
longValue := FindDINTFieldFragmented(FieldName := 'x', Str1 := '{"x":2147483647}', Str2 := '', Valid => valid);
IF NOT valid OR (longValue <> DINT#2147483647) THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 8); END_IF;
longValue := FindDINTFieldFragmented(FieldName := 'x', Str1 := '{"x":-2147483648}', Str2 := '', Valid => valid);
IF NOT valid OR (longValue <> DINT#-2147483648) THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 9); END_IF;
longValue := FindDINTFieldFragmented(FieldName := 'x', Str1 := '{"x":2147483648}', Str2 := '', Valid => valid);
IF valid OR (longValue <> -9999) THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 10); END_IF;
integerValue := FindIntField(FieldName := 'x', JsonStr := '{"x":12.3}', Valid => valid);
IF valid THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 11); END_IF;
integerValue := FindIntField(FieldName := 'x', JsonStr := '{"x":12', Valid => valid);
IF valid THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 12); END_IF;
integerValue := FindIntField(FieldName := 'x', JsonStr := '{"x":-9999}', Valid => valid);
IF NOT valid OR (integerValue <> -9999) THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 13); END_IF;
integerValue := FindINTFieldFragmented(FieldName := 'x', Str1 := 'partial', Str2 := ',"x":42}', Valid => valid);
IF NOT valid OR (integerValue <> 42) THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 14); END_IF;
integerValue := FindINTFieldFragmented(FieldName := 'x', Str1 := '{"x":4', Str2 := '2}', Valid => valid);
IF valid THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 15); END_IF;
FOR i := 0 TO 1024 DO buffer[i] := 0; END_FOR;
buffer[0] := 65; buffer[1] := 13; buffer[2] := 10; buffer[3] := 66;
result := ByteArrayToString(Lenght := 4, ByteArray := buffer, Truncated => truncated);
IF (result <> 'AB') OR truncated THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 16); END_IF;
result := ByteArrayToString(Lenght := -1, ByteArray := buffer, Truncated => truncated);
IF (result <> '') OR NOT truncated THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 17); END_IF;
FOR i := 0 TO 254 DO buffer[i] := 65; END_FOR;
result := ByteArrayToString(Lenght := 255, ByteArray := buffer, ByteArrayToString_1 => window1, Truncated => truncated);
IF (LEN(result) <> 254) OR (LEN(window1) <> 155) OR NOT truncated THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 18); END_IF;
integerValue := FindIntField(FieldName := 'x', JsonStr := '{"x":01}', Valid => valid);
IF valid THEN FC_TestTIAParsing := FC_TestTIAParsing OR SHL(DWORD#1, 19); END_IF;
]]></ST></Implementation>
  </POU>
</TcPlcObject>
