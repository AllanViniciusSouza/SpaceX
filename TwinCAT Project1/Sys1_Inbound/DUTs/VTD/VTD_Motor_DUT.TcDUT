<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="VTD_Motor_DUT" Id="{edbab4b6-9622-4d63-8741-16713e844ffb}">
    <Declaration><![CDATA[// VTD drive: SEW MOVIPRO with MOVIKIT Positioning Drive, "Standard 8 PD".
// Raw process data is filled by FC Inputs and sent by FC Outputs.
// VTD_FB (via FB_SEW_Drive) writes aProcessOutput and stStatus.
TYPE VTD_Motor_DUT :
STRUCT
	stProcessInput:  ST_SEW_ProcessInput8;  // PI 1..8 + EtherCAT diagnostics, written by Inputs
	aProcessOutput:  ARRAY[1..8] OF UINT;   // PO 1..8 raw, read by Outputs
	stStatus:  ST_SEW_MovikitStatus;        // Decoded drive status, written by VTD_FB
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
