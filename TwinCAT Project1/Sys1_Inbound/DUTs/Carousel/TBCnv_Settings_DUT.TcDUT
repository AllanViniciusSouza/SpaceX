<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="TBCnv_Settings_DUT" Id="{99d92e8b-f842-44c9-8d52-d8c7e503b55b}">
    <Declaration><![CDATA[// Parameters of the turntable roller conveyor (Settings.TBCnv). Based on ECnv_Settings_DUT.
// 0 = not configured: the function that uses the value is blocked.
TYPE TBCnv_Settings_DUT :
STRUCT
	ID:	DINT;	// XXYYZZ
	Motor:	Cnv_Motor_Settings_DUT;	// Same name as Control.<device>.Motor
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>