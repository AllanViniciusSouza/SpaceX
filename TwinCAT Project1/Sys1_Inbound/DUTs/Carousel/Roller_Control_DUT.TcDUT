<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="Roller_Control_DUT" Id="{4fa8218c-e09f-429b-a739-2664c3896c29}">
    <Declaration><![CDATA[// Internal state of one carousel roller conveyor (Control.Roller_Cnv[1..5]).
// Same layout as ECnv_Control_DUT. Drive: SEW MOVIKIT Velocity Drive, 5 PD.
TYPE Roller_Control_DUT :
STRUCT
	Mode:	UINT;	// 0 Disabled, 1 Manual, 2 Semi-Auto, 3 Auto, 5 Maintenance
	Error:	BOOL;
	Warning:	UINT;
	Enabled:	BOOL;
	Stopped:	BOOL;
	Done:	BOOL;
	Running:	BOOL;
	Ready_For_Task:	BOOL;
	Current_Task_Type:	UINT;
	Current_Task_ID:	UINT;
	Cnv_Occupied:	BOOL;
	SM_State:	UINT;	// State machine value
	Motor:	Cnv_Motor_DUT;
	Instruction:	Roller_Instruction_DUT;
	Inputs:	Roller_Inputs_DUT;
	Cnv_Errors:	Cnv_Errors_DUT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>