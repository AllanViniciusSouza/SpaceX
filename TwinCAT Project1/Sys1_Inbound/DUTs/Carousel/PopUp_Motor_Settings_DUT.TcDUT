  <DUT Name="PopUp_Motor_Settings_DUT" Id="{7a09438f-e7b3-47ea-845d-742b77c8e9fe}">
    <Declaration><![CDATA[// Motor parameters of one carousel popup (Settings.Pop_Up_Cnv[n].Motors).
// Same member names as PopUp_Motors_DUT in Control.
TYPE PopUp_Motor_Settings_DUT :
STRUCT
	Lift:	Cnv_Motor_Settings_DUT;	// Transfer_Time = lift travel watchdog
	Transfer:	Cnv_Motor_Settings_DUT;
END_STRUCT
END_TYPE
]]></Declaration>
