<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="Turn_Table_Instruction_DUT" Id="{d15c3f82-9b8e-40fd-8d4d-cc4a9b405bb2}">
    <Declaration><![CDATA[// Commands of the turntable. Same first fields as Cnv_Instruction_DUT.
TYPE Turn_Table_Instruction_DUT :
STRUCT
	Mode_Change:	UINT;	// Requested mode, see Mode
	Stop:	BOOL;
	Enable:	BOOL;
	Reset:	BOOL;
	Execute:	BOOL;	// Rising edge starts the task
	Task_ID:	UINT;
	Task_Metadata:	STRING;
	Target_Position:	UINT;	// Station 1..4 to rotate to (Settings.Turn_Table.Position[n]), 0 = none
	Start_Rotation:	BOOL;
	Rotation_in_Progress:	BOOL;	// Written by the turntable FB

	// Manual mode
	Rotate_CW:	BOOL;	// Jog clockwise
	Rotate_CCW:	BOOL;	// Jog counter-clockwise
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>