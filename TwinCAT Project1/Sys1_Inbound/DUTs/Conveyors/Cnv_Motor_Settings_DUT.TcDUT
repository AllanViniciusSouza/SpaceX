<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="Cnv_Motor_Settings_DUT" Id="{60f1b294-13bb-48db-aec9-624e012c599d}">
    <Declaration><![CDATA[// Parameters of one conveyor motor (SEW MOVIKIT Velocity Drive, 5 PD).
// Settings counterpart of Cnv_Motor_DUT: Settings.<Device>.Motor(s) mirrors Control.<Device>.Motor(s).
// Speeds use the units of Cnv_Motor_DUT.Speed (Dallas: % of the drive range).
// 0 = not configured: the function that uses the value is blocked.
TYPE Cnv_Motor_Settings_DUT :
STRUCT
	TC_Time:	UINT;
	Transfer_Time:	UINT;	// [s] watchdog of a transfer (or of a lift travel)
	Slow_Speed:	UINT;	// Units of Motor.Speed
	Full_Speed:	UINT;	// Units of Motor.Speed
	Manual_Speed:	UINT;	// Units of Motor.Speed
	Drive:	ST_SEW_VelocityScaling;	// SEW MOVIKIT Velocity scaling and ramps
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>