<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="Buffer_Cnv_Settings_DUT" Id="{a189004e-295e-4110-a348-44d8e744c89c}">
    <Declaration><![CDATA[TYPE Buffer_Cnv_Settings_DUT :
STRUCT
	ID:	DINT;
	Barcode_ID:	UINT;
	Cnv_Level:	UINT;
	TC_Time:	UINT;
	Transfer_Time:	UINT;
	Pallet_Align_Time:	UINT;
	Slow_Speed:	UINT;
	Full_Speed:	UINT;
	Manual_Speed:	UINT;
	Safety_stop_Timeout:	UINT;

	// SEW MOVIKIT Velocity scaling (user units from MOVISUITE). 0 = not configured: the conveyor does not move.
	// Motor.Speed uses the units of Full_Speed / Slow_Speed / Manual_Speed.
	// Legacy Siemens scaling for reference: Motor.Speed 130 = 1865 rpm (G120 reference speed).
	rSewSpeedPerUnit:	REAL;     // PO 2 setpoint [user units] per 1 unit of Motor.Speed
	uiSewAcceleration:	UINT;    // PO 3 acceleration [user units]
	uiSewDeceleration:	UINT;    // PO 4 deceleration [user units]
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>