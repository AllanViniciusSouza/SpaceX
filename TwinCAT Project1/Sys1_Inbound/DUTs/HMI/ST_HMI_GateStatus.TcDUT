  <DUT Name="ST_HMI_GateStatus" Id="{a857e06c-5ee2-481f-be13-99fc87f2bbdc}">
    <Declaration><![CDATA[// PLC -> HMI: status of one access gate for the screen Access_Gates (display only).
TYPE ST_HMI_GateStatus :
STRUCT
    bClosed : BOOL;
    bLocked : BOOL;
    bAccessRequested : BOOL;
    bAccessGranted : BOOL;    // Gate_Station.Secure_Access
    bSafeToRestart : BOOL;    // Gate_Station.Safe_To_Restart
    bError : BOOL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
