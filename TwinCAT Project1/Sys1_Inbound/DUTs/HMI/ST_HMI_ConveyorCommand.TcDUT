<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_HMI_ConveyorCommand" Id="{f43b8da5-e23f-41c4-8c11-859338b50672}">
    <Declaration><![CDATA[// HMI -> PLC: commands for the device selected on the screens CNV / Carrousel.
// All Tap buttons. Jog, lift and rotate are hold-to-run (TRUE while pressed).
TYPE ST_HMI_ConveyorCommand :
STRUCT
    bModeManual : BOOL;
    bModeSemi : BOOL;
    bModeAuto : BOOL;
    bEnable : BOOL;
    bStop : BOOL;
    bReset : BOOL;
    bJogForward : BOOL;
    bJogBackward : BOOL;
    bLiftUp : BOOL;
    bLiftDown : BOOL;
    bRotateCw : BOOL;
    bRotateCcw : BOOL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>
