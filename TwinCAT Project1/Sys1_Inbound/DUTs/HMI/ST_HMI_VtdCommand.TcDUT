  <DUT Name="ST_HMI_VtdCommand" Id="{2834d1f0-6986-4de1-af6d-4cdb4eb52e94}">
    <Declaration><![CDATA[// HMI -> PLC: commands of the screen VTD (all Tap buttons, evaluated on the rising edge).
TYPE ST_HMI_VtdCommand :
STRUCT
    bModeManual : BOOL;
    bModeSemi : BOOL;
    bModeAuto : BOOL;
    bStop : BOOL;
    bReset : BOOL;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
