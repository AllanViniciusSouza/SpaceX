    // DIO-06 (EPP2328-0002) = 48RIO5 - conveyor with stopper, level 5 - sheets 48.5 and 53.4.
    BUFFER_L5_SAFETY_STOPPER_UPPER_SENSOR AT %I* : BOOL; // 48RIO5 CH01 | M12-1 pin 4 | Safety stopper upper sensor
    BUFFER_L5_SAFETY_STOPPER_LOWER_SENSOR AT %I* : BOOL; // 48RIO5 CH02 | M12-1 pin 2 | Safety stopper lower sensor
    BUFFER_L5_CONVEYOR_SENSOR_1 AT %I* : BOOL; // 48RIO5 CH03 | M12-2 pin 4 | Buffer conveyor sensor 1
    BUFFER_L5_CONVEYOR_SENSOR_2 AT %I* : BOOL; // 48RIO5 CH04 | M12-2 pin 2 | Buffer conveyor sensor 2
    BUFFER_L5_STOPPER_RELAY_53RR9 AT %Q* : BOOL; // 48RIO5 CH05 | M12-3 pin 4 | 53RR9 coil, stopper motor #9 53M9, sheet 53.4/5A
    _48RIO5_SPARE_CH06 AT %Q* : BOOL; // 48RIO5 CH06 | M12-3 pin 2 | Spare
    BUFFER_L5_STOPPER_RELAY_53RR10 AT %Q* : BOOL; // 48RIO5 CH07 | M12-4 pin 4 | 53RR10 coil, sheet 53.4/7E (relay not detailed in drawing rev D)
