    // DIO-07 (EPP2328-0002) = 48RIO6 - conveyor with stopper, level 6 - sheets 48.6 and 53.5.
    BUFFER_L6_SAFETY_STOPPER_UPPER_SENSOR AT %I* : BOOL; // 48RIO6 CH01 | M12-1 pin 4 | Safety stopper upper sensor
    BUFFER_L6_SAFETY_STOPPER_LOWER_SENSOR AT %I* : BOOL; // 48RIO6 CH02 | M12-1 pin 2 | Safety stopper lower sensor
    BUFFER_L6_CONVEYOR_SENSOR_1 AT %I* : BOOL; // 48RIO6 CH03 | M12-2 pin 4 | Buffer conveyor sensor 1
    BUFFER_L6_CONVEYOR_SENSOR_2 AT %I* : BOOL; // 48RIO6 CH04 | M12-2 pin 2 | Buffer conveyor sensor 2
    BUFFER_L6_STOPPER_RELAY_53RR11 AT %Q* : BOOL; // 48RIO6 CH05 | M12-3 pin 4 | 53RR11 coil, stopper motor #11 53M11, sheet 53.5/5A
    _48RIO6_SPARE_CH06 AT %Q* : BOOL; // 48RIO6 CH06 | M12-3 pin 2 | Spare
    BUFFER_L6_STOPPER_RELAY_53RR12 AT %Q* : BOOL; // 48RIO6 CH07 | M12-4 pin 4 | 53RR12 coil, sheet 53.5/7E (relay not detailed in drawing rev D)
    _48RIO6_SPARE_CH08 AT %Q* : BOOL; // 48RIO6 CH08 | M12-4 pin 2 | Spare
    _48RIO6_WcState AT %I* : BOOL; // DIO-07 > WcState > WcState (TRUE = data invalid)
    _48RIO6_EcState AT %I* : UINT; // DIO-07 > InfoData > State (8 = OP)

    // ---------------------------------------------------------------- TwinSAFE boxes
    // Safe channels travel in the FSoE frame to the TwinSAFE logic. They are NOT standard PLC I/O:
    // the standard PLC gets their state only through TwinSAFE logic outputs (IO_Safety).
    // Only diagnostics and the EP1957 standard (non-safe) data are declared here.

    // FDI-01 (EP1918-0002) = 43SRIO1 - safe inputs - sheets 43.0-43.1.
    //   In1/In2: 43SC1 to overtravel upper (NC).
    //   In3/In4: 43SC2 to overtravel lower (NC).
    //   In5-In8: spare.
    _43SRIO1_WcState AT %I* : BOOL; // FDI-01 > WcState > WcState (TRUE = data invalid)
    _43SRIO1_EcState AT %I* : UINT; // FDI-01 > InfoData > State (8 = OP)

    // FDIO-01 (EP1957-0022) = 43SRIO2 - safe inputs / outputs - sheets 43.2-43.4.
    //   In1/In2: 43LC1 light curtain receiver OSSD1 / OSSD2 (SICK C4C-EV13530B10000), sheet 43.4.
    //   In3/In4: 43LC2 light curtain sender (SICK C4C-SV13530B10000), sheet 43.4.
    //   Other safe inputs and safe outputs 1-4: not used in drawing rev D.
    _43SRIO2_SPARE_STD_OUT1 AT %Q* : BOOL; // FDIO-01 > Outputs > Module 1.Standard Output | Spare (no output used in drawing rev D)
    _43SRIO2_SPARE_STD_OUT2 AT %Q* : BOOL; // FDIO-01 > Outputs > Module 2.Standard Output | Spare (no output used in drawing rev D)
    _43SRIO2_SPARE_STD_OUT3 AT %Q* : BOOL; // FDIO-01 > Outputs > Module 3.Standard Output | Spare (no output used in drawing rev D)
    _43SRIO2_SPARE_STD_OUT4 AT %Q* : BOOL; // FDIO-01 > Outputs > Module 4.Standard Output | Spare (no output used in drawing rev D)
    _43SRIO2_FIELDVOLTAGE_UNDERRANGE AT %I* : BOOL; // FDIO-01 > FIELDVOLTAGE Field Voltage Status > Fieldvoltage Underrange
    _43SRIO2_FIELDVOLTAGE_OVERRANGE AT %I* : BOOL; // FDIO-01 > FIELDVOLTAGE Field Voltage Status > Fieldvoltage Overrange
    _43SRIO2_WcState AT %I* : BOOL; // FDIO-01 > WcState > WcState (TRUE = data invalid)
    _43SRIO2_EcState AT %I* : UINT; // FDIO-01 > InfoData > State (8 = OP)
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>