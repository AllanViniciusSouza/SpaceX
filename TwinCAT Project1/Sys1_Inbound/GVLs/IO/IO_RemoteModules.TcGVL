    _48RIO3_EcState AT %I* : UINT; // DIO-04 > InfoData > State (8 = OP)

    // DIO-05 (EPP2328-0002) = 48RIO4 - conveyor with stopper, level 4 - sheets 48.4 and 53.3.
    BUFFER_L4_SAFETY_STOPPER_UPPER_SENSOR AT %I* : BOOL; // 48RIO4 CH01 | M12-1 pin 4 | Safety stopper upper sensor
    BUFFER_L4_SAFETY_STOPPER_LOWER_SENSOR AT %I* : BOOL; // 48RIO4 CH02 | M12-1 pin 2 | Safety stopper lower sensor
    BUFFER_L4_CONVEYOR_SENSOR_1 AT %I* : BOOL; // 48RIO4 CH03 | M12-2 pin 4 | Buffer conveyor sensor 1
    BUFFER_L4_CONVEYOR_SENSOR_2 AT %I* : BOOL; // 48RIO4 CH04 | M12-2 pin 2 | Buffer conveyor sensor 2
    BUFFER_L4_STOPPER_RELAY_53RR7 AT %Q* : BOOL; // 48RIO4 CH05 | M12-3 pin 4 | 53RR7 coil, stopper motor #7 53M7, sheet 53.3/5A
    _48RIO4_SPARE_CH06 AT %Q* : BOOL; // 48RIO4 CH06 | M12-3 pin 2 | Spare
    BUFFER_L4_STOPPER_RELAY_53RR8 AT %Q* : BOOL; // 48RIO4 CH07 | M12-4 pin 4 | 53RR8 coil, sheet 53.3/7E (relay not detailed in drawing rev D)
    _48RIO4_SPARE_CH08 AT %Q* : BOOL; // 48RIO4 CH08 | M12-4 pin 2 | Spare
