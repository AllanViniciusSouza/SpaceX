<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Outputs" Id="{9e17053a-9990-4954-87c4-1e475fc09c43}" SpecialFunc="None">
    <Declaration><![CDATA[// Output mapping: the only place where PLC IO outputs are written.
// Copies internal variables (GVL Control) to IO GVL variables. One region per device.
// Called last in MAIN.
FUNCTION Outputs : BOOL
VAR_INPUT
END_VAR
VAR
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[{region "VTD 1 - MOVIPRO process outputs (SEW Standard 8 PD)"}
IO_VFDs.VTD_PO_01 := Control.VTD.Motor.aProcessOutput[1]; // Control word
IO_VFDs.VTD_PO_02 := Control.VTD.Motor.aProcessOutput[2]; // Setpoint speed
IO_VFDs.VTD_PO_03 := Control.VTD.Motor.aProcessOutput[3]; // Setpoint acceleration
IO_VFDs.VTD_PO_04 := Control.VTD.Motor.aProcessOutput[4]; // Setpoint deceleration
IO_VFDs.VTD_PO_05 := Control.VTD.Motor.aProcessOutput[5]; // Digital outputs
IO_VFDs.VTD_PO_06 := Control.VTD.Motor.aProcessOutput[6]; // Setpoint application mode
IO_VFDs.VTD_PO_07 := Control.VTD.Motor.aProcessOutput[7]; // Target position high word
IO_VFDs.VTD_PO_08 := Control.VTD.Motor.aProcessOutput[8]; // Target position low word
{endregion}

Outputs := TRUE;
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>