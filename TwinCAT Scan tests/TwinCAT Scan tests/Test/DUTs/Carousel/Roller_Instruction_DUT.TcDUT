<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="Roller_Instruction_DUT" Id="{d08e9214-6686-4773-9e6d-37dca07b98f1}">
    <Declaration><![CDATA[// Commands of one carousel roller conveyor. Cnv_Instruction_DUT + Dallas InCnv/OutCnv_Instruction station flags.
TYPE Roller_Instruction_DUT :
STRUCT
	Mode_Change:	UINT;	// Requested mode, see Mode
	Stop:	BOOL;
	Enable:	BOOL;
	Reset:	BOOL;
	Execute:	BOOL;	// Rising edge starts the task
	Task_ID:	UINT;
	Task_Metadata:	STRING;
	Transfer_To_ID:	DINT;	// Outbound: ID (XXYYZZ) of the receiving device
	Transfer_From_ID:	DINT;	// Inbound: ID (XXYYZZ) of the sending device
	Transfer_in_Progress:	BOOL;	// Written by the conveyor FB
	Inbound_Ready:	BOOL;	// Written by Conveyors_Transfer
	Transfer_Complete:	BOOL;
	Outbound_Ready:	BOOL;	// Written by Conveyors_Transfer
	Start_Transfer:	BOOL;
	Start_Transfer_Backward:	BOOL;	// Manual mode only
	Foward:	BOOL;	// Manual jog forward (spelling as Cnv_Instruction_DUT)
	Backward:	BOOL;	// Manual jog backward

	// Forklift stations (Dallas InConveyor_FB / OutConveyor_FB)
	Automatic_Start:	BOOL;	// PLC -> WMS: pallet placed, no forklift for No_Forklift_Detect_Timer
	Empty:	BOOL;	// PLC -> WMS: station empty, no forklift for No_Forklift_Detect_Timer
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>