<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="PopUp_Control_DUT" Id="{85b18d64-1135-4135-92ad-c7e7fc247a70}">
    <Declaration><![CDATA[// Internal state of one carousel popup (Control.Pop_Up_Cnv[1..2]): lift + transfer conveyor.
// Based on Dallas PopUp_Cnv_Control; same header as ECnv_Control_DUT / Buffer_Cnv_Control_DUT.
// Motors.Lift and Motors.Transfer never run at the same time (Active_Motor, FB_Conveyor_MotorInterlock).
// Drives: SEW MOVIKIT Velocity Drive, 5 PD (Motor.stProcessInput / aProcessOutput in Cnv_Motor_DUT).
TYPE PopUp_Control_DUT :
STRUCT
	Mode:	UINT;	// 0 Disabled, 1 Manual, 2 Semi-Auto, 3 Auto, 5 Maintenance
	Error:	BOOL;
	Warning:	UINT;
	Enabled:	BOOL;
	Stopped:	BOOL;
	Done:	BOOL;
	Running:	BOOL;
	Ready_For_Task:	BOOL;
	Current_Task_Type:	UINT;
	Current_Task_ID:	UINT;
	Cnv_Occupied:	BOOL;
	SM_State:	UINT;	// State machine value
	Active_Side:	INT;	// Side 1..4 of the running transfer, 0 = none
	Inputs:	PopUp_Inputs_DUT;
	Side:	ARRAY[1..4] OF PopUp_Side_Status_DUT;	// 1/2 transfer Fwd/Rev end (Lift_Up), 3/4 Lift_Down level (pallet moved by the neighbour, e.g. Chain_Cnv)

	// Motor group: one motor at a time
	Motors:	PopUp_Motors_DUT;
	Active_Motor:	E_Carousel_PopUpMotor;	// Motor allowed to run, None = no motor granted
	Motor_Changeover:	BOOL;	// A motor is requested and waits until the other one stopped + Changeover_Time

	Instruction:	PopUp_Instruction_DUT;
	Cnv_Errors:	Cnv_Errors_DUT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>