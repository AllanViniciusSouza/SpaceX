<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="Chain_Settings_DUT" Id="{bcd5ce62-90e0-488e-8886-2e9901616155}">
    <Declaration><![CDATA[// Parameters of the carousel chain conveyor (Settings.Chain_Cnv). Based on ECnv_Settings_DUT.
// 0 = not configured: the function that uses the value is blocked.
TYPE Chain_Settings_DUT :
STRUCT
	ID:	DINT;	// XXYYZZ
	Motor:	Cnv_Motor_Settings_DUT;	// Same name as Control.<device>.Motor
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>