<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_HMI_SystemCommand" Id="{faa143dc-fd00-4930-8e2a-f7ec609b33dd}">
    <Declaration><![CDATA[// HMI -> PLC: commands of the screen Main.
TYPE ST_HMI_SystemCommand :
STRUCT
    bResetAll : BOOL;  // Tap - reset of all devices of this system (evaluated on the rising edge)
    bSafetyReset : BOOL;  // Tap - safety reset request (rising edge in MAIN -> one 500 ms pulse on IO_Safety.ErrorAcknowledgement
                          // and IO_Safety.SEW_Safety_Reset). The TwinSAFE logic decides whether the reset is accepted.
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>