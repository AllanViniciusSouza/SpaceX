<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="Charger_DUT" Id="{1736cfd0-184d-40d3-b97c-1beb2394281e}">
    <Declaration><![CDATA[TYPE Charger_DUT :
STRUCT
	Output_Voltage:	REAL;                   	//Actual Output Voltage  
	Output_Current:	REAL;                       //Actual Output Current  
	Set_Voltage_Feedback:	REAL;               //Set Voltage Value      
	Set_Current_Feedback:	REAL;               //Set Current Value      
	Charging_Start:	BOOL;                       //Charging Running Status
	Set_Voltage_Output:	REAL;                   //Issue Target Voltage   
	Set_Current_Output:	REAL;                   //Issue Target Current   
	Start_Charging:	BOOL;                       //Start Charging Command 
	Stop_Charging:	BOOL;                       //Stop Charging Command  
	Confirm_Voltage_Current_Setting:	BOOL;   //Confirmation Command   
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>