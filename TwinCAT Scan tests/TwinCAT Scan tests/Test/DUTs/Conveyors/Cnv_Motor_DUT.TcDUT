<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="Cnv_Motor_DUT" Id="{b142180c-abaf-4490-b433-f6d2125fe9be}">
    <Declaration><![CDATA[TYPE Cnv_Motor_DUT :
STRUCT
	Enable:	BOOL;
	Enabled:	BOOL;
	Ready:	BOOL;
	Forward:	BOOL;
	Reverse:	BOOL;
	Speed:	REAL;
	Speed_Actual:	REAL;
	Actual_Current:	REAL;
	Actual_Torque:	UINT;
	Config_Axis:	WORD;
	Error:	BOOL;
	Status:	WORD;
	Communication_Error:	WORD;
	Lockout:	BOOL;

	// SEW MOVIKIT Velocity Drive, "5 PD" profile (buffer and roller conveyors).
	// stProcessInput is written only by FC Inputs; aProcessOutput is read only by FC Outputs.
	stProcessInput:	ST_SEW_ProcessInput5;   // PI 1..5 + EtherCAT diagnostics, written by Inputs
	aProcessOutput:	ARRAY[1..5] OF UINT;    // PO 1..5 raw, written by the conveyor FB, read by Outputs
	stStatus:	ST_SEW_VelocityStatus;          // Decoded drive status, written by the conveyor FB
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>