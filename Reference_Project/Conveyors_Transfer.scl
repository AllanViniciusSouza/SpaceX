TYPE "LMQTT_typeConnParam"
TITLE = LMQTT_typeConnParams
VERSION : 0.1
//Specifies connection parameters for the mqtt connection
   STRUCT
      hwId : HW_ANY;   // Hardware identifier of the interface. 0: interface is selected automatically
      connId : CONN_OUC := 1;   // Unique connection identifier (1..4095)
      broker : String;   // Hostname or IP address of broker
      port : UInt := 1883;   // Port on the broker
      tls : Struct   // Parameters for TLS encryption
         enableTls : Bool;   // TRUE: Enables TLS, FALSE: disable TLS
         validateServerIdentity : Bool;   // TRUE: Validate server certificate, FALSE: No validation of server certificate
         brokerCert : UDInt;   // ID of the broker's certificate in TIA Portal
         clientCert : UDInt;   // ID of the client's certificate in TIA Portal
      END_STRUCT;
      keepAlive : UInt;   // Keepalive mechanism for MQTT in seconds. 0: disabled.
   END_STRUCT;

END_TYPE

