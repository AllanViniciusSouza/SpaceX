TYPE "WMS_OPC_UA"
VERSION : 0.1
   STRUCT
      Task_ID : Int;   // ID of the Task
      Task_Metadata : String[250];
      Task_Type : Int;
      Source_Location : DInt;
      Destination_Location : DInt;
      Task_Data_Available : Bool;   // This tag is used to inform the PLC that task data is ready to be read.
      SM_State : UInt;   // The current state machine value of the Device/VTD
      Movement_Ready : Bool;
      Movement_Request_Complete : Bool;   // This PLC tag is set to true once the task is complete.
      Movement_Request_Complete_Ack : Bool;   // The WCS will acknowledge the completion of the task. 
      Shuttle_ID : Int;
      Shuttle_Loaded : Bool;
      Pallet_Type : Char;   // Values can be (C)hep or (E)uro.
      Pallet_Alignment : Char;   // Values can be (L)eft or (R)ight.
      SM_State_Maestro : UInt;   // SM State to mimic openTCS states from devices to Maestro
      Pallet_Weight : Int;
   END_STRUCT;

END_TYPE

DATA_BLOCK "Control_DB"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      ECnv_Sys : Array[1..5] of "ECnv_Control";
      LCnv_Sys : Array[1..5] of "Cnv_VTD_Control";
      VTD_Sys : Array[1..5] of "VTD_Control";
      WCS_OPC_Control : Array[1..5] of "WMS_OPC_UA";
      Shuttles_Position : Array[1..23] of Struct
         x : DInt;
         y : DInt;
         Charging : Bool;
      END_STRUCT;
      VTDBarcode_Station { S7_SetPoint := 'False'} : Array[1..5] of "Barcode_Station_UDT";
      Pallet_ID_Received : Array[1..3] of Bool;
      Gate_Station { S7_SetPoint := 'False'} : Array[1..12] of "Gate_Station_UDT";
   END_VAR


BEGIN
   LCnv_Sys[4].Cnv_Level[1].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[2].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[3].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[4].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[5].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[6].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[7].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[8].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[1].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[2].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[3].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[4].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[5].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[6].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[7].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[8].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;

END_DATA_BLOCK

DATA_BLOCK "Settings_DB"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR RETAIN
      VTD_Sys { S7_SetPoint := 'False'} : Array[1..5] of "VTD_Settings";
      ECnv_Sys { S7_SetPoint := 'False'} : Array[1..5] of "ECnv_Settings";
      LCnv_Sys { S7_SetPoint := 'False'} : Array[1..5] of "Cnv_VTD_Settings";
      Shuttle_MQTT { S7_SetPoint := 'False'} : "MQTT_Settings";
      System { S7_SetPoint := 'False'} : "System_Settings";
   END_VAR
   VAR 
      Chain_Slack_Time { S7_SetPoint := 'True'} : Time;
   END_VAR


BEGIN
   VTD_Sys[1].ID := 1;
   VTD_Sys[1].Lowest_Level := 1;
   VTD_Sys[1].Highest_Level := 8;
   VTD_Sys[1].VTD_Max_Heigh := 16500;
   VTD_Sys[1].VTD_Min_Height := 55;
   VTD_Sys[1].VTD_Level_Granularity := 20;
   VTD_Sys[1].Dft_Level_Offset_LE := 0;
   VTD_Sys[1].Dft_Level_Offset_AE := 0;
   VTD_Sys[1].Teach_Speed := 0;
   VTD_Sys[1].Creep_Speed := 3;
   VTD_Sys[1].Slow_Speed := 5;
   VTD_Sys[1].Slow_Calib_Speed := 10;
   VTD_Sys[1].Loaded_Speed := 50;
   VTD_Sys[1].Shuttle_Speed := 50;
   VTD_Sys[1].Pallet_Speed := 100;
   VTD_Sys[1].Empty_Speed := 100;
   VTD_Sys[1].Dock_speed := 5;
   VTD_Sys[1].Manual_Speed := 15;
   VTD_Sys[1].Slowdown_Count_LE := 700;
   VTD_Sys[1].Creep_Count_LE := 60;
   VTD_Sys[1].Slowdown_Count_AE := 700;
   VTD_Sys[1].Creep_Count_AE := 60;
   VTD_Sys[1].Encoder_Delta_W1 := 0.0;
   VTD_Sys[1].Encoder_Delta_W2 := 0.0;
   VTD_Sys[1].AE_Ratio := 0.0;
   VTD_Sys[1].Encoder_Delta_Warning := 80.0;
   VTD_Sys[1].Encoder_Delta_Error := 200.0;
   VTD_Sys[1].Transfer_Timeout_Up := 50;
   VTD_Sys[1].Transfer_Timeout_Down := 45;
   VTD_Sys[1].Lockpins_Timeout_Extend := 3000;
   VTD_Sys[1].Lockpins_Timeout_Retract := 3000;
   VTD_Sys[1].Level_Detect_Timeout := 500;
   VTD_Sys[1].Teach_Timeout := 600;
   VTD_Sys[1].Chain_Slack_Timeout := 750;
   VTD_Sys[1].Level_Detect_LE := 3.0;
   VTD_Sys[1].Acc_Range_1 := 60;
   VTD_Sys[1].Acc_Range_2 := 70;
   VTD_Sys[1].Acc_Range_3 := 80;
   VTD_Sys[1].Weight_Range_1 := 250;
   VTD_Sys[1].Weight_Range_2 := 500;
   VTD_Sys[1].Weight_Range_3 := 750;
   VTD_Sys[1].G120_Hardware_ID := 475;
