DATA_BLOCK "Shuttle_MQTT_DB"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      Shuttle_MQTT { S7_SetPoint := 'False'} : Array[1..24] of "MQTT_Interface";
   END_VAR


BEGIN

END_DATA_BLOCK

FUNCTION "ID_Decode_F" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      ID : DInt;
   END_VAR

   VAR_IN_OUT 
      ID_Decoded : "ID_Decoded";
   END_VAR

   VAR_TEMP 
      Temp : UInt;
   END_VAR


BEGIN
	
	// Extract XX (first two digits)
	#ID_Decoded.Device_Type := #ID / 10000;        // 123456 / 10000 = 12
	
	// Extract YY (middle two digits)
	#ID_Decoded.Level := (#ID MOD 10000) / 100; // 123456 % 10000 = 3456 → 3456 / 100 = 34
	
	// Extract ZZ (last two digits)
	#ID_Decoded.VTD := #ID MOD 100;       // 123456 % 100 = 56
END_FUNCTION

FUNCTION "Set_Bit_F" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Bit : UInt;
      Bit_Value : Bool;
   END_VAR

   VAR_IN_OUT 
      "Var" : Word;
   END_VAR


BEGIN
	IF #Bit_Value THEN
	    // Set the bit
	    #Var := #Var OR SHL(IN := WORD#1, N := #Bit);
	// ELSE
	//     // Reset the bit
	//     #Var := #Var OR SHL(IN := DWORD#1, N := #Bit);
	END_IF;
	
END_FUNCTION

