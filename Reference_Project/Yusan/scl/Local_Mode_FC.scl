FUNCTION "Local_Mode_FC"   // FC 67, author 

VAR_INPUT
   HMI_Box_Connected : Int;
   Rem_Loc_Keys : Array[1..5] of "Level_Keys_UDT";
END_VAR

VAR_TEMP
   System : UInt;
   Level : UInt;
END_VAR

   // RETURN : Bool
BEGIN
#System := #HMI_Box_Connected / 10;
#Level := #HMI_Box_Connected MOD 10;
IF #System <> 0 AND #Level <> 0 THEN
    #Local_Mode_FC := #Rem_Loc_Keys[#System].Level[#Level];
ELSE
    #Local_Mode_FC := FALSE;
END_IF;


END_FUNCTION