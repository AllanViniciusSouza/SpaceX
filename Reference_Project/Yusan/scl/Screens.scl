FUNCTION "Screens"   // FC 12, author 

VAR_TEMP
   i : UInt;
   j : UInt;
   _id_decoded_OP : Array[1..5] of "ID_Decoded";
   Level_Strg : String;
   Destination_Location : Array[1..5] of DInt;
END_VAR

   // RETURN : Void
BEGIN
REGION MAIN SCREEN
    REGION AUTOMATIC BUTTON - SYSTEM 1
        IF "Automatic_Button_1" THEN
            FOR #i := "Settings_DB".VTD_Sys[1].Lowest_Level TO "Settings_DB".VTD_Sys[1].Highest_Level DO
                "Control_DB".VTD_Sys[1].Instruction.Mode_Change :=
                "Control_DB".ECnv_Sys[1].Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[1].Cnv_Level[#i].Cnv1.Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[1].Cnv_Level[#i].Cnv2.Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[1].Cnv_Level[#i].Cnv1.Safety_Stop_Cnrl.Mode :=
                "Control_DB".LCnv_Sys[1].Cnv_Level[#i].Cnv2.Safety_Stop_Cnrl.Mode := 3;
                
                "Control_DB".VTD_Sys[1].Instruction.Enable :=
                "Control_DB".ECnv_Sys[1].Instruction.Enable :=
                "Control_DB".LCnv_Sys[1].Cnv_Level[#i].Cnv1.Instruction.Enable :=
                "Control_DB".LCnv_Sys[1].Cnv_Level[#i].Cnv2.Instruction.Enable := TRUE;
            END_FOR;
        END_IF;
    END_REGION
    
    REGION AUTOMATIC BUTTON - SYSTEM 2
        IF "Automatic_Button_2" THEN
            FOR #i := "Settings_DB".VTD_Sys[2].Lowest_Level TO "Settings_DB".VTD_Sys[2].Highest_Level DO
                "Control_DB".VTD_Sys[2].Instruction.Mode_Change :=
                "Control_DB".ECnv_Sys[2].Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[2].Cnv_Level[#i].Cnv1.Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[2].Cnv_Level[#i].Cnv2.Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[2].Cnv_Level[#i].Cnv1.Safety_Stop_Cnrl.Mode :=
                "Control_DB".LCnv_Sys[2].Cnv_Level[#i].Cnv2.Safety_Stop_Cnrl.Mode := 3;
                
                "Control_DB".VTD_Sys[2].Instruction.Enable :=
                "Control_DB".ECnv_Sys[2].Instruction.Enable :=
                "Control_DB".LCnv_Sys[2].Cnv_Level[#i].Cnv1.Instruction.Enable :=
                "Control_DB".LCnv_Sys[2].Cnv_Level[#i].Cnv2.Instruction.Enable := TRUE;
            END_FOR;
        END_IF;
    END_REGION
    
    REGION AUTOMATIC BUTTON - SYSTEM 3
        IF "Automatic_Button_3" THEN
            FOR #i := "Settings_DB".VTD_Sys[3].Lowest_Level TO "Settings_DB".VTD_Sys[3].Highest_Level DO
                "Control_DB".VTD_Sys[3].Instruction.Mode_Change :=
                "Control_DB".ECnv_Sys[3].Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[3].Cnv_Level[#i].Cnv1.Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[3].Cnv_Level[#i].Cnv2.Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[3].Cnv_Level[#i].Cnv1.Safety_Stop_Cnrl.Mode :=
                "Control_DB".LCnv_Sys[3].Cnv_Level[#i].Cnv2.Safety_Stop_Cnrl.Mode := 3;
                
                "Control_DB".VTD_Sys[3].Instruction.Enable :=
                "Control_DB".ECnv_Sys[3].Instruction.Enable :=
                "Control_DB".LCnv_Sys[3].Cnv_Level[#i].Cnv1.Instruction.Enable :=
                "Control_DB".LCnv_Sys[3].Cnv_Level[#i].Cnv2.Instruction.Enable := TRUE;
            END_FOR;
        END_IF;
    END_REGION
    
    REGION AUTOMATIC BUTTON - SYSTEM 4
        IF "Automatic_Button_4" THEN
            FOR #i := "Settings_DB".VTD_Sys[4].Lowest_Level TO "Settings_DB".VTD_Sys[4].Highest_Level DO
                "Control_DB".VTD_Sys[4].Instruction.Mode_Change :=
                "Control_DB".ECnv_Sys[4].Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[4].Cnv_Level[#i].Cnv1.Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[4].Cnv_Level[#i].Cnv2.Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[4].Cnv_Level[#i].Cnv1.Safety_Stop_Cnrl.Mode :=
                "Control_DB".LCnv_Sys[4].Cnv_Level[#i].Cnv2.Safety_Stop_Cnrl.Mode := 3;
                
                "Control_DB".VTD_Sys[4].Instruction.Enable :=
                "Control_DB".ECnv_Sys[4].Instruction.Enable :=
                "Control_DB".LCnv_Sys[4].Cnv_Level[#i].Cnv1.Instruction.Enable :=
                "Control_DB".LCnv_Sys[4].Cnv_Level[#i].Cnv2.Instruction.Enable := TRUE;
            END_FOR;
        END_IF;
    END_REGION
    
    REGION AUTOMATIC BUTTON - SYSTEM 5
        IF "Automatic_Button_5" THEN
            FOR #i := "Settings_DB".VTD_Sys[5].Lowest_Level TO "Settings_DB".VTD_Sys[5].Highest_Level DO
                "Control_DB".VTD_Sys[5].Instruction.Mode_Change :=
                "Control_DB".ECnv_Sys[5].Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[5].Cnv_Level[#i].Cnv1.Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[5].Cnv_Level[#i].Cnv2.Instruction.Mode_Change :=
                "Control_DB".LCnv_Sys[5].Cnv_Level[#i].Cnv1.Safety_Stop_Cnrl.Mode :=
                "Control_DB".LCnv_Sys[5].Cnv_Level[#i].Cnv2.Safety_Stop_Cnrl.Mode := 3;
                
                "Control_DB".VTD_Sys[5].Instruction.Enable :=
                "Control_DB".ECnv_Sys[5].Instruction.Enable :=
                "Control_DB".LCnv_Sys[5].Cnv_Level[#i].Cnv1.Instruction.Enable :=
                "Control_DB".LCnv_Sys[5].Cnv_Level[#i].Cnv2.Instruction.Enable := TRUE;
            END_FOR;
        END_IF;
    END_REGION
    
    REGION ALL IN AUTOMATIC - SYSTEM 1
        "All_In_Automatic_1" := "Control_DB".VTD_Sys[1].Mode = 3 AND //VTD
        "Control_DB".ECnv_Sys[1].Mode = 3 AND //ECONVEYOR
        //CONVEYORS
        "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[7].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[7].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[8].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[8].Cnv2.Mode = 3 AND
        //SAFETY STOP
        "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[7].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[7].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[8].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[1].Cnv_Level[8].Cnv2.Safety_Stop_Cnrl.Mode = 3;
    END_REGION
    
    REGION ALL IN AUTOMATIC - SYSTEM 2
        "All_In_Automatic_2" := "Control_DB".VTD_Sys[2].Mode = 3 AND //VTD
        "Control_DB".ECnv_Sys[2].Mode = 3 AND //ECONVEYOR
        //CONVEYORS
        "Control_DB".LCnv_Sys[2].Cnv_Level[1].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[1].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[7].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[7].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[8].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[8].Cnv2.Mode = 3 AND
        //SAFETY STOP
        "Control_DB".LCnv_Sys[2].Cnv_Level[1].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[1].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[7].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[7].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[8].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[2].Cnv_Level[8].Cnv2.Safety_Stop_Cnrl.Mode = 3;
    END_REGION
    
    REGION ALL IN AUTOMATIC - SYSTEM 3
        "All_In_Automatic_3" := "Control_DB".VTD_Sys[3].Mode = 3 AND //VTD
        "Control_DB".ECnv_Sys[3].Mode = 3 AND //ECONVEYOR
        //CONVEYORS
        "Control_DB".LCnv_Sys[3].Cnv_Level[1].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[1].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[2].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[2].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[3].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[3].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[4].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[4].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[5].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[5].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[6].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[6].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[7].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[7].Cnv2.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[8].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[8].Cnv2.Mode = 3 AND
        //SAFETY STOP
        "Control_DB".LCnv_Sys[3].Cnv_Level[1].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[1].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[2].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[2].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[3].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[3].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[4].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[4].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[5].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[5].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[6].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[6].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[7].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[7].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[8].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[3].Cnv_Level[8].Cnv2.Safety_Stop_Cnrl.Mode = 3;
    END_REGION
    
    REGION ALL IN AUTOMATIC - SYSTEM 4
        "All_In_Automatic_4" := "Control_DB".VTD_Sys[4].Mode = 3 AND //VTD
        "Control_DB".ECnv_Sys[4].Mode = 3 AND //ECONVEYOR
        //CONVEYORS
        "Control_DB".LCnv_Sys[4].Cnv_Level[1].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[2].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[3].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[4].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[5].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[6].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[7].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[8].Cnv1.Mode = 3 AND
        //SAFETY STOP
        "Control_DB".LCnv_Sys[4].Cnv_Level[1].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[2].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[3].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[4].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[5].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[6].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[7].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[4].Cnv_Level[8].Cnv1.Safety_Stop_Cnrl.Mode = 3;
    END_REGION
    
    REGION ALL IN AUTOMATIC - SYSTEM 5
        "All_In_Automatic_5" := "Control_DB".VTD_Sys[5].Mode = 3 AND //VTD
        "Control_DB".ECnv_Sys[5].Mode = 3 AND //ECONVEYOR
        //CONVEYORS
        "Control_DB".LCnv_Sys[5].Cnv_Level[1].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[2].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[3].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[4].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[5].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Mode = 3 AND
        //SAFETY STOP
        "Control_DB".LCnv_Sys[5].Cnv_Level[1].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[2].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[3].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[4].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[5].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
        "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Safety_Stop_Cnrl.Mode = 3;
    END_REGION
    
    "Bypass".Main_Panel.ACK := "Reset_Comissioning";
    
    REGION Order processing
        //DECODES
        #Destination_Location[1] := "System_DB_1".OrderTable[1].OPC_Control.Destination_Location;
        #Destination_Location[2] := "System_DB_2".OrderTable[1].OPC_Control.Destination_Location;
        #Destination_Location[3] := "System_DB_3".OrderTable[1].OPC_Control.Destination_Location;
        #Destination_Location[4] := "System_DB_4".OrderTable[1].OPC_Control.Destination_Location;
        #Destination_Location[5] := "System_DB_5".OrderTable[1].OPC_Control.Destination_Location;
        
        FOR #i := 1 TO "Settings_DB".System.VTD_Count DO
            ID_Decode_F(ID := #Destination_Location[#i],
                          ID_Decoded := #_id_decoded_OP[#i]);
        END_FOR;
        
        //CLASSIFIES
        FOR #i := 1 TO "Settings_DB".System.VTD_Count DO
            IF #_id_decoded_OP[#i].Level <> 0 THEN
                VAL_STRG(IN := #_id_decoded_OP[#i].Level,
                         FORMAT := 16#0000,
                         PREC := 0,
                         P := 1,
                         SIZE := 0,
                         OUT => #Level_Strg);
                CASE #_id_decoded_OP[#i].VTD OF
                    1: //System 1
                        IF #_id_decoded_OP[#i].Device_Type = 30 THEN //VTD
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_1".OrderTable[1].Device, IN2 := ' To LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 10 THEN //CNV1
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_1".OrderTable[1].Device, IN2 := ' To CNV 1 LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 11 THEN //CNV2
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_1".OrderTable[1].Device, IN2 := ' To CNV 2 LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 12 THEN //ECONVEYOR
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_1".OrderTable[1].Device, IN2 := ' To ECONV LEVEL ', IN3 := #Level_Strg);
                        END_IF;
                        
                    2: //System 2
                        IF #_id_decoded_OP[#i].Device_Type = 30 THEN //VTD
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_2".OrderTable[1].Device, IN2 := ' To LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 10 THEN //CNV1
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_2".OrderTable[1].Device, IN2 := ' To CNV 1 LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 11 THEN //CNV2
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_2".OrderTable[1].Device, IN2 := ' To CNV 2 LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 12 THEN //ECONVEYOR
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_2".OrderTable[1].Device, IN2 := ' To ECONV LEVEL ', IN3 := #Level_Strg);
                        END_IF;
                        
                    3: //System 3
                        IF #_id_decoded_OP[#i].Device_Type = 30 THEN //VTD
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_3".OrderTable[1].Device, IN2 := ' To LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 10 THEN //CNV1
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_3".OrderTable[1].Device, IN2 := ' To CNV 1 LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 11 THEN //CNV2
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_3".OrderTable[1].Device, IN2 := ' To CNV 2 LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 12 THEN //ECONVEYOR
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_3".OrderTable[1].Device, IN2 := ' To ECONV LEVEL ', IN3 := #Level_Strg);
                        END_IF;
                        
                    4: //System 4
                        IF #_id_decoded_OP[#i].Device_Type = 30 THEN //VTD
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_4".OrderTable[1].Device, IN2 := ' To LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 10 THEN //CNV1
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_4".OrderTable[1].Device, IN2 := ' To CNV 1 LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 11 THEN //CNV2
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_4".OrderTable[1].Device, IN2 := ' To CNV 2 LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 12 THEN //ECONVEYOR
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_4".OrderTable[1].Device, IN2 := ' To ECONV LEVEL ', IN3 := #Level_Strg);
                        END_IF;
                        
                    5: //System 5
                        IF #_id_decoded_OP[#i].Device_Type = 30 THEN //VTD
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_5".OrderTable[1].Device, IN2 := ' To LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 10 THEN //CNV1
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_5".OrderTable[1].Device, IN2 := ' To CNV 1 LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 11 THEN //CNV2
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_5".OrderTable[1].Device, IN2 := ' To CNV 2 LEVEL ', IN3 := #Level_Strg);
                        ELSIF #_id_decoded_OP[#i].Device_Type = 12 THEN //ECONVEYOR
                            "Screen_DB".OrderProcessing[#i] := CONCAT(IN1 := "System_DB_5".OrderTable[1].Device, IN2 := ' To ECONV LEVEL ', IN3 := #Level_Strg);
                        END_IF;
                END_CASE;
            END_IF;
            END_FOR;
        
    END_REGION
    
    //empty background
    IF "System_DB_1".Error OR "System_DB_2".Error OR "System_DB_3".Error OR "System_DB_4".Error OR "System_DB_5".Error OR
        "Error_Word_1" <> 0 OR
        "Errors_Profinet_1" <> 0 OR
        "Errors_Profinet_2" <> 0 OR
        "Errors_Profinet_3" <> 0 OR
        "Errors_Profinet_4" <> 0 OR
        "Errors_Profinet_5" <> 0 OR
        "Errors_Profinet_6" <> 0 OR
        "Errors_Profinet_7" <> 0 OR
        "Errors_Profinet_8" <> 0 OR
        "Errors_Profinet_9" <> 0 OR
        "Errors_Profinet_10".%X0 OR
        "Errors_Profinet_10".%X1 OR
        "Errors_Profinet_10".%X2 OR
        "Errors_Profinet_10".%X3 OR
        "Errors_Profinet_10".%X4 OR
        "Errors_Profinet_10".%X5 OR
        "Errors_Profinet_10".%X6 OR
        "Errors_Profinet_10".%X7 OR
        "Errors_Profinet_10".%X8 OR
        "Errors_Profinet_10".%X9 OR
        "Errors_Profinet_10".%X10 OR
        "Errors_Profinet_10".%X11 OR
        "Errors_Profinet_10".%X12 OR
        "Errors_Profinet_10".%X13 OR
        "Errors_Profinet_11" <> 0 OR
        "Erros_Supply_Feedback_1" <> 0 OR
        "Erros_Supply_Feedback_2" <> 0 OR
        "Erros_Supply_Feedback_3" <> 0 OR
        "Erros_Supply_Feedback_4" <> 0 OR
        "Erros_Supply_Feedback_5" <> 0 OR
        "Erros_Supply_Feedback_6" <> 0 OR
        "Erros_Supply_Feedback_7" <> 0 OR
        "Sick Lector_Error code 1" <> 0 OR
        "Sick Lector_Error code 2" <> 0 OR
        "Sick Lector_Error code 3" <> 0 OR
        "Sick Lector_Error code 4" <> 0 OR
        "Sick Lector_Error code 5" <> 0 OR
        "Linear Encoder_Device Errors 1" <> 0 OR
        "Linear Encoder_Device Errors 2" <> 0 OR
        "Linear Encoder_Device Errors 3" <> 0 OR
        "Linear Encoder_Device Errors 4" <> 0 OR
        "Linear Encoder_Device Errors 5" <> 0 OR
        "Estop_Error_Word_1" <> 0 OR
        "Estop_Error_Word_2" <> 0 OR
        "Estop_Error_Word_3" <> 0 OR
        "Estop_Error_Word_4" <> 0 OR
        "Estop_Error_Word_5" <> 0 OR
        "Estop_Error_Word_6" <> 0 OR
        "Errors_Word_LightGuard_1" <> 0
    THEN
        "Screen_DB".EmptyTemplate_Background := 1;
    ELSE
        "Screen_DB".EmptyTemplate_Background := 0;
    END_IF;    //e

    // //main background - DEVICES
    // IF "HMI_DB".ScreenNo_Main = 1 AND "VTD_System_Selected_HMI" <> 0 THEN //VTD SCREEN
    //     IF "Control_DB".VTD_Sys["VTD_System_Selected_HMI"]."Error" THEN
    //         "Screen_DB".MainTemplate_Background := 1;
    //     ELSE
    //         "Screen_DB".MainTemplate_Background := 0;
    //     END_IF;
    // ELSIF "HMI_DB".ScreenNo_Main = 2 AND "CNV_System_Selected" <> 0 AND "CNV2_Selected" <> 0 AND "CNV_Level_Selected" <> 0 THEN //CONVEYOR SCREEN
    //     IF "CNV2_Selected" = 1 AND ("Control_DB".LCnv_Sys["CNV_System_Selected"].Cnv_Level["CNV_Level_Selected"].Cnv1.Error OR
    //         "Control_DB".ECnv_Sys["CNV_System_Selected"].Error) THEN
    //         "Screen_DB".MainTemplate_Background := 1;
    //     ELSIF "CNV2_Selected" = 2 AND ("Control_DB".LCnv_Sys["CNV_System_Selected"].Cnv_Level["CNV_Level_Selected"].Cnv2.Error OR
    //         "Control_DB".ECnv_Sys["CNV_System_Selected"].Error) THEN
    //         "Screen_DB".MainTemplate_Background := 1;
    //     ELSE
    //         "Screen_DB".MainTemplate_Background := 0;
    //     END_IF;
    // ELSE
    //     "Screen_DB".MainTemplate_Background := 0;
    // END_IF;
END_REGION;

REGION SHUTTLES
    IF "Screen_DB".Shuttle_Select >= 1 AND "Screen_DB".Shuttle_Select <= "Settings_DB".System.Shuttle_Count THEN
        CASE "Screen_DB".Shuttle_Select OF
            1:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[1].Message.Shuttle_Status;
            2:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[2].Message.Shuttle_Status;
            3:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[3].Message.Shuttle_Status;
            4:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[4].Message.Shuttle_Status;
            5:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[5].Message.Shuttle_Status;
            6:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[6].Message.Shuttle_Status;
            7:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[7].Message.Shuttle_Status;
            8:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[8].Message.Shuttle_Status;
            9:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[9].Message.Shuttle_Status;
            10:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[10].Message.Shuttle_Status;
            11:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[11].Message.Shuttle_Status;
            12:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[12].Message.Shuttle_Status;
            13:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[13].Message.Shuttle_Status;
            14:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[14].Message.Shuttle_Status;
            15:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[15].Message.Shuttle_Status;
            16:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[16].Message.Shuttle_Status;
            17:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[17].Message.Shuttle_Status;
            18:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[18].Message.Shuttle_Status;
            19:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[19].Message.Shuttle_Status;
            20:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[20].Message.Shuttle_Status;
            21:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[21].Message.Shuttle_Status;
            22:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[22].Message.Shuttle_Status;
            23:
                "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[23].Message.Shuttle_Status;
            // 24:
            //     "Screen_DB".Shuttle := "Shuttle_MQTT_DB".Shuttle_MQTT[24].Message.Shuttle_Status;
        END_CASE;
    END_IF;
    
    //E-STOP
    IF "Charge_Shuttle_Commands" THEN
        CASE "Shuttle_Level_Selected" OF
            1:
                "Shuttle_Level_EStop" := "L1_Estop";
            2:
                "Shuttle_Level_EStop" := "L2_Estop";
            3:
                "Shuttle_Level_EStop" := "L3_Estop";
            4:
                "Shuttle_Level_EStop" := "L4_Estop";
            5:
                "Shuttle_Level_EStop" := "L5_Estop";
            6:
                "Shuttle_Level_EStop" := "L6_Estop";
            7:
                "Shuttle_Level_EStop" := "L7_Estop";
            8:
                "Shuttle_Level_EStop" := "L8_Estop";
        END_CASE;
    ELSE
        CASE "Shuttle_Level_Selected" OF
            1:
                "L1_Estop" := "Shuttle_Level_EStop";
            2:
                "L2_Estop" := "Shuttle_Level_EStop";
            3:
                "L3_Estop" := "Shuttle_Level_EStop";
            4:
                "L4_Estop" := "Shuttle_Level_EStop";
            5:
                "L5_Estop" := "Shuttle_Level_EStop";
            6:
                "L6_Estop" := "Shuttle_Level_EStop";
            7:
                "L7_Estop" := "Shuttle_Level_EStop";
            8:
                "L8_Estop" := "Shuttle_Level_EStop";
        END_CASE;
    END_IF;
END_REGION

REGION ORDER TABLE
    //CHARGE OT DATA
    IF "Screen_DB".Charge_OT THEN
        CASE "Main_OrderTable_Selected" OF
            1:
                OT_Charge_Commands("Auto_Test_1_DB");
            2:
                OT_Charge_Commands("Auto_Test_2_DB");
            3:
                OT_Charge_Commands("Auto_Test_3_DB");
            4:
                OT_Charge_Commands_1("Auto_Test_4_DB");
            5:
                OT_Charge_Commands_1("Auto_Test_5_DB");
        END_CASE;
        "T_Charge_OT".TON(IN := TRUE,
                          PT := T#1000ms);
        IF "T_Charge_OT".Q THEN
            "T_Charge_OT".TON(IN := FALSE,
                              PT := T#0ms);
            "Screen_DB".Charge_OT := FALSE;
        END_IF;
    END_IF;
    
    IF NOT "Screen_DB".Charge_OT THEN
        "T_Charge_OT".TON(IN := FALSE,
                          PT := T#0ms);
        
        CASE "Main_OrderTable_Selected" OF
            1:
                "Clear_OT(1)" := "Clear_OT";
                FC_Orders(Sys := 1,
                            System := "System_DB_1",
                            Auto_Test := "Auto_Test_1_DB",
                            VTD_CurrentOrder := "Order_Table_FB_DB_1".VTD_CurrentOrder,
                            Pallet_InOut_CurrentOrder := "Order_Table_FB_DB_1".Pallet_InOut_CurrentOrder,
                            Shuttle_InOut_CurrentOrder := "Order_Table_FB_DB_1".Shuttle_InOut_CurrentOrder,
                            System_Busy := "System_1_Busy");
                
            2:
                "Clear_OT(2)" := "Clear_OT";
                FC_Orders(Sys := 2,
                            System := "System_DB_2",
                            Auto_Test := "Auto_Test_2_DB",
                            VTD_CurrentOrder := "Order_Table_FB_DB_2".VTD_CurrentOrder,
                            Pallet_InOut_CurrentOrder := "Order_Table_FB_DB_2".Pallet_InOut_CurrentOrder,
                            Shuttle_InOut_CurrentOrder := "Order_Table_FB_DB_2".Shuttle_InOut_CurrentOrder,
                            System_Busy := "System_2_Busy");
                
            3:
                "Clear_OT(3)" := "Clear_OT";
                FC_Orders(Sys := 3,
                            System := "System_DB_3",
                            Auto_Test := "Auto_Test_3_DB",
                            VTD_CurrentOrder := "Order_Table_FB_DB_3".VTD_CurrentOrder,
                            Pallet_InOut_CurrentOrder := "Order_Table_FB_DB_3".Pallet_InOut_CurrentOrder,
                            Shuttle_InOut_CurrentOrder := "Order_Table_FB_DB_3".Shuttle_InOut_CurrentOrder,
                            System_Busy := "System_3_Busy");
                
            4:
                "Clear_OT(4)" := "Clear_OT";
                FC_Orders_2(Sys := 4,
                            System := "System_DB_4",
                            Auto_Test := "Auto_Test_4_DB",
                            VTD_CurrentOrder := "Order_Table_FB_DB_4".VTD_CurrentOrder,
                            Pallet_InOut_CurrentOrder := "Order_Table_FB_DB_4".Pallet_InOut_CurrentOrder,
                            Shuttle_InOut_CurrentOrder := "Order_Table_FB_DB_4".Shuttle_InOut_CurrentOrder,
                            System_Busy := "System_4_Busy");
                
            5:
                "Clear_OT(5)" := "Clear_OT";
                FC_Orders_2(Sys := 5,
                            System := "System_DB_5",
                            Auto_Test := "Auto_Test_5_DB",
                            VTD_CurrentOrder := "Order_Table_FB_DB_5".VTD_CurrentOrder,
                            Pallet_InOut_CurrentOrder := "Order_Table_FB_DB_5".Pallet_InOut_CurrentOrder,
                            Shuttle_InOut_CurrentOrder := "Order_Table_FB_DB_5".Shuttle_InOut_CurrentOrder,
                            System_Busy := "System_5_Busy");
                
        END_CASE;
    END_IF;
END_REGION

"HMI_DB".Password := '12345';

REGION VTD BARCODE
    CASE "VTD_System_Selected_HMI" OF
        1:
            "Screen_DB".VTD_Barcode := "Control_DB".VTDBarcode_Station[1].Barcode;
            "Screen_DB".VTD_Barcode_Visu := "Control_DB".VTDBarcode_Station[1].Barcode <> '';
        2:
            "Screen_DB".VTD_Barcode := "Control_DB".VTDBarcode_Station[2].Barcode;
            "Screen_DB".VTD_Barcode_Visu := "Control_DB".VTDBarcode_Station[2].Barcode <> '';
        3:
            "Screen_DB".VTD_Barcode := "Control_DB".VTDBarcode_Station[3].Barcode;
            "Screen_DB".VTD_Barcode_Visu := "Control_DB".VTDBarcode_Station[3].Barcode <> '';
        4:
            "Screen_DB".VTD_Barcode := "Control_DB".VTDBarcode_Station[4].Barcode;
            "Screen_DB".VTD_Barcode_Visu := "Control_DB".VTDBarcode_Station[4].Barcode <> '';
        5:
            "Screen_DB".VTD_Barcode := "Control_DB".VTDBarcode_Station[5].Barcode;
            "Screen_DB".VTD_Barcode_Visu := "Control_DB".VTDBarcode_Station[5].Barcode <> '';
    END_CASE;
END_REGION VTD BARCODE

