FUNCTION "CNV_Charge_Settings_FC_1"   // FC 59, author 

VAR_INPUT
   Sys_No : UInt;
   HMI_Box : UInt;
END_VAR

VAR_TEMP
   Level : UInt;
END_VAR

   // RETURN : Void
BEGIN
#Level := #HMI_Box MOD 10;
"PopUps_DB_1"."ECnv_Settings"[#Sys_No] := "Settings_DB".ECnv_Sys[#Sys_No];

CASE #Level OF
    1:
        "PopUps_DB_1"."Buffer_Cnv_Settings_1"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[1].Cnv1;
        "PopUps_DB_1"."Buffer_Cnv_Settings_2"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[1].Cnv2;
    2:
        "PopUps_DB_1"."Buffer_Cnv_Settings_1"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv1;
        "PopUps_DB_1"."Buffer_Cnv_Settings_2"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv2;
    3:
        "PopUps_DB_1"."Buffer_Cnv_Settings_1"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv1;
        "PopUps_DB_1"."Buffer_Cnv_Settings_2"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv2;
    4:
        "PopUps_DB_1"."Buffer_Cnv_Settings_1"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv1;
        "PopUps_DB_1"."Buffer_Cnv_Settings_2"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv2;
    5:
        "PopUps_DB_1"."Buffer_Cnv_Settings_1"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv1;
        "PopUps_DB_1"."Buffer_Cnv_Settings_2"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv2;
    6:
        "PopUps_DB_1"."Buffer_Cnv_Settings_1"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv1;
        "PopUps_DB_1"."Buffer_Cnv_Settings_2"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv2;
    7:
        "PopUps_DB_1"."Buffer_Cnv_Settings_1"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[7].Cnv1;
        "PopUps_DB_1"."Buffer_Cnv_Settings_2"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[7].Cnv2;
    8:
        "PopUps_DB_1"."Buffer_Cnv_Settings_1"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[8].Cnv1;
        "PopUps_DB_1"."Buffer_Cnv_Settings_2"[#Sys_No] := "Settings_DB".LCnv_Sys[#Sys_No].Cnv_Level[8].Cnv2;
END_CASE;


END_FUNCTION