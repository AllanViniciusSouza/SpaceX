FUNCTION "VTD_Charge_Settings"   // FC 41, author 

   // RETURN : Void
BEGIN
//VTD SETTINGS
CASE "VTD_System_Selected_HMI" OF
    1:
        "PopUps_DB".VTD_Settings := "Settings_DB".VTD_Sys[1];
    2:
        "PopUps_DB".VTD_Settings := "Settings_DB".VTD_Sys[2];
    3:
        "PopUps_DB".VTD_Settings := "Settings_DB".VTD_Sys[3];
    4:
        "PopUps_DB".VTD_Settings := "Settings_DB".VTD_Sys[4];
    5:
        "PopUps_DB".VTD_Settings := "Settings_DB".VTD_Sys[5];
END_CASE;


END_FUNCTION