REGION CHARGER PANELS   
    IF "FirstScan" THEN
        "Charger 1 contactor(1)" := TRUE;
        "Charger 2 contactor(1)" := TRUE;
        "Charger 3 contactor(1)" := TRUE;
        
        "Charger 1 contactor(2)" := TRUE;
        "Charger 2 contactor(2)" := TRUE;
        "Charger 3 contactor(2)" := TRUE;
        
        "Charger 1 contactor(3)" := TRUE;
        "Charger 2 contactor(3)" := TRUE;
        "Charger 3 contactor(3)" := TRUE;
        
        "Charger 1 contactor(4)" := TRUE;
        "Charger 2 contactor(4)" := TRUE;
        "Charger 3 contactor(4)" := TRUE;
        
        "Charger 1 contactor(5)" := TRUE;
        "Charger 2 contactor(5)" := TRUE;
        "Charger 3 contactor(5)" := TRUE;
        
        "Charger 1 contactor(6)" := TRUE;
        "Charger 2 contactor(6)" := TRUE;
        "Charger 3 contactor(6)" := TRUE;
        
        "Charger 1 contactor(7)" := TRUE;
        "Charger 2 contactor(7)" := TRUE;
        "Charger 3 contactor(7)" := TRUE;
        
        "Charger 1 contactor(8)" := TRUE;
        "Charger 2 contactor(8)" := TRUE;
        "Charger 3 contactor(8)" := TRUE;
        
        //CHARGE DATA HMI 1
    ELSIF "Charge_Shuttle_Commands" THEN
        CASE "Shuttle_Level_Selected" OF
            1:
                "Charger 1" := "Charger 1 contactor(1)";
                "Charger 2" := "Charger 2 contactor(1)";
                "Charger 3" := "Charger 3 contactor(1)";
            2:
                "Charger 1" := "Charger 1 contactor(2)";
                "Charger 2" := "Charger 2 contactor(2)";
                "Charger 3" := "Charger 3 contactor(2)";
            3:
                "Charger 1" := "Charger 1 contactor(3)";
                "Charger 2" := "Charger 2 contactor(3)";
                "Charger 3" := "Charger 3 contactor(3)";
            4:
                "Charger 1" := "Charger 1 contactor(4)";
                "Charger 2" := "Charger 2 contactor(4)";
                "Charger 3" := "Charger 3 contactor(4)";
            5:
                "Charger 1" := "Charger 1 contactor(5)";
                "Charger 2" := "Charger 2 contactor(5)";
                "Charger 3" := "Charger 3 contactor(5)";
            6:
                "Charger 1" := "Charger 1 contactor(6)";
                "Charger 2" := "Charger 2 contactor(6)";
                "Charger 3" := "Charger 3 contactor(6)";
            7:
                "Charger 1" := "Charger 1 contactor(7)";
                "Charger 2" := "Charger 2 contactor(7)";
                "Charger 3" := "Charger 3 contactor(7)";
            8:
                "Charger 1" := "Charger 1 contactor(8)";
                "Charger 2" := "Charger 2 contactor(8)";
                "Charger 3" := "Charger 3 contactor(8)";
        END_CASE;
        
      "T_Shuttle_Charge_Buttons".TON(IN:=TRUE,
                                     PT:=T#100ms);
      
      IF "T_Shuttle_Charge_Buttons".Q THEN
          "T_Shuttle_Charge_Buttons".TON(IN := FALSE,
                                         PT := T#0S);
          "Charge_Shuttle_Commands" := FALSE;
      END_IF;
        
    ELSE
        //WRITE DATA
        CASE "Shuttle_Level_Selected" OF
            1:
                "Charger 1 contactor(1)" := "Charger 1";
                "Charger 2 contactor(1)" := "Charger 2";
                "Charger 3 contactor(1)" := "Charger 3";
            2:
                "Charger 1 contactor(2)" := "Charger 1";
                "Charger 2 contactor(2)" := "Charger 2";
                "Charger 3 contactor(2)" := "Charger 3";
            3:
                "Charger 1 contactor(3)" := "Charger 1";
                "Charger 2 contactor(3)" := "Charger 2";
                "Charger 3 contactor(3)" := "Charger 3";
            4:
                "Charger 1 contactor(4)" := "Charger 1";
                "Charger 2 contactor(4)" := "Charger 2";
                "Charger 3 contactor(4)" := "Charger 3";
            5:
                "Charger 1 contactor(5)" := "Charger 1";
                "Charger 2 contactor(5)" := "Charger 2";
                "Charger 3 contactor(5)" := "Charger 3";
            6:
                "Charger 1 contactor(6)" := "Charger 1";
                "Charger 2 contactor(6)" := "Charger 2";
                "Charger 3 contactor(6)" := "Charger 3";
            7:
                "Charger 1 contactor(7)" := "Charger 1";
                "Charger 2 contactor(7)" := "Charger 2";
                "Charger 3 contactor(7)" := "Charger 3";
            8:
                "Charger 1 contactor(8)" := "Charger 1";
                "Charger 2 contactor(8)" := "Charger 2";
                "Charger 3 contactor(8)" := "Charger 3";
        END_CASE;
    END_IF;
END_REGION;
END_FUNCTION