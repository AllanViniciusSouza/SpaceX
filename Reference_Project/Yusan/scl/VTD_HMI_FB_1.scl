FUNCTION_BLOCK "VTD_HMI_FB_1"   // FB 15, author 

VAR_INPUT
   HMI_No : UInt;
   HMI_Box : UInt;
   Sys_No : UInt;
END_VAR

VAR
   T_Charge : TON_TIME;
   T_Charge_IN : Bool;
   Charged : Bool;
END_VAR

BEGIN
//CHARGE ONCE THE COMMANDS STATUS
IF NOT #T_Charge.Q THEN
    CASE #Sys_No OF
        1:
            "VTD_HMI".Mode_Change[#HMI_No] := "Control_DB".VTD_Sys[1].Mode;
            "VTD_HMI".Enable[#HMI_No] := "Control_DB".VTD_Sys[1].Instruction.Enable;
            "PopUps_DB_1".Linear_Encoder[#HMI_No].LE_Bypass := "VTD_HMI".LE_Bypass[1];
            "VTD_HMI".Stop[#HMI_No] := "Control_DB".VTD_Sys[1].Instruction.Stop;
        2:
            "VTD_HMI".Mode_Change[#HMI_No] := "Control_DB".VTD_Sys[2].Mode;
            "VTD_HMI".Enable[#HMI_No] := "Control_DB".VTD_Sys[2].Instruction.Enable;
            "PopUps_DB_1".Linear_Encoder[#HMI_No].LE_Bypass := "VTD_HMI".LE_Bypass[2];
            "VTD_HMI".Stop[#HMI_No] := "Control_DB".VTD_Sys[2].Instruction.Stop;
        3:
            "VTD_HMI".Mode_Change[#HMI_No] := "Control_DB".VTD_Sys[3].Mode;
            "VTD_HMI".Enable[#HMI_No] := "Control_DB".VTD_Sys[3].Instruction.Enable;
            "PopUps_DB_1".Linear_Encoder[#HMI_No].LE_Bypass := "VTD_HMI".LE_Bypass[3];
            "VTD_HMI".Stop[#HMI_No] := "Control_DB".VTD_Sys[3].Instruction.Stop;
        4:
            "VTD_HMI".Mode_Change[#HMI_No] := "Control_DB".VTD_Sys[4].Mode;
            "VTD_HMI".Enable[#HMI_No] := "Control_DB".VTD_Sys[4].Instruction.Enable;
            "PopUps_DB_1".Linear_Encoder[#HMI_No].LE_Bypass := "VTD_HMI".LE_Bypass[4];
            "VTD_HMI".Stop[#HMI_No] := "Control_DB".VTD_Sys[4].Instruction.Stop;
        5:
            "VTD_HMI".Mode_Change[#HMI_No] := "Control_DB".VTD_Sys[5].Mode;
            "VTD_HMI".Enable[#HMI_No] := "Control_DB".VTD_Sys[5].Instruction.Enable;
            "PopUps_DB_1".Linear_Encoder[#HMI_No].LE_Bypass := "VTD_HMI".LE_Bypass[5];
            "VTD_HMI".Stop[#HMI_No] := "Control_DB".VTD_Sys[5].Instruction.Stop;
    END_CASE;
    #T_Charge_IN := TRUE;
END_IF;

#T_Charge.TON(IN := #T_Charge_IN,
              PT := T#500mS);
IF #T_Charge.Q THEN
    #Charged := TRUE;
END_IF;

// CHARGE DATA FROM HMI (AFTER CHARGE DATA)
"Control_DB".VTD_Sys[#Sys_No].Instruction.Mode_Change := 1;
IF #Charged THEN
    CASE #Sys_No OF
        1:
            Feed_VTD_HMI_FC_1(HMI_No := #HMI_No,
                                HMI_Box:= #HMI_Box,
                                Sys_No := #Sys_No,
                                Safety_OK := "Remote_Panel_DB_1".Safety_OK,
                                BCD_Test_Ok_HMI := "SICK_Lector_DB_1".Test_OK,
                                BCD_Error_HMI := "SICK_Lector_DB_1".Error,
                                BCD_RdDone := "SICK_Lector_DB_1".RdDone,
                                BCD_ReqDone := "SICK_Lector_DB_1".ReqDone,
                                BCD_ReqBusy := "SICK_Lector_DB_1".ReqBusy,
                                Sick_Lector_Reseult := "SICK_Lector_DB_1".Barcode_Result,
                                Level_Below_Extractor := "VTD_FB_DB_1".LevelBelowExtractor,
                                Speed_mm_s := "VTD_FB_DB_1".VTDSpeed_mm_s,
                                BCD_Start_Comm_Test_HMI := "BCD_Test_Comm_HMI(1)",
                                BCD_Enable_Trigger_HMI := "BCD_Enable_Trigger_HMI(1)",
                                BCD_Disable_Trigger_HMI := "BCD_Disable_Trigger_HMI(1)",
                                BCD_Execute_Function := "SICK_Lector_Control_DB_1".Enable_Req);
            
        2:
            Feed_VTD_HMI_FC_1(HMI_No := #HMI_No,
                                HMI_Box:= #HMI_Box,
                                Sys_No := #Sys_No,
                                Safety_OK := "Remote_Panel_DB_2".Safety_OK,
                                BCD_Test_Ok_HMI := "SICK_Lector_DB_2".Test_OK,
                                BCD_Error_HMI := "SICK_Lector_DB_2".Error,
                                BCD_RdDone := "SICK_Lector_DB_2".RdDone,
                                BCD_ReqDone := "SICK_Lector_DB_2".ReqDone,
                                BCD_ReqBusy := "SICK_Lector_DB_2".ReqBusy,
                                Sick_Lector_Reseult := "SICK_Lector_DB_2".Barcode_Result,
                                Level_Below_Extractor := "VTD_FB_DB_2".LevelBelowExtractor,
                                Speed_mm_s := "VTD_FB_DB_2".VTDSpeed_mm_s,
                                BCD_Start_Comm_Test_HMI := "BCD_Test_Comm_HMI(2)",
                                BCD_Enable_Trigger_HMI := "BCD_Enable_Trigger_HMI(2)",
                                BCD_Disable_Trigger_HMI := "BCD_Disable_Trigger_HMI(2)",
                                BCD_Execute_Function := "SICK_Lector_Control_DB_2".Enable_Req);
        3:
            Feed_VTD_HMI_FC_1(HMI_No := #HMI_No,
                                HMI_Box:= #HMI_Box,
                                Sys_No := #Sys_No,
                                Safety_OK := "Remote_Panel_DB_3".Safety_OK,
                                BCD_Test_Ok_HMI := "SICK_Lector_DB_3".Test_OK,
                                BCD_Error_HMI := "SICK_Lector_DB_3".Error,
                                BCD_RdDone := "SICK_Lector_DB_3".RdDone,
                                BCD_ReqDone := "SICK_Lector_DB_3".ReqDone,
                                BCD_ReqBusy := "SICK_Lector_DB_3".ReqBusy,
                                Sick_Lector_Reseult := "SICK_Lector_DB_3".Barcode_Result,
                                Level_Below_Extractor := "VTD_FB_DB_3".LevelBelowExtractor,
                                Speed_mm_s := "VTD_FB_DB_3".VTDSpeed_mm_s,
                                BCD_Start_Comm_Test_HMI := "BCD_Test_Comm_HMI(3)",
                                BCD_Enable_Trigger_HMI := "BCD_Enable_Trigger_HMI(3)",
                                BCD_Disable_Trigger_HMI := "BCD_Disable_Trigger_HMI(3)",
                                BCD_Execute_Function := "SICK_Lector_Control_DB_3".Enable_Req);
        4:
            Feed_VTD_HMI_FC_1(HMI_No := #HMI_No,
                                HMI_Box:= #HMI_Box,
                                Sys_No := #Sys_No,
                                Safety_OK := "Remote_Panel_DB_4".Safety_OK,
                                BCD_Test_Ok_HMI := "SICK_Lector_DB_4".Test_OK,
                                BCD_Error_HMI := "SICK_Lector_DB_4".Error,
                                BCD_RdDone := "SICK_Lector_DB_4".RdDone,
                                BCD_ReqDone := "SICK_Lector_DB_4".ReqDone,
                                BCD_ReqBusy := "SICK_Lector_DB_4".ReqBusy,
                                Sick_Lector_Reseult := "SICK_Lector_DB_4".Barcode_Result,
                                Level_Below_Extractor := "VTD_FB_DB_4".LevelBelowExtractor,
                                Speed_mm_s := "VTD_FB_DB_4".VTDSpeed_mm_s,
                                BCD_Start_Comm_Test_HMI := "BCD_Test_Comm_HMI(4)",
                                BCD_Enable_Trigger_HMI := "BCD_Enable_Trigger_HMI(4)",
                                BCD_Disable_Trigger_HMI := "BCD_Disable_Trigger_HMI(4)",
                                BCD_Execute_Function := "SICK_Lector_Control_DB_4".Enable_Req);
        5:
            Feed_VTD_HMI_FC_1(HMI_No := #HMI_No,
                                HMI_Box:= #HMI_Box,
                                Sys_No := #Sys_No,
                                Safety_OK := "Remote_Panel_DB_5".Safety_OK,
                                BCD_Test_Ok_HMI := "SICK_Lector_DB_5".Test_OK,
                                BCD_Error_HMI := "SICK_Lector_DB_5".Error,
                                BCD_RdDone := "SICK_Lector_DB_5".RdDone,
                                BCD_ReqDone := "SICK_Lector_DB_5".ReqDone,
                                BCD_ReqBusy := "SICK_Lector_DB_5".ReqBusy,
                                Sick_Lector_Reseult := "SICK_Lector_DB_5".Barcode_Result,
                                Level_Below_Extractor := "VTD_FB_DB_5".LevelBelowExtractor,
                                Speed_mm_s := "VTD_FB_DB_5".VTDSpeed_mm_s,
                                BCD_Start_Comm_Test_HMI := "BCD_Test_Comm_HMI(5)",
                                BCD_Enable_Trigger_HMI := "BCD_Enable_Trigger_HMI(5)",
                                BCD_Disable_Trigger_HMI := "BCD_Disable_Trigger_HMI(5)",
                                BCD_Execute_Function := "SICK_Lector_Control_DB_5".Enable_Req);
    END_CASE;
END_IF;



END_FUNCTION_BLOCK