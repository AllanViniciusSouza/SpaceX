                "Bypass".Remote_Panel_4.Chain_Slack_4 := "Chain_Slack_4_Bypass_HMI";
            ELSE
                "Bypass".Remote_Panel_4.Chain_Slack_4 := "Chain_Slack_4_Bypass_HMI" := FALSE;
            END_IF;
        END_IF;
    END_REGION ;
    
    REGION SYSTEM 5
        IF "VTD_System_Selected_HMI" = 5 THEN
            //OVERTRAVEL UP
            IF NOT "OVERTRAVEL UPPER LIMIT - CH1(5)" THEN
