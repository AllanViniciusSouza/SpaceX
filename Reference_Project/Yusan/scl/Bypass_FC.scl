            ELSE
                "Bypass".Remote_Panel_5.Chain_Slack_2 := "Chain_Slack_2_Bypass_HMI" := FALSE;
            END_IF;
            
            //CHAIN SLACK 3
            IF "Chain Slack 3 - CH1(5)" THEN
                "Bypass".Remote_Panel_5.Chain_Slack_3 := "Chain_Slack_3_Bypass_HMI";
            ELSE
