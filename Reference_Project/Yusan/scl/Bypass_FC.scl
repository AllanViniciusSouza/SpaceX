                "Bypass".Remote_Panel_4.Chain_Slack_3 := "Chain_Slack_3_Bypass_HMI";
            ELSE
                "Bypass".Remote_Panel_4.Chain_Slack_3 := "Chain_Slack_3_Bypass_HMI" := FALSE;
            END_IF;
            
            //CHAIN SLACK 4
