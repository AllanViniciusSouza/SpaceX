FUNCTION "PopUp_Screens"   // FC 9, author 

   // RETURN : Void
BEGIN
//VTD SETTINGS
IF "VTD_System_Selected_HMI" <> 0 (*AND "HMI_DB".ScreenNo_Main = 11*) AND "PopUps_DB".VTD_Settings.ID = "Settings_System_Selected" THEN
    CASE "Settings_System_Selected" OF
        1:
            "Settings_DB".VTD_Sys[1] := "PopUps_DB".VTD_Settings;
            Settings_Limits_FC("Settings_DB".VTD_Sys[1]);
        2:
            "Settings_DB".VTD_Sys[2] := "PopUps_DB".VTD_Settings;
            Settings_Limits_FC("Settings_DB".VTD_Sys[2]);
        3:
            "Settings_DB".VTD_Sys[3] := "PopUps_DB".VTD_Settings;
