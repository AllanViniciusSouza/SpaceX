REGION MQTT
    IF "LMQTT_DB".error THEN
        
        // 16#8001 - Simultaneous input at publish/subscribe/unsubscribe
        "Error_MQTT".%X0 := "LMQTT_DB".status = 16#8001;
        
        // 16#8200 - Client identifier is empty
        "Error_MQTT".%X1 := "LMQTT_DB".status = 16#8200;
        
        // 16#8201 - Broker hostname or IP address is invalid
        "Error_MQTT".%X2 := "LMQTT_DB".status = 16#8201;
        
        // 16#8210 - Invalid array size
        // willMsgLen / publishMsgLen
            "Error_MQTT".%X3 := "LMQTT_DB".status = 16#8210;
        
        
        // 16#8220 - Invalid keepAlive value
            "Error_MQTT".%X4 := "LMQTT_DB".status = 16#8220;
        
        // 16#8230 - Invalid QoS value
            "Error_MQTT".%X5 := "LMQTT_DB".status = 16#8230;

        // 16#8300 - Publish topic empty or invalid
            "Error_MQTT".%X6 := "LMQTT_DB".status = 16#8300;
        
        
        // 16#8310 - Subscribe topic empty or invalid
            "Error_MQTT".%X7 := "LMQTT_DB".status = 16#8310;
        
        // 16#8320 - Unsubscribe topic empty or invalid
            "Error_MQTT".%X8 := "LMQTT_DB".status = 16#8320;
        
        // 16#8600 - Undefined state in the state machine
            "Error_MQTT".%X9 := "LMQTT_DB".status = 16#8600;
        
        // 16#8601 - Error of subordinate instruction TCON
            "Error_MQTT".%X10 := "LMQTT_DB".status = 16#8601;
        
        // 16#8620 - Connection establishment timeout
            "Error_MQTT".%X11 := "LMQTT_DB".status = 16#8620;
        
        // 16#8650 - Timeout during processing of the job
            "Error_MQTT".%X12 := "LMQTT_DB".status = 16#8650;
        
        // 16#8670 - Timeout during MQTT connection setup
            "Error_MQTT".%X13 := "LMQTT_DB".status = 16#8670;
        
        // 16#8700 - Invalid length in received MQTT packet
            "Error_MQTT".%X14 := "LMQTT_DB".status = 16#8700;
        
        // 16#8710 - Invalid QoS in received MQTT packet
            "Error_MQTT".%X15 := "LMQTT_DB".status = 16#8710;
        
        // 16#8720 - Existing session at MQTT broker
            "Error_MQTT_2".%X0 := "LMQTT_DB".status = 16#8720;
        
        // 16#8730 - Connection rejected by MQTT broker
            "Error_MQTT_2".%X1 := "LMQTT_DB".status = 16#8730;
        
        // 16#8740 - MQTT packet acknowledged with invalid packet ID
            "Error_MQTT_2".%X2 := "LMQTT_DB".status = 16#8740;
        
        // 16#8750 - MQTT subscription rejected by broker
            "Error_MQTT_2".%X3 := "LMQTT_DB".status = 16#8750;
        
        // 16#8760 - QoS 2 message buffer full
            "Error_MQTT_2".%X4 := "LMQTT_DB".status = 16#8760;
        
        // 16#9000 - Connection to MQTT broker lost
        // Automatic reconnect in progress
            "Error_MQTT_2".%X5 := "LMQTT_DB".status = 16#9000;
    END_IF;
    
END_REGION

REGION OVERGANG SENSORS
    //SYSTEM 1
    IF NOT "Control_DB".ECnv_Sys[1].Inputs.Overhang_Left THEN
