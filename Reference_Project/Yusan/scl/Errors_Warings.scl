        END_IF;
        
        IF NOT "Remote_Panel_DB_3".EStop_Lock_2 THEN //LOCK 2
            "Estop_Error_Word_3".%X11 := TRUE;
        END_IF;
    END_REGION ;
    
    REGION SYSTEM 4
        IF NOT "E-STOP (CABINET) - CH1(4)" THEN //REMOTE PANEL 4
            "Estop_Error_Word_4".%X1 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_4"."EStop Level 1" THEN //LEVEL PANEL 1 
            "Estop_Error_Word_4".%X2 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_4"."EStop Level 2" THEN //LEVEL PANEL 2
            "Estop_Error_Word_4".%X3 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_4"."EStop Level 3" THEN //LEVEL PANEL 3
            "Estop_Error_Word_4".%X4 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_4"."EStop Level 4" THEN //LEVEL PANEL 4
            "Estop_Error_Word_4".%X5 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_4"."EStop Level 5" THEN //LEVEL PANEL 5
            "Estop_Error_Word_4".%X6 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_4"."EStop Level 6" THEN //LEVEL PANEL 6
            "Estop_Error_Word_4".%X7 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_4"."EStop Level 7" THEN //LEVEL PANEL 7
            "Estop_Error_Word_4".%X8 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_4"."EStop Level 8" THEN //LEVEL PANEL 8
            "Estop_Error_Word_4".%X9 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_4".EStop_Lock_1 THEN //LOCK 1
            "Estop_Error_Word_4".%X10 := TRUE;
        END_IF;
    END_REGION ;
    
    REGION SYSTEM 5
        IF NOT "E-STOP (CABINET) - CH1(5)" THEN //REMOTE PANEL 5
            "Estop_Error_Word_5".%X1 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_5"."EStop Level 1" THEN //LEVEL PANEL 1 
            "Estop_Error_Word_5".%X2 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_5"."EStop Level 2" THEN //LEVEL PANEL 2
            "Estop_Error_Word_5".%X3 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_5"."EStop Level 3" THEN //LEVEL PANEL 3
            "Estop_Error_Word_5".%X4 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_5"."EStop Level 4" THEN //LEVEL PANEL 4
            "Estop_Error_Word_5".%X5 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_5"."EStop Level 5" THEN //LEVEL PANEL 5
            "Estop_Error_Word_5".%X6 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_5"."EStop Level 6" THEN //LEVEL PANEL 6
            "Estop_Error_Word_5".%X7 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_5"."EStop Level 7" THEN //LEVEL PANEL 7
            "Estop_Error_Word_5".%X8 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_5"."EStop Level 8" THEN //LEVEL PANEL 8
            "Estop_Error_Word_5".%X9 := TRUE;
        END_IF;
        
        IF NOT "Remote_Panel_DB_5".EStop_Lock_1 THEN //LOCK 1
            "Estop_Error_Word_5".%X10 := TRUE;
        END_IF;
    END_REGION ;
    
    REGION IDEM LOCK
        IF NOT "F_Lock_FB_DB_7".EStop_CH1 THEN //Left level 1
            "Estop_Error_Word_6".%X0 := TRUE;
        END_IF;
        
        IF NOT "F_Lock_FB_DB_8".EStop_CH1 THEN //Left level 2
            "Estop_Error_Word_6".%X1 := TRUE;
        END_IF;
        
        IF NOT "F_Lock_FB_DB_11".EStop_CH1 THEN //Right level 2
            "Estop_Error_Word_6".%X2 := TRUE;
        END_IF;
        
        IF NOT "F_Lock_FB_DB_12".EStop_CH1 THEN //Right level 1
            "Estop_Error_Word_6".%X3 := TRUE;
        END_IF;
    END_REGION
END_REGION;

REGION Sick Barcode
    REGION System 1
        IF "SICK_Lector_DB_1".Errorcode = 16#0000_0001 THEN //Timeout (SICK_CCOM_PNDP) 
            "Sick Lector_Error code 1".%X0 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0002 THEN //Invalid module length (input)
            "Sick Lector_Error code 1".%X1 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0003 THEN //Invalid module length (output)
            "Sick Lector_Error code 1".%X2 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0004 THEN //DPWR_DAT error 
            "Sick Lector_Error code 1".%X3 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0005 THEN //DPRD_DAT error 
            "Sick Lector_Error code 1".%X4 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode > 16#0000_0006 AND "SICK_Lector_DB_1".Errorcode < 16#0000_0009 THEN //Communication error 
            "Sick Lector_Error code 1".%X5 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0010 THEN //Timeout (SICK_CCOM_PNDP)
            "Sick Lector_Error code 1".%X6 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0011 THEN //Device error 
            "Sick Lector_Error code 1".%X7 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0012 THEN //SICK_GetValue error 
            "Sick Lector_Error code 1".%X8 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0013 THEN //SICK_SetValue error
            "Sick Lector_Error code 1".%X9 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0014 THEN //#CANId > 63 
            "Sick Lector_Error code 1".%X10 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0015 THEN //No module function selected, OR more than one module function selected
            "Sick Lector_Error code 1".%X11 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0016 THEN //Invalid command response received
            "Sick Lector_Error code 1".%X12 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0017 THEN //Change not possible in "RUN mode".
            "Sick Lector_Error code 1".%X13 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0020 THEN //FreeCommand.sCommand > arrCommand (500 bytes)
            "Sick Lector_Error code 1".%X14 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0021 THEN //Response to free command > result string(FreeCommand.sResult[100 characters])
            "Sick Lector_Error code 1".%X15 := TRUE;
        ELSIF "SICK_Lector_DB_1".Errorcode = 16#0000_0022 THEN //String length Match - code.sName =0
            "Sick Lector_Error code 1_2".%X0 := TRUE;
        END_IF;
    END_REGION
    REGION System 2
        IF "SICK_Lector_DB_2".Errorcode = 16#0000_0001 THEN //Timeout (SICK_CCOM_PNDP) 
