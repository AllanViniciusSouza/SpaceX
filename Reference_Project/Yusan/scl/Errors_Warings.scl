REGION Linear Encoder
    FOR #i := 1 TO 5 DO
        IF "Control_DB".VTD_Sys[#i].Inputs.LE_Status.%X0 THEN //Error present
            IF "Control_DB".VTD_Sys[#i].Inputs.LE_Position = 1 THEN //Reader tilted 180°
                IF #i = 1 THEN
                    "Linear Encoder_Device Errors 1".%X0 := TRUE;
                ELSIF #i = 2 THEN
                    "Linear Encoder_Device Errors 2".%X0 := TRUE;
                ELSIF #i = 3 THEN
                    "Linear Encoder_Device Errors 3".%X0 := TRUE;
                ELSIF #i = 4 THEN
                    "Linear Encoder_Device Errors 4".%X0 := TRUE;
                ELSIF #i = 5 THEN
                    "Linear Encoder_Device Errors 5".%X0 := TRUE;
                END_IF;
            ELSIF "Control_DB".VTD_Sys[#i].Inputs.LE_Position = 2 THEN // No clear position can be determined (difference between codes is too great, code distance incorrect, etc.)
                IF #i = 1 THEN
                    "Linear Encoder_Device Errors 1".%X1 := TRUE;
                ELSIF #i = 2 THEN
                    "Linear Encoder_Device Errors 2".%X1 := TRUE;
                ELSIF #i = 3 THEN
                    "Linear Encoder_Device Errors 3".%X1 := TRUE;
                ELSIF #i = 4 THEN
                    "Linear Encoder_Device Errors 4".%X1 := TRUE;
                ELSIF #i = 5 THEN
                    "Linear Encoder_Device Errors 5".%X1 := TRUE;
                END_IF;
            ELSIF "Control_DB".VTD_Sys[#i].Inputs.LE_Position = 1000 THEN //Internal error
                IF #i = 1 THEN
                    "Linear Encoder_Device Errors 1".%X2 := TRUE;
                ELSIF #i = 2 THEN
                    "Linear Encoder_Device Errors 2".%X2 := TRUE;
                ELSIF #i = 3 THEN
                    "Linear Encoder_Device Errors 3".%X2 := TRUE;
                ELSIF #i = 4 THEN
                    "Linear Encoder_Device Errors 4".%X2 := TRUE;
                ELSIF #i = 5 THEN
                    "Linear Encoder_Device Errors 5".%X2 := TRUE;
                END_IF;
            ELSIF "Control_DB".VTD_Sys[#i].Inputs.LE_Status.%X1 THEN // No position information/OUT
                IF #i = 1 THEN
                    "Linear Encoder_Device Errors 1".%X3 := TRUE;
                ELSIF #i = 2 THEN
                    "Linear Encoder_Device Errors 2".%X3 := TRUE;
                ELSIF #i = 3 THEN
                    "Linear Encoder_Device Errors 3".%X3 := TRUE;
                ELSIF #i = 4 THEN
                    "Linear Encoder_Device Errors 4".%X3 := TRUE;
                ELSIF #i = 5 THEN
                    "Linear Encoder_Device Errors 5".%X3 := TRUE;
                END_IF;
            ELSIF "Control_DB".VTD_Sys[#i].Inputs.LE_Status.%X0 THEN //Error present
                IF #i = 1 THEN
                    "Linear Encoder_Device Errors 1".%X4 := TRUE;
                ELSIF #i = 2 THEN
                    "Linear Encoder_Device Errors 2".%X4 := TRUE;
                ELSIF #i = 3 THEN
                    "Linear Encoder_Device Errors 3".%X4 := TRUE;
                ELSIF #i = 4 THEN
                    "Linear Encoder_Device Errors 4".%X4 := TRUE;
                ELSIF #i = 5 THEN
                    "Linear Encoder_Device Errors 5".%X4 := TRUE;
                END_IF;
            ELSE//NO ERROR
                IF #i = 1 THEN
                    "Linear Encoder_Device Errors 1" := 0;
                ELSIF #i = 2 THEN
                    "Linear Encoder_Device Errors 2" := 0;
                ELSIF #i = 3 THEN
                    "Linear Encoder_Device Errors 3" := 0;
                ELSIF #i = 4 THEN
                    "Linear Encoder_Device Errors 4" := 0;
                ELSIF #i = 5 THEN
                    "Linear Encoder_Device Errors 5" := 0;
                END_IF;
            END_IF;
            
            //WARNINGS
            IF "Control_DB".VTD_Sys[#i].Inputs.LE_Status.%X2 THEN // Warnign present
                IF #i = 1 THEN
                    "Linear Encoder_Warnings 1".%X0 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X0; //Code with non-PXV content found
                    "Linear Encoder_Warnings 1".%X1 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X1; //Reader too close to code tape
                    "Linear Encoder_Warnings 1".%X2 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X2; //Reader too far from code tape
                    "Linear Encoder_Warnings 1".%X3 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X3; //Y position too large; the sensor is just before OUT
                    "Linear Encoder_Warnings 1".%X4 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X4; //Y position too small; the sensor is just before OUT
                    "Linear Encoder_Warnings 1".%X5 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X5; //The reader is rotated or tilted in relation to the code tape
                    "Linear Encoder_Warnings 1".%X6 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X6; // Low level of code contrast
                    "Linear Encoder_Warnings 1".%X7 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X7; //Repair tape detected
                    "Linear Encoder_Warnings 1".%X8 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X8; //Temperature too high
                ELSIF #i = 2 THEN
                    "Linear Encoder_Warnings 2".%X0 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X0; //Code with non-PXV content found
                    "Linear Encoder_Warnings 2".%X1 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X1; //Reader too close to code tape
                    "Linear Encoder_Warnings 2".%X2 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X2; //Reader too far from code tape
                    "Linear Encoder_Warnings 2".%X3 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X3; //Y position too large; the sensor is just before OUT
                    "Linear Encoder_Warnings 2".%X4 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X4; //Y position too small; the sensor is just before OUT
                    "Linear Encoder_Warnings 2".%X5 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X5; //The reader is rotated or tilted in relation to the code tape
                    "Linear Encoder_Warnings 2".%X6 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X6; // Low level of code contrast
                    "Linear Encoder_Warnings 2".%X7 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X7; //Repair tape detected
                    "Linear Encoder_Warnings 2".%X8 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X8; //Temperature too high
                ELSIF #i = 3 THEN
                    "Linear Encoder_Warnings 3".%X0 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X0; //Code with non-PXV content found
                    "Linear Encoder_Warnings 3".%X1 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X1; //Reader too close to code tape
                    "Linear Encoder_Warnings 3".%X2 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X2; //Reader too far from code tape
                    "Linear Encoder_Warnings 3".%X3 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X3; //Y position too large; the sensor is just before OUT
                    "Linear Encoder_Warnings 3".%X4 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X4; //Y position too small; the sensor is just before OUT
                    "Linear Encoder_Warnings 3".%X5 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X5; //The reader is rotated or tilted in relation to the code tape
                    "Linear Encoder_Warnings 3".%X6 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X6; // Low level of code contrast
                    "Linear Encoder_Warnings 3".%X7 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X7; //Repair tape detected
                    "Linear Encoder_Warnings 3".%X8 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X8; //Temperature too high
                ELSIF #i = 4 THEN
                    "Linear Encoder_Warnings 4".%X0 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X0; //Code with non-PXV content found
                    "Linear Encoder_Warnings 4".%X1 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X1; //Reader too close to code tape
                    "Linear Encoder_Warnings 4".%X2 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X2; //Reader too far from code tape
                    "Linear Encoder_Warnings 4".%X3 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X3; //Y position too large; the sensor is just before OUT
                    "Linear Encoder_Warnings 4".%X4 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X4; //Y position too small; the sensor is just before OUT
                    "Linear Encoder_Warnings 4".%X5 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X5; //The reader is rotated or tilted in relation to the code tape
                    "Linear Encoder_Warnings 4".%X6 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X6; // Low level of code contrast
                    "Linear Encoder_Warnings 4".%X7 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X7; //Repair tape detected
                    "Linear Encoder_Warnings 4".%X8 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X8; //Temperature too high
                ELSIF #i = 5 THEN
                    "Linear Encoder_Warnings 5".%X0 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X0; //Code with non-PXV content found
                    "Linear Encoder_Warnings 5".%X1 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X1; //Reader too close to code tape
                    "Linear Encoder_Warnings 5".%X2 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X2; //Reader too far from code tape
                    "Linear Encoder_Warnings 5".%X3 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X3; //Y position too large; the sensor is just before OUT
                    "Linear Encoder_Warnings 5".%X4 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X4; //Y position too small; the sensor is just before OUT
                    "Linear Encoder_Warnings 5".%X5 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X5; //The reader is rotated or tilted in relation to the code tape
                    "Linear Encoder_Warnings 5".%X6 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X6; // Low level of code contrast
                    "Linear Encoder_Warnings 5".%X7 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X7; //Repair tape detected
                    "Linear Encoder_Warnings 5".%X8 := "Control_DB".VTD_Sys[#i].Inputs.LE_Warnings.%X8; //Temperature too high
                END_IF;
            END_IF;
        END_IF;
    END_FOR;
END_REGION

