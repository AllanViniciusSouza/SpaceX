// "DB_Safety_SM_To_LGX".VTD_I1330_LG1_Active := #C1103_LG1;
// "DB_Safety_SM_To_LGX".VTD_I1330_LG2_Active := #C1103_LG2;


// // ============================================================
// // FC_Safety_PostProcess (FC1001 on the Spacemaker side)
// // Post-processing of safety data received from LGX
