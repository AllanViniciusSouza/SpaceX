FUNCTION "Safety_Data_FC"   // FC 50, author 

VAR_INPUT
   C1101_EStop : Bool;
   C1102_EStop : Bool;
   C1103_EStop : Bool;
   C1101_LG1 : Bool;
   C1101_LG2 : Bool;
   C1102_LG1 : Bool;
   C1102_LG2 : Bool;
   C1103_LG1 : Bool;
   C1103_LG2 : Bool;
END_VAR

VAR_OUTPUT
   o_LGX_Zone01_EStop : Bool;
   o_LGX_Zone02_EStop : Bool;
   o_LGX_Zone03_EStop : Bool;
   o_LGX_Zone04_EStop : Bool;
   o_LGX_Zone05_EStop : Bool;
   o_LGX_Zone06_EStop : Bool;
   o_LGX_Zone07_EStop : Bool;
   o_LGX_Zone08_EStop : Bool;
   o_LGX_Zone09_EStop : Bool;
