   o_LGX_Infeed_I1107_CS : Bool;
   o_LGX_Outfeed_I1401_CS : Bool;
   o_LGX_Outfeed_I1403_CS : Bool;
   o_LGX_Outfeed_I1407_CS : Bool;
   o_Any_LGX_EStop_Active : Bool;
   o_Any_LGX_Conv_CS_Active : Bool;
END_VAR

   // RETURN : Void
BEGIN
// // ============================================================
// // FC_Safety_PreProcess (FC1000 on the Spacemaker side)
// // Safety data pre-processing before OPC-UA transmission
// // Execute in the F-Runtime Group (Main_Safety_RTG1)
// // Ref: Section 6 of the document
// // ============================================================

// // NOTE: This FC runs in the F-Runtime safety group (Safety Program).
// // Inputs are the actual safety signals from the SM system.
// // Outputs populate the safety DB that will be published by the OPC-UA Server.

// // --- Map E-Stops to SM → LGX safety DB ---
// "DB_Safety_SM_To_LGX".VTD_I1310_EStop_Active := #C1101_EStop;
// "DB_Safety_SM_To_LGX".VTD_I1320_EStop_Active := #C1102_EStop;
// "DB_Safety_SM_To_LGX".VTD_I1330_EStop_Active := #C1103_EStop;

// // --- Map Light Guards ---
// "DB_Safety_SM_To_LGX".VTD_I1310_LG1_Active := #C1101_LG1;
// "DB_Safety_SM_To_LGX".VTD_I1310_LG2_Active := #C1101_LG2;
// "DB_Safety_SM_To_LGX".VTD_I1320_LG1_Active := #C1102_LG1;
