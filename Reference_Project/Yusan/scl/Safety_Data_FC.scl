// #o_LGX_Zone02_EStop := "DB_Safety_LGX_To_SM".Zone_02_EStop_Active;
// #o_LGX_Zone03_EStop := "DB_Safety_LGX_To_SM".Zone_03_EStop_Active;
// #o_LGX_Zone04_EStop := "DB_Safety_LGX_To_SM".Zone_04_EStop_Active;
// #o_LGX_Zone05_EStop := "DB_Safety_LGX_To_SM".Zone_05_EStop_Active;
// #o_LGX_Zone06_EStop := "DB_Safety_LGX_To_SM".Zone_06_EStop_Active;
// #o_LGX_Zone07_EStop := "DB_Safety_LGX_To_SM".Zone_07_EStop_Active;
// #o_LGX_Zone08_EStop := "DB_Safety_LGX_To_SM".Zone_08_EStop_Active;
