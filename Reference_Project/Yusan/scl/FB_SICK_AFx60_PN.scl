      #Data.Parameter.Scaling_Parameters.Out_CPR_Fract.%B3:= #arrRecord[46];
      #Data.Parameter.Scaling_Parameters.Out_CPR_Fract.%B2:= #arrRecord[47];
      #Data.Parameter.Scaling_Parameters.Out_CPR_Fract.%B1:= #arrRecord[48];
      #Data.Parameter.Scaling_Parameters.Out_CPR_Fract.%B0:= #arrRecord[49];
      
    (*eOperationTest1*)
    1010:
      #Data.Parameter.Operation_Test_1.%B1:= #arrRecord[6];
      #Data.Parameter.Operation_Test_1.%B0:= #arrRecord[7];
      
    (*eMACIDPort1*)
    1011:
      FOR #iIndex:= 0 TO 5 DO
        #Data.Parameter.MAC_ID_Port_1[#iIndex]:= #arrRecord[6 + #iIndex];
      END_FOR;
      
    (*eMACIDPort2*)
    1012:
      FOR #iIndex:= 0 TO 5 DO
        #Data.Parameter.MAC_ID_Port_2[#iIndex]:= #arrRecord[6 + #iIndex];
      END_FOR;

    (*eVersionFWFPGA*)
    1013:
      #Data.Parameter.Version_FW_FPGA.%B3:= #arrRecord[6];
      #Data.Parameter.Version_FW_FPGA.%B2:= #arrRecord[7];
      #Data.Parameter.Version_FW_FPGA.%B1:= #arrRecord[8];
      #Data.Parameter.Version_FW_FPGA.%B0:= #arrRecord[9];
      
    (*eTemperature*)
    1014:
      #Data.Parameter.Temperature.%B1:= #arrRecord[6];  
      #Data.Parameter.Temperature.%B0:= #arrRecord[7];  
      
    (*eStationName*)
    61000:
      Chars_TO_Strg(Chars:= #arrRecord, pChars:= 6, Cnt:= BYTE_TO_UINT(#arrRecord[5]), Strg=>#Data.Parameter.Station_Name);
     
    (*eStationIP*)
    61001:
      FOR #iIndex:= 0 TO 3 DO
        #Data.Parameter.Station_IP[#iIndex]:= #arrRecord[6 + #iIndex];
      END_FOR;

    (*eStationMACID*)
    61002:
      FOR #iIndex:= 0 TO 5 DO
        #Data.Parameter.Station_MAC_ID[#iIndex]:= #arrRecord[6 + #iIndex];
      END_FOR;

    (*eStationGateway*)
    61003:
      FOR #iIndex:= 0 TO 3 DO
        #Data.Parameter.Station_Gateway[#iIndex]:= #arrRecord[6 + #iIndex];
      END_FOR;
      
    (*eStationSubnet*)
    61004:
      FOR #iIndex:= 0 TO 3 DO
        #Data.Parameter.Station_Subnet[#iIndex]:= #arrRecord[6 + #iIndex];
      END_FOR;

    (*ePresetValue*)
    65000:
      #Data.Parameter.Preset_Value.%B3:= #arrRecord[6];
      #Data.Parameter.Preset_Value.%B2:= #arrRecord[7];
      #Data.Parameter.Preset_Value.%B1:= #arrRecord[8];
      #Data.Parameter.Preset_Value.%B0:= #arrRecord[9];
  
    (*eOperatingStatus*)
    65001:
      #Data.Parameter.Operating_Status.Header.%B3:= #arrRecord[6];
      #Data.Parameter.Operating_Status.Header.%B2:= #arrRecord[7];
      #Data.Parameter.Operating_Status.Header.%B1:= #arrRecord[8];
      #Data.Parameter.Operating_Status.Header.%B0:= #arrRecord[9];
      #Data.Parameter.Operating_Status.Operating_Status.%B3:= #arrRecord[10];
      #Data.Parameter.Operating_Status.Operating_Status.%B2:= #arrRecord[11];
      #Data.Parameter.Operating_Status.Operating_Status.%B1:= #arrRecord[12];
      #Data.Parameter.Operating_Status.Operating_Status.%B0:= #arrRecord[13];
      #Data.Parameter.Operating_Status.Faults.%B3:= #arrRecord[14];
      #Data.Parameter.Operating_Status.Faults.%B2:= #arrRecord[15];
      #Data.Parameter.Operating_Status.Faults.%B1:= #arrRecord[16];
      #Data.Parameter.Operating_Status.Faults.%B0:= #arrRecord[17];
      #Data.Parameter.Operating_Status.Supported_Faults.%B3:= #arrRecord[18];
      #Data.Parameter.Operating_Status.Supported_Faults.%B2:= #arrRecord[19];
      #Data.Parameter.Operating_Status.Supported_Faults.%B1:= #arrRecord[20];
      #Data.Parameter.Operating_Status.Supported_Faults.%B0:= #arrRecord[21];
      #Data.Parameter.Operating_Status.Warnings.%B3:= #arrRecord[22];
      #Data.Parameter.Operating_Status.Warnings.%B2:= #arrRecord[23];
      #Data.Parameter.Operating_Status.Warnings.%B1:= #arrRecord[24];
      #Data.Parameter.Operating_Status.Warnings.%B0:= #arrRecord[25];
      #Data.Parameter.Operating_Status.Supported_Warnings.%B3:= #arrRecord[26];
      #Data.Parameter.Operating_Status.Supported_Warnings.%B2:= #arrRecord[27];
      #Data.Parameter.Operating_Status.Supported_Warnings.%B1:= #arrRecord[28];
      #Data.Parameter.Operating_Status.Supported_Warnings.%B0:= #arrRecord[29];
      #Data.Parameter.Operating_Status.Encoder_Profile_Version.%B3:= #arrRecord[30];
      #Data.Parameter.Operating_Status.Encoder_Profile_Version.%B2:= #arrRecord[31];
      #Data.Parameter.Operating_Status.Encoder_Profile_Version.%B1:= #arrRecord[32];
      #Data.Parameter.Operating_Status.Encoder_Profile_Version.%B0:= #arrRecord[33];
      #Data.Parameter.Operating_Status.Operating_Time.%B3:= #arrRecord[34];
      #Data.Parameter.Operating_Status.Operating_Time.%B2:= #arrRecord[35];
      #Data.Parameter.Operating_Status.Operating_Time.%B1:= #arrRecord[36];
      #Data.Parameter.Operating_Status.Operating_Time.%B0:= #arrRecord[37];
      #Data.Parameter.Operating_Status.Offset_Value.%B3:= #arrRecord[38];
      #Data.Parameter.Operating_Status.Offset_Value.%B2:= #arrRecord[39];
      #Data.Parameter.Operating_Status.Offset_Value.%B1:= #arrRecord[40];
      #Data.Parameter.Operating_Status.Offset_Value.%B0:= #arrRecord[41];
      #Data.Parameter.Operating_Status.CPR.%B3:= #arrRecord[42];
      #Data.Parameter.Operating_Status.CPR.%B2:= #arrRecord[43];
      #Data.Parameter.Operating_Status.CPR.%B1:= #arrRecord[44];
      #Data.Parameter.Operating_Status.CPR.%B0:= #arrRecord[45];
      #Data.Parameter.Operating_Status.CMR.%B3:= #arrRecord[46];
      #Data.Parameter.Operating_Status.CMR.%B2:= #arrRecord[47];
      #Data.Parameter.Operating_Status.CMR.%B1:= #arrRecord[48];
      #Data.Parameter.Operating_Status.CMR.%B0:= #arrRecord[49];
      #Data.Parameter.Operating_Status.Velocity_Measuring_Unit.%B3:= #arrRecord[50];
      #Data.Parameter.Operating_Status.Velocity_Measuring_Unit.%B2:= #arrRecord[51];
      #Data.Parameter.Operating_Status.Velocity_Measuring_Unit.%B1:= #arrRecord[52];
      #Data.Parameter.Operating_Status.Velocity_Measuring_Unit.%B0:= #arrRecord[53];
  ELSE
    #stTempErrorCode.nBlockError:= 16#0002; (*Error: Internal error*)
  END_CASE;
  #iStep:= 9; (*Action permormed / Next command*)
END_IF;


(*======================== ACTION PERFORMED / NEXT COMMAND (STEP 9) =========================*)
IF #iStep = 9 THEN
  #iCommandIndex:= #iCommandIndex + 1;
  
  (*Job done*)
  IF (#iCommandIndex > 31) OR (#arrCommandQueue[#iCommandIndex].iPNU <= 0) THEN
    #Done:= true;
    #Busy:= false;
    #bBusyMem:= false;
    #Error:= false;
    #iStep:= 0;
    
  (*Next command*)
  ELSE
    #iStep:= 4; (*Check communication status*)
  END_IF;
END_IF;
END_FUNCTION_BLOCK