            "Control_DB".LCnv_Sys[4].Cnv_Level[8].Cnv1.Inputs.VFD_Speed_Actual := WORD_TO_INT("C4108_ActualSpeed");
            "Control_DB".LCnv_Sys[4].Cnv_Level[8].Cnv1.Inputs.VFD_ActualTorque := WORD_TO_INT("C4108_ActualTorque");
        END_REGION
    END_REGION
    
    REGION VTD
        "Control_DB".VTD_Sys[4].Inputs.Upper_Overtravel := "OVERTRAVEL UPPER LIMIT - CH1(4)";
        "Control_DB".VTD_Sys[4].Inputs.Upper_limit := "VTD4 UPPER LIMIT";
        "Control_DB".VTD_Sys[4].Inputs.Ultimate_SlowDown := "VTD4 ULTIMATE SLOWDOWN";
        "Control_DB".VTD_Sys[4].Inputs.Ultimate_Creep := "VTD4 ULTIMATE CREEP";
        "Control_DB".VTD_Sys[4].Inputs.Lower_Limit := "VTD4 LOWER LIMIT";
        "Control_DB".VTD_Sys[4].Inputs.Lower_Overtravel := "OVERTRAVEL LOWER LIMIT - CH1(4)";
