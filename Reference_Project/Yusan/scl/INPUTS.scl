        "Control_DB".VTD_Sys[3].Inputs.Level_Detect2 := "VTD3 LEVEL DETECT 2";
        "Control_DB".VTD_Sys[3].Inputs.DP1_Extended := "VTD3 DOCKING PINS EXTENDED 1";
        "Control_DB".VTD_Sys[3].Inputs.DP2_Extended := "VTD3 DOCKING PINS EXTENDED 2";
        "Control_DB".VTD_Sys[3].Inputs.DP1_Retracted := "VTD3 DOCKING PINS RETRACTED 1";
        "Control_DB".VTD_Sys[3].Inputs.DP2_Retracted := "VTD3 DOCKING PINS RETRACTED 2";
        "Control_DB".VTD_Sys[3].Inputs.Chain_Slack_1 := NOT "Remote_Panel_DB_3".Chain_Slack_1_Filtered;
        "Control_DB".VTD_Sys[3].Inputs.Chain_Slack_2 := NOT "Remote_Panel_DB_3".Chain_Slack_2_Filtered;
        "Control_DB".VTD_Sys[3].Inputs.Chain_Slack_3 := NOT "Remote_Panel_DB_3".Chain_Slack_3_Filtered;
        "Control_DB".VTD_Sys[3].Inputs.Chain_Slack_4 := NOT "Remote_Panel_DB_3".Chain_Slack_4_Filtered;
        "Control_DB".VTD_Sys[3].Inputs.PushToEnter := "VTD3 PUSH TO ENTER VTD ZONE";
        "Control_DB".VTD_Sys[3].Inputs.PushToExit := "VTD3 PUSH TO EXIT VTD ZONE";
        
        "Control_DB".VTD_Sys[3].Inputs.VFD_Status := "VTD3_StatusWord";
        "Control_DB".VTD_Sys[3].Inputs.VFD_ActualCurrent := REAL_TO_INT(("VTD3_ActualCurrent" / 10) / 72.5);
        "Control_DB".VTD_Sys[3].Inputs.VFD_Speed_Actual := "VTD3_ActualSpeed";
