FUNCTION "INPUTS"   // FC 25, author 

   // RETURN : Void
BEGIN
REGION SYSTEM 1
    REGION EXTRACTOR CONVEYOR
        "Control_DB".ECnv_Sys[1].Inputs.Left := "CVTD1 SENSOR CONVEYOR LEFT";
        "Control_DB".ECnv_Sys[1].Inputs.Lpd1 := "CVTD1 SENSOR CONVEYOR LEFT (PALLET DETECT 1)";
        "Control_DB".ECnv_Sys[1].Inputs.Center := "CVTD1 SENSOR CONVEYOR CENTER";
        "Control_DB".ECnv_Sys[1].Inputs.Right := "CVTD1 SENSOR CONVEYOR RIGHT";
        "Control_DB".ECnv_Sys[1].Inputs.Rpd1 := "CVTD1 SENSOR CONVEYOR RIGHT (PALLET DETECT 1)";
        
        "T_OH_Left_1".TOF(IN := "CVTD1 OVERHANG LEFT" OR NOT "Control_DB".VTD_Sys[1].Running,
                          PT := T#200ms);
        "Control_DB".ECnv_Sys[1].Inputs.Overhang_Left := "T_OH_Left_1".Q;
        
        "T_OH_Right_1".TOF(IN := "CVTD1 OVERHANG RIGHT" OR NOT "Control_DB".VTD_Sys[1].Running,
                           PT := T#200ms);
        "Control_DB".ECnv_Sys[1].Inputs.Overhang_Right := "T_OH_Right_1".Q;
        
        "Control_DB".ECnv_Sys[1].Inputs.VFD_Status := "CVTD1_StatusWord";
        "Control_DB".ECnv_Sys[1].Inputs.VFD_ActualCurrent := WORD_TO_INT("CVTD1_ActualCurrent");
        "Control_DB".ECnv_Sys[1].Inputs.VFD_Speed_Actual := WORD_TO_INT("CVTD1_ActualSpeed");
        "Control_DB".ECnv_Sys[1].Inputs.VFD_ActualTorque := WORD_TO_INT("CVTD1_ActualTorque");
    END_REGION
    
    REGION BUFFER CONVEYORS
        REGION LEVEL 1
            //BUFFER CONVEYOR LEVEL 1 - CONVEYOR 1
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Inputs.Left := NOT "C1101 - SENSOR CNV LEFT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Inputs.Lpd1 := NOT "C1101 - SENSOR CNV LEFT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Inputs.Lpd2 := "C1101 - SENSOR CNV LEFT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Inputs.Right := NOT "C1101 - SENSOR CNV RIGHT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Inputs.Rpd1 := NOT "C1101 - SENSOR CNV RIGHT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Inputs.Rpd2 := NOT "C1101 - SENSOR CNV RIGHT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Inputs.Sdetect1 := NOT "C1101 - SHUTTLE IN POSITION 1";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Inputs.Sdetect2 := NOT "C1101 - SHUTTLE IN POSITION 2";
            
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Inputs.VFD_Status := "C1101_StatusWord";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Inputs.VFD_ActualCurrent := WORD_TO_INT("C1101_ActualCurrent");
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Inputs.VFD_Speed_Actual := WORD_TO_INT("C1101_ActualSpeed");
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Inputs.VFD_ActualTorque := WORD_TO_INT("C1101_ActualTorque");
            
            //BUFFER CONVEYOR LEVEL 1 - CONVEYOR 2
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Inputs.Left := NOT "C1201 - SENSOR CNV LEFT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Inputs.Lpd1 := NOT "C1201 - SENSOR CNV LEFT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Inputs.Lpd2 := NOT "C1201 - SENSOR CNV LEFT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Inputs.Right := NOT "C1201 - SENSOR CNV RIGHT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Inputs.Rpd1 := NOT "C1201 - SENSOR CNV RIGHT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Inputs.Rpd2 := NOT "C1201 - SENSOR CNV RIGHT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Inputs.Sdetect1 := NOT "C1201 - SHUTTLE IN POSITION 1";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Inputs.Sdetect2 := NOT "C1201 - SHUTTLE IN POSITION 2";
            
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Inputs.VFD_Status := "C1201_StatusWord";
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Inputs.VFD_ActualCurrent := WORD_TO_INT("C1201_ActualCurrent");
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Inputs.VFD_Speed_Actual := WORD_TO_INT("C1201_ActualSpeed");
            "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Inputs.VFD_ActualTorque := WORD_TO_INT("C1201_ActualTorque");
        END_REGION
        
        REGION LEVEL 2
            //BUFFER CONVEYOR LEVEL 2 - CONVEYOR 1
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.Left := NOT "C1102 - SENSOR CNV LEFT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.Lpd1 := NOT "C1102 - SENSOR CNV LEFT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.Lpd2 := NOT "C1102 - SENSOR CNV LEFT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.Right := NOT "C1102 - SENSOR CNV RIGHT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.Rpd1 := NOT "C1102 - SENSOR CNV RIGHT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.Rpd2 := NOT "C1102 - SENSOR CNV RIGHT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.Sdetect1 := NOT "C1102 - SHUTTLE IN POSITION 1";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.Sdetect2 := NOT "C1102 - SHUTTLE IN POSITION 2";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Safety_Stop_Cnrl.Inputs.DP_Extended := "C1102 - SENSOR SAFETY PIN1 UP";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Safety_Stop_Cnrl.Inputs.DP_Retracted := "C1102 - SENSOR SAFETY PIN1 DOWN";
            
            IF "Shuttle_MQTT_DB".Shuttle_MQTT[3].Message.Shuttle_Status.Position_ID = "Settings_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Barcode_ID THEN
                "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.Shuttle_High := "Shuttle_MQTT_DB".Shuttle_MQTT[3].Message.Shuttle_Status.Sensor_Inputs.%X13;
            ELSIF "Shuttle_MQTT_DB".Shuttle_MQTT[4].Message.Shuttle_Status.Position_ID = "Settings_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Barcode_ID THEN
                "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.Shuttle_High := "Shuttle_MQTT_DB".Shuttle_MQTT[4].Message.Shuttle_Status.Sensor_Inputs.%X13;
            ELSIF "Shuttle_MQTT_DB".Shuttle_MQTT[5].Message.Shuttle_Status.Position_ID = "Settings_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Barcode_ID THEN
                "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.Shuttle_High := "Shuttle_MQTT_DB".Shuttle_MQTT[5].Message.Shuttle_Status.Sensor_Inputs.%X13;
            END_IF;
            
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.VFD_Status := "C1102_StatusWord";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.VFD_ActualCurrent := WORD_TO_INT("C1102_ActualCurrent");
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.VFD_Speed_Actual := WORD_TO_INT("C1102_ActualSpeed");
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Inputs.VFD_ActualTorque := "C1102_ActualTorque";
            
            //BUFFER CONVEYOR LEVEL 2 - CONVEYOR 2
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.Left := NOT "C1202 - SENSOR CNV LEFT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.Lpd1 := NOT "C1202 - SENSOR CNV LEFT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.Lpd2 := NOT "C1202 - SENSOR CNV LEFT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.Right := NOT "C1202 - SENSOR CNV RIGHT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.Rpd1 := NOT "C1202 - SENSOR CNV RIGHT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.Rpd2 := NOT "C1202 - SENSOR CNV RIGHT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.Sdetect1 := NOT "C1202 - SHUTTLE IN POSITION 1";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.Sdetect2 := NOT "C1202 - SHUTTLE IN POSITION 2";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := "C1202 - SENSOR SAFETY PIN1 UP";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Retracted := "C1202 - SENSOR SAFETY PIN1 DOWN";
            
            IF "Shuttle_MQTT_DB".Shuttle_MQTT[3].Message.Shuttle_Status.Position_ID = "Settings_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Barcode_ID THEN
                "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.Shuttle_High := "Shuttle_MQTT_DB".Shuttle_MQTT[3].Message.Shuttle_Status.Sensor_Inputs.%X13;
            ELSIF "Shuttle_MQTT_DB".Shuttle_MQTT[4].Message.Shuttle_Status.Position_ID = "Settings_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Barcode_ID THEN
                "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.Shuttle_High := "Shuttle_MQTT_DB".Shuttle_MQTT[4].Message.Shuttle_Status.Sensor_Inputs.%X13;
            ELSIF "Shuttle_MQTT_DB".Shuttle_MQTT[5].Message.Shuttle_Status.Position_ID = "Settings_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Barcode_ID THEN
                "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.Shuttle_High := "Shuttle_MQTT_DB".Shuttle_MQTT[5].Message.Shuttle_Status.Sensor_Inputs.%X13;
            END_IF;
            
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.VFD_Status := "C1202_StatusWord";
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.VFD_ActualCurrent := WORD_TO_INT("C1202_ActualCurrent");
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.VFD_Speed_Actual := WORD_TO_INT("C1202_ActualSpeed");
            "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Inputs.VFD_ActualTorque := "C1202_ActualTorque";
        END_REGION
        
        REGION LEVEL 3
            //BUFFER CONVEYOR LEVEL 3 - CONVEYOR 1
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Inputs.Left := NOT "C1103 - SENSOR CNV LEFT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Inputs.Lpd1 := NOT "C1103 - SENSOR CNV LEFT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Inputs.Lpd2 := NOT "C1103 - SENSOR CNV LEFT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Inputs.Right := NOT "C1103 - SENSOR CNV RIGHT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Inputs.Rpd1 := NOT "C1103 - SENSOR CNV RIGHT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Inputs.Rpd2 := NOT "C1103 - SENSOR CNV RIGHT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Inputs.Sdetect1 := NOT "C1103 - SHUTTLE IN POSITION 1";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Inputs.Sdetect2 := NOT "C1103 - SHUTTLE IN POSITION 2";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Safety_Stop_Cnrl.Inputs.DP_Extended := "C1103 - SENSOR SAFETY PIN1 UP";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Safety_Stop_Cnrl.Inputs.DP_Retracted := "C1103 - SENSOR SAFETY PIN1 DOWN";
            
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Inputs.VFD_Status := "C1103_StatusWord";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Inputs.VFD_ActualCurrent := WORD_TO_INT("C1103_ActualCurrent");
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Inputs.VFD_Speed_Actual := WORD_TO_INT("C1103_ActualSpeed");
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Inputs.VFD_ActualTorque := "C1103_ActualTorque";
            
            //BUFFER CONVEYOR LEVEL 3 - CONVEYOR 2
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Inputs.Left := NOT "C1203 - SENSOR CNV LEFT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Inputs.Lpd1 := NOT "C1203 - SENSOR CNV LEFT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Inputs.Lpd2 := NOT "C1203 - SENSOR CNV LEFT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Inputs.Right := NOT "C1203 - SENSOR CNV RIGHT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Inputs.Rpd1 := NOT "C1203 - SENSOR CNV RIGHT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Inputs.Rpd2 := NOT "C1203 - SENSOR CNV RIGHT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Inputs.Sdetect1 := NOT "C1203 - SHUTTLE IN POSITION 1";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Inputs.Sdetect2 := NOT "C1203 - SHUTTLE IN POSITION 2";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := "C1203 - SENSOR SAFETY PIN1 UP";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Retracted := "C1203 - SENSOR SAFETY PIN1 DOWN";
            
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Inputs.VFD_Status := "C1203_StatusWord";
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Inputs.VFD_ActualCurrent := WORD_TO_INT("C1203_ActualCurrent");
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Inputs.VFD_Speed_Actual := WORD_TO_INT("C1203_ActualSpeed");
            "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Inputs.VFD_ActualTorque := "C1203_ActualTorque";
        END_REGION
        
        REGION LEVEL 4
            //BUFFER CONVEYOR LEVEL 4 - CONVEYOR 1
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Inputs.Left := NOT "C1104 - SENSOR CNV LEFT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Inputs.Lpd1 := NOT "C1104 - SENSOR CNV LEFT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Inputs.Lpd2 := NOT "C1104 - SENSOR CNV LEFT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Inputs.Right := NOT "C1104 - SENSOR CNV RIGHT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Inputs.Rpd1 := NOT "C1104 - SENSOR CNV RIGHT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Inputs.Rpd2 := NOT "C1104 - SENSOR CNV RIGHT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Inputs.Sdetect1 := NOT "C1104 - SHUTTLE IN POSITION 1";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Inputs.Sdetect2 := NOT "C1104 - SHUTTLE IN POSITION 2";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Safety_Stop_Cnrl.Inputs.DP_Extended := "C1104 - SENSOR SAFETY PIN1 UP";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Safety_Stop_Cnrl.Inputs.DP_Retracted := "C1104 - SENSOR SAFETY PIN1 DOWN";
            
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Inputs.VFD_Status := "C1104_StatusWord";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Inputs.VFD_ActualCurrent := WORD_TO_INT("C1104_ActualCurrent");
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Inputs.VFD_Speed_Actual := WORD_TO_INT("C1104_ActualSpeed");
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Inputs.VFD_ActualTorque := "C1104_ActualTorque";
            
            //BUFFER CONVEYOR LEVEL 4 - CONVEYOR 2
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Inputs.Left := NOT "C1204 - SENSOR CNV LEFT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Inputs.Lpd1 := NOT "C1204 - SENSOR CNV LEFT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Inputs.Lpd2 := NOT "C1204 - SENSOR CNV LEFT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Inputs.Right := NOT "C1204 - SENSOR CNV RIGHT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Inputs.Rpd1 := NOT "C1204 - SENSOR CNV RIGHT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Inputs.Rpd2 := NOT "C1204 - SENSOR CNV RIGHT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Inputs.Sdetect1 := NOT "C1204 - SHUTTLE IN POSITION 1";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Inputs.Sdetect2 := NOT "C1204 - SHUTTLE IN POSITION 2";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := "C1204 - SENSOR SAFETY PIN1 UP";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Retracted := "C1204 - SENSOR SAFETY PIN1 DOWN";
            
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Inputs.VFD_Status := "C1204_StatusWord";
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Inputs.VFD_ActualCurrent := WORD_TO_INT("C1204_ActualCurrent");
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Inputs.VFD_Speed_Actual := WORD_TO_INT("C1204_ActualSpeed");
            "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Inputs.VFD_ActualTorque := "C1204_ActualTorque";
        END_REGION
        
        REGION LEVEL 5
            //BUFFER CONVEYOR LEVEL 5 - CONVEYOR 1
            "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Inputs.Left := NOT "C1105 - SENSOR CNV LEFT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Inputs.Lpd1 := NOT "C1105 - SENSOR CNV LEFT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Inputs.Lpd2 := NOT "C1105 - SENSOR CNV LEFT (PALLET DETECT 2)";
