            "Control_DB".LCnv_Sys[5].Cnv_Level[5].Cnv1.Safety_Stop_Cnrl.Inputs.DP_Retracted := "C5105 - SENSOR SAFETY PIN1 DOWN";
            
            "Control_DB".LCnv_Sys[5].Cnv_Level[5].Cnv1.Inputs.VFD_Status := "C5105_StatusWord";
            "Control_DB".LCnv_Sys[5].Cnv_Level[5].Cnv1.Inputs.VFD_ActualCurrent := WORD_TO_INT("C5105_ActualCurrent");
            "Control_DB".LCnv_Sys[5].Cnv_Level[5].Cnv1.Inputs.VFD_Speed_Actual := WORD_TO_INT("C5105_ActualSpeed");
            "Control_DB".LCnv_Sys[5].Cnv_Level[5].Cnv1.Inputs.VFD_ActualTorque := WORD_TO_INT("C5105_ActualTorque");
        END_REGION
        
        REGION LEVEL 6
            //BUFFER CONVEYOR LEVEL 6 - CONVEYOR 1
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Inputs.Left := NOT "C5106 - SENSOR CNV LEFT (FWD)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Inputs.Lpd1 := NOT "C5106 - SENSOR CNV LEFT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Inputs.Lpd2 := NOT "C5106 - SENSOR CNV LEFT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Inputs.Right := NOT "C5106 - SENSOR CNV RIGHT (BWD)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Inputs.Rpd1 := NOT "C5106 - SENSOR CNV RIGHT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Inputs.Rpd2 := NOT "C5106 - SENSOR CNV RIGHT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Inputs.Sdetect1 := NOT "C5106 - SHUTTLE IN POSITION 1";
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Inputs.Sdetect2 := NOT "C5106 - SHUTTLE IN POSITION 2";
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Safety_Stop_Cnrl.Inputs.DP_Extended := "C5106 - SENSOR SAFETY PIN1 UP";
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Safety_Stop_Cnrl.Inputs.DP_Retracted := "C5106 - SENSOR SAFETY PIN1 DOWN";
            
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Inputs.VFD_Status := "C5106_StatusWord";
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Inputs.VFD_ActualCurrent := WORD_TO_INT("C5106_ActualCurrent");
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Inputs.VFD_Speed_Actual := WORD_TO_INT("C5106_ActualSpeed");
            "Control_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.Inputs.VFD_ActualTorque := WORD_TO_INT("C5106_ActualTorque");
        END_REGION
        
        REGION LEVEL 7
            //BUFFER CONVEYOR LEVEL 7 - CONVEYOR 1
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Inputs.Left := NOT "C5107 - SENSOR CNV LEFT (FWD)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Inputs.Lpd1 := NOT "C5107 - SENSOR CNV LEFT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Inputs.Lpd2 := NOT "C5107 - SENSOR CNV LEFT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Inputs.Right := NOT "C5107 - SENSOR CNV RIGHT (BWD)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Inputs.Rpd1 := NOT "C5107 - SENSOR CNV RIGHT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Inputs.Rpd2 := NOT "C5107 - SENSOR CNV RIGHT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Inputs.Sdetect1 := NOT "C5107 - SHUTTLE IN POSITION 1";
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Inputs.Sdetect2 := NOT "C5107 - SHUTTLE IN POSITION 2";
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Safety_Stop_Cnrl.Inputs.DP_Extended := "C5107 - SENSOR SAFETY PIN1 UP";
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Safety_Stop_Cnrl.Inputs.DP_Retracted := "C5107 - SENSOR SAFETY PIN1 DOWN";
            
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Inputs.VFD_Status := "C5107_StatusWord";
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Inputs.VFD_ActualCurrent := WORD_TO_INT("C5107_ActualCurrent");
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Inputs.VFD_Speed_Actual := WORD_TO_INT("C5107_ActualSpeed");
            "Control_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.Inputs.VFD_ActualTorque := WORD_TO_INT("C5107_ActualTorque");
        END_REGION
        
        REGION LEVEL 8
            //BUFFER CONVEYOR LEVEL 8 - CONVEYOR 1
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Inputs.Left := NOT "C5108 - SENSOR CNV LEFT (FWD)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Inputs.Lpd1 := NOT "C5108 - SENSOR CNV LEFT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Inputs.Lpd2 := NOT "C5108 - SENSOR CNV LEFT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Inputs.Right := NOT "C5108 - SENSOR CNV RIGHT (BWD)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Inputs.Rpd1 := NOT "C5108 - SENSOR CNV RIGHT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Inputs.Rpd2 := NOT "C5108 - SENSOR CNV RIGHT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Inputs.Sdetect1 := NOT "C5108 - SHUTTLE IN POSITION 1";
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Inputs.Sdetect2 := NOT "C5108 - SHUTTLE IN POSITION 2";
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Safety_Stop_Cnrl.Inputs.DP_Extended := "C5108 - SENSOR SAFETY PIN1 UP";
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Safety_Stop_Cnrl.Inputs.DP_Retracted := "C5108 - SENSOR SAFETY PIN1 DOWN";
            
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Inputs.VFD_Status := "C5108_StatusWord";
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Inputs.VFD_ActualCurrent := WORD_TO_INT("C5108_ActualCurrent");
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Inputs.VFD_Speed_Actual := WORD_TO_INT("C5108_ActualSpeed");
            "Control_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.Inputs.VFD_ActualTorque := WORD_TO_INT("C5108_ActualTorque");
        END_REGION
    END_REGION
    
    REGION VTD
        "Control_DB".VTD_Sys[5].Inputs.Upper_Overtravel := "OVERTRAVEL UPPER LIMIT - CH1(5)";
        "Control_DB".VTD_Sys[5].Inputs.Upper_limit := "VTD5 UPPER LIMIT";
        "Control_DB".VTD_Sys[5].Inputs.Ultimate_SlowDown := "VTD5 ULTIMATE SLOWDOWN";
        "Control_DB".VTD_Sys[5].Inputs.Ultimate_Creep := "VTD5 ULTIMATE CREEP";
        "Control_DB".VTD_Sys[5].Inputs.Lower_Limit := "VTD5 LOWER LIMIT";
        "Control_DB".VTD_Sys[5].Inputs.Lower_Overtravel := "OVERTRAVEL LOWER LIMIT - CH1(5)";
        "Control_DB".VTD_Sys[5].Inputs.Level_Detect1 := "VTD5 LEVEL DETECT 1";
        "Control_DB".VTD_Sys[5].Inputs.Level_Detect2 := "VTD5 LEVEL DETECT 2";
        "Control_DB".VTD_Sys[5].Inputs.DP1_Extended := "VTD5 DOCKING PINS 1 EXTENDED";
        "Control_DB".VTD_Sys[5].Inputs.DP2_Extended := "VTD5 DOCKING PINS 2 EXTENDED";
        "Control_DB".VTD_Sys[5].Inputs.DP1_Retracted := "VTD5 DOCKING PINS 1 RETRACTED";
        "Control_DB".VTD_Sys[5].Inputs.DP2_Retracted := "VTD5 DOCKING PINS 2 RETRACTED";
        "Control_DB".VTD_Sys[5].Inputs.Chain_Slack_1 := NOT "Remote_Panel_DB_5".Chain_Slack_1_Filtered;
        "Control_DB".VTD_Sys[5].Inputs.Chain_Slack_2 := NOT "Remote_Panel_DB_5".Chain_Slack_2_Filtered;
        "Control_DB".VTD_Sys[5].Inputs.Chain_Slack_3 := NOT "Remote_Panel_DB_5".Chain_Slack_3_Filtered;
        "Control_DB".VTD_Sys[5].Inputs.Chain_Slack_4 := NOT "Remote_Panel_DB_5".Chain_Slack_4_Filtered;
        "Control_DB".VTD_Sys[5].Inputs.PushToEnter := "VTD5 PUSH TO ENTER VTD ZONE";
        "Control_DB".VTD_Sys[5].Inputs.PushToExit := "VTD5 PUSH TO EXIT VTD ZONE";
        "Control_DB".VTD_Sys[5].Inputs.VFD_Status := "VTD5_StatusWord";
        "Control_DB".VTD_Sys[5].Inputs.VFD_ActualCurrent := REAL_TO_INT(("VTD5_ActualCurrent" / 10) / 72.5);
        "Control_DB".VTD_Sys[5].Inputs.VFD_Speed_Actual := "VTD5_ActualSpeed";
        "Control_DB".VTD_Sys[5].Inputs.VFD_ActualTorque := WORD_TO_INT("VTD5_ActualTorque");
        
    END_REGION
    
    REGION ABSOLUTE ENCODER
        REGION DOCUMENTATION
            //STATUS---------------------------------------------------------------------------------------------------------------------
            //
            //Encoder state word 2 - INPUT WORD 1
            //
            // 15 … 12 Encoder’s Sign-OF-Life (NOT relevant)
            // 11, 10 Reserved
            // 9 Control requested 0 = No control BY the PLC requested 1 = Control BY the PLC requested
            // 8 … 0 Reserved
            
            //Sensor 1 state word - INPUT WORD 2
            //
            // 15 Encoder error Description 0 = No error 1 = Error The error code is output in G1_XIST2.
            // 14 Park mode activated 0 = Normal operation 1 = Park mode activated Feedback based on G1_STW bit 14: No output OF position data G1_XIST1 AND G1_XIST2
            // 13 Transmission OF absolute position value 0 = No transmission 1 = Position value is output in G1_XIST2
            // 12 Status OF the Preset function (set/shift OF home position executed) 0 = No Preset function active 1 = Preset function is run Feedback based on G1_STW bit 12:  
            // 11 Requirement OF error acknowledgement detected New position value is output in G1_XIST1 AND G1_XIST2. On conclusion OF the Preset function the bit is set TO 0. 0 = No RETURN acknowledgement OF Encoder error 1 = Requirement OF error acknowledgement detected Reaction TO bit 15 in the sensor control word 1 G1_STW is acknowledged (see Table 14)
            // 10 Reserved
            // 9 … 0 NOT supported
            
            //Position 1 - INPUT WORD 3 AND 4
            // "AE_Position_1_Scaled" := (*SCALE_X(MIN := "Settings_DB".VTD_Settings.VTD_Min_Height,
            //                                   VALUE := *)NORM_X(MIN := 0,
            //                                                   VALUE := (SHL(IN:="AE_Position_1", N:=2) * 0.00228881) (*- "AE_Offset"*),
            //                                                   MAX := 1073741824)(*,
            //                                   MAX := "Settings_DB".VTD_Settings.VTD_Max_Heigh)*);
            // "mm_per_pulse" := 401,5584 / 262144;
            // 
            //CONTROL---------------------------------------------------------------------------------------------------------------------
            //
            //Encoder control word 2 - OUTPUT WORD 1
            //
            // 15 … 12 Master’s Sign-OF-Life (NOT relevant)
            // 10 control BY PLC 0 = No control BY the PLC 1 = Control BY the PLC Enables the PLC BY using control words TO activate / deactivate encoder functions
            // 7 Fault acknowledge Error-buffer handling NOT supported
            // 11, 9, 8, 6 … 0 Reserved
            // "AE_Control_Word_1".%X10 := "AE_PLC_Control";
            // 
            //Sensor 1 control word - OUTPUT WORD 2-------------------------------------------------------------------------------------------
            //
            // 15 Acknowledging a sensor error Description 0 = Encoder error message NOT acknowledged BY PLC 1 = Encoder error message acknowledged BY the PLC
            // 14 Activate park mode 0 = Normal operation 1 = Activate park mode
            // 13 Request FOR the absolute position value 0 = No request 1 = Request BY the master Results in the cyclic output OF the position values in G1_XIST2
            // 12 Activate preset value (see note below) Defines that a configured preset value is used (see section 3.5 on page 24) 0 = Preset value is NOT activated 1 = Preset value is activated
            // 11 Preset mode Defines how a configured preset value is used 0 = Preset value is used as a new absolute value 1 = Preset value is added TO the previous value
            // 10 … 0 Reserved
            // "AE_Control_Word_2".%X15 := "VTD_Reset_HMI_Tags";
            // "AE_Control_Word_2".%X14 := "AE_Activate_ParkMode";
            // "AE_Control_Word_2".%X13 := "AE_Request_ABS_Value";
            // "AE_Control_Word_2".%X12 := "AE_Activate_Preset_Value";
            // "AE_Control_Word_2".%X11 := "AE_Preset_Mode";
        END_REGION
        
        //STATUS---------------------------------------------------------------------------------------------------------------------
        "Control_DB".VTD_Sys[5].Inputs.AE_Status_2 := "AE_Status_2(5)";
        //Position 1 - INPUT WORD 3 AND 4
        "Control_DB".VTD_Sys[5].Inputs.AE_Position_1 := REAL_TO_DINT((((1073741823 - (*reverse the direction*)
 (SHR(IN := "AE_Position_1(5)", N := 2))) - 31381317) * 0.0015318237304688 (*Mechanical relationship*) - 1805195)(*Offset*));
        
// Position 2 - INPUT WORD 5 AND 6
        "Control_DB".VTD_Sys[5].Inputs.AE_Position_2 := SHR(IN := "AE_Position_2(5)", N := 2);
        
        //Speed A - INPUT WORD 7
        "Control_DB".VTD_Sys[5].Inputs.AE_Speed := "AE_Speed(5)";
    END_REGION
    
    REGION LINEAR ENCODER
        "Control_DB".VTD_Sys[5].Inputs.LE_Position := "LE_X_Unsafe_Position(5)" / 10;
        "Control_DB".VTD_Sys[5].Inputs.LE_Speed := "LE_Speed(5)" * 100;
        "Control_DB".VTD_Sys[5].Inputs.LE_Status := "LE_Status(5)";
        "Control_DB".VTD_Sys[5].Inputs.LE_Warnings := "LE_Warnings(5)";
        REGION DOCUMENTATION
            //STATUS 
            //
            // 0 ERR - Error message (Error code in XP00– XP15); remaining bits = 0, see Error Codes
            // 1 NP - No position information/OUT (XP = 0, YP = 0, SP = 0)
            // 2 WRN - Warnings present, see Warning Module
            // 3 EV - Event present
            // 4 posdetected - Valid position information available
            
            //WARNINGS
            //
            // 0 WRN01 A code with non-PXV content was found.
            // 1 WRN02 the read head is too close TO the Data Matrix code tape.
            // 2 WRN03 the read head is too far from the Data Matrix code tape.
            // 3 WRN04 Y position too large. The sensor is just before OUT.
            // 4 WRN05 Y position is too small. The sensor is just before OUT.
            // 5 WRN06 the read head is rotated OR tilted in relation TO the Data Matrix code tape.
            // 6 WRN07 Low level OF code contrast.
            // 7 WRN08 Repair tape detected.
            // 8 WRN09 Temperature too high.
            // 9...15 Reserved
            
            //QUALITY GRADE
            //
            //The quality grades enable constant monitoring of the code tape and the camera along the entire
            //traverse distance. This enables you to detect and act upon potential damage or contamination
            //of the code tape and camera at the earliest stage possible during commissioning and normal
            //operation. As a result, this maximizes the overall functional reliability of your plant, and
            //it means you are able to immediately localize the issue in the case of a fault. Evaluations
            //are made using a scale of 1 to 6. The value 1 is the best possible read quality. A value greater
            //than 3 or worse requires the camera and its path to be inspected. The value 7 signifies "No position"
            //because no code was detected. An evaluation that indicates poor quality as the outcome can be due to
            //a misalignment or incorrect orientation, an incorrect measuring distance, or because the code tape has been affixed incorrectly
        END_REGION
    END_REGION
    
    REGION SICK BARCODE LECTORS
        IF "Control_DB".VTDBarcode_Station[5].Running AND "SICK_Lector_Control_DB_5".Result <> "Control_DB".VTDBarcode_Station[5].Barcode_Old THEN
            "Control_DB".VTD_Sys[5].Inputs."Barcode 1" := "SICK_Lector_Control_DB_5".Result;
            // "Control_DB".VTD_Control.Inputs."Barcode 2'" := SICK_Barcode_DB".Result;
            // "Control_DB".VTDBarcode_Station[5].Barcode_Old := "SICK_Lector_Control_DB_5".Result;
        ELSE
            "Control_DB".VTD_Sys[5].Inputs."Barcode 1" :=
            "Control_DB".VTD_Sys[5].Inputs."Barcode 2" := '';
        END_IF;
        
    END_REGION
    
    REGION VFD HARDWARE ID
        //Buffer conveyors 1
        "Settings_DB".LCnv_Sys[5].Cnv_Level[1].Cnv1.G120_Hardware_ID := "C5101~Drive_1~Standard_telegram_20__PZD-2_6";
        "Settings_DB".LCnv_Sys[5].Cnv_Level[2].Cnv1.G120_Hardware_ID := "C5102~Drive_1~Standard_telegram_20__PZD-2_6";
        "Settings_DB".LCnv_Sys[5].Cnv_Level[3].Cnv1.G120_Hardware_ID := "C5103~Drive_1~Standard_telegram_20__PZD-2_6";
        "Settings_DB".LCnv_Sys[5].Cnv_Level[4].Cnv1.G120_Hardware_ID := "C5104~Drive_1~Standard_telegram_20__PZD-2_6";
        "Settings_DB".LCnv_Sys[5].Cnv_Level[5].Cnv1.G120_Hardware_ID := "C5105~Drive_1~Standard_telegram_20__PZD-2_6";
        "Settings_DB".LCnv_Sys[5].Cnv_Level[6].Cnv1.G120_Hardware_ID := "C5106~Drive_1~Standard_telegram_20__PZD-2_6";
        "Settings_DB".LCnv_Sys[5].Cnv_Level[7].Cnv1.G120_Hardware_ID := "C5107~Drive_1~Standard_telegram_20__PZD-2_6";
        "Settings_DB".LCnv_Sys[5].Cnv_Level[8].Cnv1.G120_Hardware_ID := "C5108~Drive_1~Standard_telegram_20__PZD-2_6";
        
        //Extractor conveyor
        "Settings_DB".ECnv_Sys[5].G120_Hardware_ID := "CVTD_5~Drive_1~Standard_telegram_20__PZD-2_6";
        
        //VTD
        "Settings_DB".VTD_Sys[5].G120_Hardware_ID := "VTD_5~DO_VECTOR_1~Standard_telegram_20__PZD-2_6";
    END_REGION
END_REGION

