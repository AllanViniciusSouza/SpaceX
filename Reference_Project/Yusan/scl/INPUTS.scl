            "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Inputs.VFD_Status := "C1105_StatusWord";
            "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Inputs.VFD_ActualCurrent := WORD_TO_INT("C1105_ActualCurrent");
            "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Inputs.VFD_Speed_Actual := WORD_TO_INT("C1105_ActualSpeed");
            "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Inputs.VFD_ActualTorque := "C1105_ActualTorque";
            
            //BUFFER CONVEYOR LEVEL 5 - CONVEYOR 2
            "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2.Inputs.Left := NOT "C1205 - SENSOR CNV LEFT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2.Inputs.Lpd1 := NOT "C1205 - SENSOR CNV LEFT (PALLET DETECT 1)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2.Inputs.Lpd2 := NOT "C1205 - SENSOR CNV LEFT (PALLET DETECT 2)";
            "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2.Inputs.Right := NOT "C1205 - SENSOR CNV RIGHT";
            "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2.Inputs.Rpd1 := NOT "C1205 - SENSOR CNV RIGHT (PALLET DETECT 1)";
