        "Settings_DB".LCnv_Sys[4].Cnv_Level[5].Cnv1.G120_Hardware_ID := "C4105~Drive_1~Standard_telegram_20__PZD-2_6";
        "Settings_DB".LCnv_Sys[4].Cnv_Level[6].Cnv1.G120_Hardware_ID := "C4106~Drive_1~Standard_telegram_20__PZD-2_6";
        "Settings_DB".LCnv_Sys[4].Cnv_Level[7].Cnv1.G120_Hardware_ID := "C4107~Drive_1~Standard_telegram_20__PZD-2_6";
        "Settings_DB".LCnv_Sys[4].Cnv_Level[8].Cnv1.G120_Hardware_ID := "C4108~Drive_1~Standard_telegram_20__PZD-2_6";
        
        //Extractor conveyor
        "Settings_DB".ECnv_Sys[4].G120_Hardware_ID := "CVTD_4~Drive_1~Standard_telegram_20__PZD-2_6";
        
        //VTD
        "Settings_DB".VTD_Sys[4].G120_Hardware_ID := "VTD_4~DO_VECTOR_1~Standard_telegram_20__PZD-2_6";
    END_REGION
END_REGION

