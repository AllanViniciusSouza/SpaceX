REGION Assign Conveyor 2
    REGION CHARGE DATA FROM THE CORRECT CONVEYOR
        //CHARGE DATA CHANGING CONVEYORS ID
        IF #"ID(1)" <> #"ID_Old(1)" THEN
            "CNV_HMI".Charge_Commands[#HMI_No] := TRUE;
            #"ID_Old(1)" := #"ID(1)";
        END_IF;
        #R_Charge_Cnv_Commands(CLK := "CNV_HMI".Charge_Commands[#HMI_No]);
        
        IF "CNV_HMI".Charge_Commands[#HMI_No] THEN
            CASE #"ID(1)" OF
                    //CNV 1 - SYSTEM 1
                100101:
                    #"Enable(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[1].Cnv1.Instruction.Enable;
                    #"Mode_Change(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[1].Cnv1.Instruction.Mode_Change;
                    #"Transfer_To_ID(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[1].Cnv1.Instruction.Transfer_To_ID;
                    #"Transfer_From_ID(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[1].Cnv1.Instruction.Transfer_From_ID;
                    #"Pallet_Allignment(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[1].Cnv1.Instruction.Pallet_Allignment;
                100201:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv1.Instruction.Transfer_From_ID;
                    "Pallet_Allignment_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv1.Instruction.Pallet_Allignment;
                100301:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv1.Instruction.Transfer_From_ID;
                    "Pallet_Allignment_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv1.Instruction.Pallet_Allignment;
                100401:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv1.Instruction.Transfer_From_ID;
                    "Pallet_Allignment_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv1.Instruction.Pallet_Allignment;
                100501:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv1.Instruction.Mode_Change;
                    "Task_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv1.Instruction.Task_ID;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv1.Instruction.Transfer_From_ID;
                    "Pallet_Allignment_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv1.Instruction.Pallet_Allignment;
                100601:
