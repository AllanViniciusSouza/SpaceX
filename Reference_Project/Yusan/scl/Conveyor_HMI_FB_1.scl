FUNCTION_BLOCK "Conveyor_HMI_FB_1"   // FB 13, author 

VAR_INPUT
   HMI_No : UInt;
   Sys_No : UInt;
   Zone : UInt;
END_VAR

VAR_IN_OUT
   Enable : Bool;
   Mode_Change : UInt;
   Transfer_To_ID : DInt;
   Transfer_From_ID : DInt;
   Pallet_Allignment : Bool;
   Enable(1) : Bool;
   Mode_Change(1) : UInt;
   Transfer_To_ID(1) : DInt;
   Transfer_From_ID(1) : DInt;
   Pallet_Allignment(1) : Bool;
END_VAR

VAR
   R_Charge_Cnv_Commands : R_TRIG;
   T_Reset_Charge : TON_TIME;
   ID : DInt;
   ID(1) : DInt;
   ID_Old : DInt;
   ID_Old(1) : DInt;
END_VAR

VAR_TEMP
   i : UInt;
   J : UInt;
   No_Light_Guard : Bool;
END_VAR

BEGIN
CNV_Selector_1(Sys_No := #Sys_No,
                 Zone:= #Zone,
                 CNV1_2_Selected := "CNV_HMI".CNV2_Selected[#HMI_No],
                 ID => #ID,
                 ID(1) => #"ID(1)");


REGION SEND/RECEIVE BUTTON
    IF NOT "Control_DB".VTD_Sys[#Sys_No].Running AND "Control_DB".VTD_Sys[#Sys_No].Current_Level <> 0 THEN
        IF "CNV_HMI".CNV2_Selected[#HMI_No] = 1 AND "HMI_DB".ScreenNo[#HMI_No] = 2 THEN
            //CNV 1
            IF "Control_DB".ECnv_Sys[#Sys_No].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv1.Cnv_Occupied AND
                NOT "Control_DB".ECnv_Sys[#Sys_No].Running AND NOT "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv1.Running THEN
                "CNV_HMI".In_Out[#HMI_No] := TRUE;
            ELSIF NOT "Control_DB".ECnv_Sys[#Sys_No].Cnv_Occupied AND "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv1.Cnv_Occupied AND
                NOT "Control_DB".ECnv_Sys[#Sys_No].Running AND NOT "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv1.Running THEN
                "CNV_HMI".In_Out[#HMI_No] := FALSE;
            ELSE
                ;
            END_IF;
            //CNV 2
        ELSIF "CNV_HMI".CNV2_Selected[#HMI_No] = 2 AND "HMI_DB".ScreenNo[#HMI_No] = 2 THEN   //CNV 2
            IF "Control_DB".ECnv_Sys[#Sys_No].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv2.Cnv_Occupied AND
                NOT "Control_DB".ECnv_Sys[#Sys_No].Running AND NOT "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv2.Running THEN
                "CNV_HMI".In_Out[#HMI_No] := TRUE;
            ELSIF NOT "Control_DB".ECnv_Sys[#Sys_No].Cnv_Occupied AND "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv2.Cnv_Occupied AND
                NOT "Control_DB".ECnv_Sys[#Sys_No].Running AND NOT "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv2.Running THEN
                "CNV_HMI".In_Out[#HMI_No] := FALSE;
            ELSE
                ;
            END_IF;
        END_IF;
    END_IF;
END_REGION ;

REGION Assign Conveyor 1
    REGION CHARGE DATA FROM THE CORRECT CONVEYOR
        //CHARGE DATA CHANGING CONVEYORS ID
        IF #ID <> #ID_Old THEN
            "CNV_HMI".Charge_Commands[#HMI_No] := TRUE;
            #ID_Old := #ID;
        END_IF;
        #R_Charge_Cnv_Commands();
        
        #R_Charge_Cnv_Commands(CLK := "CNV_HMI".Charge_Commands[#HMI_No]);
        
        //CHARGE ONCE THE COMMANDS
        IF "CNV_HMI".Charge_Commands[#Sys_No] THEN
            #Enable := "Control_DB".ECnv_Sys[#Sys_No].Instruction.Enable;
            #Mode_Change := "Control_DB".ECnv_Sys[#Sys_No].Instruction.Mode_Change;
            #Transfer_To_ID := "Control_DB".ECnv_Sys[#Sys_No].Instruction.Transfer_To_ID;
            #Transfer_From_ID := "Control_DB".ECnv_Sys[#Sys_No].Instruction.Transfer_From_ID;
            #Pallet_Allignment := "Control_DB".ECnv_Sys[#Sys_No].Instruction.Pallet_Allignment;
        END_IF;
    END_REGION
    
    REGION CHARGE DATA FROM HMI (AFTER CHARGE DATA)
