                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv1.Instruction.Mode_Change;
                    "Task_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv1.Instruction.Task_ID;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv1.Instruction.Transfer_From_ID;
                    "Pallet_Allignment_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv1.Instruction.Pallet_Allignment;
                100701:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[7].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[7].Cnv1.Instruction.Mode_Change;
                    "Task_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[7].Cnv1.Instruction.Task_ID;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[7].Cnv1.Instruction.Transfer_To_ID;
