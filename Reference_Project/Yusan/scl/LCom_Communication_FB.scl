                                                    #diagnostics.statistics.maxMsgSendingTime := #instMsgSendingTimer.ET;
                                                ELSE
                                                    ;//Actual sending time is smaller
                                                END_IF;
                                                
                                                //Statistic --> Calculate average of message sending time [ms)]
                                                #diagnostics.statistics.avgMsgSendingTime := (((#diagnostics.statistics.avgMsgSendingTime * 19) + UDINT_TO_REAL((TIME_TO_UDINT(#instMsgSendingTimer.ET)))) / 20);
                                                
                                                //Stop message sending timer
                                                #instMsgSendingTimer(IN := FALSE,
                                                                     PT := T#+24d20h31m23s647ms);
                                                
                                                //Initialize values, for next send request
                                                #statSend.userData.offset := 0;
                                                #statSend.dataTelegram.messageOffset := 0;
                                                #statSend.dataTelegram.totalMessageLength := 0;
                                            ELSE
