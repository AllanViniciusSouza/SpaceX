                                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 5] := 16#00;
                                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 6] := 16#00;
                                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 7] := 16#00;
                                                    //Acknowledge message offset
