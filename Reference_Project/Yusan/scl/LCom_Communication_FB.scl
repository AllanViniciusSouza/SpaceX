                                                    #diagnostics.statistics.avgMsgReceivingTime := (((#diagnostics.statistics.avgMsgReceivingTime * 19) + UDINT_TO_REAL((TIME_TO_UDINT(#instMsgReceivingTimer.ET)))) / 20);
                                                    
                                                    //Stop message receiving timer
                                                    #instMsgReceivingTimer(IN := FALSE,
