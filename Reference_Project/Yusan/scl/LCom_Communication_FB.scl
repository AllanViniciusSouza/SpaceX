                                                #diagnostics.partnerConfig.timeSync.usePartnerTimestamps)
                                                AND
                                                (#diagnostics.localConfig.timeSync.sendMode > 0
                                                OR
                                                #diagnostics.partnerConfig.timeSync.sendMode > 0))
                                            THEN
                                                ;//One cpu does send timeSync information
                                            ELSE
                                                //Write diagnostics
                                                #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                                #statDiag.buffer[#statDiag.bufferIndex].status := #WARN_NO_TIME_SYNC;
                                                #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                            END_IF;
                                            
                                        2://telegram type 2
                                            
                                            //Reset index, so a new temp. LCom header can be built
                                            #statReceive.tempTelegram.index := 0;
                                            #statReceive.numberOfLComHeader := #statReceive.numberOfLComHeader + 1;
                                            
                                            //LCom V2
                                            IF (#statActualLocalLComVersion = #HEADER_V2) THEN
                                                //UsesTimeStamp
                                                #diagnostics.partnerConfig.timeSync.usePartnerTimestamps := BYTE_TO_BOOL(#statReceive.tempTelegram.data[2]);
                                                //SendModeSyncTime
                                                #diagnostics.partnerConfig.timeSync.sendMode := #statReceive.tempTelegram.data[3];
                                                //LifeSignCycle
                                                #tempDWord.%B3 := #statReceive.tempTelegram.data[4];
                                                #tempDWord.%B2 := #statReceive.tempTelegram.data[5];
                                                #tempDWord.%B1 := #statReceive.tempTelegram.data[6];
                                                #tempDWord.%B0 := #statReceive.tempTelegram.data[7];
                                                #statReceive.configTelegramV2.lifeSignCycle := DWORD_TO_TIME(#tempDWord);
                                                #diagnostics.partnerConfig.connnection.lifeSignCycleTime := #statReceive.configTelegramV2.lifeSignCycle;
                                                
                                                //Sender cycleTime
                                                #tempDWord.%B3 := #statReceive.tempTelegram.data[8];
                                                #tempDWord.%B2 := #statReceive.tempTelegram.data[9];
                                                #tempDWord.%B1 := #statReceive.tempTelegram.data[10];
                                                #tempDWord.%B0 := #statReceive.tempTelegram.data[11];
                                                #statReceive.configTelegramV2.cycleTime := DWORD_TO_TIME(#tempDWord);
                                                #diagnostics.partnerConfig.sender.cycleTime := #statReceive.configTelegramV2.cycleTime;
                                                //Sender ackTimeOut
                                                #tempDWord.%B3 := #statReceive.tempTelegram.data[12];
                                                #tempDWord.%B2 := #statReceive.tempTelegram.data[13];
                                                #tempDWord.%B1 := #statReceive.tempTelegram.data[14];
                                                #tempDWord.%B0 := #statReceive.tempTelegram.data[15];
                                                #statReceive.configTelegramV2.ackTimeOut := DWORD_TO_TIME(#tempDWord);
                                                #diagnostics.partnerConfig.sender.ackTimeout := #statReceive.configTelegramV2.ackTimeOut;
                                                //MaxSendDataLength
                                                #tempDWord.%B3 := #statReceive.tempTelegram.data[16];
                                                #tempDWord.%B2 := #statReceive.tempTelegram.data[17];
                                                #tempDWord.%B1 := #statReceive.tempTelegram.data[18];
                                                #tempDWord.%B0 := #statReceive.tempTelegram.data[19];
                                                #statReceive.configTelegramV2.maxSendDataLength := #tempDWord;
                                                #diagnostics.partnerConfig.sizeOfSendBuffer := #statReceive.configTelegramV2.maxSendDataLength;
                                                //MaxReceiveDataLength
                                                #tempDWord.%B3 := #statReceive.tempTelegram.data[20];
                                                #tempDWord.%B2 := #statReceive.tempTelegram.data[21];
                                                #tempDWord.%B1 := #statReceive.tempTelegram.data[22];
                                                #tempDWord.%B0 := #statReceive.tempTelegram.data[23];
                                                #statReceive.configTelegramV2.maxReceiveDataLength := #tempDWord;
                                                #diagnostics.partnerConfig.sizeOfReceiveBuffer := #statReceive.configTelegramV2.maxReceiveDataLength;
                                                
                                                //Set FB.#connected and #diagnostics information
                                                #connected := #statConnected := TRUE;
                                                #diagnostics.statistics.LComProtocolUsed := TRUE;
                                                #diagnostics.statistics.activeLComVersion := #HEADER_V2;
                                                #statState.cfgSender := #OPERATION;
                                                
                                                //Write diagnostics
                                                #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                                #statDiag.buffer[#statDiag.bufferIndex].status := #STATUS_CONNECTED_V2;
                                                #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                                
                                                //Check timeSync setting at local cpu and partner cpu
                                                IF ((#diagnostics.localConfig.timeSync.usePartnerTimestamps
                                                    XOR
                                                    #diagnostics.partnerConfig.timeSync.usePartnerTimestamps)
                                                    AND
                                                    (#diagnostics.localConfig.timeSync.sendMode > 0
                                                    OR
                                                    #diagnostics.partnerConfig.timeSync.sendMode > 0))
                                                THEN
                                                    ;//One cpu does send timeSync information
                                                ELSE
                                                    //Write diagnostics
                                                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                                    #statDiag.buffer[#statDiag.bufferIndex].status := #WARN_NO_TIME_SYNC;
                                                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                                END_IF;
                                                //Do not send telegram 1
                                            ELSE
                                                //LCom V1
                                                //LifeSignCycle
                                                #statReceive.configTelegramV1.lifeSignCycle.%B1 := #statReceive.tempTelegram.data[8];
                                                #statReceive.configTelegramV1.lifeSignCycle.%B0 := #statReceive.tempTelegram.data[9];
                                                #diagnostics.partnerConfig.connnection.lifeSignCycleTime := UINT_TO_TIME(#statReceive.configTelegramV1.lifeSignCycle);
                                                //CycleTime
                                                #statReceive.configTelegramV1.cycleTime.%B1 := #statReceive.tempTelegram.data[4];
                                                #statReceive.configTelegramV1.cycleTime.%B0 := #statReceive.tempTelegram.data[5];
                                                #diagnostics.partnerConfig.sender.cycleTime := UINT_TO_TIME(#statReceive.configTelegramV1.cycleTime);
                                                //AckTimeOut
                                                #statReceive.configTelegramV1.ackTimeOut.%B1 := #statReceive.tempTelegram.data[6];
                                                #statReceive.configTelegramV1.ackTimeOut.%B0 := #statReceive.tempTelegram.data[7];
                                                #diagnostics.partnerConfig.sender.ackTimeout := UINT_TO_TIME(#statReceive.configTelegramV1.ackTimeOut);
                                                //MaxSendDataLength
                                                #statReceive.configTelegramV1.maxSendDataLength.%B1 := #statReceive.tempTelegram.data[12];
                                                #statReceive.configTelegramV1.maxSendDataLength.%B0 := #statReceive.tempTelegram.data[13];
                                                #diagnostics.partnerConfig.sizeOfSendBuffer := #statReceive.configTelegramV1.maxSendDataLength;
                                                //MaxReceiveDataLength
                                                #statReceive.configTelegramV1.maxReceiveDataLength.%B1 := #statReceive.tempTelegram.data[14];
                                                #statReceive.configTelegramV1.maxReceiveDataLength.%B0 := #statReceive.tempTelegram.data[15];
                                                #diagnostics.partnerConfig.sizeOfReceiveBuffer := #statReceive.configTelegramV1.maxReceiveDataLength;
                                                //UsesTimeStamp
                                                #diagnostics.partnerConfig.timeSync.usePartnerTimestamps := BYTE_TO_BOOL(#statReceive.tempTelegram.data[10]);
                                                //SendModeSyncTime
                                                #diagnostics.partnerConfig.timeSync.sendMode := #statReceive.tempTelegram.data[11];
                                                
                                                //Send Telegram 1
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset] := #statSend.configTelegramV1.LComVersion;
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 1] := 16#01;
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 2] := #statSend.configTelegramV1.comMode;
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 3] := #statSend.configTelegramV1.slidingWindow;
                                                //CycleTime
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 4] := #statReceive.configTelegramV1.cycleTime.%B1;
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 5] := #statReceive.configTelegramV1.cycleTime.%B0;
                                                //AckTimeOut
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 6] := #statReceive.configTelegramV1.ackTimeOut.%B1;
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 7] := #statReceive.configTelegramV1.ackTimeOut.%B0;
                                                //LifeSignCycle
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 8] := #statSend.configTelegramV1.lifeSignCycle.%B1;
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 9] := #statSend.configTelegramV1.lifeSignCycle.%B0;
                                                //Status
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 10] := #statSend.configTelegramV1.status;
                                                //SendModeSyncTime
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 11] := #statSend.configTelegramV1.sendModeSyncTime;
                                                //MaxSendDataLength
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 12] := #statSend.configTelegramV1.maxSendDataLength.%B1;
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 13] := #statSend.configTelegramV1.maxSendDataLength.%B0;
                                                //MaxReceiveDataLength
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 14] := #statSend.configTelegramV1.maxReceiveDataLength.%B1;
                                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 15] := #statSend.configTelegramV1.maxReceiveDataLength.%B0;
                                                //Calculate offset in the tcp send buffer
                                                #statSend.tsendFct.dataOffset := #statSend.tsendFct.dataOffset + 16;
                                                //Set state
                                                #statState.sender := #SEND_CONFIG;
                                            END_IF;
                                            
                                        5://Telegram type 5
                                            
                                            //Reset index, so a new temp. LCom header can be built
                                            #statReceive.tempTelegram.index := 0;
                                            #statReceive.numberOfLComHeader := #statReceive.numberOfLComHeader + 1;
                                            
                                            //Accept timestamp from partner ?
                                            IF (#diagnostics.localConfig.timeSync.usePartnerTimestamps) THEN
                                                //Yes --> Accept timestamp from partner
                                                #tempActTime.YEAR := INT_TO_UINT(BCD16_TO_INT(#statReceive.tempTelegram.data[2] AND 16#00FF));
                                                IF ((#tempActTime.YEAR >= 90)
                                                    AND (#tempActTime.YEAR <= 99))
                                                THEN
                                                    #tempActTime.YEAR := #tempActTime.YEAR + 1900;
                                                ELSE
                                                    #tempActTime.YEAR := #tempActTime.YEAR + 2000;
                                                END_IF;
                                                
                                                #tempActTime.MONTH := INT_TO_USINT(BCD16_TO_INT(#statReceive.tempTelegram.data[3] AND 16#00FF));
                                                #tempActTime.DAY := INT_TO_USINT(BCD16_TO_INT(#statReceive.tempTelegram.data[4] AND 16#00FF));
                                                #tempActTime.HOUR := INT_TO_USINT(BCD16_TO_INT(#statReceive.tempTelegram.data[5] AND 16#00FF));
                                                #tempActTime.MINUTE := INT_TO_USINT(BCD16_TO_INT(#statReceive.tempTelegram.data[6] AND 16#00FF));
                                                #tempActTime.SECOND := INT_TO_USINT(BCD16_TO_INT(#statReceive.tempTelegram.data[7] AND 16#00FF));
                                                #tempActTime.NANOSECOND := INT_TO_UDINT(BCD16_TO_INT(#statReceive.tempTelegram.data[8] AND 16#00FF));
                                                #tempActTime.NANOSECOND := #tempActTime.NANOSECOND * 1000;
                                                #tempActTime.NANOSECOND := #tempActTime.NANOSECOND + 500;
                                                #tempActTime.WEEKDAY := INT_TO_USINT(BCD16_TO_INT(#statReceive.tempTelegram.data[9] AND 16#000F));
                                                //Write local time
                                                #statRet := WR_LOC_T(LOCTIME := #tempActTime, DST := FALSE);
                                                //Statistic --> Get time stamp of last time sync
                                                #diagnostics.statistics.lastTimeSync := #tempActTime;
                                            ELSE
                                                ;//No --> Do not write system time
                                            END_IF;
                                            
                                        20://Telegram type 20
                                            
                                            //Reset index, so a new temp. LCom header can be built
                                            #statReceive.numberOfLComHeader := #statReceive.numberOfLComHeader + 1;
                                            #statReceive.tempTelegram.index := 0;
                                            
                                            //Write diagnostics ---> Stop analyzing the tcp receive buffer
                                            #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                            #statDiag.buffer[#statDiag.bufferIndex].status := #STATUS_DISCONNECTING;
                                            #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                            #statState.connection := #CLOSE_CONNECTION;
                                            EXIT;
                                            
                                        ELSE//Telegram type is unknown
                                            //Write diagnostics
                                            #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                            #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_WRONG_TELEGRAM_ID;
                                            #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := #statReceive.tempTelegram.telegramType;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                            #statState.connection := #CLOSE_CONNECTION;
                                            GOTO ;
                                    END_CASE;
                                    
                                END_IF;
                            END_REGION LCOM_PROTOCOL
                            
                            //Calculate rest of data in the tcp receive buffer
                            #statReceive.trcvFct.dataLengthRest := #statReceive.trcvFct.dataLength - #statReceive.trcvFct.dataOffset;
                            
                        UNTIL ((#statReceive.trcvFct.dataLengthRest <= 0)
                            OR (#statReceive.trcvFct.dataLengthRest > #MAX_DATA_BUFFER))
                            //If the result of the calculation of the rest data is greater than 4096, then an error occurred
                        END_REPEAT;
                        //End:Analyze tcp receive buffer with LCom protocol
                        
                    END_IF;//#readDataLength <> 0
                END_REGION READ_TCP_BUFFER
                
                REGION HANDLE_SENDING
                    //---------------------------------------------------------------------
                    //Check if next package can be sent
                    //---------------------------------------------------------------------
                    IF ((#statConnected = TRUE) AND (#statState.connection = #OPERATION)) THEN
                        
                        //Get cycle time [ms]
                        #instLocalCycleTimeTimer(IN := TRUE,
                                                 PT := #diagnostics.localConfig.sender.cycleTime);
                        
                        
                        //---------------------------------------------------------------------
                        //In sending process
                        //---------------------------------------------------------------------
                        IF (#statSending = TRUE) THEN
                            //Yes --> In sending process
                            
                            REGION CHECK_SEND_CYCLETIME
                                //---------------------------------------------------------------------
                                //Check if sender cycle time is expired (with and without LCom protocol) ?
                                //---------------------------------------------------------------------
                                IF (#instLocalCycleTimeTimer.Q AND #diagnostics.localConfig.sender.cycleTime > T#0ms) THEN
                                    //Yes --> Sender cycle time is expired
                                    //Check if sender cycle time violation is already stored ?
                                    IF (#statSend.userData.sendCycleViolation) THEN
                                        ;//Yes --> Exceeded before and stored
                                    ELSE
                                        //No --> Increase number of send cycle time violations
                                        #diagnostics.statistics.totalSendCycleViolations := #diagnostics.statistics.totalSendCycleViolations + 1;
                                        #statSend.userData.sendCycleViolation := TRUE;
                                    END_IF;
                                    
                                    //Write diagnostics
                                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                    #statDiag.buffer[#statDiag.bufferIndex].status := #WARN_SEND_CYCLE_EXPIRED;
                                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := UDINT_TO_REAL(TIME_TO_UDINT(#diagnostics.localConfig.sender.cycleTime));
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := #instLocalCycleTimeTimer.ET;
                                ELSE
                                    ;//No --> Sender cycle time is not expired
                                END_IF;//End: Check if sender cycle time is expired (with and without LCom protocol) ?
                            END_REGION CHECK_SEND_CYCLETIME
                            
                            REGION CHECK_ACK_TIMEOUT
                                //---------------------------------------------------------------------
                                //Check acknowledge timeout with LCom protocol
                                //---------------------------------------------------------------------
                                IF (#diagnostics.localConfig.connection.useLComProtocol = TRUE) THEN
                                    
                                    //Get acknowledge timeout [ms]
                                    #instExpectedAckPackage1(IN := TRUE,
                                                             PT := #diagnostics.localConfig.sender.ackTimeout);
                                    
                                    //Check if acknowledge timeout is expired ?
                                    IF ((#instExpectedAckPackage1.Q = TRUE)
                                        AND
                                        (#statSend.numberOfLComPackage > 0))
                                    THEN
                                        //Yes --> Acknowledge timeout is expired, increase number of confirmation timeouts
                                        #diagnostics.statistics.totalAckTimeouts := #diagnostics.statistics.totalAckTimeouts + 1;
                                        
                                        //Write diagnostics
                                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                        #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_ACK_TIMEOUT_EXPIRED;
                                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := UDINT_TO_REAL(TIME_TO_UDINT(#diagnostics.localConfig.sender.ackTimeout));
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := #instExpectedAckPackage1.ET;
                                        #statState.connection := #CLOSE_CONNECTION;
                                        GOTO ;
                                    ELSE
                                        //No --> Acknowledge timeout is not expired
                                        
                                        //Is the last LCom package already sent ?
                                        IF (#statState.comSender = #SEND_NO_DATA) THEN
                                            ;//Yes --> Wait for acknowledge telegram
                                        ELSE
                                            //No --> Last LCom package not sent yet
                                            
                                            //Check if the next LCom package can be sent ? (Sliding window)
                                            IF ((#statSend.numberOfLComPackage < 1)
                                                AND
                                                (#diagnostics.statistics.activeLComVersion = #HEADER_V1
                                                OR
                                                #diagnostics.statistics.activeLComVersion = #HEADER_V2))
                                            THEN
                                                //Yes --> Continue sending
                                                #statState.comSender := #CYCLE;
                                            ELSE
                                                //No --> Wait for acknowledge telegram
                                                #statState.comSender := #WAIT_ACK_TELEGRAM;
                                            END_IF;
                                        END_IF;//End: Is the last LCom package already sent ?
                                    END_IF;//End: Check if acknowledge time is expired ?
                                ELSE
                                    //Continue without LCom protocol, acknowledge timeout is not valid
                                    #statState.comSender := #CYCLE;
                                END_IF;
                            END_REGION CHECK_ACK_TIMEOUT
                            
                        ELSE
                            //Not --> Not in sending process
                            REGION CHECK_SEND_CONFIG_AND_DATA_TO_SEND
                                //With LCom protocol --> Check if sender configuration was changed
                                IF (#diagnostics.localConfig.connection.useLComProtocol = TRUE
                                    AND
                                    ((#configuration.sender.cycleTime <> #statCompare.sender.cycleTime)
                                    OR
                                    (#configuration.sender.ackTimeout <> #statCompare.sender.ackTimeOut)))
                                THEN
                                    #connected := #statConnected := FALSE;
                                    //Update parameters
                                    #statState.cfgSender := #STATE_INIT;
                                ELSIF (NOT #diagnostics.localConfig.connection.useLComProtocol
                                    AND
                                    #configuration.sender.cycleTime <> #statCompare.sender.cycleTime)
                                THEN//Without LCom protocol --> Check if sender configuration was changed
                                    //Update parameters
                                    #diagnostics.localConfig.sender.cycleTime := #configuration.sender.cycleTime;
                                    #statCompare.sender.cycleTime := #configuration.sender.cycleTime;
                                ELSIF (#send OR #statRisingEdgeSend)//Check if FB.send input is true or rising edge is detected ?
                                THEN
                                    //Yes --> FB.send input is true
                                    
                                    //---------------------------------------------------------------------
                                    //Check if data have to be sent
                                    //---------------------------------------------------------------------
                                    IF ((#sendDataLength > 0)
                                        AND
                                        ((#statRisingEdgeSend)//Rising edge
                                        OR
                                        ((#instLocalCycleTimeTimer.Q)//check CycleTimeTimer
                                        AND
                                        (#diagnostics.localConfig.sender.cycleTime > T#0ms))))
                                    THEN
                                        //Start sending
                                        #sending := #statSending := TRUE;
                                        #statSend.userData.sendCycleViolation := FALSE;
                                        #statSend.userData.offset := 0;
                                        #statRisingEdgeSend := FALSE;
                                        
                                        //Start message sending timer
                                        #instMsgSendingTimer(IN := TRUE,
                                                             PT := T#+24d20h31m23s647ms);
                                        
                                        //Stop/Start local cycle timer
                                        #instLocalCycleTimeTimer(IN := FALSE,
                                                                 PT := #diagnostics.localConfig.sender.cycleTime);
                                        #instLocalCycleTimeTimer(IN := TRUE,
                                                                 PT := #diagnostics.localConfig.sender.cycleTime);
                                        
                                        
                                        //Send data length greater than size of local send buffer ?
                                        IF (#sendDataLength > #diagnostics.localConfig.sizeOfSendBuffer) THEN
                                            //Yes --> Send data length is greater than size of local send buffer
                                            #statSend.dataTelegram.totalMessageLength := #diagnostics.localConfig.sizeOfSendBuffer;
                                            
                                            IF #diagnostics.localConfig.connection.useLComProtocol THEN
                                                #statSend.dataTelegram.totalMessageLength := #diagnostics.localConfig.sizeOfSendBuffer;
                                            ELSE
                                                #statSend.dataTelegram.totalMessageLength := #sendDataLength;
                                            END_IF;
                                            //Write diagnostics
                                            #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                            #statDiag.buffer[#statDiag.bufferIndex].status := #WARN_SEND_DATA_LENGTH;
                                            #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := UDINT_TO_REAL(#sendDataLength);
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := UDINT_TO_REAL(#diagnostics.localConfig.sizeOfSendBuffer);
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                        ELSE
                                            //No --> Send data length is less than size of local send buffer
                                            #statSend.dataTelegram.totalMessageLength := #sendDataLength;
                                        END_IF;
                                        
                                        //"Send data length" greater than size of partner receive buffer ?
                                        IF ((#diagnostics.localConfig.connection.useLComProtocol)
                                            AND
                                            (#diagnostics.partnerConfig.sizeOfReceiveBuffer < #statSend.dataTelegram.totalMessageLength)
                                            ) THEN
                                            //Yes --> "Send data length" is greater than size of partner receive buffer
                                            #statSend.dataTelegram.totalMessageLength := #diagnostics.partnerConfig.sizeOfReceiveBuffer;
                                            //Write diagnostics
                                            #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                            #statDiag.buffer[#statDiag.bufferIndex].status := #WARN_RECEIVE_BUFFER_LEN;
                                            #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := UDINT_TO_REAL(#sendDataLength);
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := UDINT_TO_REAL(#diagnostics.partnerConfig.sizeOfReceiveBuffer);
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                        ELSE
                                            ;//No --> "Send data length" is less than size of partner receive buffer
                                        END_IF;
                                        
                                        //Increase message counter
                                        #statSend.dataTelegram.messageCounter := #statSend.dataTelegram.messageCounter + 1;
                                        
                                        #statState.comSender := #CYCLE;
                                    ELSE
                                        //Cycle time is not expired
                                        #statState.comSender := #STATE_WAIT;
                                    END_IF;//End: Check if data have to be send ?
                                ELSE
                                    //Sender configuration was not changed
                                    //FB:send = FALSE
                                    #statState.comSender := #STATE_INACTIVE;
                                    #statOldSend := FALSE;
                                END_IF;
                            END_REGION CHECK_SEND_CONFIG_AND_DATA_TO_SEND
                            
                            //Update
                            #statCompare.sender.cycleTime := #configuration.sender.cycleTime;
                            #statCompare.sender.ackTimeOut := #configuration.sender.ackTimeout;
                            
                            REGION TIME_SYNCHRONIZATION
                                //---------------------------------------------------------------------
                                //Time synchronization
                                //---------------------------------------------------------------------
                                
                                //Calculate rest bytes from tcp send buffer
                                #statSend.tsendFct.dataLengthRest := (#MAX_DATA_BUFFER - #statSend.tsendFct.dataOffset);
                                
                                //---------------------------------------------------------------------
                                //10 Bytes still free in the tcp send buffer
                                //---------------------------------------------------------------------
                                IF ((#diagnostics.localConfig.connection.useLComProtocol)
                                    AND
                                    (#diagnostics.localConfig.timeSync.sendMode > 0)
                                    AND
                                    (NOT (#diagnostics.localConfig.timeSync.usePartnerTimestamps))
                                    AND
                                    (#diagnostics.partnerConfig.timeSync.usePartnerTimestamps)
                                    AND
                                    (#statSend.tsendFct.dataLengthRest >= 10))
                                THEN
                                    //Yes 10 bytes still free --> Get local time
                                    #statRet := RD_LOC_T(#tempActTime);
                                    
                                    CASE #diagnostics.localConfig.timeSync.sendMode OF
                                        0:
                                            ;//Time synchronization is inactive
                                            
                                        1: //Cycle time synchronization --> Get cycle time [ms]
                                            
                                            #instSyncTimer(IN := TRUE,
                                                           PT := #diagnostics.localConfig.timeSync.cycleTime);
                                            
                                            //Cycle time expired ?
                                            IF ((#instSyncTimer.Q) OR (#diagnostics.statistics.lastTimeSync.YEAR = 2200)) THEN
                                                //Stop/Start local cycle timer
                                                #instSyncTimer(IN := FALSE,
                                                               PT := #diagnostics.localConfig.timeSync.cycleTime);
                                                #instSyncTimer(IN := TRUE,
                                                               PT := #diagnostics.localConfig.timeSync.cycleTime);
                                                //Statistic --> Get time stamp of last time sync
                                                #diagnostics.statistics.lastTimeSync := #tempActTime;
                                            END_IF;
                                        2: //Time of day synchronization
                                            IF ((DTL_TO_TOD(#tempActTime) > #diagnostics.localConfig.timeSync.sendAtTimeOfDay)
                                                OR
                                                #diagnostics.statistics.lastTimeSync.YEAR = 2200)
                                            THEN
                                                
                                                IF #diagnostics.statistics.lastTimeSync.YEAR = 2200 THEN
                                                    //Start after connect
                                                    #diagnostics.statistics.lastTimeSync := #tempActTime;
                                                    //Is the date unequal
                                                ELSIF (#diagnostics.statistics.lastTimeSync.DAY <> #tempActTime.DAY) THEN
                                                    //Yes --> date is unequal
                                                    #diagnostics.statistics.lastTimeSync := #tempActTime;
                                                ELSE
                                                    //No --> date is equal
                                                    //Has the time sync telegram already sent on specified time of day ?
                                                    IF (DTL_TO_TOD(#diagnostics.statistics.lastTimeSync) > #diagnostics.localConfig.timeSync.sendAtTimeOfDay) THEN
                                                        ;//already sent, nothing to do
                                                    ELSE
                                                        #diagnostics.statistics.lastTimeSync := #tempActTime;
                                                    END_IF;
                                                END_IF;
                                            END_IF;
                                        ELSE
                                            ;
                                    END_CASE;
                                    
                                    //Build telegram 5 (time synchronization) ?
                                    IF (#diagnostics.statistics.lastTimeSync = #tempActTime) THEN
                                        
                                        #statSend.tsendFct.data[#statSend.tsendFct.dataOffset] := #diagnostics.statistics.activeLComVersion;
                                        #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 1] := 16#05;
                                        
                                        //Convert from nSecond in mSecond
                                        #tempActTime.NANOSECOND := #tempActTime.NANOSECOND / 1000000;
                                        #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 8] := WORD_TO_BYTE(SHR(N := 4, IN := ((INT_TO_BCD16(UDINT_TO_INT(#tempActTime.NANOSECOND))))));
                                        
                                        #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 3] := WORD_TO_BYTE(INT_TO_BCD16(UDINT_TO_INT(#tempActTime.NANOSECOND)) AND 16#000F);
                                        #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 9] := SHL(IN := #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 3], N := 4);
                                        #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 2] := WORD_TO_BYTE(INT_TO_BCD16(#tempActTime.WEEKDAY));
                                        #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 9] := #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 9] + #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 2];
                                        
                                        
                                        IF ((#tempActTime.YEAR > 1970) AND (#tempActTime.YEAR <= 1990)) THEN
                                            #tempActTime.YEAR := 1990;
                                        ELSIF ((#tempActTime.YEAR > 1990) AND (#tempActTime.YEAR <= 1999)) THEN
                                            #tempActTime.YEAR := #tempActTime.YEAR - 1900;
                                        ELSE
                                            #tempActTime.YEAR := #tempActTime.YEAR - 2000;
                                        END_IF;
                                        
                                        #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 2] := WORD_TO_BYTE(INT_TO_BCD16(UINT_TO_INT(#tempActTime.YEAR)));
                                        #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 3] := WORD_TO_BYTE(INT_TO_BCD16(#tempActTime.MONTH));
                                        #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 4] := WORD_TO_BYTE(INT_TO_BCD16(#tempActTime.DAY));
                                        #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 5] := WORD_TO_BYTE(INT_TO_BCD16(#tempActTime.HOUR));
                                        #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 6] := WORD_TO_BYTE(INT_TO_BCD16(#tempActTime.MINUTE));
                                        #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 7] := WORD_TO_BYTE(INT_TO_BCD16(#tempActTime.SECOND));
                                        
                                        #statState.sender := #SEND_DATA;
                                        //Calculate offset in the tcp send buffer
                                        #statSend.tsendFct.dataOffset := #statSend.tsendFct.dataOffset + 10;
                                    END_IF;
                                ELSE
                                    ;//No space
                                END_IF;//End: 10 bytes still free in the tcp send buffer
                            END_REGION TIME_SYNCHRONIZATION
                            
                        END_IF;//End: In sending process
                        
                        REGION SEND_DATA_TELEGRAM
                            //---------------------------------------------------------------------
                            //Send telegram
                            //---------------------------------------------------------------------
                            IF (#statState.comSender = #CYCLE
                                AND
                                (#diagnostics.localConfig.connection.useLComProtocol))
                            THEN
                                //---------------------------------------------------------------------
                                //Send data telegram with LCom protocol
                                //---------------------------------------------------------------------
                                #statState.sender := #SEND_DATA;
                                
                                //Calculate rest bytes from tcp send buffer
                                IF (#diagnostics.statistics.activeLComVersion = #HEADER_V2) THEN
                                    #statSend.tsendFct.dataLengthRest := #MAX_DATA_BUFFER - #statSend.tsendFct.dataOffset - 20;
                                ELSE
                                    #statSend.tsendFct.dataLengthRest := #MAX_DATA_BUFFER - #statSend.tsendFct.dataOffset - 12;
                                END_IF;
                                
                                //Calculate rest data from the total LCom message
                                #tempUDint := #statSend.dataTelegram.totalMessageLength - #statSend.dataTelegram.messageOffset;
                                
                                //Calculate max. actual package length
                                IF (#statSend.tsendFct.dataLengthRest > #diagnostics.partnerConfig.sizeOfReceiveBuffer) THEN
                                    #statMaxActPacketLength := #diagnostics.partnerConfig.sizeOfReceiveBuffer;
                                ELSE
                                    #statMaxActPacketLength := #statSend.tsendFct.dataLengthRest;
                                END_IF;
                                
                                //Rest data from the total LCom message, is greater than max. actual package length
                                IF (#tempUDint > #statMaxActPacketLength) THEN
                                    #statSend.dataTelegram.actPackageLength := #statMaxActPacketLength;
                                ELSE
                                    #statSend.dataTelegram.actPackageLength := #tempUDint;
                                END_IF;
                                
                                #statSend.tsendFct.dataLengthRest := 0;
                                //Build header from data telegram
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset] := #statSend.dataTelegram.LComVersion;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 1] := #statSend.dataTelegram.telegramType;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 2] := #statSend.dataTelegram.messageCounter;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 3] := #statSend.dataTelegram.ackMessageCounter;
                                
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 4] := #statSend.dataTelegram.messageOffset.%B3;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 5] := #statSend.dataTelegram.messageOffset.%B2;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 6] := #statSend.dataTelegram.messageOffset.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 7] := #statSend.dataTelegram.messageOffset.%B0;
                                
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 8] := #statSend.dataTelegram.ackMessageOffset.%B3;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 9] := #statSend.dataTelegram.ackMessageOffset.%B2;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 10] := #statSend.dataTelegram.ackMessageOffset.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 11] := #statSend.dataTelegram.ackMessageOffset.%B0;
                                
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 12] := #statSend.dataTelegram.actPackageLength.%B3;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 13] := #statSend.dataTelegram.actPackageLength.%B2;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 14] := #statSend.dataTelegram.actPackageLength.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 15] := #statSend.dataTelegram.actPackageLength.%B0;
                                
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 16] := #statSend.dataTelegram.totalMessageLength.%B3;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 17] := #statSend.dataTelegram.totalMessageLength.%B2;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 18] := #statSend.dataTelegram.totalMessageLength.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 19] := #statSend.dataTelegram.totalMessageLength.%B0;
                                
                                //LCom V2
                                IF (#diagnostics.statistics.activeLComVersion = #HEADER_V2) THEN
                                    //Calculate offset in the tcp send buffer
                                    #statSend.tsendFct.dataOffset := #statSend.tsendFct.dataOffset + 20;
                                ELSE
                                    //LCom V1
                                    //MessageOffset
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 4] := #statSend.dataTelegram.messageOffset.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 5] := #statSend.dataTelegram.messageOffset.%B0;
                                    //AckMessageOffset
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 6] := #statSend.dataTelegram.ackMessageOffset.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 7] := #statSend.dataTelegram.ackMessageOffset.%B0;
                                    //ActPackageLength
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 8] := #statSend.dataTelegram.actPackageLength.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 9] := #statSend.dataTelegram.actPackageLength.%B0;
                                    //TotalMessageLength
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 10] := #statSend.dataTelegram.totalMessageLength.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 11] := #statSend.dataTelegram.totalMessageLength.%B0;
                                    //Calculate offset in the tcp send buffer
                                    #statSend.tsendFct.dataOffset := #statSend.tsendFct.dataOffset + 12;
                                END_IF;
                                
                                //Store expected acknowledge message offset and time
                                #statSend.expectedAck.package1.offset := #statSend.dataTelegram.messageOffset + #statSend.dataTelegram.actPackageLength;
                                //Start expe. message Timer 1
                                #instExpectedAckPackage1(IN := TRUE,
                                                         PT := #diagnostics.localConfig.sender.ackTimeout);
                                
                                #statSend.numberOfLComPackage := #statSend.numberOfLComPackage + 1;
                                
                                //Copy data from FB.sendBuffer
                                #statRet := MOVE_BLK_VARIANT(SRC := #sendBuffer, COUNT := #statSend.dataTelegram.actPackageLength, SRC_INDEX := UDINT_TO_DINT(#statSend.userData.offset), DEST_INDEX := #statSend.tsendFct.dataOffset, DEST => #statSend.tsendFct.data);
                                //Calculate offset in FB.sendBuffer
                                #statSend.userData.offset := #statSend.userData.offset + #statSend.dataTelegram.actPackageLength;
                                //Copy offset in telegram
                                #statSend.dataTelegram.messageOffset := #statSend.userData.offset;
                                //Calculate offset in the tcp send buffer
                                #statSend.tsendFct.dataOffset := #statSend.tsendFct.dataOffset + UDINT_TO_UINT(#statSend.dataTelegram.actPackageLength);
                                
                                //All sent data is copied ?
                                IF (#statSend.userData.offset = #statSend.dataTelegram.totalMessageLength) THEN
                                    //Yes
                                    #statState.comSender := #SEND_NO_DATA;
                                ELSE
                                    ;//No --> Not all sent data has been copied
                                END_IF;
                            ELSIF (#statState.comSender = #CYCLE
                                AND
                                (NOT #diagnostics.localConfig.connection.useLComProtocol)) THEN
                                //---------------------------------------------------------------------
                                //Send telegram without LCom protocol
                                //---------------------------------------------------------------------
                                #statState.sender := #SEND_DATA;
                                
                                //Calculate rest data from the total message
                                IF ((#statSend.dataTelegram.totalMessageLength - #statSend.userData.offset) > #MAX_DATA_BUFFER) THEN
                                    #statSend.tsendFct.dataOffset := #MAX_DATA_BUFFER;
                                ELSE
                                    #statSend.tsendFct.dataOffset := UDINT_TO_UINT(#statSend.dataTelegram.totalMessageLength - #statSend.userData.offset);
                                END_IF;
                                
                                //Copy data from FB.sendBuffer
                                #statRet := MOVE_BLK_VARIANT(SRC := #sendBuffer, COUNT := #statSend.tsendFct.dataOffset, SRC_INDEX := UDINT_TO_DINT(#statSend.userData.offset), DEST_INDEX := 0, DEST => #statSend.tsendFct.data);
                                //Calculate offset in tcp send buffer
                                #statSend.userData.offset := #statSend.userData.offset + #statSend.tsendFct.dataOffset;
                                //End: Send telegram without LCom protocol
                            ELSE
                                ;//Not in sending process 
                            END_IF;//End: Send telegram
                        END_REGION SEND_DATA_TELEGRAM
                        
                    END_IF;//End: Connected
                END_REGION HANDLE_SENDING
                
                REGION SENDER_STATE_MACHINE
                    //---------------------------------------------------------------------
                    //State machine sender configuration
                    //---------------------------------------------------------------------
                    CASE #statState.cfgSender OF
                            
                        #OPERATION:
                            ;//Sender configuration successful exchange
                        #STATE_WAIT:
                            ;
                        #STATE_INIT:
                            
                            #statCompare.sender.cycleTime := #configuration.sender.cycleTime;
                            #statCompare.sender.ackTimeOut := #configuration.sender.ackTimeout;
                            
                            //LCom Version V1.0
                            IF (#statActualLocalLComVersion = #HEADER_V1) THEN
                                
                                //Check max. cycleTime
                                IF (#configuration.sender.cycleTime > T#65535ms) THEN
                                    
                                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := #configuration.sender.cycleTime;
                                    #statSend.configTelegramV1.cycleTime := 65535;
                                    
                                    #statDiag.buffer[#statDiag.bufferIndex].status := #WARN_SEND_CYCLE_LIMITATION;
                                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 65535.0;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                ELSE
                                    #statSend.configTelegramV1.cycleTime := TIME_TO_UINT(#configuration.sender.cycleTime);
                                END_IF;
                                
                                //Check max. ackTimeOut
                                IF (#configuration.sender.ackTimeout > T#65535ms) THEN
                                    
                                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := #configuration.sender.ackTimeout;
                                    #statSend.configTelegramV1.ackTimeOut := 65535;
                                    
                                    #statDiag.buffer[#statDiag.bufferIndex].status := #WARN_ACK_TIMEOUT_LIMITATION;
                                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 65535.0;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                ELSE
                                    #statSend.configTelegramV1.ackTimeOut := TIME_TO_UINT(#configuration.sender.ackTimeout);
                                END_IF;
                            ELSE //LCom Version V2.0
                                #statSend.configTelegramV2.cycleTime := #configuration.sender.cycleTime;
                                #statSend.configTelegramV2.ackTimeOut := #configuration.sender.ackTimeout;
                            END_IF;
                            
                            #statState.cfgSender := #SEND_CONFIG;
                            
                        #SEND_CONFIG:
                            REGION SEND_CONFIG_TELEGRAM
                                #statState.cfgSender := #STATE_WAIT;
                                
                                //LCom Version V1.0
                                IF (#statActualLocalLComVersion = #HEADER_V1) THEN
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset] := #statSend.configTelegramV1.LComVersion;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 1] := 16#02;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 2] := #statSend.configTelegramV1.comMode;//ComMode
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 3] := #statSend.configTelegramV1.slidingWindow;//SlidingWindow
                                    //cycleTime
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 4] := #statSend.configTelegramV1.cycleTime.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 5] := #statSend.configTelegramV1.cycleTime.%B0;
                                    //ackTimeOut
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 6] := #statSend.configTelegramV1.ackTimeOut.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 7] := #statSend.configTelegramV1.ackTimeOut.%B0;
                                    //lifeSignCycle
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 8] := #statSend.configTelegramV1.lifeSignCycle.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 9] := #statSend.configTelegramV1.lifeSignCycle.%B0;
                                    //status
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 10] := #statSend.configTelegramV1.status;
                                    //sendModeSyncTime
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 11] := #statSend.configTelegramV1.sendModeSyncTime;
                                    //maxSendDataLength
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 12] := #statSend.configTelegramV1.maxSendDataLength.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 13] := #statSend.configTelegramV1.maxSendDataLength.%B0;
                                    //maxReceiveDataLength
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 14] := #statSend.configTelegramV1.maxReceiveDataLength.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 15] := #statSend.configTelegramV1.maxReceiveDataLength.%B0;
                                    
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 16] := #statSend.configTelegramV1.LComVersion;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 17] := 16#02;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 18] := #statSend.configTelegramV1.comMode;//ComMode
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 19] := #statSend.configTelegramV1.slidingWindow;//SlidingWindow
                                    //cycleTime
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 20] := #statSend.configTelegramV1.cycleTime.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 21] := #statSend.configTelegramV1.cycleTime.%B0;
                                    //ackTimeOut
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 22] := #statSend.configTelegramV1.ackTimeOut.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 23] := #statSend.configTelegramV1.ackTimeOut.%B0;
                                    //lifeSignCycle
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 24] := #statSend.configTelegramV1.lifeSignCycle.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 25] := #statSend.configTelegramV1.lifeSignCycle.%B0;
                                    //status
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 26] := #statSend.configTelegramV1.status;
                                    //sendModeSyncTime
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 27] := #statSend.configTelegramV1.sendModeSyncTime;
                                    //maxSendDataLength
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 28] := #statSend.configTelegramV1.maxSendDataLength.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 29] := #statSend.configTelegramV1.maxSendDataLength.%B0;
                                    //maxReceiveDataLength
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 30] := #statSend.configTelegramV1.maxReceiveDataLength.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 31] := #statSend.configTelegramV1.maxReceiveDataLength.%B0;
                                    //calculate new offset
                                    #statSend.tsendFct.dataOffset := #statSend.tsendFct.dataOffset + 32;
                                    #statState.sender := #SEND_CONFIG;
                                    
                                    #diagnostics.localConfig.sender.cycleTime := UINT_TO_TIME(#statSend.configTelegramV1.cycleTime);
                                    #diagnostics.localConfig.sender.ackTimeout := UINT_TO_TIME(#statSend.configTelegramV1.ackTimeOut);
                                ELSE
                                    //LCom Version V2.0
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset] := #statSend.configTelegramV2.LComVersion;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 1] := 16#02;
                                    //status
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 2] := #statSend.configTelegramV2.status;
                                    //sendModeSyncTime
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 3] := #statSend.configTelegramV2.sendModeSyncTime;
                                    //lifeSignCycle
                                    #tempDWord := TIME_TO_DWORD(#statSend.configTelegramV2.lifeSignCycle);
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 4] := #tempDWord.%B3;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 5] := #tempDWord.%B2;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 6] := #tempDWord.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 7] := #tempDWord.%B0;
                                    //cycleTime
                                    #tempDWord := TIME_TO_DWORD(#statSend.configTelegramV2.cycleTime);
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 8] := #tempDWord.%B3;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 9] := #tempDWord.%B2;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 10] := #tempDWord.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 11] := #tempDWord.%B0;
                                    //ackTimeOut
                                    #tempDWord := TIME_TO_DWORD(#statSend.configTelegramV2.ackTimeOut);
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 12] := #tempDWord.%B3;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 13] := #tempDWord.%B2;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 14] := #tempDWord.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 15] := #tempDWord.%B0;
                                    //maxSendDataLength
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 16] := #statSend.configTelegramV2.maxSendDataLength.%B3;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 17] := #statSend.configTelegramV2.maxSendDataLength.%B2;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 18] := #statSend.configTelegramV2.maxSendDataLength.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 19] := #statSend.configTelegramV2.maxSendDataLength.%B0;
                                    //maxReceiveDataLength
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 20] := #statSend.configTelegramV2.maxReceiveDataLength.%B3;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 21] := #statSend.configTelegramV2.maxReceiveDataLength.%B2;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 22] := #statSend.configTelegramV2.maxReceiveDataLength.%B1;
                                    #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 23] := #statSend.configTelegramV2.maxReceiveDataLength.%B0;
                                    
                                    //calculate new offset
                                    #statSend.tsendFct.dataOffset := #statSend.tsendFct.dataOffset + 24;
                                    #statState.sender := #SEND_CONFIG;
                                    
                                    #diagnostics.localConfig.sender.cycleTime := #statSend.configTelegramV2.cycleTime;
                                    #diagnostics.localConfig.sender.ackTimeout := #statSend.configTelegramV2.ackTimeOut;
                                    
                                    IF #diagnostics.statistics.activeLComVersion = #HEADER_V2 THEN
                                        #connected := #statConnected := TRUE;
                                        #diagnostics.statistics.LComProtocolUsed := TRUE;
                                        #diagnostics.statistics.activeLComVersion := #HEADER_V2;
                                        #statState.cfgSender := #OPERATION;
                                        
                                        //Write diagnostics
                                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                        #statDiag.buffer[#statDiag.bufferIndex].status := #STATUS_CONNECTED_V2;
                                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                    END_IF;
                                END_IF;
                                
                                #statCompare.sender.cycleTime := #configuration.sender.cycleTime;
                                #statCompare.sender.ackTimeOut := #configuration.sender.ackTimeout;
                            END_REGION SEND_CONFIG_TELEGRAM
                            
                        #ERROR_STATE:
                            ;
                        ELSE
                            ;// Statement section ELSE
                    END_CASE;
                END_REGION SENDER_STATE_MACHINE
                
                REGION SEND_LIFESIGN
                    //No telegram 1,2,5 or 10 to  be sent, therefore check whether life sign tel. must be sent
                    IF (#statState.sender = #STATE_INACTIVE
                        AND
                        (#diagnostics.localConfig.connection.lifeSignCycleTime <> T#0ms)
                        AND
                        #diagnostics.localConfig.connection.useLComProtocol)
                    THEN
                        #instLocalLifeSignCycleTimer(IN := TRUE,
                                                     PT := #diagnostics.localConfig.connection.lifeSignCycleTime);
                        
                        IF (#instLocalLifeSignCycleTimer.Q)
                        THEN
                            
                            //LCom Version V1.0
                            IF (#statActualLocalLComVersion = #HEADER_V1) THEN
                                
                                //LCom Version V1
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset] := #statSend.configTelegramV1.LComVersion;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 1] := 16#03;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 2] := #statSend.configTelegramV1.comMode;//ComMode
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 3] := #statSend.configTelegramV1.slidingWindow;//SlidingWindow
                                //cycleTime
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 4] := #statSend.configTelegramV1.cycleTime.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 5] := #statSend.configTelegramV1.cycleTime.%B0;
                                //ackTimeOut
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 6] := #statSend.configTelegramV1.ackTimeOut.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 7] := #statSend.configTelegramV1.ackTimeOut.%B0;
                                //lifeSignCycle
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 8] := #statSend.configTelegramV1.lifeSignCycle.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 9] := #statSend.configTelegramV1.lifeSignCycle.%B0;
                                //status
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 10] := #statSend.configTelegramV1.status;
                                //sendModeSyncTime
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 11] := #statSend.configTelegramV1.sendModeSyncTime;
                                //maxSendDataLength
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 12] := #statSend.configTelegramV1.maxSendDataLength.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 13] := #statSend.configTelegramV1.maxSendDataLength.%B0;
                                //maxReceiveDataLength
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 14] := #statSend.configTelegramV1.maxReceiveDataLength.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 15] := #statSend.configTelegramV1.maxReceiveDataLength.%B0;
                                //calculate new offset
                                #statSend.tsendFct.dataOffset := 16;
                            ELSE
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset] := #statSend.configTelegramV2.LComVersion;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 1] := 16#03;
                                //status
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 2] := #statSend.configTelegramV2.status;
                                //sendModeSyncTime
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 3] := #statSend.configTelegramV2.sendModeSyncTime;
                                //lifeSignCycle
                                #tempDWord := TIME_TO_DWORD(#statSend.configTelegramV2.lifeSignCycle);
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 4] := #tempDWord.%B3;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 5] := #tempDWord.%B2;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 6] := #tempDWord.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 7] := #tempDWord.%B0;
                                //cycleTime
                                #tempDWord := TIME_TO_DWORD(#statSend.configTelegramV2.cycleTime);
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 8] := #tempDWord.%B3;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 9] := #tempDWord.%B2;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 10] := #tempDWord.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 11] := #tempDWord.%B0;
                                //ackTimeOut
                                #tempDWord := TIME_TO_DWORD(#statSend.configTelegramV2.ackTimeOut);
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 12] := #tempDWord.%B3;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 13] := #tempDWord.%B2;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 14] := #tempDWord.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 15] := #tempDWord.%B0;
                                //maxSendDataLength
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 16] := #statSend.configTelegramV2.maxSendDataLength.%B3;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 17] := #statSend.configTelegramV2.maxSendDataLength.%B2;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 18] := #statSend.configTelegramV2.maxSendDataLength.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 19] := #statSend.configTelegramV2.maxSendDataLength.%B0;
                                //maxReceiveDataLength
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 20] := #statSend.configTelegramV2.maxReceiveDataLength.%B3;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 21] := #statSend.configTelegramV2.maxReceiveDataLength.%B2;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 22] := #statSend.configTelegramV2.maxReceiveDataLength.%B1;
                                #statSend.tsendFct.data[#statSend.tsendFct.dataOffset + 23] := #statSend.configTelegramV2.maxReceiveDataLength.%B0;
                                //calculate new offset
                                #statSend.tsendFct.dataOffset := 24;
                            END_IF;
                            #statSend.tsendFct.enable := TRUE;
                            
                            #instLocalLifeSignCycleTimer(IN := FALSE,
                                                         PT := #diagnostics.localConfig.connection.lifeSignCycleTime);
                        ELSE
                            ;//Telegram 3 don´t need be send
                            
                        END_IF;
                    ELSIF (NOT #diagnostics.localConfig.connection.useLComProtocol //without LCom Protocol
                        AND #statState.sender = #STATE_INACTIVE) THEN
                        #statSend.tsendFct.enable := FALSE;
                    ELSE
                        #statSend.tsendFct.enable := TRUE;
                        
                        #instLocalLifeSignCycleTimer(IN := FALSE,
                                                     PT := #diagnostics.localConfig.connection.lifeSignCycleTime);
                    END_IF;
                    
                    //differ between different connection types (IPv4, QDN)
                    IF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4) THEN
                        #tempConnOucId := #statTconPar.ID;
                    ELSE    //#CON_TYPE_QDN
                        #tempConnOucId := #statTconParQdn.ID;
                    END_IF;
                    
                    #instTSEND(REQ := #statSend.tsendFct.enable,
                               LEN := #statSend.tsendFct.dataOffset,
                               ID := #tempConnOucId,
                               DATA := #statSend.tsendFct.data,
                               STATUS => #statSend.tsendFct.status);
                    
                    //16#80C4=Temporary communication error
                    IF (#statSend.tsendFct.status = 16#80C4) THEN
                        
                        #instSendErrorTimer(IN := TRUE,
                                            PT := #MAX_TRIAL_TIME);
                        
                        //#MAX_TRIAL_TIME is expired
                        IF #instSendErrorTimer.Q THEN
                            //Write diagnostics
                            #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                            #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_SEND;
                            #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := #statSend.tsendFct.status;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := #statSend.tsendFct.dataOffset;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                            #statState.connection := #CLOSE_CONNECTION;
                            GOTO ;
                        END_IF;
                    ELSIF (#statSend.tsendFct.status >= 16#8085) THEN
                        //#WARN_SEND
                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                        #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_SEND;
                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := #statSend.tsendFct.status;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := #statSend.tsendFct.dataOffset;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                        
                        #statState.connection := #CLOSE_CONNECTION;
                        GOTO ;
                    END_IF;
                END_REGION SEND_LIFESIGN
                
            END_REGION OPERATION
            
        #STATE_INACTIVE_PREPARE:
            REGION INACTIVE_PREPARE
                
                #statState.connection := #STATE_INACTIVE;
                #status := #statStatus := #STATUS_NO_CALL;
                #statFallingEdgeEnable := FALSE;
                #statOldEnable := FALSE;
                #busy := FALSE;
            END_REGION INACTIVE_PREPARE
            
        #STATE_INIT:
            REGION INIT
                //Reset FB Outputs
                #connected := #statConnected := FALSE;
                #sending := #statSending := FALSE;
                #error := FALSE;
                
                //Diagnostics purpose
                //connection
                #diagnostics.localConfig.connection.connectionID := #configuration.connection.connectionID;
                #diagnostics.localConfig.connection.interfaceID := #configuration.connection.interfaceID;
                #diagnostics.localConfig.connection.comService := #configuration.connection.comService;
                #diagnostics.localConfig.connection.isClient := #configuration.connection.isClient;
                #diagnostics.localConfig.connection.localPort := #configuration.connection.localPort;
                #diagnostics.localConfig.connection.partnerPort := #configuration.connection.partnerPort;
                #diagnostics.localConfig.connection.partnerIP := #configuration.connection.partnerIP;
                #diagnostics.localConfig.connection.acceptUnknownPartner := #configuration.connection.acceptUnknownPartner;
                #statActualLocalLComVersion := #HEADER_V2;
                #diagnostics.localConfig.connection.lifeSignCycleTime := #configuration.connection.lifeSignCycleTime;
                //-->QDN
                #diagnostics.localConfig.connection.connectType := #configuration.connection.connectType;
                #diagnostics.localConfig.connection.partnerQDN := #configuration.connection.partnerQDN;
                //Sender
                #diagnostics.localConfig.sender.cycleTime := #configuration.sender.cycleTime;
                #diagnostics.localConfig.sender.ackTimeout := #configuration.sender.ackTimeout;
                //TimeSync
                #diagnostics.localConfig.timeSync.usePartnerTimestamps := #configuration.timeSync.usePartnerTimestamps;
                #diagnostics.localConfig.timeSync.sendMode := #configuration.timeSync.sendMode;
                #diagnostics.localConfig.timeSync.cycleTime := #configuration.timeSync.cycleTime;
                #diagnostics.localConfig.timeSync.sendAtTimeOfDay := #configuration.timeSync.sendAtTimeOfDay;
                //Statistics
                #diagnostics.statistics.avgCallCycle := 0.0;
                #diagnostics.statistics.avgReceiveMsgCycle := 0.0;
                #diagnostics.statistics.maxReceiveMsgCycle := T#0ms;
                #diagnostics.statistics.LComProtocolUsed := FALSE;
                #diagnostics.statistics.activeLComVersion := 0;
                #diagnostics.statistics.avgMsgSendingTime := 0.0;
                #diagnostics.statistics.maxMsgSendingTime := T#0ms;
                #diagnostics.statistics.avgMsgReceivingTime := 0.0;
                #diagnostics.statistics.maxMsgReceivingTime := T#0ms;
                #diagnostics.statistics.numberOfSentMessages := 0;
                #diagnostics.statistics.numberOfReceivedMessages := 0;
                #diagnostics.statistics.totalAckTimeouts := 0;
                #diagnostics.statistics.totalSendCycleViolations := 0;
                #diagnostics.statistics.totalReceiveCycleViolations := 0;
                #diagnostics.statistics.totalReconnects := 0;
                
                #statConnectAttempts := 0;
                
                //Check hardware identifier of the local interface
                IF ((#diagnostics.localConfig.connection.interfaceID >= 0) //(0...65535)
                    AND
                    (#diagnostics.localConfig.connection.interfaceID <= 65535))
                THEN
                    //Hardware identifier of the local interface --> OK
                    #statTconPar.InterfaceId := #diagnostics.localConfig.connection.interfaceID;
                ELSE
                    //Hardware identifier of the local interface --> NOT OK
                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                    #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_INTERFACE_ID;
                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := UINT_TO_REAL(#diagnostics.localConfig.connection.interfaceID);//value from user
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                    
                    #statState.connection := #ERROR_STATE;
                    GOTO ;
                END_IF;
                
                //Read the IP address
                #instRDREC(REQ := TRUE,
                           ID := #configuration.connection.interfaceID,
                           INDEX := 16#8080,
                           MLEN := 0,
                           RECORD := #statSend.tsendFct.data);
                
                //1st call from RDREC, to get the IP address
                IF #instRDREC.STATUS = 16#00700100 THEN
                    ;//don´t change the #status = "STATUS_FIRST_CALL"
                ELSE
                    //change status, that 1st call is just one time occur 
                    #status := #statStatus := #STATUS_INTERMEDIATE_CALL;
                END_IF;
                
                IF (#instRDREC.VALID = TRUE) THEN
                    //New data received and data is valid
                    #diagnostics.localConfig.connection.localIP.ADDR[1] := #statSend.tsendFct.data[28];
                    #diagnostics.localConfig.connection.localIP.ADDR[2] := #statSend.tsendFct.data[29];
                    #diagnostics.localConfig.connection.localIP.ADDR[3] := #statSend.tsendFct.data[30];
                    #diagnostics.localConfig.connection.localIP.ADDR[4] := #statSend.tsendFct.data[31];
                ELSIF (#instRDREC.ERROR = TRUE) THEN
                    //An error occurred during the reading process
                    #diagnostics.localConfig.connection.localIP.ADDR[1] := 16#00;
                    #diagnostics.localConfig.connection.localIP.ADDR[2] := 16#00;
                    #diagnostics.localConfig.connection.localIP.ADDR[3] := 16#00;
                    #diagnostics.localConfig.connection.localIP.ADDR[4] := 16#00;
                ELSE
                    RETURN;//The reading process is not complete yet
                END_IF;
                
                //Local port number
                #statTconPar.LocalPort := #diagnostics.localConfig.connection.localPort;
                
                //Check if send buffer is a VARIANT pointer to array of byte
                IF ((TypeOfElements(#sendBuffer) = TypeOf(#statSend.tsendFct.data[0]))
                    AND
                    (IS_ARRAY(#sendBuffer))) THEN
                    ;//Is VARIANT pointer to array of byte
                ELSE
                    //Write diagnostics
                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                    #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_SEND_DATA_TYPE;
                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                    
                    #statState.connection := #ERROR_STATE;
                    GOTO ;
                END_IF;
                
                //Check if receive buffer is a VARIANT pointer to array of byte
                IF ((TypeOfElements(#receiveBuffer) = TypeOf(#statReceive.trcvFct.data[0]))
                    AND
                    (IS_ARRAY(#receiveBuffer))) THEN
                    ;//Is VARIANT pointer to array of byte
                ELSE
                    //Write diagnostics
                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                    #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_RECEIVE_DATA_TYPE;
                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                    
                    #statState.connection := #ERROR_STATE;
                    GOTO ;
                END_IF;
                
                //Get size of user send buffer and user receive buffer in bytes
                #diagnostics.localConfig.sizeOfSendBuffer := CountOfElements(#sendBuffer);
                #diagnostics.localConfig.sizeOfReceiveBuffer := CountOfElements(#receiveBuffer);
                
                //Check communication service: 0:UDP, 1:TCP, 2:LCOM
                IF (#diagnostics.localConfig.connection.comService = 16#01) THEN
                    //Communication service --> transport protocol TCP
                    #statTconPar.ConnectionType := 16#0B;
                    #diagnostics.localConfig.connection.useLComProtocol := FALSE;
                ELSIF (#diagnostics.localConfig.connection.comService = 16#02) THEN
                    //Communication service --> transport protocol TCP and LCom protocol
                    #statTconPar.ConnectionType := 16#0B;
                    #diagnostics.localConfig.connection.useLComProtocol := TRUE;
                ELSE
                    //Communication service --> NOT OK
                    //Write diagnostics
                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                    #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_COM_SERVICE;
                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := #diagnostics.localConfig.connection.comService;//value from operator
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                    
                    #statState.connection := #ERROR_STATE;
                    GOTO ;
                END_IF;
                
                //Check unique connection identifier (16#0001...16#0FFF)
                IF ((#diagnostics.localConfig.connection.connectionID > 0)
                    AND
                    (#diagnostics.localConfig.connection.connectionID <= 4095))
                THEN
                    //Connection identifier -->OK
                    #statTconPar.ID := #diagnostics.localConfig.connection.connectionID;
                ELSE
                    //Connection identifier --> NOT OK
                    //Write diagnostics
                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                    #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_CONNECTION_ID;
                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := WORD_TO_UDINT(#diagnostics.localConfig.connection.connectionID);//value from user
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                    
                    #statState.connection := #ERROR_STATE;
                    GOTO ;
                END_IF;
                
                //check connection type: 1 = IPv4, 10 = QDN
                IF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4) THEN
                    //connection type IPv4
                    ;
                ELSIF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_QDN) THEN
                    //connection type fully qualified domain name (QDN)
                    ;
                ELSE
                    //connection type --> NOT OK
                    //write diagnostics
                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                    #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_CONNECTION_TYPE;
                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := #diagnostics.localConfig.connection.connectType;//value from operator
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                    
                    #statState.connection := #ERROR_STATE;
                    GOTO ;
                END_IF;
                
                //If client
                IF (#diagnostics.localConfig.connection.isClient) THEN
                    //Partner port and remote address is not checked here
                    //The TCON will rise an error and return value, when the parameters (partnerPort or partnerIP) are wrong
                    //differ between different connection types (IPv4, QDN)
                    IF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4) THEN
                        //remote addressing via IPv4
                        #statTconPar.RemotePort := #diagnostics.localConfig.connection.partnerPort;
                        #statTconPar.RemoteAddress := #diagnostics.localConfig.connection.partnerIP;
                    ELSE
                        //remote addressing via qualified domain name
                        #statTconParQdn.RemotePort := #diagnostics.localConfig.connection.partnerPort;
                        #statTconParQdn.RemoteQDN := #diagnostics.localConfig.connection.partnerQDN;
                        //additionally store all TCON configurations done before for QDN connection parameters
                        #statTconParQdn.ConnectionType := 16#0B;
                        #statTconParQdn.LocalPort := #diagnostics.localConfig.connection.localPort;
                        #statTconParQdn.InterfaceId := #diagnostics.localConfig.connection.interfaceID;
                        #statTconParQdn.ID := #diagnostics.localConfig.connection.connectionID;
                    END_IF;
                    //If server
                ELSE
                    //Accept requests from all partners or only specified partner is allowed
                    IF (#diagnostics.localConfig.connection.acceptUnknownPartner) THEN
                        //Accept requests from all partners
                        //differ between different connection types (IPv4, QDN)
                        IF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4) THEN
                            #statTconPar.RemoteAddress.ADDR[1] := 0;
                            #statTconPar.RemoteAddress.ADDR[2] := 0;
                            #statTconPar.RemoteAddress.ADDR[3] := 0;
                            #statTconPar.RemoteAddress.ADDR[4] := 0;
                            #statTconPar.RemotePort := 0;
                        ELSE    //#CON_TYPE_QDN
                            #statTconParQdn.RemoteQDN := '';
                            #statTconParQdn.RemotePort := 0;
                        END_IF;
                    ELSE
                        //Only specified partner is allowed
                        //differ between different connection types (IPv4, QDN)
                        IF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4) THEN
                            #statTconPar.RemoteAddress := #diagnostics.localConfig.connection.partnerIP;
                            #statTconPar.RemotePort := #diagnostics.localConfig.connection.partnerPort;
                        ELSE    //#CON_TYPE_QDN
                            #statTconParQdn.RemoteQDN := #diagnostics.localConfig.connection.partnerQDN;
                            #statTconParQdn.RemotePort := #diagnostics.localConfig.connection.partnerPort;
                        END_IF;
                    END_IF;
                END_IF;
                
                //Check cycleTime
                IF ((#diagnostics.localConfig.sender.cycleTime >= T#0ms)
                    AND
                    (#diagnostics.localConfig.sender.cycleTime <= T#+24d20h31m23s647ms))
                THEN
                    ;//CycleTime --> OK
                ELSE
                    //CycleTime --> NOT OK
                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                    #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_SEND_CYCLE_TIME;
                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := #diagnostics.localConfig.sender.cycleTime;//value from operator
                    
                    #statState.connection := #ERROR_STATE;
                    GOTO ;
                END_IF;
                
                //With LCom header
                IF (#diagnostics.localConfig.connection.useLComProtocol) THEN
                    
                    //Check lifeSignCycleTime
                    IF ((#diagnostics.localConfig.connection.lifeSignCycleTime > T#0ms) //(1ms...T#+24d20h31m23s647ms)
                        AND
                        (#diagnostics.localConfig.connection.lifeSignCycleTime <= T#+24d20h31m23s647ms))
                    THEN
                        ;//lifeSignCycleTime--> OK
                    ELSE
                        //LifeSignCycle --> NOT OK
                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                        #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_LIFE_SIGN_CYCLE;
                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := #diagnostics.localConfig.connection.lifeSignCycleTime;//value from operator
                        
                        #statState.connection := #ERROR_STATE;
                        GOTO ;
                    END_IF;
                    
                    //Check ackTimeOut
                    IF ((#diagnostics.localConfig.sender.ackTimeout > T#0ms)
                        AND
                        (#diagnostics.localConfig.sender.ackTimeout <= T#+24d20h31m23s647ms))
                    THEN
                        ;//AckTimeOut --> OK
                    ELSE
                        //AckTimeOut --> NOT OK
                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                        #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_ACK_TIMEOUT;
                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := #diagnostics.localConfig.sender.ackTimeout;//value from operator
                        
                        #statState.connection := #ERROR_STATE;
                        GOTO ;
                    END_IF;
                    
                    //Check timeSync
                    IF (NOT #diagnostics.localConfig.timeSync.usePartnerTimestamps) THEN
                        
                        IF ((#diagnostics.localConfig.timeSync.sendMode >= 0)//(0...2)
                            AND
                            (#diagnostics.localConfig.timeSync.sendMode <= 2))
                        THEN
                            CASE (#diagnostics.localConfig.timeSync.sendMode) OF
                                    
                                1: //TimeSync.cycleTime
                                    IF ((#diagnostics.localConfig.timeSync.cycleTime > T#0ms) //(1ms...T#+24d20h31m23s647ms)
                                        AND
                                        (#diagnostics.localConfig.timeSync.cycleTime <= T#+24d20h31m23s647ms))
                                    THEN
                                        ;//CycleTime --> OK
                                    ELSE
                                        //CycleTime --> Not OK
                                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                        #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_TIME_CYCLE_TIME;
                                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := #diagnostics.localConfig.timeSync.cycleTime;//value from user
                                        
                                        #statState.connection := #ERROR_STATE;
                                        GOTO ;
                                        
                                    END_IF;
                                2://TimeSync.sendAtTimeOfDay
                                    IF ((#diagnostics.localConfig.timeSync.sendAtTimeOfDay >= TOD#00:00:00.000) //(TOD#00:00:00.000...TOD#23:59:59.999)
                                        AND
                                        #diagnostics.localConfig.timeSync.sendAtTimeOfDay <= TOD#23:59:59.999)
                                    THEN
                                        ;//SendAtTimeOfDay --> OK
                                    ELSE
                                        //SendAtTimeOfDay --> NOT OK
                                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                        #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_TIME_OF_DAY;
                                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                        
                                        #statState.connection := #ERROR_STATE;
                                        GOTO ;
                                    END_IF;
                                ELSE
                                    ;
                            END_CASE;
                        ELSE
                            //SendMode --> NOT OK
                            #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                            #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_TIME_SYNC_MODE;
                            #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := #diagnostics.localConfig.timeSync.sendMode;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                            
                            #statState.connection := #ERROR_STATE;
                            GOTO ;
                        END_IF;
                    ELSE
                        //usePartnerTimeStamp
                        
                        //Is sendMode inactive ?
                        IF #diagnostics.localConfig.timeSync.sendMode = 0 THEN
                            ;// Yes
                        ELSE
                            //SendMode --> NOT OK
                            #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                            #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_TIME_SYNC_MODE;
                            #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := #diagnostics.localConfig.timeSync.sendMode;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                            
                            #statState.connection := #ERROR_STATE;
                            GOTO ;
                        END_IF;
                        
                    END_IF;
                ELSE
                    ;//No LCom Protocol is used
                END_IF;
                
                //differ between different connection types (IPv4, QDN)
                IF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4) THEN
                    //IPv4
                    #instTCON(REQ := FALSE,
                              ID := #statTconPar.ID,
                              CONNECT := #statTconPar);
                    //store connection ID temporary
                    #tempConnOucId := #statTconPar.ID;
                ELSE
                    //QDN (CON_TYPE_QDN)
                    #instTCON(REQ := FALSE,
                              ID := #statTconParQdn.ID,
                              CONNECT := #statTconParQdn);
                    //store connection ID temporary
                    #tempConnOucId := #statTconParQdn.ID;
                END_IF;
                
                #instTSEND(REQ := FALSE,
                           ID := #tempConnOucId,
                           DATA := #statSend.tsendFct.data);
                
                #instTRCV(EN_R := FALSE,
                          ID := #tempConnOucId,
                          DATA := #statReceive.trcvFct.data);
                
                #instTDISCON(REQ := FALSE,
                             ID := #tempConnOucId);
                
                //Passive (server), active connection establishment (client)
                IF (#diagnostics.localConfig.connection.isClient) THEN
                    #statState.connection := #OPEN_CLIENT;
                    #statTconPar.ActiveEstablished := TRUE;
                    #statTconParQdn.ActiveEstablished := TRUE;
                ELSE
                    #statState.connection := #OPEN_SERVER;
                    #statTconPar.ActiveEstablished := FALSE;
                    #statTconParQdn.ActiveEstablished := FALSE;
                END_IF;
            END_REGION INIT
            
        #OPEN_CLIENT, #OPEN_SERVER:
            REGION OPEN_CLIENT_SERVER
                #instTCON.STATUS := 16#0000;
                
                //differ between different connection types (IPv4, QDN)
                IF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4) THEN
                    //IPv4
                    #instTCON(REQ := TRUE,
                              CONNECT := #statTconPar,
                              ID := #diagnostics.localConfig.connection.connectionID);
                ELSE
                    //QDN (CON_TYPE_QDN)
                    #instTCON(REQ := TRUE,
                              CONNECT := #statTconParQdn,
                              ID := #diagnostics.localConfig.connection.connectionID);
                END_IF;
                
                // Error occurred
                IF (#instTCON.ERROR) THEN
                    
                    //Local port is being used by the system
                    IF (#instTCON.STATUS = 16#80A2 OR (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4 AND #statTconPar.LocalPort = 16#0)) THEN
                        
                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                        #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_LOCAL_PORT;
                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := #instTCON.STATUS;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := #statTconPar.LocalPort;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                        
                        #statState.connection := #ERROR_STATE;
                        GOTO ;
                        //Local port is being used by the system (in case of QDN)
                    ELSIF (#instTCON.STATUS = 16#80A2 OR (#diagnostics.localConfig.connection.connectType = #CON_TYPE_QDN AND #statTconParQdn.LocalPort = 16#0)) THEN
                        
                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                        #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_LOCAL_PORT;
                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := #instTCON.STATUS;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := #statTconParQdn.LocalPort;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                        
                        #statState.connection := #ERROR_STATE;
                        GOTO ;
                    ELSIF (#instTCON.STATUS = 16#80B7 OR #instTCON.STATUS = 16#80A4) THEN
                        //IP address of the remote partner is invalid
                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                        #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_PARTNER_IP;
                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := #instTCON.STATUS;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                        
                        #statState.connection := #ERROR_STATE;
                        GOTO ;
                    ELSIF (#instTCON.STATUS = 16#809B) THEN
                        //The local_device_id in the connection description does not match the CPU
                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                        #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_INTERFACE_ID;
                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := #instTCON.STATUS;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := UINT_TO_REAL(#diagnostics.localConfig.connection.interfaceID);//value from user
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                        
                        #statState.connection := #ERROR_STATE;
                        GOTO ;
                    ELSE
                        IF (#statState.connection = #OPEN_CLIENT) THEN
                            
                            #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                            #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_OPEN_CLIENT;
                            #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := #instTCON.STATUS;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                            
                            //Try reconnection after a wait time
                            #statIterator := 0;
                            #statState.connection := #STATE_WAIT;
                        ELSE
                            #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                            #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_OPEN_SERVER;
                            #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := #instTCON.STATUS;
                            //differ between different connection types (IPv4, QDN)
                            IF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4) THEN
                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := #statTconPar.LocalPort;
                            ELSE    //CON_TYPE_QDN
                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := #statTconParQdn.LocalPort;
                            END_IF;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                            
                            //Try reconnection after a wait time
                            #statIterator := 0;
                            #statState.connection := #STATE_WAIT;
                        END_IF;
                    END_IF;
                    //Job completed without error
                ELSIF (#instTCON.DONE) THEN
                    
                    //Connection successfully established
                    #diagnostics.statistics.totalReconnects := #diagnostics.statistics.totalReconnects + 1;
                    #statState.connection := #OPERATION;
                    
                    #error := FALSE;
                    
                    //Reset all state machines
                    #statState.receiver := #READ;
                    #statState.sender := #STATE_INACTIVE;
                    #statState.comReceiver := #EXPECTED;
                    #statState.comSender := #STATE_INACTIVE;
                    //Receive
                    #statReceive.trcvFct.dataOffset := 0;
                    #statReceive.trcvFct.dataLength := 0;
                    #statReceive.trcvFct.dataLengthRest := 0;
                    #statReceive.trcvFct.dataReceived := FALSE;
                    #statReceive.tempTelegram.index := 0;
                    #statReceive.tempTelegram.telegramType := 0;
                    #statReceive.numberOfLComHeader := 0;
                    #statReceive.dataTelegram.totalMessageLength := 0;
                    #statReceive.dataTelegram.actPackageLength := 0;
                    #statReceive.dataTelegram.ackMessageOffset := 0;
                    #statReceive.dataTelegram.messageOffset := 0;
                    #statReceive.dataTelegram.ackMessageCounter := 0;
                    #statReceive.dataTelegram.messageCounter := 0;
                    #statReceive.userData.totalLength := 0;
                    #statReceive.userData.offset := 0;
                    //Send
                    #statSend.tsendFct.dataLengthRest := 0;
                    #statSend.tsendFct.dataOffset := 0;
                    #statSend.tsendFct.status := 16#0000;
                    #statSend.expectedAck.package1.offset := 0;
                    #statSend.dataTelegram.messageCounter := 0;
                    #statSend.dataTelegram.ackMessageCounter := 0;
                    #statSend.dataTelegram.messageOffset := 0;
                    #statSend.dataTelegram.ackMessageOffset := 0;
                    #statSend.dataTelegram.actPackageLength := 0;
                    #statSend.dataTelegram.totalMessageLength := 0;
                    #statSend.numberOfLComPackage := 0;
                    #statSend.userData.totalLength := 0;
                    #statSend.userData.offset := 0;
                    #statSend.userData.sendCycleViolation := FALSE;
                    #statOldSend := FALSE;
                    
                    #diagnostics.statistics.maxMsgSendingTime := T#0ms;
                    #diagnostics.localConfig.sender.cycleTime := T#0ms;
                    #diagnostics.localConfig.sender.ackTimeout := T#0ms;
                    
                    #diagnostics.statistics.lastTimeSync.YEAR := 2200;
                    #statCopyNBytes := 0;
                    
                    //Reset all timer
                    #instLocalLifeSignCycleTimer(IN := FALSE,
                                                 PT := #diagnostics.localConfig.connection.lifeSignCycleTime);
                    
                    #instPartnerLifeSignCycleTimer(IN := FALSE,
                                                   PT := (#diagnostics.partnerConfig.connnection.lifeSignCycleTime));
                    
                    #instLocalCycleTimeTimer(IN := FALSE,
                                             PT := #diagnostics.localConfig.sender.cycleTime);
                    
                    #instExpectedAckPackage1(IN := FALSE,
                                             PT := #diagnostics.localConfig.sender.ackTimeout);
                    
                    #instSyncTimer(IN := FALSE,
                                   PT := T#1s);
                    
                    #instSendErrorTimer(IN := FALSE,
                                        PT := #MAX_TRIAL_TIME);
                    
                    #instRcvErrorTimer(IN := FALSE,
                                       PT := #MAX_TRIAL_TIME);
                    
                    //Reset all active failures in the diagnostics buffer
                    FOR #statIterator := 0 TO #DIAG_BUFFER_UPPER_LIM BY 1 DO
                        #diagnostics.buffer[#statIterator].isActive := FALSE;
                    END_FOR;
                    
                    //With LCom protocol
                    IF (#diagnostics.localConfig.connection.useLComProtocol = TRUE) THEN
                        
                        IF (#statConnectAttempts MOD 2 = 0) THEN
                            //1st try LCom Version 2.0
                            #statActualLocalLComVersion := #HEADER_V2;
                            #statSend.configTelegramV2.LComVersion := #HEADER_V2;
                            #statSend.configTelegramV2.status := BOOL_TO_BYTE(#diagnostics.localConfig.timeSync.usePartnerTimestamps);
                            #statSend.configTelegramV2.sendModeSyncTime := #diagnostics.localConfig.timeSync.sendMode;
                            #statSend.configTelegramV2.lifeSignCycle := #diagnostics.localConfig.connection.lifeSignCycleTime;
                            #statSend.configTelegramV2.cycleTime := #configuration.sender.cycleTime;
                            #statSend.configTelegramV2.ackTimeOut := #configuration.sender.ackTimeout;
                            #statSend.configTelegramV2.maxSendDataLength := #diagnostics.localConfig.sizeOfSendBuffer;
                            #statSend.configTelegramV2.maxReceiveDataLength := #diagnostics.localConfig.sizeOfReceiveBuffer;
                            
                            #statSend.dataTelegram.LComVersion := #statSend.configTelegramV2.LComVersion;
                        ELSE
                            //2nd try LCom Version 1.0
                            #statActualLocalLComVersion := #HEADER_V1;
                            #statSend.configTelegramV1.LComVersion := #HEADER_V1;
                            #statSend.configTelegramV1.comMode := 16#03;
                            #statSend.configTelegramV1.slidingWindow := 1;
                            #statSend.configTelegramV1.status := BOOL_TO_BYTE(#diagnostics.localConfig.timeSync.usePartnerTimestamps);
                            #statSend.configTelegramV1.sendModeSyncTime := #diagnostics.localConfig.timeSync.sendMode;
                            
                            #statSend.dataTelegram.LComVersion := #statSend.configTelegramV1.LComVersion;
                            
                            //Check max. lifeSignCycleTime
                            IF (#diagnostics.localConfig.connection.lifeSignCycleTime > T#65535ms) THEN
                                
                                #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := #diagnostics.localConfig.connection.lifeSignCycleTime;
                                #diagnostics.localConfig.connection.lifeSignCycleTime := T#65535ms;
                                
                                #statDiag.buffer[#statDiag.bufferIndex].status := #WARN_LIFE_SIGN_LIMITATION;
                                #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 65535.0;
                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                            ELSE
                                ;
                            END_IF;
                            #statSend.configTelegramV1.lifeSignCycle := TIME_TO_UINT(#diagnostics.localConfig.connection.lifeSignCycleTime);
                            
                            //Check max.sizeOfSendBuffer
                            IF (#diagnostics.localConfig.sizeOfSendBuffer > 65535) THEN
                                #diagnostics.localConfig.sizeOfSendBuffer := 65535;
                                #statSend.configTelegramV1.maxSendDataLength := 65535;
                            ELSE
                                #statSend.configTelegramV1.maxSendDataLength := UDINT_TO_UINT(#diagnostics.localConfig.sizeOfSendBuffer);
                            END_IF;
                            
                            //Check max.sizeOfReceiveBuffer
                            IF (#diagnostics.localConfig.sizeOfReceiveBuffer > 65535) THEN
                                #diagnostics.localConfig.sizeOfReceiveBuffer := 65535;
                                #statSend.configTelegramV1.maxReceiveDataLength := 65535;
                            ELSE
                                #statSend.configTelegramV1.maxReceiveDataLength := UDINT_TO_UINT(#diagnostics.localConfig.sizeOfReceiveBuffer);
                            END_IF;
                            
                        END_IF;
                        //Set telegram type of data telegrams for LCom Version 1.0 and 2.0
                        #statSend.dataTelegram.telegramType := 16#0A;
                        
                        //Start sender config directly with LCom protocol
                        #statState.cfgSender := #STATE_INIT;
                    ELSE
                        //without LCom
                        #statCompare.sender.cycleTime := #configuration.sender.cycleTime;
                        #diagnostics.localConfig.sender.cycleTime := #configuration.sender.cycleTime;
                        
                        #diagnostics.partnerConfig.sizeOfReceiveBuffer := 0;
                        #diagnostics.partnerConfig.sizeOfSendBuffer := 0;
                        #connected := #statConnected := TRUE;
                        #statState.cfgSender := #OPERATION;
                        
                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                        #statDiag.buffer[#statDiag.bufferIndex].status := #STATUS_TCP_CONNECTED;
                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                    END_IF;
                    //TCON still in progress
                ELSE
                    IF (#diagnostics.localConfig.connection.isClient) THEN
                        
                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                        #statDiag.buffer[#statDiag.bufferIndex].status := #STATUS_CLIENT_TRY_CONNECT;
                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                    ELSE
                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                        #statDiag.buffer[#statDiag.bufferIndex].status := #STATUS_SERVER_PORT_OPEN;
                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                    END_IF;
                END_IF;
            END_REGION OPEN_CLIENT_SERVER
            
        #STATE_WAIT:
            REGION WAIT
                //Wait and then establish the connection
                IF (#statIterator > #STATE_WAIT) THEN
                    
                    #tempConnOucId := 0;
                    
                    //differ between different connection types (IPv4, QDN)
                    IF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4) THEN
                        //IPv4
                        #instTCON(REQ := FALSE,
                                  ID := #statTconPar.ID,
                                  CONNECT := #statTconPar);
                        //store connection ID temporary
                        #tempConnOucId := #statTconPar.ID;
                    ELSE
                        //QDN (CON_TYPE_QDN)
                        #instTCON(REQ := FALSE,
                                  ID := #statTconParQdn.ID,
                                  CONNECT := #statTconParQdn);
                        //store connection ID temporary
                        #tempConnOucId := #statTconParQdn.ID;
                    END_IF;
                    
                    #instTSEND(REQ := FALSE,
                               ID := #tempConnOucId,
                               DATA := #statSend.tsendFct.data);
                    
                    #instTRCV(EN_R := FALSE,
                              ID := #tempConnOucId,
                              DATA := #statReceive.trcvFct.data);
                    
                    #instTDISCON(REQ := FALSE,
                                 ID := #tempConnOucId);
                    
                    IF (#diagnostics.localConfig.connection.isClient) THEN
                        #statState.connection := #OPEN_CLIENT;
                        #statTconPar.ActiveEstablished := TRUE;
                        #statTconParQdn.ActiveEstablished := TRUE;
                    ELSE
                        #statState.connection := #OPEN_SERVER;
                        #statTconPar.ActiveEstablished := FALSE;
                        #statTconParQdn.ActiveEstablished := FALSE;
                    END_IF;
                    
                ELSE
                    #statIterator := #statIterator + 1;
                END_IF;
            END_REGION WAIT
            
        #FINISH_TSEND:
            REGION FINISH_TSEND
                IF (#statIterator > #STATE_WAIT) THEN
                    #statIterator := 0;
                    #statState.connection := #FINISH_TRCV;
                ELSE
                    //differ between different connection types (IPv4, QDN)
                    IF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4) THEN
                        #tempConnOucId := #statTconPar.ID;
                    ELSE    //CON_TYPE_QDN
                        #tempConnOucId := #statTconParQdn.ID;
                    END_IF;
                    
                    #instTSEND(REQ := TRUE,
                               LEN := #statSend.tsendFct.dataOffset,
                               ID := #tempConnOucId,
                               DATA := #statSend.tsendFct.data,
                               STATUS => #statSend.tsendFct.status);
                    
                    IF ((#statSend.tsendFct.status = 16#0000) OR (#instTSEND.ERROR)) THEN
                        //"TSEND" instruction is finished
                        #statState.connection := #FINISH_TRCV;
                    ELSE
                        ;//"TSEND" instruction still in process
                    END_IF;
                END_IF;
                #statIterator := #statIterator + 1;
            END_REGION FINISH_TSEND
            
        #FINISH_TRCV:
            REGION FINISH_TRCV
                
                IF (#statIterator > #STATE_WAIT) THEN
                    #statState.connection := #CALL_TDISCON;
                ELSE
                    //differ between different connection types (IPv4, QDN)
                    IF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4) THEN
                        #tempConnOucId := #statTconPar.ID;
                    ELSE    //CON_TYPE_QDN
                        #tempConnOucId := #statTconParQdn.ID;
                    END_IF;
                    
                    #instTRCV(EN_R := TRUE,
                              ID := #tempConnOucId,
                              LEN := 0,
                              ADHOC := TRUE,
                              NDR => #statReceive.trcvFct.dataReceived,
                              RCVD_LEN => #statReceive.trcvFct.dataLength,
                              DATA := #statReceive.trcvFct.data);
                    
                    //Is the "TRCV" instruction still in process
                    IF (#instTRCV.ERROR OR NOT #instTRCV.BUSY) THEN
                        #statState.connection := #CALL_TDISCON;
                    ELSE
                        ;//TRCV instruction still in process
                    END_IF;
                END_IF;
                #statIterator := #statIterator + 1;
            END_REGION FINISH_TRCV
            
        #CLOSE_CONNECTION:
            REGION CLOSE_CONNECTION
                //reset FB Outputs
                #connected := #statConnected := FALSE;
                #sending := #statSending := FALSE;
                #receivedDataLength := 0;
                #error := FALSE;
                
                //Is "TSEND" instruction still in process ?
                IF (#statSend.tsendFct.status <> 16#0000) THEN
                    //"TSEND" instruction still in process
                    #statState.connection := #FINISH_TSEND;
                    #statIterator := 0;
                ELSE
                    ;//"TSEND" instruction is finished
                END_IF;
                
                #instTRCV(EN_R := TRUE,
                          ID := #diagnostics.localConfig.connection.connectionID,
                          LEN := 0,
                          ADHOC := TRUE,
                          NDR => #statReceive.trcvFct.dataReceived,
                          RCVD_LEN => #statReceive.trcvFct.dataLength,
                          DATA := #statReceive.trcvFct.data);
                
                //Is the "TRCV" instruction still in process
                IF (#instTRCV.ERROR OR NOT #instTRCV.BUSY) THEN
                    #statState.connection := #CALL_TDISCON;
                ELSE
                    #statState.connection := #FINISH_TRCV;
                    #statIterator := 0;
                END_IF;
            END_REGION CLOSE_CONNECTION
            
        #CALL_TDISCON:
            REGION CALL_TDISCON
                //differ between different connection types (IPv4, QDN)
                IF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4) THEN
                    #tempConnOucId := #statTconPar.ID;
                ELSE    //CON_TYPE_QDN
                    #tempConnOucId := #statTconParQdn.ID;
                END_IF;
                
                #instTSEND(REQ := FALSE,
                           LEN := #statSend.tsendFct.dataOffset,
                           ID := #tempConnOucId,
                           DATA := #statSend.tsendFct.data);
                
                #instTRCV(EN_R := FALSE,
                          ID := #diagnostics.localConfig.connection.connectionID,
                          LEN := 0,
                          ADHOC := TRUE,
                          NDR => #statReceive.trcvFct.dataReceived,
                          RCVD_LEN => #statReceive.trcvFct.dataLength,
                          DATA := #statReceive.trcvFct.data);
                
                #instTDISCON(REQ := TRUE,
                             ID := #tempConnOucId);
                
                //Error occurred during processing
                IF (#instTDISCON.ERROR) THEN
                    
                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                    #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_CLOSE_CONNECTION;
                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := #instTDISCON.STATUS;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                    
                    #statState.connection := #STATE_INACTIVE_PREPARE;
                    
                    #instTDISCON(REQ := FALSE,
                                 ID := #tempConnOucId);
                    
                ELSIF (#instTDISCON.DONE) THEN
                    
                    #instTDISCON(REQ := FALSE,
                                 ID := #tempConnOucId);
                    //Job executed without errors
                    IF (#enable AND (NOT #statFallingEdgeEnable)) THEN
                        //Reconnect automatically if not in disconnecting process
                        #statIterator := 0;
                        #statState.connection := #STATE_WAIT;
                    ELSE
                        //Reset all active failures in the diagnostics buffer
                        FOR #statIterator := 0 TO #DIAG_BUFFER_UPPER_LIM BY 1 DO
                            #diagnostics.buffer[#statIterator].isActive := FALSE;
                        END_FOR;
                        
                        #statState.connection := #STATE_INACTIVE_PREPARE;
                    END_IF;
                    //Job is not completed yet
                ELSE
                    ;//Wait until job is finished
                END_IF;
            END_REGION CALL_TDISCON
            
        #ERROR_STATE:
            REGION ERROR
                ;
            END_REGION ERROR
    END_CASE;
END_REGION STATE_MACHINE

REGION DIAGNOSTICS
    // -----------------------------------------------------------------------------------------------------------
    //Diagnostics buffer
    // -----------------------------------------------------------------------------------------------------------
:
    //Diagnostics entry is in the temp. buffer
    IF (#statDiag.bufferIndex <> -1) THEN
        
        //Get current time
        #statRet := RD_LOC_T(#tempActTime);
        //init
        #statDiag.actualIndex := 0;
        
        WHILE (#statDiag.actualIndex <= #statDiag.bufferIndex) DO
            
            #tempUDint := 0;
            //Check if the failure is already in the buffer and still active
            FOR #statIterator := 0 TO #DIAG_BUFFER_UPPER_LIM BY 1 DO
                
                IF (#diagnostics.buffer[#statIterator].isActive = TRUE) THEN
                    
                    IF ((#statDiag.buffer[#statDiag.actualIndex].status = #WARN_SEND_CYCLE_EXPIRED)
                        AND
                        (#diagnostics.buffer[#statIterator].status = #WARN_SEND_CYCLE_EXPIRED)
                        AND
                        (#diagnostics.buffer[#statIterator].additionalValue1 = #statDiag.buffer[#statDiag.actualIndex].additionalValue1)
                        AND
                        (#diagnostics.buffer[#statIterator].additionalValue2 = #statDiag.buffer[#statDiag.actualIndex].additionalValue2)
                        AND
                        (#diagnostics.buffer[#statIterator].additionalValue3 = #statDiag.buffer[#statDiag.actualIndex].additionalValue3)) THEN
                        //Retrigger just the activation time
                        #diagnostics.buffer[#statIterator].timestamp := #tempActTime;
                        #diagnostics.buffer[#statIterator].additionalValue4 := #statDiag.buffer[#statDiag.actualIndex].additionalValue4;
                        #tempUDint := 100;
                        EXIT;
                    ELSIF ((#diagnostics.buffer[#statIterator].status = #statDiag.buffer[#statDiag.actualIndex].status)
                        AND
                        (#diagnostics.buffer[#statIterator].additionalValue1 = #statDiag.buffer[#statDiag.actualIndex].additionalValue1)
                        AND
                        (#diagnostics.buffer[#statIterator].additionalValue2 = #statDiag.buffer[#statDiag.actualIndex].additionalValue2)
                        AND
                        (#diagnostics.buffer[#statIterator].additionalValue3 = #statDiag.buffer[#statDiag.actualIndex].additionalValue3)
                        AND
                        (#diagnostics.buffer[#statIterator].additionalValue4 = #statDiag.buffer[#statDiag.actualIndex].additionalValue4)) THEN
                        //Retrigger just the activation time
                        #diagnostics.buffer[#statIterator].timestamp := #tempActTime;
                        #tempUDint := 100;
                        EXIT;
                    ELSE
                        ;//ErrorId is not in the diagnostics buffer
                    END_IF;
                END_IF;
            END_FOR;
            
            IF (#tempUDint = 100) THEN
                ;//ErrorId was already retriggered
            ELSE
                //Check range of diagnostics ring buffer [0...DIAG_ARRAY]
                IF ((#diagnostics.bufferIndex = 255) OR (#diagnostics.bufferIndex = #DIAG_BUFFER_UPPER_LIM)) THEN
                    #diagnostics.bufferIndex := 0;
                ELSE
                    #diagnostics.bufferIndex := #diagnostics.bufferIndex + 1;
                END_IF;
                
                //Stored new entry in the diagnostics buffer
                #diagnostics.buffer[#diagnostics.bufferIndex].status := #statDiag.buffer[#statDiag.actualIndex].status;
                #diagnostics.buffer[#diagnostics.bufferIndex].timestamp := #tempActTime;
                #diagnostics.buffer[#diagnostics.bufferIndex].isActive := TRUE;
                
                #diagnostics.buffer[#diagnostics.bufferIndex].subFunctionErrorID := #statDiag.buffer[#statDiag.actualIndex].subFunctionErrorID;
                #diagnostics.buffer[#diagnostics.bufferIndex].additionalValue1 := #statDiag.buffer[#statDiag.actualIndex].additionalValue1;
                #diagnostics.buffer[#diagnostics.bufferIndex].additionalValue2 := #statDiag.buffer[#statDiag.actualIndex].additionalValue2;
                #diagnostics.buffer[#diagnostics.bufferIndex].additionalValue3 := #statDiag.buffer[#statDiag.actualIndex].additionalValue3;
                #diagnostics.buffer[#diagnostics.bufferIndex].additionalValue4 := #statDiag.buffer[#statDiag.actualIndex].additionalValue4;
            END_IF;
            
            IF ((#diagnostics.buffer[#diagnostics.bufferIndex].status = #STATUS_TCP_CONNECTED)
                OR (#diagnostics.buffer[#diagnostics.bufferIndex].status = #STATUS_CONNECTED_V1)
                OR (#diagnostics.buffer[#diagnostics.bufferIndex].status = #STATUS_CONNECTED_V2))
            THEN
                #statConnectAttempts := 0;
                #diagnostics.statistics.lastConnect := #tempActTime;
            END_IF;
            
            //Set FB status
            #status := #statStatus := #statDiag.buffer[#statDiag.actualIndex].status;
            
            //Check if FB.error has been set ?
            IF ((#statDiag.buffer[#statDiag.actualIndex].status >= #ERR_COM_SERVICE)//16#8200
                AND
                (#statDiag.buffer[#statDiag.actualIndex].status <= #ERR_WRONG_TELEGRAM_ID))//16#8614
            THEN
                
                #error := TRUE;
                #connected := #statConnected := FALSE;
                #sending := #statSending := FALSE;
                #dataReceived := #statDataReceived := FALSE;
                #receivedDataLength := 0;
                
                //Check if FB.busy has been set ?
                IF ((#statDiag.buffer[#statDiag.actualIndex].status >= #ERR_OPEN_CLIENT)//16#8600
                    AND
                    (#statDiag.buffer[#statDiag.actualIndex].status <= #ERR_WRONG_TELEGRAM_ID))//16#8614
                THEN
                    #busy := TRUE;
                ELSE
                    #busy := FALSE;
                END_IF;
                
                EXIT;//Leave loop
            ELSE
                ;
            END_IF;
            
            //Increase index
            #statDiag.actualIndex := #statDiag.actualIndex + 1;
            
        END_WHILE;
    ELSE
        ;//No failure
    END_IF;//End: Diagnostics buffer
END_REGION DIAGNOSTICS
END_FUNCTION_BLOCK