FUNCTION_BLOCK "LCom_Communication_FB"   // FB 30300, author APC_ERLF

VAR_INPUT
   enable : Bool := FALSE;   // Starts the FB with a rising edge
   send : Bool := FALSE;   // Send data connected to input parameter sendBuffer
   sendDataLength : UDInt := 16#FFFF_FFFF;   // Length of data to be sent in Bytes
   readDataLength : UDInt := 16#FFFF_FFFF;   // Receving property: 0 = data from TCP buffer is not read, > 0 = see documentation
   configuration : "LCom_typeConfig";   // FB configuration
END_VAR

VAR_OUTPUT
   connected : Bool := FALSE;   // Connection to partner is established
   sending : Bool := FALSE;   // Send data connected to input parameter sendBuffer
   dataReceived : Bool := FALSE;   // New data received
   receivedDataLength : UDInt;   // Length of received data in Bytes
   busy : Bool;   // Processing is executed automatically
   error : Bool := FALSE;   // An error occured
   status : Word := 16#7000;   // FB status
END_VAR

VAR_IN_OUT
   sendBuffer : Variant;   // Data to be sent (Array of Byte)
   receiveBuffer : Variant;   // Data received (Array of Byte)
   diagnostics : "LCom_typeDiagnostics";   // Diagnostics
END_VAR

VAR
   statConnectAttempts : SInt;
   statActualLocalLComVersion : USInt;
   statRuntimeTask : LReal;
   statCopyNBytes : UDInt;
   statMaxActPacketLength : UDInt;
   statState : Struct
      connection : USInt := 0;
      cfgSender : USInt;
      comSender : USInt;
      comReceiver : USInt;
      sender : USInt;
      receiver : USInt;
   END_STRUCT;
   statReceive : Struct
      tempTelegram : Struct
         LComVersion : USInt;
         index : USInt;
         telegramType : USInt;
         data : Array[0..23] of Byte;
      END_STRUCT;
      configTelegramV1 : Struct
         LComVersion : USInt;
         telegramType : USInt;
         comMode : USInt;
         slidingWindow : USInt;
         cycleTime : UInt;
         ackTimeOut : UInt;
         lifeSignCycle : UInt;
         status : USInt;
         sendModeSyncTime : USInt;
         maxSendDataLength : UInt;
         maxReceiveDataLength : UInt;
      END_STRUCT;
      configTelegramV2 : Struct
         LComVersion : USInt;
         telegramType : USInt;
         status : USInt;
         sendModeSyncTime : USInt;
         lifeSignCycle : Time;
         cycleTime : Time;
         ackTimeOut : Time;
         maxSendDataLength : UDInt;
         maxReceiveDataLength : UDInt;
      END_STRUCT;
      dataTelegram : Struct
         LComVersion : USInt;
         telegramType : USInt;
         messageCounter : USInt;
         ackMessageCounter : USInt;
         messageOffset : UDInt;
         ackMessageOffset : UDInt;
         actPackageLength : UDInt;
         totalMessageLength : UDInt;
      END_STRUCT;
      userData : Struct
         totalLength : UDInt;
         offset : UDInt;
      END_STRUCT;
      trcvFct : Struct
         data : Array[0..4095] of Byte;
         dataOffset : UDInt;
         dataLength : UDInt;
         dataLengthRest : UDInt;
         dataReceived : Bool := FALSE;
      END_STRUCT;
      numberOfLComHeader : USInt;
   END_STRUCT;
   statSend : Struct
      configTelegramV1 : Struct
         LComVersion : USInt;
         comMode : USInt;
         slidingWindow : USInt;
         cycleTime : UInt;
         ackTimeOut : UInt;
         lifeSignCycle : UInt;
         status : USInt;
         sendModeSyncTime : USInt;
         maxSendDataLength : UInt;
         maxReceiveDataLength : UInt;
      END_STRUCT;
      configTelegramV2 : Struct
         LComVersion : USInt;
         status : USInt;
         sendModeSyncTime : USInt;
         lifeSignCycle : Time;
         cycleTime : Time;
         ackTimeOut : Time;
         maxSendDataLength : UDInt;
         maxReceiveDataLength : UDInt;
      END_STRUCT;
      dataTelegram : Struct
         LComVersion : USInt;
         telegramType : USInt;
         messageCounter : USInt;
         ackMessageCounter : USInt;
         messageOffset : UDInt;
         ackMessageOffset : UDInt;
         actPackageLength : UDInt;
         totalMessageLength : UDInt;
      END_STRUCT;
      userData : Struct
         totalLength : UDInt;
         offset : UDInt;
         sendCycleViolation : Bool;
      END_STRUCT;
      tsendFct : Struct
         dataLengthRest : UInt;
         data : Array[0..4095] of Byte;
         dataOffset : UInt;
         status : Word;
         enable : Bool := FALSE;
      END_STRUCT;
      expectedAck : Struct
         package1 : Struct
            offset : UDInt;
         END_STRUCT;
      END_STRUCT;
      numberOfLComPackage : USInt;
   END_STRUCT;
   statIterator : Int;
   statOldEnable : Bool := FALSE;
   statOldSend : Bool := FALSE;
   statRisingEdgeSend : Bool;
   statFallingEdgeEnable : Bool;
   statRet : Int := -1;
   statCompare : Struct
      sender : Struct
         cycleTime : Time;
         ackTimeOut : Time;
      END_STRUCT;
   END_STRUCT;
   statTconPar : TCON_IP_v4;
   statTconParQdn : TCON_QDN;
   instTCON : TCON;
   instTDISCON : TDISCON;
   instTRCV : TRCV;
   instTSEND : TSEND;
   instLocalLifeSignCycleTimer : TON_TIME;
   instPartnerLifeSignCycleTimer : TON_TIME;
   instLocalCycleTimeTimer : TON_TIME;
   instReceiveMsgCycle : TON_TIME;
   instExpectedAckPackage1 : TON_TIME;
   instMsgSendingTimer : TON_TIME;
   instMsgReceivingTimer : TON_TIME;
   instSyncTimer : TON_TIME;
   instSendErrorTimer : TON_TIME;
   instRcvErrorTimer : TON_TIME;
   instRDREC : RDREC;
   statDiag : Struct
      buffer : Array[0..9] of Struct;
      bufferIndex : Int := -1;
      actualIndex : USInt;
   END_STRUCT;
   statDataReceived : Bool;
   statConnected : Bool;
   statStatus : Word;
   statSending : Bool;
END_VAR

VAR_TEMP
   tempRuntime : Real;
   tempActTime : DTL;
   tempUDint : UDInt;
   tempDWord : DWord;
   tempConnOucId : CONN_OUC;
END_VAR

VAR CONSTANT
   LIFE_SIGN_FACTOR : UInt := 4;
   DIAG_BUFFER_UPPER_LIM : SInt := 63;
   MAX_DATA_BUFFER : Word := 4096;
   HEADER_V1 : USInt := 16#10;
   HEADER_V2 : USInt := 16#20;
   MAX_TRIAL_TIME : Time := T#200MS;
   CON_TYPE_IPV4 : USInt := 1;
   CON_TYPE_QDN : USInt := 10;
   STATE_INACTIVE : USInt;
   STATE_INACTIVE_PREPARE : USInt := 1;
   STATE_INIT : USInt := 2;
   OPEN_SERVER : USInt := 3;
   OPEN_CLIENT : USInt := 4;
   OPERATION : USInt := 5;
   FINISH_TSEND : USInt := 6;
   FINISH_TRCV : USInt := 7;
   CALL_TDISCON : USInt := 8;
   CLOSE_CONNECTION : USInt := 9;
   SEND_CONFIG : USInt := 20;
   SEND_DATA : USInt := 30;
   CYCLE : USInt := 31;
   SEND_NO_DATA : USInt := 38;
   NO_CALL_TRCV : USInt := 40;
   READ : USInt := 50;
   NO_DATA_RECEIVED : USInt := 51;
   DATA_RECEIVED : USInt := 52;
   EXPECTED : USInt := 53;
   DATA_EXPECTED : USInt := 54;
   WAIT_ACK_TELEGRAM : USInt := 55;
   ACK_TELEGRAM : USInt := 56;
   STATE_WAIT : USInt := 60;
   ERROR_STATE : USInt := 99;
   WARN_RECEIVE_BUFFER_LEN : Word := 16#7614;
   ERR_LIFE_SIGN_CYCLE : Word := 16#8210;
   ERR_OPEN_SERVER : Word := 16#8601;
   STATUS_CONNECTED_V1 : Word := 16#7006;
   ERR_COM_SERVICE : Word := 16#8200;
   ERR_ACK_TIMEOUT : Word := 16#8212;
   STATUS_NO_CALL : Word := 16#7000;
   WARN_ACK_TIMEOUT_LIMITATION : Word := 16#7612;
   ERR_WRONG_HEADER : Word := 16#8613;
   ERR_TIME_SYNC_MODE : Word := 16#8205;
   WARN_SEND_CYCLE_EXPIRED : Word := 16#7613;
   STATUS_FIRST_CALL : Word := 16#7001;
   ERR_PARTNER_IP : Word := 16#8204;
   ERR_ACK_MESSAGE_NUMBER : Word := 16#8612;
   ERR_WRONG_TELEGRAM_ID : Word := 16#8614;
   ERR_CONNECTION_ID : Word := 16#8201;
   STATUS_TCP_CONNECTED : Word := 16#7005;
   WARN_LIFE_SIGN_LIMITATION : Word := 16#7610;
   ERR_ACK_TIMEOUT_EXPIRED : Word := 16#8611;
   ERR_SEND_DATA_TYPE : Word := 16#8208;
   ERR_INTERFACE_ID : Word := 16#8202;
   WARN_NO_TIME_SYNC : Word := 16#7615;
   ERR_RECEIVE : Word := 16#8603;
   STATUS_DISCONNECTING : Word := 16#7008;
   STATUS_CLIENT_TRY_CONNECT : Word := 16#7003;
   STATUS_CONNECTED_V2 : Word := 16#7007;
   ERR_RECEIVE_DATA_TYPE : Word := 16#8209;
   ERR_OPEN_CLIENT : Word := 16#8600;
   ERR_LOCAL_PORT : Word := 16#8203;
   ERR_TIME_CYCLE_TIME : Word := 16#8206;
   WARN_SEND_DATA_LENGTH : Word := 16#7600;
   WARN_SEND_CYCLE_LIMITATION : Word := 16#7611;
   ERR_SEND_CYCLE_TIME : Word := 16#8211;
   STATUS_INTERMEDIATE_CALL : Word := 16#7002;
   ERR_SEND : Word := 16#8602;
   ERR_TIME_OF_DAY : Word := 16#8207;
   STATUS_SERVER_PORT_OPEN : Word := 16#7004;
   ERR_LIFE_SIGN_EXPIRED : Word := 16#8610;
   ERR_CLOSE_CONNECTION : Word := 16#8604;
   ERR_CONNECTION_TYPE : Word := 16#8213;
END_VAR

BEGIN
REGION BLOCK INFO HEADER
    //=============================================================================
    // SIEMENS AG / (c)Copyright 2020
    //-----------------------------------------------------------------------------
    // Title:        LCom_Communication
    // Function:     Function block for TCP communication via Industrial Ethernet.
    //               An extended transport protocol, the LCom protocol, has been
    //               implemented for extended communication functions.
    // Library:      LCom
    // Author:       APC_ERLF
    // Tested with:  CPU 1215 V4.x, CPU 1516 V2x
    // Engineering:  TIA Portal V16
    // Restrictions: --
    // Requirements: --
    //-----------------------------------------------------------------------------
    // Change log table:
    // Version  | Date       | Expert in charge       | Changes applied
    //----------|------------|------------------------|------------------------------
    // 02.00.03 | 2015-06-15 | APC_ERLF               | First release
    // 02.00.04 | 2015-09-08 | APC_ERLF               | Several bug fixes
    //                                                | Number of sign-of-life cycles changed from 3 to 4
    // 02.00.05 | 2016-10-10 | APC_ERLF               | Several bug fixes
    //                                                | HW_ANY data type changed (basic data type = UINT)
    // 02.00.06 | 2019-11-07 | APC_ERLF               | Fixed compilation warnings
    // 02.00.07 | 2020.12.16 | APC_ERLF               | Integrated global constants into FB
    // 02.00.08 | 2022.12.01 | APC_ERLF               | Add REGION keywords
    // 02.01.00 | 2022.12.19 | APC_ERLF               | Add connection type (IPv4/QDN) selector in configuration structure
    //=============================================================================
END_REGION BLOCK INFO HEADER

REGION RECEIVED_DATA?
    //---------------------------------------------------------------------
    //Reset FB outputs, if in the previous cycle are data received
    //---------------------------------------------------------------------
    IF (#statDataReceived = TRUE) THEN
        #dataReceived := #statDataReceived := FALSE;
        #receivedDataLength := 0;
        
        //Without LCom protocol
        //Leave the FB, if the tcp buffer is not completely analyzed yet
        //Necessary to enforce an L/H edge (FB.dataReceived), if readDataLength is small
        //Example: Rx=100, readDataLength=1
        IF ((NOT #diagnostics.localConfig.connection.useLComProtocol) AND (#statReceive.trcvFct.dataLengthRest > 0)) THEN
            RETURN;
        END_IF;
    END_IF;
    //End:Reset FB outputs, if in the previous cycle data was received
END_REGION RECEIVED_DATA?

REGION ENABLING/DISABLING
    //---------------------------------------------------------------------
    //Check enable input
    //---------------------------------------------------------------------
    IF ((#enable) AND (NOT #statOldEnable) AND (NOT #statFallingEdgeEnable))//Rising edge
    THEN
        //Start initialize state for the tcp connection
        #statState.connection := #STATE_INIT;
        #status := #statStatus := #STATUS_FIRST_CALL;
        #busy := TRUE;
    ELSIF (NOT #enable AND #statState.connection = #STATE_INACTIVE) THEN//Inactive
        RETURN;//Do nothing, wait rising edge on enable
    ELSIF ((NOT #enable) AND (#statOldEnable)) THEN//Falling edge
        
        #statFallingEdgeEnable := TRUE;
        //LCom Version 1.0 or 2.0 is used OR native tcp
        #statState.connection := #CLOSE_CONNECTION;
        
        #status := #statStatus := #STATUS_DISCONNECTING;
        //Write diagnostics
        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
        #statDiag.buffer[#statDiag.bufferIndex].status := #STATUS_DISCONNECTING;
        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
    ELSE
        ;//No change on enable input
    END_IF;
    #statOldEnable := #enable;
    //End:Check enable input
END_REGION ENABLING/DISABLING

REGION CYCLE_TIME_STATISTIC
    // -----------------------------------------------------------------------------------------------------------
    //Statistic --> Calculate average of cycle time [ms]
    // -----------------------------------------------------------------------------------------------------------
    #tempRuntime := (LREAL_TO_REAL(RUNTIME(#statRuntimeTask)) * 1000);
    
    //Check the measured runtime value and calculate average of cycle time
    IF ((#tempRuntime > 0) AND #enable)
    THEN
        #diagnostics.statistics.avgCallCycle := (((#diagnostics.statistics.avgCallCycle * 49.0) + #tempRuntime) / 50.0);
    ELSE
        ;//Ignore this runtime value 
    END_IF;
END_REGION CYCLE_TIME_STATISTIC

REGION INIT_VALUES
    //---------------------------------------------------------------------
    //Initialize values
    //---------------------------------------------------------------------
    #statState.sender := #STATE_INACTIVE;
    #statSend.tsendFct.enable := FALSE;
    #statSend.tsendFct.dataOffset := 0;
    //Set index of temp diagnostics entry
    #statDiag.bufferIndex := -1;
    //End: Calculate average of cycle time and initialize values
END_REGION INIT_VALUES

REGION CHECK_SEND_INPUT
    //---------------------------------------------------------------------
    //Check send input
    //---------------------------------------------------------------------
    IF #statConnected THEN
        //Check rising edge
        IF (#send AND (NOT #statOldSend)) THEN
            //Rising edge detected
            #statRisingEdgeSend := TRUE;
        ELSE
            ;
        END_IF;
        #statOldSend := #send;
    ELSE
        ;//Change at send input is not relevant, because FB is not connected
    END_IF;
    //End:Check send input
END_REGION CHECK_SEND_INPUT

REGION ACK_AUTOMATICALLY_WARNINGS
    //---------------------------------------------------------------------
    //Acknowledge automatically the followings warnings
    //---------------------------------------------------------------------
    IF (#statStatus = #WARN_SEND_DATA_LENGTH)
        OR (#statStatus = #WARN_SEND_CYCLE_EXPIRED)
        OR (#statStatus = #WARN_RECEIVE_BUFFER_LEN
        OR (#statStatus = #WARN_NO_TIME_SYNC))
    THEN
        //With LCom protocol
        IF #diagnostics.localConfig.connection.useLComProtocol THEN
            
            IF (#diagnostics.statistics.activeLComVersion = #HEADER_V1) THEN
                #status := #STATUS_CONNECTED_V1;
            ELSE
                #status := #STATUS_CONNECTED_V2;
            END_IF;
        ELSE//Without LCom protocol
            #status := #statStatus := #STATUS_TCP_CONNECTED;
        END_IF;
    END_IF;
    //End:Acknowledge automatically the followings warnings
END_REGION ACK_AUTOMATICALLY_WARNINGS

REGION STATE_MACHINE
    //---------------------------------------------------------------------
    // State machine for IP connection
    //---------------------------------------------------------------------
    CASE #statState.connection OF
            
        #OPERATION:
            REGION OPERATION
                //IP connection is established
                
                REGION CHECK_LIFESIGN
                    //Get time difference between the last received telegram
                    #instPartnerLifeSignCycleTimer(IN := TRUE,
                                                   PT := (#diagnostics.partnerConfig.connnection.lifeSignCycleTime * #LIFE_SIGN_FACTOR));
                    
                    //Only with LCom protocol, check life sign monitoring
                    IF ((#diagnostics.localConfig.connection.useLComProtocol)
                        AND
                        (#diagnostics.partnerConfig.connnection.lifeSignCycleTime > T#0ms)
                        AND
                        (#instPartnerLifeSignCycleTimer.Q))
                    THEN
                        //Write diagnostics
                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                        #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_LIFE_SIGN_EXPIRED;
                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := UDINT_TO_REAL(TIME_TO_UDINT(#diagnostics.partnerConfig.connnection.lifeSignCycleTime));
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := #instPartnerLifeSignCycleTimer.ET;
                        
                        #statState.connection := #CLOSE_CONNECTION;
                        GOTO ;
                    END_IF;
                END_REGION CHECK_LIFESIGN
                
                REGION CHECK_SENDING
                    //---------------------------------------------------------------------
                    //Check the status of the "TSEND" instruction of the previous request
                    //---------------------------------------------------------------------
                    IF ((#statSend.tsendFct.status = 16#7001)
                        OR
                        (#statSend.tsendFct.status = 16#7002)
                        OR
                        (#statSend.tsendFct.status = 16#80C4))
                    THEN
                        //differ between different connection types (IPv4, QDN)
                        IF (#diagnostics.localConfig.connection.connectType = #CON_TYPE_IPV4) THEN
                            #tempConnOucId := #statTconPar.ID;
                        ELSE    //#CON_TYPE_QDN
                            #tempConnOucId := #statTconParQdn.ID;
                        END_IF;
                        //When "TSEND" instruction started or is in sending process
                        #instTSEND(REQ := TRUE,
                                   LEN := #statSend.tsendFct.dataOffset,
                                   ID := #tempConnOucId,
                                   DATA := #statSend.tsendFct.data,
                                   STATUS => #statSend.tsendFct.status);
                        
                        //When "TSEND" instruction of the previous request is not yet completed
                        IF ((#statSend.tsendFct.status = 16#7001)
                            OR
                            (#statSend.tsendFct.status = 16#7002))
                        THEN
                            //Stop SendError timer
                            #instSendErrorTimer(IN := FALSE,
                                                PT := #MAX_TRIAL_TIME);
                            RETURN;//"TSEND" instruction still in process, leave FB
                        ELSIF (#statSend.tsendFct.status = 16#80C4) THEN
                            //Temporary communication error-->Start/Get SendError timer
                            #instSendErrorTimer(IN := TRUE,
                                                PT := #MAX_TRIAL_TIME);
                            
                            //#MAX_TRIAL_TIME is expired
                            IF #instSendErrorTimer.Q THEN
                                //Write diagnostics
                                #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_SEND;
                                #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := #statSend.tsendFct.status;
                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := #statSend.tsendFct.dataOffset;
                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                #statState.connection := #CLOSE_CONNECTION;
                                GOTO ;
                            ELSE
                                RETURN;//Temporary communication error still valid ant timer is not expired leave FB
                            END_IF;
                        ELSIF ((#statSend.tsendFct.status = 16#7000) OR (#statSend.tsendFct.status = 16#0000)) THEN
                            //---------------------------------------------------------------------
                            //Send job completed without error
                            //---------------------------------------------------------------------
                            IF ((NOT #diagnostics.localConfig.connection.useLComProtocol)
                                AND
                                (#statSend.userData.offset = #statSend.dataTelegram.totalMessageLength))
                            THEN
                                //Without LCom protocol
                                #statSend.dataTelegram.totalMessageLength := 0;
                                #sending := #statSending := FALSE;
                                
                                //Statistic, increase number of sent messages
                                #diagnostics.statistics.numberOfSentMessages := #diagnostics.statistics.numberOfSentMessages + 1;
                                
                                //Get the message sending time (ms)
                                #instMsgSendingTimer(IN := TRUE,
                                                     PT := T#+24d20h31m23s647ms);
                                
                                //Check maximum message sending time (ms)
                                IF (#instMsgSendingTimer.ET > #diagnostics.statistics.maxMsgSendingTime) THEN
                                    #diagnostics.statistics.maxMsgSendingTime := #instMsgSendingTimer.ET;
                                ELSE
                                    ;//Actual sending time is smaller
                                END_IF;
                                
                                //Calculate average of message sending time (ms)
                                #diagnostics.statistics.avgMsgSendingTime := (((#diagnostics.statistics.avgMsgSendingTime * 19) + UDINT_TO_REAL((TIME_TO_UDINT(#instMsgSendingTimer.ET)))) / 20);
                                
                                //Stop message sending timer
                                #instMsgSendingTimer(IN := FALSE,
                                                     PT := T#+24d20h31m23s647ms);
                            ELSE
                                ;//With LCom protocol and not in disconnecting process
                            END_IF;
                            //Stop SendError timer
                            #instSendErrorTimer(IN := FALSE,
                                                PT := #MAX_TRIAL_TIME);
                            
                            //Call "TSEND" instruction, with REQ:= FALSE (falling edge)
                            //Preparation for the next send job
                            #instTSEND(REQ := FALSE,
                                       LEN := #statSend.tsendFct.dataOffset,
                                       ID := #tempConnOucId,
                                       DATA := #statSend.tsendFct.data,
                                       STATUS => #statSend.tsendFct.status);
                            
                            #statSend.tsendFct.dataOffset := 0;
                            //End:Send job completed without error
                        ELSE
                            //An error occurred during execution of "TSEND" call
                            //The data to send was not completely transmitted
                            //Write diagnostics
                            #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                            #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_SEND;
                            #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := #statSend.tsendFct.status;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := #statSend.tsendFct.dataOffset;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                            
                            #statState.connection := #CLOSE_CONNECTION;
                            GOTO ;
                        END_IF;
                    ELSE
                        ; //The "TSEND" instruction is not started or in processing
                    END_IF;
                    //End:Check the #status OF the TSEND instruction from the previous request
                END_REGION CHECK_SENDING
                
                REGION READ_TCP_BUFFER
                    //Check if the tcp buffer must read
                    IF (#readDataLength = 0 OR #statState.cfgSender = #STATE_INIT OR #statState.cfgSender = #SEND_CONFIG)
                    THEN
                        ;//Do not read tcp Buffer
                    ELSE
                        //Check if there are still data in the tcp buffer from the previous "TRCV" call
                        IF (#statState.receiver = #NO_CALL_TRCV) THEN
                            ;//Still bytes in the tcp buffer, don´t call "TRCV" instruction
                        ELSE
                            //Read the complete tcp buffer
                            #instTRCV.STATUS := 16#0000;
                            #instTRCV(EN_R := TRUE,
                                      ID := #diagnostics.localConfig.connection.connectionID,
                                      LEN := 0,
                                      ADHOC := TRUE,
                                      NDR => #statReceive.trcvFct.dataReceived,
                                      RCVD_LEN => #statReceive.trcvFct.dataLength,
                                      DATA := #statReceive.trcvFct.data);
                            
                            //An error occurred during execution of "TRCV" call
                            IF (#instTRCV.ERROR) THEN
                                //16#80C4=Temporary communication error
                                //16#80A1=Connection or port already being used by user
                                IF ((#instTRCV.STATUS = 16#80C4) OR (#instTRCV.STATUS = 16#80A1)) THEN
                                    //Get RcvError time
                                    #instRcvErrorTimer(IN := TRUE,
                                                       PT := #MAX_TRIAL_TIME);
                                    
                                    //#MAX_TRIAL_TIME is expired
                                    IF #instRcvErrorTimer.Q THEN
                                        //Write diagnostics
                                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                        #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_RECEIVE;
                                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := #instTRCV.STATUS;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                        #statState.connection := #CLOSE_CONNECTION;
                                        GOTO ;
                                    END_IF;
                                    //Stop partner watch dog timer of life sign cycle
                                    #instPartnerLifeSignCycleTimer(IN := FALSE,
                                                                   PT := (#diagnostics.partnerConfig.connnection.lifeSignCycleTime * #LIFE_SIGN_FACTOR));
                                ELSE//An error occurred during execution <>16#80C4 and <> 16#80A1
                                    //Write diagnostics
                                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                    #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_RECEIVE;
                                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := #instTRCV.STATUS;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := 0.0;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                    #statState.connection := #CLOSE_CONNECTION;
                                    GOTO ;
                                END_IF;
                            ELSE
                                //"TRCV" call completed without error
                                //New data received
                                IF (#instTRCV.NDR) THEN
                                    
                                    #statState.receiver := #DATA_RECEIVED;
                                    
                                    //Stop partner watch dog timer of life sign cycle
                                    #instPartnerLifeSignCycleTimer(IN := FALSE,
                                                                   PT := (#diagnostics.partnerConfig.connnection.lifeSignCycleTime * #LIFE_SIGN_FACTOR));
                                    
                                    #statReceive.trcvFct.dataLengthRest := #statReceive.trcvFct.dataLength;
                                    #statReceive.trcvFct.dataOffset := 0;
                                    
                                    //Reset the counter
                                    #statCopyNBytes := 0;
                                ELSE
                                    //No data received
                                    #statState.receiver := #NO_DATA_RECEIVED;
                                END_IF;
                                //Stop RcvError timer
                                #instRcvErrorTimer(IN := FALSE,
                                                   PT := #MAX_TRIAL_TIME);
                            END_IF;
                        END_IF;
                        
                        //Initialize before the tcp is analyzed
                        #statReceive.numberOfLComHeader := 0;
                        
                        //---------------------------------------------------------------------
                        //Analysis tcp receive buffer
                        //---------------------------------------------------------------------
                        REPEAT
                            
                            //The complete tcp receive buffer is analyzed --> stop analyzing
                            IF (#statReceive.trcvFct.dataLengthRest <= 0)
                            THEN
                                EXIT;
                            END_IF;
                            REGION NATIVE_TCP
                                //---------------------------------------------------------------------
                                //Analyze tcp receive buffer without LCom protocol
                                //---------------------------------------------------------------------
                                IF (NOT #diagnostics.localConfig.connection.useLComProtocol) THEN
                                    
                                    //Store the total receive length with the 1st received telegram
                                    IF (#statReceive.userData.offset = 0) THEN
                                        
                                        //Compare readDataLength with the local max. receive data length
                                        IF ((#diagnostics.localConfig.sizeOfReceiveBuffer < #readDataLength)
                                            AND
                                            (#readDataLength > 0 AND #readDataLength < 4294967295))//#readDataLength 1 ... 4294967295
                                        THEN
                                            #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                            #statDiag.buffer[#statDiag.bufferIndex].status := #WARN_RECEIVE_BUFFER_LEN;
                                            #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := UDINT_TO_REAL(#diagnostics.localConfig.sizeOfReceiveBuffer);
                                            
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := UDINT_TO_REAL(#readDataLength);
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                            #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                            
                                            #statReceive.userData.totalLength := #diagnostics.localConfig.sizeOfReceiveBuffer;
                                        ELSIF (#readDataLength = 4294967295) THEN//Adhoc
                                            //The TRCV Fkt. can read up to 4096 Byte
                                            //If the Rx user buffer is less than the current received bytes, limit to the Rx user buffer
                                            //Otherwise copy received bytes (LCom internal Rx) to the Rx user buffer
                                            IF (#statReceive.trcvFct.dataLengthRest < #diagnostics.localConfig.sizeOfReceiveBuffer)
                                            THEN
                                                #statReceive.userData.totalLength := #statReceive.trcvFct.dataLengthRest;
                                            ELSE
                                                #statReceive.userData.totalLength := #diagnostics.localConfig.sizeOfReceiveBuffer;
                                            END_IF;
                                        ELSE
                                            #statReceive.userData.totalLength := #readDataLength;
                                        END_IF;
                                        
                                        //Start message receiving timer (ms)
                                        //Duration between start of message and FB output dataReceived becomes TRUE
                                        #instMsgReceivingTimer(IN := TRUE,
                                                               PT := T#+24d20h31m23s647ms);
                                    ELSE
                                        ;//Not the 1st received telegram
                                    END_IF;
                                    
                                    //Is the data to be analyzed in the tcp receive buffer bigger than the complete message ?
                                    IF (#statReceive.userData.offset + #statReceive.trcvFct.dataLengthRest) > #statReceive.userData.totalLength THEN
                                        //Copy only the rest data from the message, not all data from the tcp receive buffer
                                        #statCopyNBytes := #statReceive.userData.totalLength - #statReceive.userData.offset;
                                    ELSE
                                        //Copy just the rest of data from the tcp receive buffer
                                        #statCopyNBytes := #statReceive.trcvFct.dataLengthRest;
                                    END_IF;
                                    
                                    //Copy data to FB.receiveBuffer
                                    #statRet := MOVE_BLK_VARIANT(SRC := #statReceive.trcvFct.data, COUNT := #statCopyNBytes, SRC_INDEX := UDINT_TO_DINT(#statReceive.trcvFct.dataOffset), DEST_INDEX := UDINT_TO_DINT(#statReceive.userData.offset), DEST => #receiveBuffer);
                                    //Calculate offset in the FB.#receiveBuffer
                                    #statReceive.userData.offset := #statReceive.userData.offset + #statCopyNBytes;
                                    //Calculate offset in the tcp receive buffer
                                    #statReceive.trcvFct.dataOffset := #statReceive.trcvFct.dataOffset + #statCopyNBytes;
                                    //Calculate the rest of data in the tcp receive buffer
                                    #statReceive.trcvFct.dataLengthRest := #statReceive.trcvFct.dataLength - #statReceive.trcvFct.dataOffset;
                                    
                                    //Is the complete message in the FB.#receiveBuffer copied ?
                                    IF (#statReceive.userData.offset = #statReceive.userData.totalLength) THEN
                                        //The complete message is copied in the FB.#receiveBuffer
                                        //Set FB outputs and initialize for the next receive request
                                        #dataReceived := #statDataReceived := TRUE;
                                        #receivedDataLength := #statReceive.userData.totalLength;
                                        #statReceive.userData.offset := 0;
                                        
                                        //Statistic --> increase number of received user messages
                                        #diagnostics.statistics.numberOfReceivedMessages := #diagnostics.statistics.numberOfReceivedMessages + 1;
                                        
                                        //Get message receiving time [ms]
                                        #instMsgReceivingTimer(IN := TRUE,
                                                               PT := T#+24d20h31m23s647ms);
                                        
                                        //Statistic --> compare max. message receiving time
                                        IF (#instMsgReceivingTimer.ET > #diagnostics.statistics.maxMsgReceivingTime) THEN
                                            #diagnostics.statistics.maxMsgReceivingTime := #instMsgReceivingTimer.ET;
                                        ELSE
                                            ;//Actual receiving time is smaller
                                        END_IF;
                                        
                                        //Statistic --> calculate average of message receiving time (ms)
                                        #diagnostics.statistics.avgMsgReceivingTime := (((#diagnostics.statistics.avgMsgReceivingTime * 19) + UDINT_TO_REAL((TIME_TO_UDINT(#instMsgReceivingTimer.ET)))) / 20);
                                        
                                        //Stop message receiving timer
                                        #instMsgReceivingTimer(IN := FALSE,
                                                               PT := T#+24d20h31m23s647ms);
                                        
                                        //Get receive message cycle time [ms]
                                        #instReceiveMsgCycle(IN := TRUE,
                                                             PT := T#+24d20h31m23s647ms);
                                        
                                        //Statistic --> compare max. receive message cycle time
                                        IF (#instReceiveMsgCycle.ET > #diagnostics.statistics.maxReceiveMsgCycle) THEN
                                            #diagnostics.statistics.maxReceiveMsgCycle := #instReceiveMsgCycle.ET;
                                        ELSE
                                            ;//Actual receive message cycle time is smaller
                                        END_IF;
                                        
                                        //Statistic --> calculate average of receive message cycle time
                                        #diagnostics.statistics.avgReceiveMsgCycle := (((#diagnostics.statistics.avgReceiveMsgCycle * 19) + UDINT_TO_REAL((TIME_TO_UDINT(#instReceiveMsgCycle.ET)))) / 20);
                                        
                                        //Stop receive message cycle timer
                                        #instReceiveMsgCycle(IN := FALSE,
                                                             PT := T#+24d20h31m23s647ms);
                                        
                                        //Start receive message cycle timer
                                        #instReceiveMsgCycle(IN := TRUE,
                                                             PT := T#+24d20h31m23s647ms);
                                        
                                        //There are still bytes in the tcp receive buffer which must be analyzed
                                        IF (#statReceive.trcvFct.dataLengthRest > 0) THEN
                                            //Do not call "TRCV" instruction
                                            #statState.receiver := #NO_CALL_TRCV;
                                        ELSE
                                            //Call "TRCV" instruction in the next cycle
                                            #statState.receiver := #READ;
                                        END_IF;
                                    ELSE
                                        //The complete message is not copied to the FB.#receiveBuffer
                                        #statState.receiver := #READ;
                                    END_IF;
                                    EXIT;//Stop analyzing the tcp receive buffer without LCom protocol
                                ELSE
                                    ;//With LCom protocol
                                END_IF;//End: Analyze tcp receive buffer without LCom protocol
                            END_REGION NATIVE_TCP
                            
                            REGION LCOM_PROTOCOL
                                //---------------------------------------------------------------------
                                //Analyze tcp receive buffer with LCom protocol
                                //---------------------------------------------------------------------
                                
                                //Is data expected without LCom header ?
                                IF (#statState.comReceiver = #DATA_EXPECTED) THEN
                                    ;//LCom header is already known, still some bytes missing so the actual LCom package becomes complete
                                ELSE
                                    //There is already data in the temp. LCom header ?
                                    IF (#statReceive.tempTelegram.index = 0) THEN
                                        //No data in the temp. LCom header
                                        //Get the LCom version from the receive telegram
                                        #statReceive.tempTelegram.LComVersion := #statReceive.trcvFct.data[#statReceive.trcvFct.dataOffset];
                                        
                                        //Is the data in the tcp receive buffer to be analyzed bigger than 1 byte
                                        IF (#statReceive.trcvFct.dataLengthRest > 1) THEN
                                            //Yes --> get the telegram type in the 2nd byte
                                            #statReceive.tempTelegram.telegramType := #statReceive.trcvFct.data[#statReceive.trcvFct.dataOffset + 1];
                                        ELSE
                                            //No --> just one byte
                                            #statCopyNBytes := 1;
                                            #statReceive.tempTelegram.telegramType := 0;
                                        END_IF;
                                        
                                    ELSE
                                        //Already data in the temp. LCom header
                                        IF (#statReceive.tempTelegram.index = 1) THEN
                                            //Get the telegram type in the 1st byte
                                            #statReceive.tempTelegram.telegramType := #statReceive.trcvFct.data[#statReceive.trcvFct.dataOffset];
                                        ELSE
                                            //Get the telegram type in the 2nd byte
                                            #statReceive.tempTelegram.telegramType := #statReceive.trcvFct.data[#statReceive.trcvFct.dataOffset + 1];
                                        END_IF;
                                    END_IF;
                                    
                                    
                                    //---------------------------------------------------------------------
                                    //Build temp LCom header, if the telegram type is known
                                    //---------------------------------------------------------------------
                                    //Check if the telegram type is known
                                    IF (#statReceive.tempTelegram.telegramType > 0) THEN
                                        
                                        //Yes -->  telegram type is known
                                        CASE (#statReceive.tempTelegram.telegramType) OF
                                            1..3://Config telegram type 1,2,3
                                                //LCom V2 (24 byte)
                                                IF (#statReceive.tempTelegram.LComVersion = #HEADER_V2) THEN
                                                    IF ((24 - #statReceive.tempTelegram.index) < #statReceive.trcvFct.dataLengthRest) THEN
                                                        #statCopyNBytes := 24 - #statReceive.tempTelegram.index;
                                                    ELSE
                                                        #statCopyNBytes := #statReceive.trcvFct.dataLengthRest;
                                                    END_IF;
                                                ELSE
                                                    //LCom V1 (16 byte)
                                                    IF ((16 - #statReceive.tempTelegram.index) < #statReceive.trcvFct.dataLengthRest) THEN
                                                        #statCopyNBytes := 16 - #statReceive.tempTelegram.index;
                                                    ELSE
                                                        #statCopyNBytes := #statReceive.trcvFct.dataLengthRest;
                                                    END_IF;
                                                END_IF;
                                            5://Clock synchronization telegram type 5
                                                //LCom V1 and V2 (10 byte)
                                                IF ((10 - #statReceive.tempTelegram.index) < #statReceive.trcvFct.dataLengthRest) THEN
                                                    #statCopyNBytes := 10 - #statReceive.tempTelegram.index;
                                                ELSE
                                                    #statCopyNBytes := #statReceive.trcvFct.dataLengthRest;
                                                END_IF;
                                            10://Data telegram type 10
                                                //LCom V2 (20 byte)
                                                IF (#statReceive.tempTelegram.LComVersion = #HEADER_V2) THEN
                                                    IF ((20 - #statReceive.tempTelegram.index) < #statReceive.trcvFct.dataLengthRest) THEN
                                                        #statCopyNBytes := 20 - #statReceive.tempTelegram.index;
                                                    ELSE
                                                        #statCopyNBytes := #statReceive.trcvFct.dataLengthRest;
                                                    END_IF;
                                                ELSE
                                                    //LCom V1 (12 byte)
                                                    IF ((12 - #statReceive.tempTelegram.index) < #statReceive.trcvFct.dataLengthRest) THEN
                                                        #statCopyNBytes := 12 - #statReceive.tempTelegram.index;
                                                    ELSE
                                                        #statCopyNBytes := #statReceive.trcvFct.dataLengthRest;
                                                    END_IF;
                                                END_IF;
                                            20://Close connection telegram type 20
                                                //LCom V1 (2 byte)
                                                IF ((2 - #statReceive.tempTelegram.index) < #statReceive.trcvFct.dataLengthRest) THEN
                                                    #statCopyNBytes := 2 - #statReceive.tempTelegram.index;
                                                ELSE
                                                    #statCopyNBytes := #statReceive.trcvFct.dataLengthRest;
                                                END_IF;
                                            ELSE
                                                //Write diagnostics
                                                #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                                #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_WRONG_TELEGRAM_ID;
                                                #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := #statReceive.tempTelegram.telegramType;
                                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := 0.0;
                                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                                #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                                
                                                #statState.connection := #CLOSE_CONNECTION;
                                                GOTO ;
                                        END_CASE;
                                    ELSE
                                        ;//No --> telegram type is zero
                                    END_IF;
                                    
                                    //Copy data into the temp. LCom header
                                    #statRet := MOVE_BLK_VARIANT(SRC := #statReceive.trcvFct.data, COUNT := #statCopyNBytes, SRC_INDEX := UDINT_TO_DINT(#statReceive.trcvFct.dataOffset), DEST_INDEX := #statReceive.tempTelegram.index, DEST => #statReceive.tempTelegram.data);
                                    //Calculate index in the temp. LCom header buffer
                                    #statReceive.tempTelegram.index := #statReceive.tempTelegram.index + UDINT_TO_USINT(#statCopyNBytes);
                                    //Calculate offset in the tcp receive buffer
                                    #statReceive.trcvFct.dataOffset := #statReceive.trcvFct.dataOffset + #statCopyNBytes;
                                    
                                    //Is local LCom version equal to partner LCom version ?
                                    IF (#statActualLocalLComVersion <> #statReceive.tempTelegram.LComVersion) THEN
                                        #statConnectAttempts := #statConnectAttempts + 1;
                                        //Write diagnostics
                                        #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                        #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_WRONG_HEADER;
                                        #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := #statReceive.tempTelegram.LComVersion;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := #statActualLocalLComVersion;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                        #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                        
                                        #statState.connection := #CLOSE_CONNECTION;
                                        GOTO ;
                                    ELSE
                                        ;//local LCom version and partner LCom versions are equal
                                        #diagnostics.statistics.activeLComVersion := #statActualLocalLComVersion;
                                    END_IF;
                                END_IF;//End: There is data expected without LCom header
                                
                                //---------------------------------------------------------------------
                                //Interpret temp LCom header
                                //---------------------------------------------------------------------
                                IF (((#statReceive.tempTelegram.LComVersion = #HEADER_V1)//LCom V1
                                    AND//1,2,3 = 16 Byte
                                    ((#statReceive.tempTelegram.telegramType <= 3 AND #statReceive.tempTelegram.index = 16)
                                    OR//5 = 10 Byte
                                    (#statReceive.tempTelegram.telegramType = 5 AND #statReceive.tempTelegram.index = 10)
                                    OR//10 = 12 Byte
                                    (#statReceive.tempTelegram.telegramType = 10 AND #statReceive.tempTelegram.index = 12)
                                    OR//20 = 2 Byte
                                    (#statReceive.tempTelegram.telegramType = 20 AND #statReceive.tempTelegram.index = 2)))
                                    OR
                                    ((#statReceive.tempTelegram.LComVersion = #HEADER_V2)//LCom V2
                                    AND//1,2,3 = 24 Byte
                                    ((#statReceive.tempTelegram.telegramType <= 3 AND #statReceive.tempTelegram.index = 24)
                                    OR//5 = 10 Byte
                                    (#statReceive.tempTelegram.telegramType = 5 AND #statReceive.tempTelegram.index = 10)
                                    OR//10 = 20 Byte
                                    (#statReceive.tempTelegram.telegramType = 10 AND #statReceive.tempTelegram.index = 20)))
                                    OR
                                    (#statState.comReceiver = #DATA_EXPECTED))
                                THEN
                                    
                                    CASE #statReceive.tempTelegram.telegramType OF
                                            
                                        10://Telegram type 10
                                            
                                            //Data expected without LCom header ?
                                            IF (#statState.comReceiver = #DATA_EXPECTED) THEN
                                                //Yes --> LCom header from data telegram is already interpreted
                                                //#receive.dataTelegram.messageOffset and #receive.dataTelegram.acPackageLength is known
                                                //Calculate the bytes which have to be copied into FB.receiveData
                                                IF (#statReceive.userData.offset + #statReceive.trcvFct.dataLengthRest) > (#statReceive.dataTelegram.messageOffset + #statReceive.dataTelegram.actPackageLength) THEN
                                                    //Copy just the missing bytes from the actual LCom package
                                                    #statCopyNBytes := ((#statReceive.dataTelegram.messageOffset + #statReceive.dataTelegram.actPackageLength) - #statReceive.userData.offset);
                                                ELSE
                                                    //Copy all bytes which are still in the tcp receive buffer
                                                    #statCopyNBytes := #statReceive.trcvFct.dataLengthRest;
                                                END_IF;
                                                //Set SEND acknowledge message offset
                                                #statSend.dataTelegram.ackMessageOffset := #statSend.dataTelegram.ackMessageOffset + #statCopyNBytes;
                                            ELSE
                                                //Reset index, so a new temp. LCom header can be build
                                                #statReceive.tempTelegram.index := 0;
                                                #statReceive.numberOfLComHeader := #statReceive.numberOfLComHeader + 1;
                                                
                                                //LComVersion
                                                #statReceive.dataTelegram.LComVersion := #statReceive.tempTelegram.data[0];
                                                //Telegram type
                                                #statReceive.dataTelegram.telegramType := #statReceive.tempTelegram.data[1];
                                                //Message counter
                                                #statReceive.dataTelegram.messageCounter := #statReceive.tempTelegram.data[2];
                                                //Acknowledge message counter
                                                #statReceive.dataTelegram.ackMessageCounter := #statReceive.tempTelegram.data[3];
                                                
                                                //LCom V2
                                                IF (#statActualLocalLComVersion = #HEADER_V2) THEN
                                                    //Get tem. total message length
                                                    #tempDWord.%B3 := #statReceive.tempTelegram.data[16];
                                                    #tempDWord.%B2 := #statReceive.tempTelegram.data[17];
                                                    #tempDWord.%B1 := #statReceive.tempTelegram.data[18];
                                                    #tempDWord.%B0 := #statReceive.tempTelegram.data[19];
                                                    
                                                    //Acknowledge message offset
                                                    #statReceive.dataTelegram.ackMessageOffset.%B3 := #statReceive.tempTelegram.data[8];
                                                    #statReceive.dataTelegram.ackMessageOffset.%B2 := #statReceive.tempTelegram.data[9];
                                                    #statReceive.dataTelegram.ackMessageOffset.%B1 := #statReceive.tempTelegram.data[10];
                                                    #statReceive.dataTelegram.ackMessageOffset.%B0 := #statReceive.tempTelegram.data[11];
                                                    
                                                    //Is it an acknowledge telegram ?
                                                    IF (#tempDWord = 16#0000) THEN
                                                        //Acknowledge telegram
                                                        #statState.comReceiver := #ACK_TELEGRAM;
                                                    ELSE
                                                        //Is no acknowledge telegram
                                                        //Message offset
                                                        #statReceive.dataTelegram.messageOffset.%B3 := #statReceive.tempTelegram.data[4];
                                                        #statReceive.dataTelegram.messageOffset.%B2 := #statReceive.tempTelegram.data[5];
                                                        #statReceive.dataTelegram.messageOffset.%B1 := #statReceive.tempTelegram.data[6];
                                                        #statReceive.dataTelegram.messageOffset.%B0 := #statReceive.tempTelegram.data[7];
                                                        //Actual package length
                                                        #statReceive.dataTelegram.actPackageLength.%B3 := #statReceive.tempTelegram.data[12];
                                                        #statReceive.dataTelegram.actPackageLength.%B2 := #statReceive.tempTelegram.data[13];
                                                        #statReceive.dataTelegram.actPackageLength.%B1 := #statReceive.tempTelegram.data[14];
                                                        #statReceive.dataTelegram.actPackageLength.%B0 := #statReceive.tempTelegram.data[15];
                                                        //Total message length
                                                        #statReceive.dataTelegram.totalMessageLength := #tempDWord;
                                                    END_IF;
                                                ELSE
                                                    //LCom V1
                                                    //Get temp. total message length
                                                    #tempDWord.%B1 := #statReceive.tempTelegram.data[10];
                                                    #tempDWord.%B0 := #statReceive.tempTelegram.data[11];
                                                    
                                                    //Acknowledge message offset
                                                    #statReceive.dataTelegram.ackMessageOffset.%B1 := #statReceive.tempTelegram.data[6];
                                                    #statReceive.dataTelegram.ackMessageOffset.%B0 := #statReceive.tempTelegram.data[7];
                                                    
                                                    //Is it an acknowledge telegram ?
                                                    IF (#tempDWord = 16#0000) THEN
                                                        //Acknowledge telegram
                                                        #statState.comReceiver := #ACK_TELEGRAM;
                                                    ELSE
                                                        //Is no acknowledge telegram
                                                        //Message offset
                                                        #statReceive.dataTelegram.messageOffset.%B1 := #statReceive.tempTelegram.data[4];
                                                        #statReceive.dataTelegram.messageOffset.%B0 := #statReceive.tempTelegram.data[5];
                                                        //Actual package length
                                                        #statReceive.dataTelegram.actPackageLength.%B1 := #statReceive.tempTelegram.data[8];
                                                        #statReceive.dataTelegram.actPackageLength.%B0 := #statReceive.tempTelegram.data[9];
                                                        //Total message length
                                                        #statReceive.dataTelegram.totalMessageLength := #tempDWord;
                                                    END_IF;
                                                END_IF;
                                                
                                                //Set SEND acknowledge message offset
                                                #statSend.dataTelegram.ackMessageCounter := #statReceive.dataTelegram.messageCounter;
                                                
                                                //Check if the LCom package, which was sent before is acknowledged ?
                                                IF ((#statSend.numberOfLComPackage = 1)//One package was sent
                                                    AND
                                                    ((#statSend.expectedAck.package1.offset = #statReceive.dataTelegram.ackMessageOffset)
                                                    AND
                                                    (#statSend.dataTelegram.messageCounter = #statReceive.dataTelegram.ackMessageCounter)))
                                                THEN
                                                    //Acknowledgement for the package x.1
                                                    #statSend.numberOfLComPackage := 0;
                                                    //Stop acknowledge timer for the 1st package
                                                    #instExpectedAckPackage1(IN := FALSE,
                                                                             PT := #diagnostics.localConfig.sender.ackTimeout);
                                                ELSIF ((#statSend.dataTelegram.messageCounter = #statReceive.dataTelegram.ackMessageCounter)
                                                    OR
                                                    (#statSend.dataTelegram.messageCounter - 1 = #statReceive.dataTelegram.ackMessageCounter)
                                                    OR
                                                    (#diagnostics.statistics.maxMsgSendingTime = T#0ms))//Workaround: S7 Controller does not start with correct ack. message counter
                                                THEN
                                                    ;
                                                ELSE
                                                    //Write diagnostics
                                                    #statDiag.bufferIndex := #statDiag.bufferIndex + 1;
                                                    #statDiag.buffer[#statDiag.bufferIndex].status := #ERR_ACK_MESSAGE_NUMBER;
                                                    #statDiag.buffer[#statDiag.bufferIndex].subFunctionErrorID := 16#0000;
                                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue1 := #statReceive.dataTelegram.messageCounter;
                                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue2 := #statSend.dataTelegram.messageCounter;
                                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue3 := 0.0;
                                                    #statDiag.buffer[#statDiag.bufferIndex].additionalValue4 := T#0ms;
                                                    
                                                    #statState.connection := #CLOSE_CONNECTION;
                                                    GOTO ;
                                                END_IF;
                                                
                                                
                                                //Is the 1st LCom package received and nothing is copied into FB.receiveData so far ?
                                                IF ((#statReceive.userData.totalLength = 0)
                                                    AND
                                                    (#statReceive.dataTelegram.messageOffset = 0)
                                                    AND
                                                    (#statState.comReceiver <> #ACK_TELEGRAM))
                                                THEN
                                                    //Store the 1st received telegram with the total receive length
                                                    #statReceive.userData.totalLength := #statReceive.dataTelegram.totalMessageLength;
                                                    //Reset the acknowledged message offset
                                                    #statSend.dataTelegram.ackMessageOffset := 0;
                                                    
                                                    //Start message receiving timer
                                                    #instMsgReceivingTimer(IN := TRUE,
                                                                           PT := T#+24d20h31m23s647ms);
                                                ELSE
                                                    ;//In receiving process or acknowledge telegram
                                                END_IF;
                                                
                                                //Is the data telegram a acknowledge telegram ?
                                                IF (#statState.comReceiver = #ACK_TELEGRAM)
                                                THEN
                                                    //Yes --> Acknowledge telegram, no bytes have to be copied
                                                    #statCopyNBytes := 0;
                                                ELSIF ((#diagnostics.statistics.activeLComVersion = #HEADER_V1)
                                                    AND
                                                    ((#statReceive.userData.offset + (#statReceive.trcvFct.dataLengthRest - 12)) > (#statReceive.dataTelegram.messageOffset + #statReceive.dataTelegram.actPackageLength)))
                                                THEN//No --> The data to be analyzed in the tcp receive buffer is bigger than the complete message
                                                    
                                                    //Do not copy all data from the tcp receive buffer, only the rest data from the LCom package
                                                    #statCopyNBytes := ((#statReceive.dataTelegram.messageOffset + #statReceive.dataTelegram.actPackageLength) - #statReceive.userData.offset);
                                                    //Calculate acknowledge message offset which has to be sent to the partner
                                                    #statSend.dataTelegram.ackMessageOffset := #statSend.dataTelegram.ackMessageOffset + #statCopyNBytes;
                                                ELSIF ((#diagnostics.statistics.activeLComVersion = #HEADER_V2)
