                                                END_IF;
                                                
                                                
                                                //---------------------------------------------------------------------
                                                //Is the complete LCom message received (1 Byte ... 4 Gigabyte) ?
                                                //---------------------------------------------------------------------
                                                IF (#statReceive.userData.offset = #statReceive.dataTelegram.totalMessageLength) THEN
                                                    //Yes --> Set FB outputs
                                                    #dataReceived := #statDataReceived := TRUE;
