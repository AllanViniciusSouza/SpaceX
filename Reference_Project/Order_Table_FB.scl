TYPE "Sfts_Inputs"
VERSION : 0.1
   STRUCT
      DP_Extended : Bool;
      DP_Retracted : Bool;
   END_STRUCT;

END_TYPE

TYPE "Sfts_Instruction"
VERSION : 0.1
   STRUCT
      Mode_Change : UInt;
      Enable : Bool;
      Extend : Bool;
      Retract : Bool;
      Manual_Extend : Bool;
      Manual_Retract : Bool;
   END_STRUCT;

END_TYPE

TYPE "Cnv_Instruction"
VERSION : 0.1
   STRUCT
      Mode_Change : UInt;
      Stop : Bool;
      Enable : Bool;
      Reset : Bool;
      Pallet_Type : UInt;
      Pallet_Allignment : Bool;
      Execute : Bool;
      Task_ID : UInt;
      Task_Metadata : String;
      Transfer_To_ID : DInt;
      Transfer_From_ID : DInt;
      Transfer_in_Progress : Bool;   // Transfer In progress
      Inbound_Ready : Bool;   // Ready to receive
      Transfer_Complete : Bool;   // Transfer complete
      Outbound_Ready : Bool;   // Ready to send
      Start_Transfer : Bool;
      Pallet_Align_Left : Bool;
      Pallet_Align_Right : Bool;
      Pallet_Align_Center : Bool;
      Start_Transfer_Backward : Bool;
      Foward : Bool;
      Backward : Bool;
   END_STRUCT;

END_TYPE

TYPE "Buffer_Cnv_Inputs"
VERSION : 0.1
   STRUCT
      Left : Bool;   // Sensor Conveyor Left (Fwd)
      Lpd1 : Bool;   // Sensor Conveyor Left (Pallet detect 1)
      Lpd2 : Bool;   // Sensor Conveyor Left (Pallet detect 2)
      Right : Bool;   // Sensor Conveyor Right (Bwd)
      Rpd1 : Bool;   // Sensor Conveyor Right (Pallet detect 1)
      Rpd2 : Bool;   // Sensor Conveyor Right (Pallet detect 2)
      Sdetect1 : Bool;   // Shuttle In Position 1
      Sdetect2 : Bool;   // Shuttle In Position 2
      Shuttle_High : Bool;
      VFD_Status : Word;
      VFD_Speed_Actual : Int;
      VFD_ActualCurrent : Int;
      VFD_ActualTorque : Int;
   END_STRUCT;

END_TYPE

TYPE "Sfts_Control"
VERSION : 0.1
   STRUCT
      Mode { ExternalWritable := 'False'} : UInt;
      Error { ExternalWritable := 'False'} : Bool;
      Enabled { ExternalWritable := 'False'} : Bool;
      Running { ExternalWritable := 'False'} : Bool;
      LP_State : USInt;
      Motor_Extend { ExternalWritable := 'False'} : Bool;
      Motor_Retract { ExternalWritable := 'False'} : Bool;
      SM_State : UInt;
      Instruction { S7_SetPoint := 'False'} : "Sfts_Instruction";
      Inputs : "Sfts_Inputs";
   END_STRUCT;

END_TYPE

TYPE "Cnv_Motor"
VERSION : 0.1
   STRUCT
      Enable : Bool;
      Enabled : Bool;
      Ready : Bool;
      Forward : Bool;
      Reverse : Bool;
      Speed : Real;
      Speed_Actual : Real;
      Actual_Current : Real;
      Actual_Torque : UInt;
      Control_Word : Word;
      Config_Axis : Word := 16#003F;
      Error : Bool;
      Status : Word;
      Communication_Error : Word;
      Lockout : Bool;
   END_STRUCT;

END_TYPE

TYPE "Cnv_Errors"
VERSION : 0.1
   STRUCT
      Error_Word_1 : UInt;
      Error_Word_2 : UInt;
      Error_Word_3 : UInt;
      Error_Word_4 : UInt;
   END_STRUCT;

END_TYPE

TYPE "Buffer_Cnv_Control"
VERSION : 0.1
   STRUCT
      Mode { ExternalWritable := 'False'} : UInt;
      Error { ExternalWritable := 'False'} : Bool;
      Warning { ExternalWritable := 'False'} : UInt;
      Enabled { ExternalWritable := 'False'} : Bool;
      Stopped { ExternalWritable := 'False'} : Bool;
      Done : Bool;
      Running { ExternalWritable := 'False'} : Bool;
      Ready_For_Task { ExternalWritable := 'False'} : Bool;
      Current_Task_Type : UInt;
      Current_Task_ID { ExternalWritable := 'False'} : UInt;
      Cnv_Occupied { ExternalWritable := 'False'} : Bool;
      Pallet_Type { ExternalWritable := 'False'} : UInt;
