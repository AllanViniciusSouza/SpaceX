TYPE "Cnv_Inputs"
VERSION : 0.1
   STRUCT
      Left : Bool;   // Sensor Conveyor Left (Fwd)
      Lpd1 : Bool;   // Sensor Conveyor Left (Pallet detect 1)
      Center : Bool;   // Sensor Conveyor Left (Pallet detect 2)
      Right : Bool;   // Sensor Conveyor Right (Bwd)
      Rpd1 : Bool;   // Sensor Conveyor Right (Pallet detect 1)
      Sdetect1 : Bool;   // Shuttle In Position 1
      Sdetect2 : Bool;   // Shuttle In Position 2
      VFD_Status : Word;
      VFD_Speed_Actual : Int;
      VFD_ActualCurrent : Int;
      VFD_ActualTorque : Int;
   END_STRUCT;

END_TYPE

TYPE "WMS_OPC_UA"
VERSION : 0.1
   STRUCT
      Task_ID : Int;   // ID of the Task
      Task_Metadata : String[250];
      Task_Type : Int;
      Source_Location : DInt;
      Destination_Location : DInt;
      Task_Data_Available : Bool;   // This tag is used to inform the PLC that task data is ready to be read.
      SM_State : UInt;   // The current state machine value of the Device/VTD
      Movement_Ready : Bool;
      Movement_Request_Complete : Bool;   // This PLC tag is set to true once the task is complete.
      Movement_Request_Complete_Ack : Bool;   // The WCS will acknowledge the completion of the task. 
      Shuttle_ID : Int;
      Shuttle_Loaded : Bool;
      Pallet_Type : Char;   // Values can be (C)hep or (E)uro.
      Pallet_Alignment : Char;   // Values can be (L)eft or (R)ight.
      SM_State_Maestro : UInt;   // SM State to mimic openTCS states from devices to Maestro
      Pallet_Weight : Int;
   END_STRUCT;

END_TYPE

TYPE "VTD_Motor"
VERSION : 0.1
   STRUCT
      Enable : Bool;
      Enabled : Bool;
      Ready : Bool;
      Running : Bool;
      Forward : Bool;
      Reverse : Bool;
      Brake_Opened : Bool;
      Speed : Int;
      Speed_Actual : Int;
