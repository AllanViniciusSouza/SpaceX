      DP_Extended { ExternalWritable := 'False'} : Bool;
      Pallet_Loaded { ExternalWritable := 'False'} : UInt;
      Shuttle_Loaded { ExternalWritable := 'False'} : UInt;
      SM_State { ExternalWritable := 'False'} : UInt;   // State Machine state
      Motor_UP { ExternalWritable := 'False'} : Bool;
