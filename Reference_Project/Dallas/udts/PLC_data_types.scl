TYPE "LCom_typeConfig"
   STRUCT
      connection : Struct
         interfaceID : HW_ANY;
         connectionID : CONN_ANY;
         comService : USInt;
         isClient : Bool;
         connectType : USInt;
         localPort : UInt;
         partnerPort : UInt;
         partnerIP : IP_V4;
         partnerQDN : String [254];
         acceptUnknownPartner : Bool;
         lifeSignCycleTime : Time;
      END_STRUCT;
      sender : Struct
         cycleTime : Time;
         ackTimeout : Time;
      END_STRUCT;
      timeSync : Struct
         usePartnerTimestamps : Bool;
         sendMode : USInt;
         cycleTime : Time;
         sendAtTimeOfDay : Time_Of_Day;
      END_STRUCT;
   END_STRUCT;
END_TYPE

TYPE "LCom_typeDiagnostics"
   STRUCT
      localConfig : Struct
         connection : Struct
            interfaceID : HW_ANY;
            connectionID : CONN_ANY;
            comService : USInt;
            isClient : Bool;
            connectType : USInt;
            localPort : UInt;
            localIP : IP_V4;
            partnerPort : UInt;
            partnerIP : IP_V4;
            partnerQDN : String [254];
            acceptUnknownPartner : Bool;
            useLComProtocol : Bool;
            lifeSignCycleTime : Time;
         END_STRUCT;
         sender : Struct
            cycleTime : Time;
            ackTimeout : Time;
         END_STRUCT;
         timeSync : Struct
            usePartnerTimestamps : Bool;
            sendMode : USInt;
            cycleTime : Time;
            sendAtTimeOfDay : Time_Of_Day;
         END_STRUCT;
         sizeOfSendBuffer : UDInt;
         sizeOfReceiveBuffer : UDInt;
      END_STRUCT;
      partnerConfig : Struct
         connnection : Struct
            lifeSignCycleTime : Time;
         END_STRUCT;
         sender : Struct
            cycleTime : Time;
            ackTimeout : Time;
         END_STRUCT;
         timeSync : Struct
            usePartnerTimestamps : Bool;
            sendMode : USInt;
         END_STRUCT;
         sizeOfSendBuffer : UDInt;
         sizeOfReceiveBuffer : UDInt;
      END_STRUCT;
      statistics : Struct
         avgCallCycle : Real;
         avgReceiveMsgCycle : Real;
         maxReceiveMsgCycle : Time;
         LComProtocolUsed : Bool;
         activeLComVersion : USInt;
         avgMsgSendingTime : Real;
         maxMsgSendingTime : Time;
         avgMsgReceivingTime : Real;
         maxMsgReceivingTime : Time;
         numberOfSentMessages : UDInt;
         numberOfReceivedMessages : UDInt;
         totalAckTimeouts : UInt;
         totalSendCycleViolations : UInt;
         totalReceiveCycleViolations : UInt;
         totalReconnects : UInt;
         lastConnect : DTL;
         lastTimeSync : DTL;
      END_STRUCT;
      bufferIndex : USInt;
      buffer : Array[0..63] of Struct;
   END_STRUCT;
END_TYPE

TYPE "LMQTT_DB_UDT"
   STRUCT
      enable : Bool;
      publish : Bool;
