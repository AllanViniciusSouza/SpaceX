            Output_CNR_D : UDInt;
            Output_CMR : DWord;
            Out_CPR_Integer : DWord;
            Out_CPR_Fract : UDInt;
         END_STRUCT;
         Operation_Test_1 : UInt;
         MAC_ID_Port_1 : Array[0..5] of Byte;
         MAC_ID_Port_2 : Array[0..5] of Byte;
         Version_FW_FPGA : DWord;
         Temperature : Int;
         Station_Name : String[240];
