         END_STRUCT;
         Enc_Profile_Number : Struct
            Profile_Number : Byte;
            Profile_Version : USInt;
         END_STRUCT;
         Eeprom_Storage : Word;
         Object_Identification : Struct
            Manufacturer : Word;
            Encoder_Unit_Type : Word;
            FW_Version : UInt;
            FW_Date_Year : UInt;
            FW_Date_Day_Month : UInt;
            EO_Type_Class : Word;
            EO_Sub_Class : Word;
         END_STRUCT;
         Sensor_Format : Struct
            Header : DWord;
            Sensor_Type : DWord;
            Sensor_Resolution : UDInt;
            Shift_Factor_Left : UDInt;
            Shift_Factor_Right : UDInt;
            Revolutions : UDInt;
         END_STRUCT;
         Parameter_List : Array[0..26] of UInt;
         Encoder_Status_Flag : Word;
         Device_Status_Flag : Struct
            S_STAT_A : Word;
            S_STAT_B : Word;
            S_STAT_C : Word;
         END_STRUCT;
         Diag_History_Absolute : Struct
            Power_Up_Counter : UDInt;
            Operating_Time : UDInt;
            Maximum_Speed : UDInt;
            Counter_Rotation_fw : UDInt;
            Counter_Rotation_bw : UDInt;
            Counter_Rotation_alt : UDInt;
            Counter_Motion : UDInt;
            Reserved : UDInt;
            LED_Current_Maximum : UDInt;
            LED_Current_Minimum : UDInt;
            Voltage_Maximum : UDInt;
            Temperatur_Maximum : DInt;
            Temperature_Minimum : DInt;
         END_STRUCT;
         Diag_History_Relative : Struct
            Power_Up_Counter : UDInt;
            Operating_Time : UDInt;
            Maximum_Speed : UDInt;
            Counter_Rotation_fw : UDInt;
            Counter_Rotation_bw : UDInt;
            Counter_Rotation_alt : UDInt;
            Counter_Motion : UDInt;
            Reserved : UDInt;
            LED_Current_Maximum : UDInt;
            LED_Current_Minimum : UDInt;
            Voltage_Maximum : UDInt;
            Temperatur_Maximum : DInt;
            Temperature_Minimum : DInt;
         END_STRUCT;
         Diag_Hist_Err_Counter : Array[0..15] of UInt;
         Speed_Calculation : Struct
            Control : UInt;
            Velocity_Measuring_Unit : UInt;
            Update_Time_Tu : UInt;
            Update_Time_Ti : UInt;
            Upper_Limit : UInt;
