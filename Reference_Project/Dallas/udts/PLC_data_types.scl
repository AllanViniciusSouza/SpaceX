TYPE "ST_SICK_AFx60"
   STRUCT
      ParameterSelection : Struct
         Telegram_Number : Bool;
         Device_Identification : Bool;
         Enc_Profile_Number : Bool;
         Eeprom_Storage : Bool;
         Object_Identification : Bool;
         Sensor_Format : Bool;
         Parameter_List : Bool;
         Encoder_Status_Flag : Bool;
         Device_Status_Flag : Bool;
         Diag_History_Absolute : Bool;
         Diag_History_Relative : Bool;
         Diag_Hist_Err_Counter : Bool;
         Speed_Calculation : Bool;
         Temperature_Limits : Bool;
         Voltage_Limits : Bool;
         Scaling_Parameters : Bool;
         Operation_Test_1 : Bool;
         MAC_ID_Port_1 : Bool;
         MAC_ID_Port_2 : Bool;
         Version_FW_FPGA : Bool;
         Temperature : Bool;
         Station_Name : Bool;
         Station_IP : Bool;
         Station_MAC_ID : Bool;
         Station_Gateway : Bool;
         Station_Subnet : Bool;
         Preset_Value : Bool;
         Operating_Status : Bool;
      END_STRUCT;
      Parameter : Struct
         Telegram_Number : UInt;
         Device_Identification : Struct
            Manufacturer : Word;
            Encoder_Unit_Type : Word;
            FW_Version : UInt;
