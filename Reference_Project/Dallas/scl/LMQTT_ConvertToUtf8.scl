FUNCTION "LMQTT_ConvertToUtf8"   // FC 6, author SIEMENS

VAR_INPUT
   character : WChar;   // Character that shall be converted to UTF-8
END_VAR

VAR_OUTPUT
   convertedUtf8 : DWord;   // UTF-8 conformant byte sequence. B0 stores first Byte, B1 second and B2 third Byte. B3 is not used
   bytesUsed : USInt;   // Amount of Bytes converted. Ranges from 1 to 3.
   error : Bool;   // TRUE: An error occurred during the execution of the FC
   status : Word;   // 16#0000 - 16#7FFF: Status of the FC, 16#8000 - 16#FFFF: Error identification
END_VAR

VAR_TEMP
   tempStatus : Word;   // temp value for output 'status'
   tempConvertedUtf8 : DWord;   // temp value for output 'convertedUtf8'
   tempBytesUsed : USInt;   // temp value for output 'bytesUsed'
   tempCharacter : WChar;   // temp value for input 'character'
END_VAR

VAR CONSTANT
   STATUS_NO_ERROR : Word := 16#0000;   // no error status
   STATUS_EXECUTION_FINISHED : Word := 16#0000;   // Execution finished without errors
   ERR_UNDEFINED : Word := 16#8000;   // Error due to an undefined case
   USINT_NULL : USInt := 0;   // Init value with 0
   DWORD_NULL : DWord := 16#0000_0000;   // Init value with 0
   EMPTY_WCHAR : WChar := WCHAR#' ';   // Empty WChar for comparison
   BELOW_7F : Word := 16#007F;   // Upper limit for character if only one Byte used
   BELOW_7FF : Word := 16#07FF;   // Upper limit for character if  two Byte used
   BELOW_MAX_FFFF : Word := 16#FFFF;   // Upper limit for character if three Byte used
   BYTE_3F : Byte := 16#3F;   // Conversion Value
   BYTE_80 : Byte := 16#80;   // Conversion Value
   BYTE_C0 : Byte := 16#C0;   // Conversion Value
   BYTE_E0 : Byte := 16#E0;   // Conversion Value
   USINT_ONE : USInt := 1;   // Const Value to assign amount of bytes used
   USINT_TWO : USInt := 2;   // Const Value to assign amount of bytes used
   USINT_THREE : USInt := 3;   // Const Value to assign amount of bytes used
END_VAR

   // RETURN : Void
BEGIN
REGION BLOCK INFO HEADER
    //=============================================================================
    // SIEMENS AG
    // (c)Copyright 2020
    //-----------------------------------------------------------------------------
    // Library:       LMQTT
    // Tested with:   CPU 1516-3 PN/DP V2.8
    // Engineering:   TIA Portal V16
    // Restrictions:  --
    // Requirements:  --
    // Functionality: Converts a single WChar Character to a valid UTF-8 encoded byte sequence and saves this to a DWord.
    //                The amount of bytes saved is stored in bytesUsed Output.
    //-----------------------------------------------------------------------------
    // Change log table:
    // Version    Date         Expert in charge         Changes applied
    // 03.00.00   01.10.2020   Siemens Online Support   First released version
    //=============================================================================
END_REGION

REGION INITIALISATION  
    // Initialize functionality: reset of variables, diagnostics, etc.
    #tempConvertedUtf8 := ;
    #tempBytesUsed := ;
    #tempStatus := ;
    //assign temp value from input:
     #tempCharacter := #character;
    
END_REGION

REGION PROGRAM LOGIC
    // Use this region for application specific code
    IF #tempCharacter =  THEN
        //will be only 1 byte occupied
        #tempConvertedUtf8 := WCHAR_TO_DWORD(#tempCharacter);
        #tempBytesUsed := ;
    ELSIF (WCHAR_TO_WORD(#tempCharacter) <= ()) THEN
        //will be only 1 byte occupied
        #tempConvertedUtf8 := WCHAR_TO_DWORD(#tempCharacter);
        #tempBytesUsed := ;
    ELSIF (WCHAR_TO_WORD(#tempCharacter) <= ()) THEN
        //will be 2 byte occupied
        #tempConvertedUtf8.%B1 := (WCHAR_TO_BYTE(#tempCharacter) AND ) OR ;
        #tempConvertedUtf8.%B0 := WORD_TO_BYTE(SHR(IN := WCHAR_TO_WORD(#tempCharacter), N := 6)) OR ;
        #tempBytesUsed := ;
    ELSIF (WCHAR_TO_WORD(#tempCharacter) <= ()) THEN
        //will be 3 byte occupied
        #tempConvertedUtf8.%B2 := (WCHAR_TO_BYTE(#tempCharacter) AND ) OR ;
        #tempConvertedUtf8.%B1 := (WORD_TO_BYTE(SHR(IN := WCHAR_TO_WORD(#tempCharacter), N := 6)) AND ) OR ;
        #tempConvertedUtf8.%B0 := WORD_TO_BYTE(SHR(IN := WCHAR_TO_WORD(#tempCharacter), N := 12)) OR ;
        #tempBytesUsed := ;
    END_IF;
END_REGION

REGION OUTPUTS
    // Write application specific temp values to outputs
    #bytesUsed := #tempBytesUsed;
    #convertedUtf8 := #tempConvertedUtf8;
    // Write error and status
    #error := #tempStatus.%X15;
    #status := #tempStatus;
    // ENO mechanism is not used --> ENO := TRUE;
     := TRUE;
END_REGION

END_FUNCTION