                //     "Shuttle_MQTT_DB".Shuttle_MQTT[6].Message.Shuttle_Status.Sensor_Inputs := STRING_TO_INT(#JSON_Tree[6].value);
                // ELSIF #JSON_Tree[6].key = 'sensorOutputs' THEN
                //     "Shuttle_MQTT_DB".Shuttle_MQTT[6].Message.Shuttle_Status.Sensor_Outputs := STRING_TO_INT(#JSON_Tree[6].value);
