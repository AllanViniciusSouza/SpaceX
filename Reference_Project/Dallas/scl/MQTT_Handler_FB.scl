                // ELSIF #JSON_Tree[6].key = 'positionId' THEN
                //     "Shuttle_MQTT_DB".Shuttle_MQTT[6].Message.Shuttle_Status.Position_ID := STRING_TO_INT(#JSON_Tree[6].value);
                // ELSIF #JSON_Tree[6].key = 'destinationId' THEN
                //     "Shuttle_MQTT_DB".Shuttle_MQTT[6].Message.Shuttle_Status.Destination_ID := STRING_TO_INT(#JSON_Tree[6].value);
