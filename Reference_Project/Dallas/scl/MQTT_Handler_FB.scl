                //     "Shuttle_MQTT_DB".Shuttle_MQTT[6].Message.Shuttle_Status.Position_X := STRING_TO_INT(#JSON_Tree[6].value);
                // ELSIF #JSON_Tree[6].key = 'positionY' THEN
                //     "Shuttle_MQTT_DB".Shuttle_MQTT[6].Message.Shuttle_Status.Position_Y := STRING_TO_INT(#JSON_Tree[6].value);
