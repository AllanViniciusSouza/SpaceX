                // ELSIF #JSON_Tree[6].key = 'loadState' THEN
                //     "Shuttle_MQTT_DB".Shuttle_MQTT[6].Message.Shuttle_Status.Load_State := (#JSON_Tree[6].value);
                // ELSIF #JSON_Tree[6].key = 'errorVehicle' THEN
                //     "Shuttle_MQTT_DB".Shuttle_MQTT[6].Message.Shuttle_Status.Error_Vehicle_1 := STRING_TO_INT(#JSON_Tree[6].value);
