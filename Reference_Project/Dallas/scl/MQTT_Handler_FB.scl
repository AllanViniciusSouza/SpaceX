                // ELSIF #JSON_Tree[6].key = 'energyLevel' THEN
                //     "Shuttle_MQTT_DB".Shuttle_MQTT[6].Message.Shuttle_Status.Energy_Level := STRING_TO_INT(#JSON_Tree[6].value);
