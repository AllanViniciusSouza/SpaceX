FUNCTION_BLOCK "Order_Table_FB_Carousel_1"   // FB 34, author 

VAR_INPUT
   System_Selected : Bool;
   AutoMan_Switch : Bool;   // Auto/Man Switch on CPU Panel - 1 = Auto, 0 = Manual
   CurrentTime : String;
   CurrentDTL : DTL;
   Watchdog : "Watchdog_Settings_UDT";
END_VAR

VAR_IN_OUT
   Cnv_Entry : "Inbound_Cnv_Control_UDT";
   Cnv_PopUp_1 : "PopUp_Cnv_Control";
   WeighingStation : "Stations_DB_UDT";
   ProfileStation : "Stations_DB_UDT";
   Cnv_PopUp_2 : "PopUp_Cnv_Control";
   Cnv_PopUp_3 : "PopUp_Cnv_Control";
   Cnv_PopUp_4 : "PopUp_Cnv_Control";
   Cnv_Exit : "Outbound_Cnv_Control";
   System : "System_UDT";
   Control_OPC_Ua : "WMS_OPC_UA";
END_VAR

VAR
   RTR_ITP1_CurrentOrder : UDInt;
   RTR_P1P2_CurrentOrder : UDInt;
   RTR_P3P4_CurrentOrder : UDInt;
   RTR_P4TO_CurrentOrder : UDInt;
   Roller_To_Roller_CurrentOrder : UDInt;
   Chain_To_Chain_CurrentOrder : UDInt;
   Pop4_To_PickSt_CurrentOrder : UDInt;
   PickSt_To_Pop1_CurrentOrder : UDInt;
   WeighingStation_CurrentOrder : UDInt := 0;
   ProfileStation_CurrentOrder : UDInt := 0;
   Roller_To_RollerDoneRTrig : R_TRIG;
   RTR_ITP1DoneRTrig : R_TRIG;
   RTR_P1P2DoneRTrig : R_TRIG;
   RTR_P3P4DoneRTrig : R_TRIG;
   RTR_P4TODoneRTrig : R_TRIG;
   Chain_To_ChainDoneRTrig : R_TRIG;
   Pop4_To_PickSt_DoneRTrig : R_TRIG;
   PickSt_To_Pop1_DoneRTrig : R_TRIG;
   WeighingStationDoneRTrig : R_TRIG;
   ProfileStationDoneRTrig : R_TRIG;
   PalletRefused_1_RTig : R_TRIG;
   ErrorRTrig : R_TRIG;
   CancelRTrig : R_TRIG;
   PauseRTrig : R_TRIG;
   ResumeRTrig : R_TRIG;
   Clear_Store : R_TRIG;
   Clear_Retrieve : R_TRIG;
   Canceling : Bool;
   RTR_ITP1_WatchdogTimer : TON_TIME;
   RTR_P1P2_WatchdogTimer : TON_TIME;
   RTR_P3P4_WatchdogTimer : TON_TIME;
   RTR_P4TO_WatchdogTimer : TON_TIME;
   Roller_To_Roller_WatchdogTimer : TON_TIME;
   Chain_To_Chain_WatchdogTimer : TON_TIME;
   Pop4_To_PickWatchdogTimer : TON_TIME;
   PickSt_To_Pop1WatchdogTimer : TON_TIME;
   WeighingStation_WatchdogTimer : TON_TIME;
   ProfileStation_WatchdogTimer : TON_TIME;
   Roller_To_Roller_WatchdogStart : Bool;
   RTR_ITP1_WatchdogStart : Bool;
   RTR_P1P2_WatchdogStart : Bool;
   RTR_P3P4_WatchdogStart : Bool;
   RTR_P4TO_WatchdogStart : Bool;
   Chain_To_Chain_WatchdogStart : Bool;
   Pop4_To_PickWatchdogStart : Bool;
   PickSt_To_Pop1WatchdogStart : Bool;
   WeighingStation_WatchdogStart : Bool;
   ProfileStation_WatchdogStart : Bool;
   dummy : Int;
   dummy_1 : Bool;
   dummy_3 : Bool;
END_VAR

VAR_TEMP
   i : DInt;
   n : DInt;
   EmptyOrder : "OrderTable_UDT";
   MaxRunningOrderNo : UInt;
END_VAR

VAR CONSTANT
   ROLLER_TO_ROLLER_DEVICE : String := 'Roller to Roller';
   CHAIN_TO_CHAIN_DEVICE : String := 'Chain to Chain';
   POP4_TO_PICK_DEVICE : String := 'Pop4 to Pick';
   PICK_TO_POP1_DEVICE : String := 'Pick to Pop1';
   WEIGH_STATION_DEVICE : String := 'Weigh Station';
   PROFILE_STATION_DEVICE : String := 'Profile Station';
   RUNNING_STATUS : String := 'Running';
   COMPLETED_STATUS : String := 'Completed';
   QUEUED_STATUS : String := 'Queued';
   PALLET_REFUSED_STATUS : String := 'Pallet Refused';
   ERROR_STATUS : String := 'Error';
   CANCELED_STATUS : String := 'Canceled';
   PAUSED_STATUS : String := 'Paused';
   ORDER_REFUSED : String := 'Refused';
   ERROR_CANCELED_STATUS : String := 'Error\Cancel';
END_VAR

BEGIN

// Converts the task type for strings 
IF #System.OrderTable[1].OPC_Control.Task_Type = 6
    OR #System.OrderTable[1].OPC_Control.Task_Type =16
        OR #System.OrderTable[1].OPC_Control.Task_Type = 14 THEN // Roller to Roller OR Roller to Roller + Barcode scanner OR Roller To Roller + Profile Station 
    #System.OrderTable[1].Device := 'Roller to Roller';
ELSIF #System.OrderTable[1].OPC_Control.Task_Type = 7 THEN
    #System.OrderTable[1].Device := 'Chain to Chain';
ELSIF #System.OrderTable[1].OPC_Control.Task_Type = 8 THEN
    #System.OrderTable[1].Device := 'Pop4 to Pick';
ELSIF #System.OrderTable[1].OPC_Control.Task_Type = 9 THEN
    #System.OrderTable[1].Device := 'Pick to Pop1' ;
ELSIF #System.OrderTable[1].OPC_Control.Task_Type = 10 THEN
    #System.OrderTable[1].Device := 'Weigh Station';
// ELSIF #System.OrderTable[1].OPC_Control.Task_Type = 14 THEN
//     #System.OrderTable[1].Device := 'Profile Station';
ELSE
    #System.OrderTable[1].Device := '';
END_IF;


REGION #New Order was Sent
    IF #System.OrderSent THEN
        //Count orders in Step Table
        FOR #i := 0 TO 20 DO
            IF #System.StepTable[#i].OrderNo <> 0
                AND #System.StepTable[#i].StepNo <> 0
                AND #System.StepTable[#i].PlaceTime <> ''
                //AND #System.StepTable[#i].Device <> ''
                AND #System.StepTable[#i].Status = 
            THEN
                #n += 1;
            ELSE
                EXIT;
            END_IF;
        END_FOR;
        
        IF #n > 0 THEN
            //shift order table down by Order number rows
            FOR #i := 99 TO (#n + 1) BY -1 DO
                #System.OrderTable[#i] := #System.OrderTable[#i - #n];
            END_FOR;
            //copy data from step table to order table
            FOR #i := 0 TO #n DO
                #System.OrderTable[#n - #i (*+ 1*)] := #System.StepTable[#i];
            END_FOR;
            //clean step table
            FOR #i := 0(*1*) TO 20 DO
                #System.StepTable[#i] := #EmptyOrder;
            END_FOR;
            #System.CurrentOrder += #n;
        
            
            // Transfer Pallet Roller to Roller - 
      
            IF #Roller_To_Roller_CurrentOrder <> 0 THEN
                #Roller_To_Roller_CurrentOrder += #n;
            END_IF;
            
            
            // Transfer Pallet Roller to Roller - Inbound to PP1
            
            IF #RTR_ITP1_CurrentOrder <> 0 THEN
                #RTR_ITP1_CurrentOrder += #n;
            END_IF;
            
            // Transfer Pallet Roller to Roller - PP1 to PP2
            
            IF #RTR_P1P2_CurrentOrder <> 0 THEN
                #RTR_P1P2_CurrentOrder += #n;
            END_IF;
            
            // Transfer Pallet Roller TO Roller - PP3 TO PP4
            
            IF #RTR_P3P4_CurrentOrder <> 0 THEN
                #RTR_P3P4_CurrentOrder += #n;
            END_IF;
            
            
            // Transfer Pallet Roller TO Roller - PP4 TO OUTBOUND
            
            IF #RTR_P4TO_CurrentOrder <> 0 THEN
                #RTR_P4TO_CurrentOrder += #n;
            END_IF;
            
            
            // Transfer Pallet Chain to Chain
            IF #Chain_To_Chain_CurrentOrder <> 0 THEN
                #Chain_To_Chain_CurrentOrder += #n;
            END_IF;
            
            // Transfer TO pick station (From Pop Conveyor 4)
            IF #Pop4_To_PickSt_CurrentOrder <> 0 THEN
                #Pop4_To_PickSt_CurrentOrder += #n;
            END_IF;
            
            // Transfer from Pick station (To Pop Conveyor 1)
            IF #PickSt_To_Pop1_CurrentOrder <> 0 THEN
                #PickSt_To_Pop1_CurrentOrder += #n;
            END_IF;
            
            
            //Weigh Station
            IF #WeighingStation_CurrentOrder <> 0 THEN
                #WeighingStation_CurrentOrder += #n;
            END_IF;
            
            //Profile Station
            IF #ProfileStation_CurrentOrder <> 0 THEN
                #ProfileStation_CurrentOrder += #n;
            END_IF;
       
       
        END_IF;
         #System.OrderSent := FALSE;
    END_IF;
END_REGION

REGION Auto/Man Mode
    //Enable Devices in Auto/Man Mode
    IF #System.Auto_Man THEN
      //  #Cnv_Entry.Mode := #Cnv_PopUp_1.Mode:= #WeighingStation.Mode := #ProfileStation.Mode :=
       // #Cnv_PopUp_2.Mode := #Cnv_PopUp_3.Mode := #Cnv_PopUp_4.Mode := #Cnv_Exit.Mode := 3;// Auto Mode
        
        #Cnv_Entry.Instruction.Enable := #Cnv_PopUp_1.Instruction.Enable := #WeighingStation.Enable :=
        #ProfileStation.Enable := #Cnv_PopUp_2.Instruction.Enable := #Cnv_PopUp_3.Enabled := #Cnv_PopUp_4.Instruction.Enable :=
        #Cnv_Exit.Instruction.Enable := TRUE; // := Not System.Error
        
    ELSE //Disable Devices in Auto/Man Mode
       // #Cnv_Entry.Mode := #Cnv_PopUp_1.Mode := #WeighingStation.Mode := #ProfileStation.Mode :=
      //  #Cnv_PopUp_2.Mode := #Cnv_PopUp_3.Mode := #Cnv_PopUp_4.Mode := #Cnv_Exit.Mode:= 0;
        #Cnv_Entry.Instruction.Enable := #Cnv_PopUp_1.Instruction.Enable := #WeighingStation.Enable :=
        #ProfileStation.Enable := #Cnv_PopUp_2.Instruction.Enable := #Cnv_PopUp_3.Enabled := #Cnv_PopUp_4.Instruction.Enable :=
        #Cnv_Exit.Instruction.Enable := FALSE;
    END_IF;
END_REGION

REGION Roller to Roller - Carousel Conveyors - Original
    //Roller conveyors
    IF #System.OrderTable[1].StepNo <> 0
        AND #System.OrderTable[1].Device = 
        AND #System.OrderTable[1].Status = 
       // AND NOT (#Cnv_Entry.Running OR #Cnv_Exit.Running OR #Cnv_PopUp_1.Running OR #Cnv_PopUp_2.Running  OR #Cnv_PopUp_3.Running OR #Cnv_PopUp_4.Running)
        AND NOT #System.Error
        AND NOT #Canceling
      //  AND #System.OrderTable[#PickSt_To_Pop1_CurrentOrder].Status <> #RUNNING_STATUS
        //AND #System.OrderTable[#Roller_To_Roller_CurrentOrder].Status <> #RUNNING_STATUS
       // AND #System.OrderTable[#Chain_To_Chain_CurrentOrder].Status <> #RUNNING_STATUS
       // 
       // AND "OPC_UA_Control_FB_DB".State_Carrousel = 10 // OPC UA ready to receive next transaction
    THEN
        #Roller_To_Roller_CurrentOrder := 1;
    END_IF;
    IF #System.OrderTable[#Roller_To_Roller_CurrentOrder].StepNo <> 0
        AND #System.OrderTable[#Roller_To_Roller_CurrentOrder].Device = 
        AND #System.OrderTable[#Roller_To_Roller_CurrentOrder].Status = 
        //AND NOT (#Cnv_Entry.Running OR #Cnv_Exit.Running OR #Cnv_PopUp_1.Running OR #Cnv_PopUp_2.Running  OR #Cnv_PopUp_3.Running OR #Cnv_PopUp_4.Running)
        AND NOT #System.Error
        AND NOT #Canceling
       // AND #System.OrderTable[#PickSt_To_Pop1_CurrentOrder].Status <> #RUNNING_STATUS
       //AND #System.OrderTable[#Roller_To_Roller_CurrentOrder].Status <> #RUNNING_STATUS
       // AND #System.OrderTable[#Chain_To_Chain_CurrentOrder].Status <> #RUNNING_STATUS
    THEN
        //OPC Commands to Move Pallets - Carousel Conveyors
        // WCS => Order Table => OPC Ua Control Table
        // 
        IF #System.OrderTable[1].OPC_Control.Task_Type = 14 THEN // Profile Station - P1 TO P2
            "Control_DB"."Profiling Station".Start := TRUE;
        ELSE
            "Control_DB"."Profiling Station".Start :=FALSE;
        END_IF;
            
        IF #System.OrderTable[1].OPC_Control.Task_Type = 16 THEN // Barcode Scanner - INB TO P1
            "Control_DB"."InBarcode_Station".Start := TRUE;
        ELSE
            "Control_DB"."InBarcode_Station".Start := FALSE;
        END_IF;
        
        //"Control_DB".InBarcode_Station.Start := TRUE;
        "Control_DB"."Carrousel_Order Table".Task_Data_Available := TRUE;//#System.OrderTable[#Roller_To_Roller_CurrentOrder].OPC_Control.Task_Data_Available; // Send the Task Data Available from WCS 
        "Control_DB"."Carrousel_Order Table".Task_Type := #System.OrderTable[#Roller_To_Roller_CurrentOrder].OPC_Control.Task_Type; //  Send the Task Type - Roller to Roller Conveyor = Task Type = 6
        "Control_DB"."Carrousel_Order Table".Task_ID := #System.OrderTable[#Roller_To_Roller_CurrentOrder].OPC_Control.Task_ID; // Send the Task ID number;
        "Control_DB"."Carrousel_Order Table".Task_Metadata := #System.OrderTable[#Roller_To_Roller_CurrentOrder].OPC_Control.Task_Metadata; // Send the Task Metadata Unique identifier
        "Control_DB"."Carrousel_Order Table".Source_Location:=#System.OrderTable[#Roller_To_Roller_CurrentOrder].OPC_Control.Source_Location; // Send the Source Location from the Conveyor
        "Control_DB"."Carrousel_Order Table".Destination_Location := #System.OrderTable[#Roller_To_Roller_CurrentOrder].OPC_Control.Destination_Location; // Send the Destination Location to the Conveyor;
        #Roller_To_Roller_WatchdogStart := true;
      
        
    END_IF;
    
    //RUNNING
    IF (#Cnv_Entry.Running OR #Cnv_Exit.Running OR #Cnv_PopUp_1.Running OR #Cnv_PopUp_2.Running
        OR #Cnv_PopUp_3.Running OR #Cnv_PopUp_4.Running)AND #System.Auto_Man THEN
        // "Control_DB"."Profiling Station".Start := FALSE;
        // "Control_DB".InBarcode_Station.Start := FALSE;
        // "Control_DB"."Carrousel_Order Table".Task_Data_Available := FALSE; // Send the Task Data Available from WCS 
        // "Control_DB"."Carrousel_Order Table".Task_Type := 0; //  Send the Task Type - Roller to Roller Conveyor = Task Type = 6
        // "Control_DB"."Carrousel_Order Table".Task_ID := 0; // Send the Task ID number;
        // "Control_DB"."Carrousel_Order Table".Task_Metadata := ''; // Send the Task Metadata Unique identifier
        // "Control_DB"."Carrousel_Order Table".Source_Location := 0; // Send the Source Location from the Conveyor
        // "Control_DB"."Carrousel_Order Table".Destination_Location := 0; // Send the Destination Location to the Conveyor;
        
        //#Cnv_Entry.Instruction.Execute := FALSE;
        #System.OrderTable[#Roller_To_Roller_CurrentOrder].Status := ;
    END_IF;
    
    //Cancel order
    IF #Canceling AND NOT (#Cnv_Entry.Running OR #Cnv_Exit.Running OR #Cnv_PopUp_1.Running OR
        #Cnv_PopUp_2.Running OR #Cnv_PopUp_3.Running OR #Cnv_PopUp_4.Running) AND #Roller_To_Roller_CurrentOrder <> 0
    THEN
        #System.OrderTable[#Roller_To_Roller_CurrentOrder].Status := ;
        #System.OrderTable[#Roller_To_Roller_CurrentOrder].CompleteTime := #CurrentTime;
        #Roller_To_Roller_CurrentOrder := 0;
        
        "Control_DB"."Profiling Station".Start := FALSE;
        "Control_DB".InBarcode_Station.Start := FALSE;
        "Control_DB"."Carrousel_Order Table".Task_Data_Available := FALSE; // Send the Task Data Available from WCS 
        "Control_DB"."Carrousel_Order Table".Task_Type := 0; //  Send the Task Type - Roller to Roller Conveyor = Task Type = 6
        "Control_DB"."Carrousel_Order Table".Task_ID := 0; // Send the Task ID number;
        "Control_DB"."Carrousel_Order Table".Task_Metadata := ''; // Send the Task Metadata Unique identifier
        "Control_DB"."Carrousel_Order Table".Source_Location := 0; // Send the Source Location from the Conveyor
        "Control_DB"."Carrousel_Order Table".Destination_Location := 0; // Send the Destination Location to the Conveyor;
        //#Cnv_Entry.Instruction.Execute := FALSE;
    END_IF;
    
    //Error
    IF (#Cnv_Entry.Error OR #Cnv_Exit.Error OR #Cnv_PopUp_1.Error OR #Cnv_PopUp_2.Error OR #Cnv_PopUp_3.Error OR #Cnv_PopUp_4.Error) THEN
        //#Cnv_Entry.Instruction.Execute := FALSE;
        "Control_DB"."Profiling Station".Start := FALSE;
        "Control_DB".InBarcode_Station.Start := FALSE;
        "Control_DB"."Carrousel_Order Table".Task_Data_Available := FALSE; // Send the Task Data Available from WCS 
        "Control_DB"."Carrousel_Order Table".Task_Type := 0; //  Send the Task Type - Roller to Roller Conveyor = Task Type = 6
        "Control_DB"."Carrousel_Order Table".Task_ID := 0; // Send the Task ID number;
        "Control_DB"."Carrousel_Order Table".Task_Metadata := ''; // Send the Task Metadata Unique identifier
        "Control_DB"."Carrousel_Order Table".Source_Location := 0; // Send the Source Location from the Conveyor
        "Control_DB"."Carrousel_Order Table".Destination_Location := 0; // Send the Destination Location to the Conveyor;
        #System.OrderTable[#Roller_To_Roller_CurrentOrder].ErrorID := (#Cnv_Entry.Cnv_Errors.Error_Word_4
        OR #Cnv_Exit.Cnv_Errors.Error_Word_4
        OR #Cnv_PopUp_1.Cnv_Errors.Error_Word_1
        OR #Cnv_PopUp_2.Cnv_Errors.Error_Word_1
        OR #Cnv_PopUp_3.Cnv_Errors.Error_Word_1
        OR #Cnv_PopUp_4.Cnv_Errors.Error_Word_1);
        
    END_IF;
    
    //MOVEMENT FINALIZED
    #Roller_To_RollerDoneRTrig(CLK :="Control_DB"."Carrousel_Order Table".Movement_Request_Complete);
    IF #Roller_To_RollerDoneRTrig.Q THEN
        
        "Control_DB"."Profiling Station".Start := FALSE;
        "Control_DB".InBarcode_Station.Start := FALSE;
        "Control_DB"."Carrousel_Order Table".Task_Data_Available := FALSE; // Send the Task Data Available from WCS 
        "Control_DB"."Carrousel_Order Table".Task_Type := 0; //  Send the Task Type - Roller to Roller Conveyor = Task Type = 6
        "Control_DB"."Carrousel_Order Table".Task_ID := 0; // Send the Task ID number;
        "Control_DB"."Carrousel_Order Table".Task_Metadata := ''; // Send the Task Metadata Unique identifier
        "Control_DB"."Carrousel_Order Table".Source_Location := 0; // Send the Source Location from the Conveyor
        "Control_DB"."Carrousel_Order Table".Destination_Location := 0; // Send the Destination Location to the Conveyor;
        
        #Roller_To_Roller_WatchdogStart := FALSE;
        #System.OrderTable[#Roller_To_Roller_CurrentOrder].Status := ;
        #System.OrderTable[#Roller_To_Roller_CurrentOrder].CompleteTime := #CurrentTime;
        #Roller_To_Roller_CurrentOrder := 0;
    END_IF;
END_REGION

REGION Roller TO Roller - Carousel Conveyors - Inbound to PP1 - With Barcode
//Roller conveyors
IF #System.OrderTable[1].StepNo <> 0
    AND #System.OrderTable[1].Device = 
    AND #System.OrderTable[1].Status = 
    // AND NOT (#Cnv_Entry.Running OR #Cnv_Exit.Running OR #Cnv_PopUp_1.Running OR #Cnv_PopUp_2.Running  OR #Cnv_PopUp_3.Running OR #Cnv_PopUp_4.Running)
    AND NOT #System.Error
    AND NOT #Canceling
    //  AND #System.OrderTable[#PickSt_To_Pop1_CurrentOrder].Status <> #RUNNING_STATUS
    //AND #System.OrderTable[#Roller_To_Roller_CurrentOrder].Status <> #RUNNING_STATUS
    // AND #System.OrderTable[#Chain_To_Chain_CurrentOrder].Status <> #RUNNING_STATUS
    // 
    // AND "OPC_UA_Control_FB_DB".State_Carrousel = 10 // OPC UA ready to receive next transaction
THEN
    #Roller_To_Roller_CurrentOrder := 1;
END_IF;
IF #System.OrderTable[#Roller_To_Roller_CurrentOrder].StepNo <> 0
    AND #System.OrderTable[#Roller_To_Roller_CurrentOrder].Device = 
    AND #System.OrderTable[#Roller_To_Roller_CurrentOrder].Status = 
    //AND NOT (#Cnv_Entry.Running OR #Cnv_Exit.Running OR #Cnv_PopUp_1.Running OR #Cnv_PopUp_2.Running  OR #Cnv_PopUp_3.Running OR #Cnv_PopUp_4.Running)
    AND NOT #System.Error
    AND NOT #Canceling
    // AND #System.OrderTable[#PickSt_To_Pop1_CurrentOrder].Status <> #RUNNING_STATUS
    //AND #System.OrderTable[#Roller_To_Roller_CurrentOrder].Status <> #RUNNING_STATUS
    // AND #System.OrderTable[#Chain_To_Chain_CurrentOrder].Status <> #RUNNING_STATUS
THEN
    //OPC Commands to Move Pallets - Carousel Conveyors
    // WCS => Order Table => OPC Ua Control Table
    // 
    IF #System.OrderTable[1].OPC_Control.Task_Type = 14 THEN // Profile Station - P1 TO P2
        "Control_DB"."Profiling Station".Start := TRUE;
    ELSE
        "Control_DB"."Profiling Station".Start := FALSE;
    END_IF;
    
    IF #System.OrderTable[1].OPC_Control.Task_Type = 16 THEN // Barcode Scanner - INB TO P1
        "Control_DB"."InBarcode_Station".Start := TRUE;
    ELSE
        "Control_DB"."InBarcode_Station".Start := FALSE;
    END_IF;
    
    //"Control_DB".InBarcode_Station.Start := TRUE;
    "Control_DB"."Carrousel_Order Table".Task_Data_Available := TRUE;//#System.OrderTable[#Roller_To_Roller_CurrentOrder].OPC_Control.Task_Data_Available; // Send the Task Data Available from WCS 
    "Control_DB"."Carrousel_Order Table".Task_Type := #System.OrderTable[#Roller_To_Roller_CurrentOrder].OPC_Control.Task_Type; //  Send the Task Type - Roller to Roller Conveyor = Task Type = 6
    "Control_DB"."Carrousel_Order Table".Task_ID := #System.OrderTable[#Roller_To_Roller_CurrentOrder].OPC_Control.Task_ID; // Send the Task ID number;
    "Control_DB"."Carrousel_Order Table".Task_Metadata := #System.OrderTable[#Roller_To_Roller_CurrentOrder].OPC_Control.Task_Metadata; // Send the Task Metadata Unique identifier
    "Control_DB"."Carrousel_Order Table".Source_Location := #System.OrderTable[#Roller_To_Roller_CurrentOrder].OPC_Control.Source_Location; // Send the Source Location from the Conveyor
    "Control_DB"."Carrousel_Order Table".Destination_Location := #System.OrderTable[#Roller_To_Roller_CurrentOrder].OPC_Control.Destination_Location; // Send the Destination Location to the Conveyor;
    #Roller_To_Roller_WatchdogStart := true;
    
    
END_IF;

//RUNNING
IF (#Cnv_Entry.Running OR #Cnv_Exit.Running OR #Cnv_PopUp_1.Running OR #Cnv_PopUp_2.Running
    OR #Cnv_PopUp_3.Running OR #Cnv_PopUp_4.Running) AND #System.Auto_Man THEN
    // "Control_DB"."Profiling Station".Start := FALSE;
    // "Control_DB".InBarcode_Station.Start := FALSE;
    // "Control_DB"."Carrousel_Order Table".Task_Data_Available := FALSE; // Send the Task Data Available from WCS 
    // "Control_DB"."Carrousel_Order Table".Task_Type := 0; //  Send the Task Type - Roller to Roller Conveyor = Task Type = 6
    // "Control_DB"."Carrousel_Order Table".Task_ID := 0; // Send the Task ID number;
    // "Control_DB"."Carrousel_Order Table".Task_Metadata := ''; // Send the Task Metadata Unique identifier
    // "Control_DB"."Carrousel_Order Table".Source_Location := 0; // Send the Source Location from the Conveyor
    // "Control_DB"."Carrousel_Order Table".Destination_Location := 0; // Send the Destination Location to the Conveyor;
    
    //#Cnv_Entry.Instruction.Execute := FALSE;
    #System.OrderTable[#Roller_To_Roller_CurrentOrder].Status := ;
END_IF;

//Cancel order
IF #Canceling AND NOT (#Cnv_Entry.Running OR #Cnv_Exit.Running OR #Cnv_PopUp_1.Running OR
    #Cnv_PopUp_2.Running OR #Cnv_PopUp_3.Running OR #Cnv_PopUp_4.Running) AND #Roller_To_Roller_CurrentOrder <> 0
THEN
    #System.OrderTable[#Roller_To_Roller_CurrentOrder].Status := ;
    #System.OrderTable[#Roller_To_Roller_CurrentOrder].CompleteTime := #CurrentTime;
    #Roller_To_Roller_CurrentOrder := 0;
    
    "Control_DB"."Profiling Station".Start := FALSE;
    "Control_DB".InBarcode_Station.Start := FALSE;
    "Control_DB"."Carrousel_Order Table".Task_Data_Available := FALSE; // Send the Task Data Available from WCS 
    "Control_DB"."Carrousel_Order Table".Task_Type := 0; //  Send the Task Type - Roller to Roller Conveyor = Task Type = 6
    "Control_DB"."Carrousel_Order Table".Task_ID := 0; // Send the Task ID number;
    "Control_DB"."Carrousel_Order Table".Task_Metadata := ''; // Send the Task Metadata Unique identifier
    "Control_DB"."Carrousel_Order Table".Source_Location := 0; // Send the Source Location from the Conveyor
    "Control_DB"."Carrousel_Order Table".Destination_Location := 0; // Send the Destination Location to the Conveyor;
    //#Cnv_Entry.Instruction.Execute := FALSE;
END_IF;

//Error
IF (#Cnv_Entry.Error OR #Cnv_Exit.Error OR #Cnv_PopUp_1.Error OR #Cnv_PopUp_2.Error OR #Cnv_PopUp_3.Error OR #Cnv_PopUp_4.Error) THEN
    //#Cnv_Entry.Instruction.Execute := FALSE;
    "Control_DB"."Profiling Station".Start := FALSE;
    "Control_DB".InBarcode_Station.Start := FALSE;
    "Control_DB"."Carrousel_Order Table".Task_Data_Available := FALSE; // Send the Task Data Available from WCS 
