REGION Max Running Order Number
    #MaxRunningOrderNo := MAX(IN1 := #Roller_To_Roller_CurrentOrder, IN2 := #Chain_To_Chain_CurrentOrder,
                              IN3 := #Pop4_To_PickSt_CurrentOrder, IN4 := #PickSt_To_Pop1_CurrentOrder,
                              IN5 := #WeighingStation_CurrentOrder, IN6 := #ProfileStation_CurrentOrder);
END_REGION

REGION Pause Orders
    #ErrorRTrig(CLK := #System.Error);
    #PauseRTrig(CLK := #System.PauseOrders OR NOT #System.Auto_Man);
    IF #ErrorRTrig.Q OR #PauseRTrig.Q THEN
        #System.PauseOrders := FALSE;
        #System.Paused := #MaxRunningOrderNo > 0;
        IF #System.Paused THEN
            FOR #i := 1 TO UDINT_TO_DINT(#MaxRunningOrderNo) DO
                IF #System.OrderTable[#i].Status = '' THEN
                    EXIT;
                ELSIF #System.OrderTable[#i].Status =  THEN
                    #System.OrderTable[#i].Status := ;
                ELSIF #System.OrderTable[#i].Status =  AND NOT #System.Auto_Man THEN
                    #System.OrderTable[#i].Status := ;
                END_IF;
            END_FOR;
        END_IF;
    END_IF;
    IF #System.Paused AND #MaxRunningOrderNo = 0 THEN
        #System.Paused := FALSE;
    END_IF;
END_REGION

REGION Cancel Orders
    #CancelRTrig(CLK := #System.CancelOrders);
    #WeighingStation.Cancel := #ProfileStation.Cancel := #CancelRTrig.Q;
    IF #CancelRTrig.Q THEN
        #Canceling := TRUE;
        #System.CancelOrders := FALSE;
        #System.Paused := FALSE;
        FOR #i := 1 TO UDINT_TO_DINT(#MaxRunningOrderNo) DO
            IF #System.OrderTable[#i].Status = '' THEN
                CONTINUE;
            ELSIF #System.OrderTable[#i].Status = 
                OR #System.OrderTable[#i].Status = 
            THEN
                #System.OrderTable[#i].Status := ;
                #System.OrderTable[#i].CompleteTime := #CurrentTime;
            ELSIF #System.OrderTable[#i].Status = 
            THEN
                #System.OrderTable[#i].Status := ;
                #System.OrderTable[#i].CompleteTime := #CurrentTime;
            END_IF;
        END_FOR;
        #System.CurrentOrder := 0;
    END_IF;
    IF #Canceling AND NOT (#Cnv_Entry.Running OR #Cnv_PopUp_1.Running OR #WeighingStation.Running OR #ProfileStation.Running
        OR #Cnv_PopUp_2.Running OR #Cnv_PopUp_3.Running OR #Cnv_PopUp_4.Running OR #Cnv_Exit.Running) THEN
        #Canceling := FALSE;
        #Roller_To_Roller_CurrentOrder := #Chain_To_Chain_CurrentOrder:= #PickSt_To_Pop1_CurrentOrder := #Pop4_To_PickSt_CurrentOrder := 0;
         #WeighingStation_CurrentOrder:= #ProfileStation_CurrentOrder := 0;
    END_IF;
END_REGION

REGION Resume Orders
    #ResumeRTrig(CLK := #System.ResumeOrders);
    IF #ResumeRTrig.Q THEN
        #System.ResumeOrders := FALSE;
        #System.CurrentOrder := #MaxRunningOrderNo;
        IF NOT #System.Error THEN
            #System.Paused := FALSE;
            FOR #i := 1 TO UDINT_TO_DINT(#MaxRunningOrderNo) DO
                IF #System.OrderTable[#i].Status = '' THEN
                    EXIT;
                ELSIF #System.OrderTable[#i].Status = 
                    OR #System.OrderTable[#i].Status = 
                THEN
                    #System.OrderTable[#i].Status := ;
                END_IF;
            END_FOR;
        END_IF;

    END_IF;
END_REGION

REGION Order Handler
    IF #System.Running AND NOT #System.Error
        AND (#System.OrderTable[#System.CurrentOrder].Status = 
        OR #System.OrderTable[#System.CurrentOrder].Status = 
        OR #System.OrderTable[#System.CurrentOrder].Status = 
        OR #System.OrderTable[#System.CurrentOrder].Sequence = 0)
    THEN
        IF #System.CurrentOrder > 0 THEN
            #System.CurrentOrder -= 1;
        ELSE
            #System.CurrentOrder := 0;
        END_IF;
    END_IF;
END_REGION

REGION Watchdogs
    //Watchdog Timers
    #PickSt_To_Pop1WatchdogTimer(IN := #PickSt_To_Pop1WatchdogStart,
                                 PT := UDINT_TO_TIME(#Watchdog.Pick_TO_Pop1 * 60000),
                                 Q => #System.Watchdog_TimeOut.Pick_TO_Pop1);
    #Roller_To_Roller_WatchdogTimer(IN := #Roller_To_Roller_WatchdogStart,
                                    PT := UDINT_TO_TIME(#Watchdog.Roller_TO_Roller * 60000),
                                    Q => #System.Watchdog_TimeOut.Roller_TO_Roller);
    #Chain_To_Chain_WatchdogTimer(IN := #Chain_To_Chain_WatchdogStart,
                                  PT := UDINT_TO_TIME(#Watchdog.Chain_TO_Chain * 60000),
                                  Q => #System.Watchdog_TimeOut.Chain_TO_Chain);
    #Pop4_To_PickWatchdogTimer(IN := #Pop4_To_PickWatchdogStart,
                               PT := UDINT_TO_TIME(#Watchdog.Pop4_TO_Pick * 60000),
                               Q => #System.Watchdog_TimeOut.Pop4_TO_Pick);
    #WeighingStation_WatchdogTimer(IN := #WeighingStation_WatchdogStart,
                                   PT := UDINT_TO_TIME(#Watchdog.Weigh_Station * 60000),
                                   Q => #System.Watchdog_TimeOut.Weigh_Station);
    #ProfileStation_WatchdogTimer(IN := #ProfileStation_WatchdogStart,
                                  PT := UDINT_TO_TIME(#Watchdog.Profile_Station * 60000),
                                  Q => #System.Watchdog_TimeOut.Profile_Station);
    
    //Reset  Watchdog Timers
    IF #System.Error OR #CancelRTrig.Q OR #PauseRTrig.Q OR "Reset_All" THEN
        #PickSt_To_Pop1WatchdogStart := FALSE;
        #Roller_To_Roller_WatchdogStart := FALSE;
        #Chain_To_Chain_WatchdogStart := FALSE;
        #Pop4_To_PickWatchdogStart := FALSE;
        #WeighingStation_WatchdogStart := FALSE;
        #ProfileStation_WatchdogStart := FALSE;
       
    END_IF;
END_REGION

REGION Reset Next Order Number
    IF #System.NextOrder > 1
        AND #CurrentDTL.HOUR = 0
        AND #CurrentDTL.MINUTE = 0
        AND #CurrentDTL.SECOND = 0
    THEN
        #System.NextOrder := 1;
    END_IF;
        
END_REGION

REGION #System Mode and State
    #System.Selected := #System_Selected; // System selected
    #System.Ready := NOT #System.Error AND #System.Selected;
    #System.Auto_Man := #AutoMan_Switch;
    #System.Running := #Cnv_Entry.Running OR #Cnv_PopUp_1.Running OR #WeighingStation.Running
    OR #ProfileStation.Running OR #Cnv_PopUp_3.Running OR #Cnv_PopUp_4.Running;
            
    #System.Error := #Cnv_Entry.Error OR #Cnv_PopUp_1.Error OR #Cnv_PopUp_2.Error OR #Cnv_PopUp_3.Error OR #Cnv_PopUp_4.Error
    OR #Cnv_Exit.Error ; (*Implement Weigh station error and Profile Station error*)
    #System.IDLE := NOT #System.Running AND NOT #System.Paused AND NOT #System.Error;
    IF #System.Running THEN
        #System.State := 1;
    ELSIF #System.Paused AND NOT #System.Error THEN
        #System.State := 2;
    ELSIF #System.Error THEN
        #System.State := 3;
    ELSE
        #System.State := 0;
    END_IF;
END_REGION
END_FUNCTION_BLOCK