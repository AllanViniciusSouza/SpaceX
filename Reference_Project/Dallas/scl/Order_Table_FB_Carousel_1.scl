    END_IF;
    
    //RUNNING
    IF ("Control_DB"."Profiling Station".Running) AND #System.Auto_Man THEN
        //#Cnv_Entry.Instruction.Execute := FALSE;
        #System.OrderTable[#ProfileStation_CurrentOrder].Status := #RUNNING_STATUS;
        
        "Control_DB"."Carrousel_Order Table".Task_Data_Available := FALSE;//#System.OrderTable[#ProfileStation_CurrentOrder].OPC_Control.Task_Data_Available; // Send the Task Data Available from WCS 
        "Control_DB"."Carrousel_Order Table".Task_Type := 0; //  Send the Task Type - Start Weigh Station = Task Type = 10
        "Control_DB"."Carrousel_Order Table".Task_ID := 0; // Send the Task ID number;
        "Control_DB"."Carrousel_Order Table".Task_Metadata := ''; // Send the Task Metadata Unique identifier
        #ProfileStation_WatchdogStart := true;
    END_IF;
    
    //Cancel order
    IF #Canceling AND NOT ("Control_DB"."Profiling Station".Running) AND #ProfileStation_CurrentOrder <> 0 THEN
        #System.OrderTable[#ProfileStation_CurrentOrder].Status := #CANCELED_STATUS;
        #System.OrderTable[#ProfileStation_CurrentOrder].CompleteTime := #CurrentTime;
        #ProfileStation_CurrentOrder := 0;
        "Control_DB"."Carrousel_Order Table".Task_Data_Available := FALSE;//#System.OrderTable[#ProfileStation_CurrentOrder].OPC_Control.Task_Data_Available; // Send the Task Data Available from WCS 
        "Control_DB"."Carrousel_Order Table".Task_Type := 0; //  Send the Task Type - Start Weigh Station = Task Type = 10
        "Control_DB"."Carrousel_Order Table".Task_ID := 0; // Send the Task ID number;
        "Control_DB"."Carrousel_Order Table".Task_Metadata := ''; // Send the Task Metadata Unique identifier
        //#Cnv_Entry.Instruction.Execute := FALSE;
    END_IF;
    (*  
      //Error
      IF (#WeighingStation. OR #Cnv_PopUp_3.Error) THEN
          //#Cnv_Entry.Instruction.Execute := FALSE;
          
          #System.OrderTable[#WeighingStation_CurrentOrder].ErrorID := (#Cnv_PopUp_2.Cnv_Errors.Error_Word_1
        OR #Cnv_PopUp_3.Cnv_Errors.Error_Word_1);
          
      END_IF;
     *)
     //MOVEMENT FINALIZED
    #ProfileStationDoneRTrig(CLK := "Control_DB"."Profiling Station".Done);
    IF #ProfileStationDoneRTrig.Q THEN
         #ProfileStation_WatchdogStart := FALSE;
         #System.OrderTable[#ProfileStation_CurrentOrder].Status := #COMPLETED_STATUS;
         #System.OrderTable[#ProfileStation_CurrentOrder].CompleteTime := #CurrentTime;
         #ProfileStation_CurrentOrder := 0;
         "Control_DB"."Carrousel_Order Table".Task_Data_Available := FALSE;//#System.OrderTable[#ProfileStation_CurrentOrder].OPC_Control.Task_Data_Available; // Send the Task Data Available from WCS 
         "Control_DB"."Carrousel_Order Table".Task_Type := 0; //  Send the Task Type - Start Weigh Station = Task Type = 10
         "Control_DB"."Carrousel_Order Table".Task_ID := 0; // Send the Task ID number;
         "Control_DB"."Carrousel_Order Table".Task_Metadata := ''; // Send the Task Metadata Unique identifier
     END_IF;
 END_REGION
