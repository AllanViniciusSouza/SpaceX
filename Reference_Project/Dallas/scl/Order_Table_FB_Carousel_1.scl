        "Control_DB"."Carrousel_Order Table".Task_Type := 0; //  Send the Task Type - Start Weigh Station = Task Type = 10
        "Control_DB"."Carrousel_Order Table".Task_ID := 0; // Send the Task ID number;
        "Control_DB"."Carrousel_Order Table".Task_Metadata := ''; // Send the Task Metadata Unique identifier
    END_IF;
END_REGION
(*
REGION Profile Station - Carousel Conveyors 
    IF #System.OrderTable[1].StepNo <> 0
        AND #System.OrderTable[1].Device = #PROFILE_STATION_DEVICE
        AND #System.OrderTable[1].Status = #QUEUED_STATUS
        AND NOT ("Control_DB"."Profiling Station".Running)
        AND NOT #System.Error
        AND NOT #Canceling
    THEN
        #ProfileStation_CurrentOrder := 1;
    END_IF;
    IF #System.OrderTable[#ProfileStation_CurrentOrder].StepNo <> 0
        AND #System.OrderTable[#ProfileStation_CurrentOrder].Device = #PROFILE_STATION_DEVICE
        AND #System.OrderTable[#ProfileStation_CurrentOrder].Status = #QUEUED_STATUS
        AND NOT ("Control_DB"."Profiling Station".Running)
        AND NOT #System.Error
        AND NOT #Canceling
    THEN
        //OPC Commands to Move Pallets - Carousel Conveyors
        // WCS => Order Table => OPC Ua Control Table
        
        "Control_DB"."Carrousel_Order Table".Task_Data_Available := TRUE;//#System.OrderTable[#ProfileStation_CurrentOrder].OPC_Control.Task_Data_Available; // Send the Task Data Available from WCS 
        "Control_DB"."Carrousel_Order Table".Task_Type := #System.OrderTable[#ProfileStation_CurrentOrder].OPC_Control.Task_Type; //  Send the Task Type - Start Weigh Station = Task Type = 10
        "Control_DB"."Carrousel_Order Table".Task_ID := #System.OrderTable[#ProfileStation_CurrentOrder].OPC_Control.Task_ID; // Send the Task ID number;
