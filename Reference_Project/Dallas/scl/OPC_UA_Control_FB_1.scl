REGION SM STATE MAESTRO - Carousel
    // Statement section - Send the State machine to Maestro "Emulating" openTCS states
    // 
    
    (*
    IF #State_Carrousel = 0 THEN
        
        "Control_DB"."Carrousel_Order Table".SM_State_Maestro := 0;//"LIMBO" condition 
        
    ELSIF "Control_DB"."Carrousel_Order Table".SM_State = 10 THEN
        ;
        // "Control_DB".WMS_OPC_UA.SM_State_Maestro := 1;//RAW conidtion => Maestro will write this condition
        
        //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////      
        // QUEUED ANY DEVICE    
        // ELSIF "Control_DB".WMS_OPC_UA.Task_Data_Available AND #State >= 10 AND #State <= 20 THEN
    ELSIF "Control_DB"."Carrousel_Order Table".Task_Data_Available AND NOT "Control_DB"."Carrousel_Order Table".Movement_Ready AND "Control_DB"."Carrousel_Order Table".SM_State_Maestro = 1 THEN
        "Control_DB"."Carrousel_Order Table".SM_State_Maestro := 2;//QUEUED condition =>ANY device (Conveyor, VTD OR Shuttle)  
        
        //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////       
        // Any Device RUNNING on the system (VTD - Conveyor Transfer - Shuttle Transfer) 
    ELSIF ("Control_DB"."Carrousel_Order Table".Task_Type = 6 OR "Control_DB"."Carrousel_Order Table".Task_Type = 7
        OR "Control_DB"."Carrousel_Order Table".Task_Type = 8 OR "Control_DB"."Carrousel_Order Table".Task_Type = 9
        OR "Control_DB"."Carrousel_Order Table".Task_Type = 10 OR "Control_DB"."Carrousel_Order Table".Task_Type = 14 OR "Control_DB"."Carrousel_Order Table".Task_Type = 16)
        AND "Control_DB"."Carrousel_Order Table".Movement_Ready AND NOT "Control_DB"."Carrousel_Order Table".Movement_Request_Complete THEN
        
        "Control_DB"."Carrousel_Order Table".SM_State_Maestro := 3;//RUNNING condition
        
        // Any Device DONE on the system (VTD - Coneveyor Transfer - Shuttle Transfer) 
    ELSIF ("Control_DB"."Carrousel_Order Table".Task_Type = 6 OR "Control_DB"."Carrousel_Order Table".Task_Type = 7
        OR "Control_DB"."Carrousel_Order Table".Task_Type = 8 OR "Control_DB"."Carrousel_Order Table".Task_Type = 9
        OR "Control_DB"."Carrousel_Order Table".Task_Type = 10 OR "Control_DB"."Carrousel_Order Table".Task_Type = 14 OR "Control_DB"."Carrousel_Order Table".Task_Type = 16)
        AND (*"Control_DB".WMS_OPC_UA.Movement_Request_Complete AND "Control_DB".WMS_OPC_UA.Movement_Ready*)#State_Carrousel = 70 OR #State_Carrousel = 120 OR #State_Carrousel = 170 OR #State_Carrousel = 220 OR #State_Carrousel = 232 THEN
        
        "Control_DB"."Carrousel_Order Table".SM_State_Maestro := 4;//DONE condition
        
        // Any Device ERRORS on the system (VTD - Coneveyor Transfer - Shuttle Transfer)  
    ELSIF ("Control_DB"."Carrousel_Order Table".Task_Type = 6 OR "Control_DB"."Carrousel_Order Table".Task_Type = 7
        OR "Control_DB"."Carrousel_Order Table".Task_Type = 8 OR "Control_DB"."Carrousel_Order Table".Task_Type = 9
        OR "Control_DB"."Carrousel_Order Table".Task_Type = 10 OR "Control_DB"."Carrousel_Order Table".Task_Type = 14 OR "Control_DB"."Carrousel_Order Table".Task_Type = 16)
        AND "Control_DB"."Carrousel_Order Table".SM_State = 400 THEN
        
        "Control_DB"."Carrousel_Order Table".SM_State_Maestro := 5;//ERROR condition => Conveyors   
    END_IF;
    /////////////////////////////////////////////////////////////////////////////////////////////        
    *)
    
    
    IF #State_Carrousel = 0 THEN
        ;
        //"Control_DB"."Carrousel_Order Table".SM_State_Maestro := 0;//"LIMBO" condition 
        //"System_DB_Carousel".OrderTable[1].OPC_Control.SM_State_Maestro := 0;
        
    ELSIF "Control_DB"."Carrousel_Order Table".SM_State = 10 THEN
        ;
        // "Control_DB".WMS_OPC_UA.SM_State_Maestro := 1;//RAW conidtion => Maestro will write this condition
        
        //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////      
        // QUEUED ANY DEVICE    
        // ELSIF "Control_DB".WMS_OPC_UA.Task_Data_Available AND #State >= 10 AND #State <= 20 THEN
    ELSIF "Control_DB"."Carrousel_Order Table".Task_Data_Available AND NOT "Control_DB"."Carrousel_Order Table".Movement_Ready AND "System_DB_Carousel".OrderTable[1].OPC_Control.SM_State_Maestro = 1 THEN
        "System_DB_Carousel".OrderTable[1].OPC_Control.SM_State_Maestro := 2;//QUEUED condition =>ANY device (Conveyor, VTD OR Shuttle)  
        
        //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////       
        // Any Device RUNNING on the system (VTD - Conveyor Transfer - Shuttle Transfer) 
    ELSIF ("Control_DB"."Carrousel_Order Table".Task_Type = 6 OR "Control_DB"."Carrousel_Order Table".Task_Type = 7
        OR "Control_DB"."Carrousel_Order Table".Task_Type = 8 OR "Control_DB"."Carrousel_Order Table".Task_Type = 9
        OR "Control_DB"."Carrousel_Order Table".Task_Type = 10 OR "Control_DB"."Carrousel_Order Table".Task_Type = 14 OR "Control_DB"."Carrousel_Order Table".Task_Type = 16)
        AND "Control_DB"."Carrousel_Order Table".Movement_Ready AND NOT "Control_DB"."Carrousel_Order Table".Movement_Request_Complete THEN
        
        "System_DB_Carousel".OrderTable[1].OPC_Control.SM_State_Maestro := 3;//RUNNING condition
        
        // Any Device DONE on the system (VTD - Coneveyor Transfer - Shuttle Transfer) 
    ELSIF ("Control_DB"."Carrousel_Order Table".Task_Type = 6 OR "Control_DB"."Carrousel_Order Table".Task_Type = 7
        OR "Control_DB"."Carrousel_Order Table".Task_Type = 8 OR "Control_DB"."Carrousel_Order Table".Task_Type = 9
        OR "Control_DB"."Carrousel_Order Table".Task_Type = 10 OR "Control_DB"."Carrousel_Order Table".Task_Type = 14 OR "Control_DB"."Carrousel_Order Table".Task_Type = 16)
        AND (*"Control_DB".WMS_OPC_UA.Movement_Request_Complete AND "Control_DB".WMS_OPC_UA.Movement_Ready*)#State_Carrousel = 70 OR #State_Carrousel = 120 OR #State_Carrousel = 170 OR #State_Carrousel = 220 OR #State_Carrousel = 232 THEN
        
        "System_DB_Carousel".OrderTable[1].OPC_Control.SM_State_Maestro := 4;//DONE condition
        
        // Any Device ERRORS on the system (VTD - Coneveyor Transfer - Shuttle Transfer)  
    ELSIF ("Control_DB"."Carrousel_Order Table".Task_Type = 6 OR "Control_DB"."Carrousel_Order Table".Task_Type = 7
        OR "Control_DB"."Carrousel_Order Table".Task_Type = 8 OR "Control_DB"."Carrousel_Order Table".Task_Type = 9
        OR "Control_DB"."Carrousel_Order Table".Task_Type = 10 OR "Control_DB"."Carrousel_Order Table".Task_Type = 14 OR "Control_DB"."Carrousel_Order Table".Task_Type = 16)
        AND "Control_DB"."Carrousel_Order Table".SM_State = 400 THEN
        
        "System_DB_Carousel".OrderTable[1].OPC_Control.SM_State_Maestro:= 5;//ERROR condition => Conveyors   
    END_IF;
    /////////////////////////////////////////////////////////////////////////////////////////////        
    
    
    
    
    
END_REGION

END_FUNCTION_BLOCK