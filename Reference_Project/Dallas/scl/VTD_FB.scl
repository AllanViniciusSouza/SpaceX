FUNCTION_BLOCK "VTD_FB"   // FB 18, author 

VAR_INPUT
   Cnv_Sensors : "ECnv_Inputs";
   VTD_Settings : "VTD_Settings";
END_VAR

VAR_IN_OUT
   VTD_Control : "VTD_Control";
   SinaSpeed : SinaSpeed;
END_VAR

VAR
   State : UInt;
   I_State : UInt;
   LD_Timer : TON_TIME;
   LP_Timer : TON_TIME;
   Watchdog : TON_TIME;
   CS_TImer : TON_TIME;
   Interlock_Timer : TON_TIME;
   MainSetpoint : Int;
   Position_Offset : Real;
   ChangeToLow : Array[1..4] of DInt;
   DestPosition : Real;
   SetUpSpeed : UInt;
   LevelBelowExtractor : UInt := 1;
   IEC_Timer_0_Instance : TON_TIME;
   DestinationLevel : UInt;
   CurrentlLevel : UInt;
   VTD_ID_Decoded : "ID_Decoded";
   Cnv_ID_Decoded : "ID_Decoded";
   IEC_Timer_0_Instance_1 : TON_TIME;
   IEC_Timer_0_Instance_2 : TON_TIME;
   VTD_ControlInstructionTask_ID_Old : Int;
   R_Execulte : R_TRIG;
END_VAR

VAR_TEMP
   Level_Accuracy : String;
   i : UInt;
   Do_Once : Bool;
   Level_Detect : Bool;
   Upper_limit : Bool;
   Lower_Limit : Bool;
   Ultimate_Slow : Bool;
   Ulitmate_Creep : Bool;
   Level_Detect2 : Bool;
   Level_Detect1 : Bool;
   LPR_Extended : Bool;
   LPR_Retracted : Bool;
   LPL_Extended : Bool;
   LPL_Retracted : Bool;
   Shuttle_Detect1 : Bool;
   Shuttle_Detect2 : Bool;
   LPL_Retract : Bool;
   LPL_Extend : Bool;
   LPR_Retract : Bool;
   LPR_Extend : Bool;
   Cnvs1_NotExtended : Bool;
   Cnvs2_NotExtended : Bool;
   Stoppers_NotExtended : Bool;
   MainSetpoint1 : Int;
END_VAR

BEGIN
//Execute
#R_Execulte(CLK:=#VTD_Control.Instruction.Execulte);

IF #VTD_Control.Mode = 3 THEN
    #VTD_Control.Instruction.Enable := TRUE;
END_IF;

#VTD_Control.Enabled := #VTD_Control.Instruction.Enable;

#VTD_Control.Mode := "Control_DB".VTD_Control.Instruction.Mode_Change;

//MANUAL MODE
IF (#VTD_Control.Mode = 1 OR #VTD_Control.Mode = 5) AND NOT #VTD_Control.Error THEN
    #State := 500;
END_IF;

(*
TODO:

Mode select is done via the HMI. Might add external mode select switches.
        
        Mode select mask:
        0: Disabled
        1: Manual
        2: Semi-Auto
        3: Auto
        4: Teach
        5: Maintenance
        
Device ID Format: XXYYZZ    
XX = Device type   
    01   VTD
    10  Cnv_Front_of_VTD
    11  Cnv_Rear_of_VTD
    12  Cnv_On_Extractor
    20  Safety_Stop_Front_of_VTD
    21  Safety_Stop_Rear_of_VTD
YY = Floor   
ZZ = VTD Connected to 
*)

REGION Sensor allocations
    //Assign inputs to local vars
    #Upper_limit := "Upper Ultimate";
    #Lower_Limit := "Lower Ultimate";
    #Ultimate_Slow := "Slowdown";
    #Ulitmate_Creep := "Creep speed";
    #Level_Detect2 := "Docking Sensor Rear";
    #Level_Detect1 := "Docking Sensor Front";
    #LPR_Extended := "Locking Pins Extended Right";
    #LPR_Retracted := "Locking Pins Retracted Right";
    #LPL_Extended := "Locking Pins Extended left";
    #LPL_Retracted := "Locking Pins Retracted left";
    
    #VTD_Control.LE := "LE_X_Unsafe_Position_1";
    #VTD_Control.AE := "AE_Position_1_Scaled";
END_REGION

REGION Cyclic Checks
    // Check for shuttle
    IF #Shuttle_Detect1 AND #Shuttle_Detect2 THEN
        #VTD_Control.Shuttle_Loaded := 1; //inplace
    ELSIF NOT #Shuttle_Detect1 AND #Shuttle_Detect2 THEN
        #VTD_Control.Shuttle_Loaded := 2; // Front overhang
    ELSIF #Shuttle_Detect1 AND NOT #Shuttle_Detect2 THEN
        #VTD_Control.Shuttle_Loaded := 3; //Rear overhang
    ELSE
        #VTD_Control.Shuttle_Loaded := 0; //None
    END_IF;
    
    // Check for Pallet
    IF #Cnv_Sensors."Pallet Detect 1" OR #Cnv_Sensors."Pallet Detect 2" THEN
        //Chep Pallet
        IF #Cnv_Sensors."Pallet Detect 1" AND #Cnv_Sensors."Pallet Detect 2" THEN
            #VTD_Control.Pallet_Loaded := 2; //Chep
            //Euro skewed to the left
        ELSIF #Cnv_Sensors."Pallet Detect 1" AND NOT #Cnv_Sensors."Pallet Detect 2" THEN
            #VTD_Control.Pallet_Loaded := 4; //Euro right alligned
            //Euro skewed to the right
        ELSIF #Cnv_Sensors."Pallet Detect 2" AND NOT #Cnv_Sensors."Pallet Detect 1" THEN
            #VTD_Control.Pallet_Loaded := 3; //Euro left alligned
            //Euro CENTERED
        ELSIF NOT #Cnv_Sensors."Pallet Detect 2" AND NOT #Cnv_Sensors."Pallet Detect 1" THEN
            #VTD_Control.Pallet_Loaded := 5;//'Euro';
            //Some unknown combination of sensors
        ELSE
            #VTD_Control.Pallet_Loaded := 1; //Unknown mythical pallet
        END_IF;
        
    ELSE
        //No Pallet
        #VTD_Control.Pallet_Loaded := 0; //No Pallet
    END_IF;
    
    // Locking pins state
    IF #LPL_Extended AND #LPR_Extended THEN
        #VTD_Control.LP_State := 1; //'Extended'
    ELSIF #LPL_Retracted AND #LPR_Retracted THEN
        #VTD_Control.LP_State := 2; //'Retracted'
    ELSE
        #VTD_Control.LP_State := 0; //'Unknown'
    END_IF;
    
    // Level detect
    #Level_Detect := #Level_Detect1 AND #Level_Detect2;
    
    //VTD extractor is docked
    IF #LPL_Extended AND #LPR_Extended AND #Level_Detect THEN
        
        #VTD_Control.Docked := TRUE;
    ELSE
        #VTD_Control.Docked := FALSE;
    END_IF;
    
    //Ultimate stop checks
    IF #Ulitmate_Creep AND #Ultimate_Slow AND #VTD_Control.Running THEN
        #VTD_Control.Motor_Speed := #VTD_Settings.Creep_Speed;
        #VTD_Control.Warning := 0; // Overtravel creep zone reached
    ELSIF NOT #Ulitmate_Creep AND #Ultimate_Slow AND #VTD_Control.Running THEN
        #VTD_Control.Motor_Speed := #VTD_Settings.Slow_Speed; // Overtravel creep zone reached
    END_IF;
    
    //Timeout of movement
    IF #VTD_Control.Mode = 2 OR #VTD_Control.Mode = 3 OR #VTD_Control.Mode = 4 THEN
        IF (#DestinationLevel - #CurrentlLevel = 1) AND #VTD_Control.Running THEN
            #Watchdog.TON(IN := TRUE,
                          PT := UINT_TO_TIME(#VTD_Settings.Transfer_Timeout_Up) * 1000);
        ELSIF (#DestinationLevel - #CurrentlLevel = 2) AND #VTD_Control.Running THEN
            #Watchdog.TON(IN := TRUE,
                          PT := UINT_TO_TIME(#VTD_Settings.Transfer_Timeout_Up) * 2000);
        ELSIF (#DestinationLevel - #CurrentlLevel = -1) AND #VTD_Control.Running THEN
            #Watchdog.TON(IN := TRUE,
                          PT := UINT_TO_TIME(#VTD_Settings.Transfer_Timeout_Down) * 1000);
        ELSIF (#DestinationLevel - #CurrentlLevel = -2) AND #VTD_Control.Running THEN
            #Watchdog.TON(IN := TRUE,
                          PT := UINT_TO_TIME(#VTD_Settings.Transfer_Timeout_Down) * 2000);
        ELSE
            #Watchdog.TON(IN := FALSE,
                          PT := T#0S);
        END_IF;
    END_IF;
    
    //Update Variables
    IF #VTD_Control.Current_Task_Type = 0 OR #VTD_Control.Current_Task_Type = 1 THEN
        #VTD_Control.SM_State := #State;
    ELSIF #VTD_Control.Current_Task_Type = 2 OR #VTD_Control.Current_Task_Type = 3 THEN
        #VTD_Control.SM_State := #I_State;
    END_IF;
    
    FOR #i := 1 TO "Settings_DB".System_Settings.Level_Count DO
        IF NOT "Control_DB".LCnv_Control[#i].Safety_Stop_Cnrl.Inputs.LP_Extended THEN
            #Cnvs1_NotExtended := true;
        END_IF;
        IF NOT "Control_DB".LCnv_Control[#i].Safety_Stop_Cnrl.Inputs.LP_Extended THEN
            #Cnvs2_NotExtended := true;
        END_IF;
    END_FOR;
    
    //Confirm whish level is below the extractor
    FOR #i := 0 TO "Settings_DB".System_Settings.Level_Count DO
        IF #VTD_Control.LE >= #VTD_Settings.Teach_Values.Levels_LE[#i] THEN
            #LevelBelowExtractor := #i;
        END_IF;
    END_FOR;
    
    #Stoppers_NotExtended := #Cnvs1_NotExtended (*AND #Cnvs2_NotExtended*);
    
    //AE ERROR
    IF "AE_Status_2".%X15 THEN
        #VTD_Control.AE_Error := 1;
    ELSE
        #VTD_Control.AE_Error := 0;
    END_IF;
    
    //Encoder Delta
    #VTD_Control.Encoder_Delta := ABS(#VTD_Control.AE - #VTD_Control.LE);
    
    //CURRENT LEVEL
    FOR #i := 0 TO #VTD_Settings.Highest_Level DO
        IF ABS(#VTD_Control.LE - #VTD_Settings.Teach_Values.Levels_LE[#i]) <= #VTD_Settings.VTD_Level_Granularity AND #Level_Detect THEN
            #VTD_Control.Current_Level := #i;
            EXIT;
        ELSE
            #VTD_Control.Current_Level := 99;
        END_IF;
    END_FOR;
    
    //Bypass linear encoder
    IF #VTD_Control.LE <> 0 THEN
        "LE_Bypass" := FALSE;
    END_IF;
END_REGION

REGION Auto/Semi-Auto Mode
        CASE #State OF
            0: //Idle
                #DestinationLevel := #CurrentlLevel := 0;
                "VTD_Move_To_Level_HMI_Tag" := 0;
                IF (#VTD_Control.Mode = 3 AND #VTD_Control.Current_Task_Type = 1) OR #VTD_Control.Mode = 2 THEN
                    IF #VTD_Control.Instruction.Enable AND #VTD_Control.Error = 0 THEN
                        #VTD_Control.Enabled := TRUE;
                        #State := 10;
                    END_IF;
                END_IF;
                
            10: //Standby
                IF NOT #VTD_Control.Running AND #VTD_Control.Instruction.Move_To_Level <> 99 AND
                    ((#VTD_Control.Instruction.Task_ID > 0 OR #VTD_Control.Instruction.Task_Metadata <> '' AND #VTD_Control.Mode = 3 AND "Control_DB"."VTD_Order Table".Task_Type = 1) OR
                    (#VTD_Control.Mode = 2 AND #R_Execulte.Q))
                THEN
                    IF #VTD_Control.Instruction.Move_To_Level = #VTD_Control.Current_Level AND #VTD_Control.Instruction.Move_To_Level <> 0 THEN
                        #VTD_Control.Warning := 1; //VTD already at level requested
                    //Go straght to the travel complete feedabck 
                    ELSIF (#VTD_Control.Shuttle_Loaded = 0 OR #VTD_Control.Shuttle_Loaded = 1) (*AND
                        (#VTD_Control.Pallet_Loaded = 0 OR #VTD_Control.Pallet_Loaded = 2 OR #VTD_Control.Pallet_Loaded = 3)*) THEN
                        #DestinationLevel := #VTD_Control.Instruction.Move_To_Level;
                        #CurrentlLevel := #VTD_Control.Current_Level;
                        #VTD_Control.Current_Task_ID := #VTD_Control.Instruction.Task_ID;
                        #State := 20;
                    // ELSIF #VTD_Control.Shuttle_Loaded = 2 THEN //24:11 Shuttle is not in the center of the extractor, to far forward
                    //     "Set_Bit_F"(Bit := 12,
                    //                 Bit_Value := 1,
                    //                 Var := #VTD_Control.VTD_Errors.Error_Word_2);
                    // ELSIF #VTD_Control.Shuttle_Loaded = 3 THEN //24:12 Shuttle is not in the center of the extractor, to far backward
                    //     "Set_Bit_F"(Bit := 13,
                    //                 Bit_Value := 1,
                    //                 Var := #VTD_Control.VTD_Errors.Error_Word_2);
                    // ELSIF #VTD_Control.Pallet_Loaded = 1 THEN //24:13 Pallet broken or not in position
                    //     "Set_Bit_F"(Bit := 14,
                    //                 Bit_Value := 1,
                    //                 Var := #VTD_Control.VTD_Errors.Error_Word_2);
                    // ELSE //24:14 Unknown load state
                    //     "Set_Bit_F"(Bit := 15,
                    //                 Bit_Value := 1,
                    //                 Var := #VTD_Control.VTD_Errors.Error_Word_2);
                    END_IF;
                    
                END_IF;
                
            20: //Extend all safety stoppers that are not in the up position
                #VTD_Control.Running := TRUE;
                #VTD_Control.Done := FALSE;// To report to order table
                FOR #i := 1 TO "Settings_DB".System_Settings.Level_Count DO
                    IF NOT "Control_DB".LCnv_Control[#i].Safety_Stop_Cnrl.Inputs.LP_Extended THEN
                        "Control_DB".LCnv_Control[#i].Safety_Stop_Cnrl.Instruction.LP_Extend := TRUE;
                    END_IF;
                END_FOR;
                #State := 25;
                
            25: //Check to ensure the Safety stoppers are in the up position.    
                FOR #i := 1 TO "Settings_DB".System_Settings.Level_Count DO
                    IF "Control_DB".LCnv_Control[#i].Safety_Stop_Cnrl.Inputs.LP_Extended THEN
                        "Control_DB".LCnv_Control[#i].Safety_Stop_Cnrl.Instruction.LP_Extend := FALSE;
                    END_IF;
                END_FOR;
                IF "Control_DB".LCnv_Control[1].Safety_Stop_Cnrl.Inputs.LP_Extended AND
                    "Control_DB".LCnv_Control[2].Safety_Stop_Cnrl.Inputs.LP_Extended AND
                    "Control_DB".LCnv_Control[3].Safety_Stop_Cnrl.Inputs.LP_Extended THEN
                    #State := 30;
                END_IF;
                
            30: //Undock the VTD
                IF #VTD_Control.Docked OR (#VTD_Control.LE < #VTD_Settings.Teach_Values.Levels_LE[#LevelBelowExtractor]+ 50 AND
                    #VTD_Control.LE > #VTD_Settings.Teach_Values.Levels_LE[#LevelBelowExtractor]) THEN
                    IF #VTD_Control.LP_State = 1 THEN //extended
                        #VTD_Control.Motor_Speed := #VTD_Settings.Dock_speed;
                        #VTD_Control.Motor_UP := TRUE;
                        #Position_Offset := #VTD_Control.LE + 40;
                        #State := 35;
                    ELSIF #VTD_Control.LP_State = 2 THEN //retracted
                        #State := 45;
                    ELSE //24:4 Docking pins in an known state
                        Set_Bit_F(Bit := 5,
                                    Bit_Value := 1,
                                    Var := #VTD_Control.VTD_Errors.Error_Word_2);
                    END_IF;
                ELSE
                    #Position_Offset := #VTD_Control.LE - 5;
                    #State := 35;
                END_IF;
                
            35: //Retract the docking pins
                IF NOT #Level_Detect AND #VTD_Control.LE >= #Position_Offset THEN //change back to the original condition
                    #VTD_Control.Motor_Speed := 0;
                    #VTD_Control.Motor_UP := FALSE;
                    #LPR_Retract := #LPL_Retract := TRUE;
                    #LP_Timer(IN := TRUE,
                              PT := UINT_TO_TIME(#VTD_Settings.Lockpins_Timeout_Retract));
                    
                    IF #LPR_Retracted THEN
                        #LPR_Retract := FALSE;
                    END_IF;
                    IF #VTD_Control.Inputs.LPL_Retracted THEN
                        #LPL_Retract := FALSE;
                    END_IF;
                    
                    IF #VTD_Control.LP_State = 2 THEN
                        #State := 40;
                    END_IF;
                END_IF;
                
            40: //Check docking pins have been retracted
                IF #VTD_Control.LP_State = 2 THEN
                    #LP_Timer(IN := FALSE,
                              PT := T#0S);
                    #LPR_Retract := #LPL_Retract := FALSE;
                    #State := 45;
                END_IF;
                
            45: //Start moving towards the level required
                //Check load type and set extractor speed
                IF #VTD_Control.Shuttle_Loaded = 0 AND #VTD_Control.Pallet_Loaded = 0 THEN 
                    #VTD_Control.Motor_Speed := #VTD_Settings.Empty_Speed;
                ELSIF #VTD_Control.Shuttle_Loaded = 1 AND #VTD_Control.Pallet_Loaded = 0 THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Shuttle_Speed;
                ELSIF #VTD_Control.Shuttle_Loaded = 0 AND (#VTD_Control.Pallet_Loaded > 0) THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Pallet_Speed;
                ELSIF #VTD_Control.Shuttle_Loaded = 1 AND (#VTD_Control.Pallet_Loaded > 0) THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Loaded_Speed;
                END_IF;
                
                #DestPosition := #VTD_Settings.Teach_Values.Levels_LE[#VTD_Control.Instruction.Move_To_Level];
                #SetUpSpeed := #VTD_Control.Motor_Speed;
                
                //VTD needs to move up
                IF #VTD_Control.LE < #DestPosition THEN
                    #VTD_Control.Motor_UP := TRUE;
                    #State := 50;
                    //VTD needs to move down
                ELSIF #VTD_Control.LE > #DestPosition THEN
                    #VTD_Control.Motor_Down := TRUE;
                    #State := 65; //change to 65
                END_IF;
                
            50: //travel upwards to designated level
                #ChangeToLow[1] := ABS((#VTD_Settings.Slowdown_Count_LE / 100) * 80); (* 80% *) //80  600mm
                #ChangeToLow[2] := ABS((#VTD_Settings.Slowdown_Count_LE / 100) * 60); (* 60% *) //60
                #ChangeToLow[3] := ABS((#VTD_Settings.Slowdown_Count_LE / 100) * 40); (* 40% *) //40
                #ChangeToLow[4] := ABS((#VTD_Settings.Slowdown_Count_LE / 100) * 20); (* 20% *) //20 60
                
                //switch to fast freq Low UP
                IF ABS(#DestPosition - #VTD_Control.LE) > #VTD_Settings.Slowdown_Count_LE THEN
                    #VTD_Control.Motor_Speed := #SetUpSpeed; //5
                    //switch to low freq
                ELSIF ABS(#DestPosition - #VTD_Control.LE) <= #VTD_Settings.Slowdown_Count_LE
                    AND ABS(#DestPosition - #VTD_Control.LE) > #ChangeToLow[1] THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Slow_Calib_Speed * 1.8; //5 * 1.8 = 9%
                ELSIF ABS(#DestPosition - #VTD_Control.LE) <= #ChangeToLow[1]
                    AND ABS(#DestPosition - #VTD_Control.LE) > #ChangeToLow[2] THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Slow_Calib_Speed * 1.6; //5 * 1.6 = 8%
                ELSIF ABS(#DestPosition - #VTD_Control.LE) <= #ChangeToLow[2]
                    AND ABS(#DestPosition - #VTD_Control.LE) > #ChangeToLow[3] THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Slow_Calib_Speed * 1.4; //5 * 1.4 = 7%
                ELSIF ABS(#DestPosition - #VTD_Control.LE) <= #ChangeToLow[3]
                    AND ABS(#DestPosition - #VTD_Control.LE) > #ChangeToLow[4] THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Slow_Calib_Speed * 1.2; //5 * 1.2 = 6%
                ELSIF ABS(#DestPosition - #VTD_Control.LE) <= #ChangeToLow[4] THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Slow_Calib_Speed; //5%
                    #State := 55;
                END_IF;
                
            55: // Travel upwards using slow speed towards required floor
                IF #VTD_Control.LE > #VTD_Settings.Teach_Values.Levels_LE[#VTD_Control.Instruction.Move_To_Level] - #VTD_Settings.Creep_Count_LE
                THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Creep_Speed; //3% - 60mm 
                    #State := 60;
                END_IF;
                
            60: // Travel past the level in order to extend the docking pins
                IF #VTD_Control.LE > #VTD_Settings.Teach_Values.Levels_LE[#VTD_Control.Instruction.Move_To_Level] + #VTD_Settings.Creep_Count_LE
                THEN
                    #VTD_Control.Motor_Speed := 0;
                    #VTD_Control.Motor_UP := FALSE;
                    #State := 80;
                END_IF;
                
            65: //travel Downwards to designated level   
                #ChangeToLow[1] := ABS((#VTD_Settings.Slowdown_Count_LE / 100) * 80); (* 80% *) //80
                #ChangeToLow[2] := ABS((#VTD_Settings.Slowdown_Count_LE / 100) * 60); (* 60% *) //60
                #ChangeToLow[3] := ABS((#VTD_Settings.Slowdown_Count_LE / 100) * 40); (* 40% *) //40
                #ChangeToLow[4] := ABS((#VTD_Settings.Slowdown_Count_LE / 100) * 20); (* 20% *) //20
                //switch to fast freq Low UP
                IF ABS(#DestPosition - #VTD_Control.LE) > #VTD_Settings.Slowdown_Count_LE THEN
                    #VTD_Control.Motor_Speed := #SetUpSpeed;
                    //switch to low freq
                ELSIF ABS(#DestPosition - #VTD_Control.LE) <= #VTD_Settings.Slowdown_Count_LE
                    AND ABS(#DestPosition - #VTD_Control.LE) > #ChangeToLow[1] THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Slow_Calib_Speed * 1.8;
                ELSIF ABS(#DestPosition - #VTD_Control.LE) <= #ChangeToLow[1]
                    AND ABS(#DestPosition - #VTD_Control.LE) > #ChangeToLow[2] THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Slow_Calib_Speed * 1.6;
                ELSIF ABS(#DestPosition - #VTD_Control.LE) <= #ChangeToLow[2]
                    AND ABS(#DestPosition - #VTD_Control.LE) > #ChangeToLow[3] THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Slow_Calib_Speed * 1.4;
                ELSIF ABS(#DestPosition - #VTD_Control.LE) <= #ChangeToLow[3]
                    AND ABS(#DestPosition - #VTD_Control.LE) > #ChangeToLow[4] THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Slow_Calib_Speed * 1.2;
                ELSIF ABS(#DestPosition - #VTD_Control.LE) <= #ChangeToLow[4] THEN
                    #VTD_Control.Motor_Speed := #VTD_Settings.Slow_Calib_Speed;
                    #State := 70;
                END_IF;
                
            70: // Travel downwards using slow speed towards required floor 
                IF #VTD_Control.LE < #VTD_Settings.Teach_Values.Levels_LE[#VTD_Control.Instruction.Move_To_Level] + #VTD_Settings.Creep_Count_LE
                THEN
                    #VTD_Control.Motor_Speed := 0;
                    #VTD_Control.Motor_Down := FALSE;
                    #State := 80;
                END_IF;
                
            80: //Extend Docking pins
                IF #VTD_Control.LP_State = 2 AND NOT #Level_Detect THEN 
                    #LPL_Extend := #LPR_Extend := TRUE;
                    #LP_Timer(IN := TRUE,
                              PT := UINT_TO_TIME(#VTD_Settings.Lockpins_Timeout_Extend));
                ELSIF #VTD_Control.LP_State <> 1 AND NOT #Level_Detect THEN 
                    #LPL_Extend := #LPR_Extend := TRUE;
                ELSIF #VTD_Control.LP_State = 1 THEN
                    #State := 85;
                END_IF;
                
                
            85: // Wait for docking pins to extend
                IF #VTD_Control.LP_State = 1 AND NOT #Level_Detect THEN
                    #LP_Timer(IN := FALSE,
                              PT := T#0S);
                    #LPL_Extend := #LPR_Extend := FALSE;
                    #VTD_Control.Motor_Speed := #VTD_Settings.Dock_speed;
                    #VTD_Control.Motor_Down := TRUE;
                    #State := 90;
                END_IF;
                
            90: // Dock the VTD
                //Using the Linear Encoder for comparation and Release tension in the VTD chain
                IF ABS(#VTD_Control.LE - #DestPosition) <= (#VTD_Settings.Level_Detect_LE) AND NOT #CS_TImer.Q THEN
                    #CS_TImer(IN := TRUE,
                              PT := UINT_TO_TIME(#VTD_Settings.Chain_Slack_Timeout));
                END_IF;
                IF #CS_TImer.Q THEN
                    #VTD_Control.Motor_Speed := 0;
                    #VTD_Control.Motor_Down := FALSE;
                    #CS_TImer(IN := FALSE,
                              PT := T#0S);
                    #State := 95;
                END_IF;
                    
            95: // Dock the VTD
                //Check the level detect sensors
                IF (#Level_Detect1 AND NOT #Level_Detect2) OR
                    (NOT #Level_Detect1 AND #Level_Detect2) THEN
                    #LD_Timer(IN := TRUE,
                              PT := UINT_TO_TIME(#VTD_Settings.Level_Detect_Timeout));
                ELSE
                    #LD_Timer(IN := FALSE,
                              PT := T#0s);
                END_IF;
                
                    IF #Level_Detect THEN
                        #Watchdog(IN := FALSE,
                                  PT := T#0S);
                        #State := 100;
                    END_IF;
                    
            100: //Wait for Movement completion ack  
                //Reset timers
                #LP_Timer(IN := FALSE,
                          PT := T#0s);
                #Watchdog(IN := FALSE,
                          PT := T#0s);
                #LD_Timer(IN := FALSE,
                          PT := T#0s);
                #CS_TImer(IN := FALSE,
                          PT := T#0s);
                
                #VTD_Control.Motor_Speed := 0;
                IF #VTD_Control.Mode = 3 THEN //VTD in Auto
                   
                    IF "Control_DB"."VTD_Order Table".Movement_Request_Complete_Ack THEN
                        #VTD_Control.Current_Task_ID := 0;
                        #VTD_Control.Running := FALSE;
                        #VTD_Control.Done := TRUE;// To report to order table
                        #State := 0;
                        // "Control_DB".WMS_OPC_UA.Movement_Request_Complete_Ack := FALSE;
                    END_IF;
                ELSIF #VTD_Control.Mode = 2 THEN //VTD in Semi-Auto
                    #VTD_Control.Current_Task_ID := 0;
                    "VTD_Move_To_Level_HMI_Tag" := 0;
                    #VTD_Control.Running := FALSE;
                    #State := 0;
                END_IF;
                
            400: // Error state
                #VTD_Control.Done := FALSE;// To report to order table
                #VTD_Control.Motor.Enable := FALSE;
                #VTD_Control.Motor_UP := FALSE;
                #VTD_Control.Motor_Down := FALSE;
                #VTD_Control.Running := FALSE;
                #VTD_Control.Stopped := TRUE;
                #VTD_Control.Motor.Speed := 0;
                #VTD_Control.Motor.Forward := FALSE;
                #VTD_Control.Motor.Reverse := FALSE;
                #LPL_Extend := #LPR_Extend := FALSE;
                #LPL_Retract := #LPR_Retract := FALSE;
                //Reset timers
                #LP_Timer(IN := FALSE,
                          PT := T#0s);
                #Watchdog(IN := FALSE,
                          PT := T#0s);
                #LD_Timer(IN := FALSE,
                          PT := T#0s);
                #CS_TImer(IN := FALSE,
                          PT := T#0s);
                IF #VTD_Control.Instruction.Reset THEN
                    #VTD_Control.Instruction.Move_To_Level := 0;
                    "VTD_Move_To_Level_HMI_Tag" := 0;
                    #VTD_Control.Error := FALSE;
                    #VTD_Control.Warning := 0;
                    #VTD_Control.Stopped := FALSE;
                    #VTD_Control.Current_Task_Type := 0;
                    #VTD_Control.VTD_Errors.Error_Word_1 := 0;
                    #VTD_Control.VTD_Errors.Error_Word_2 := 0;
                    #VTD_Control.VTD_Errors.Error_Word_3 := 0;
                    #VTD_Control.VTD_Errors.Error_Word_4 := 0;
                    #State := 0;
                END_IF;
                
            500: //MANUAL MODE
                IF #VTD_Control.Error = 0 THEN
                    
                    //VTD
                    IF #VTD_Control.Instruction.Manual_Up AND NOT "Upper Ultimate" THEN
                        #VTD_Control.Motor_UP := TRUE;
                        #VTD_Control.Running := TRUE;
                        IF NOT (#Ultimate_Slow OR #Ulitmate_Creep) THEN
                            #VTD_Control.Motor_Speed := #VTD_Settings.Manual_Speed;
                        END_IF;
                    ELSIF #VTD_Control.Instruction.Manual_Down AND NOT "Lower Ultimate" THEN
                        #VTD_Control.Motor_Down := TRUE;
                        #VTD_Control.Running := TRUE;
                        IF NOT (#Ultimate_Slow OR #Ulitmate_Creep) THEN
                            #VTD_Control.Motor_Speed := #VTD_Settings.Manual_Speed;
                        END_IF;
                    ELSE
                        #VTD_Control.Motor_Speed := 0;
                        #VTD_Control.Running := FALSE;
                        #VTD_Control.Motor_Down := FALSE;
                        #VTD_Control.Motor_UP := FALSE;
                    END_IF;
                    
                    //LOCKING PINS RIGHT 
                    IF NOT #VTD_Control.Running AND #VTD_Control.Instruction.Manual_LP_Extend
                        AND NOT #LPR_Extended THEN
                        #LPR_Extend := TRUE;
                    ELSIF NOT #VTD_Control.Running AND #VTD_Control.Instruction.Manual_LP_Retract
                        AND NOT #LPR_Retracted THEN
                        #LPR_Retract := TRUE;
                    ELSE
                        #LPR_Extend := FALSE;
                        #LPR_Retract := FALSE;
                    END_IF;
                    
                    //LOCKING PINS LEFT 
                    IF NOT #VTD_Control.Running AND #VTD_Control.Instruction.Manual_LP_Extend
                        AND NOT #LPL_Extended THEN
                        #LPL_Extend := TRUE;
                    ELSIF NOT #VTD_Control.Running AND #VTD_Control.Instruction.Manual_LP_Retract
                        AND NOT #LPL_Retracted THEN
                        #LPL_Retract := TRUE;
                    ELSE
                        #LPL_Extend := FALSE;
                        #LPL_Retract := FALSE;
                    END_IF;
                    
                    IF #VTD_Control.Mode <> 1 AND #VTD_Control.Mode <> 5 THEN
                        #State := 0;
                    END_IF;
                    
                    IF #LPR_Extend OR #LPL_Extend THEN
                        #LP_Timer(IN := TRUE,
                                  PT := UINT_TO_TIME(#VTD_Settings.Lockpins_Timeout_Extend));
                    ELSIF #LPR_Retract OR #LPL_Retract THEN
                        #LP_Timer(IN := TRUE,
                                  PT := UINT_TO_TIME(#VTD_Settings.Lockpins_Timeout_Retract));
                    ELSE
                        #LP_Timer(IN := FALSE,
                                  PT := T#0S);
                    END_IF;
                END_IF;
        END_CASE;
END_REGION

REGION Shuttle Interlock
    // VTD needs to be in Auto mode to perform a Shuttle interlock
    CASE #I_State OF
        0:
            IF #VTD_Control.Mode = 3 AND #VTD_Control.Shuttle_Interlock.Interlock_Request AND #VTD_Control.Shuttle_Interlock.Shuttle_Interlock_Task_ID > 0 THEN
                #I_State := 10;
            END_IF;
            
            10: //Standby
                
                //Start by decoding all the IDs of the devices pertaining to the VTD in question on that level
                ID_Decode_F(ID := #VTD_Settings.ID,
                              ID_Decoded := #VTD_ID_Decoded);
                ID_Decode_F(ID := "Settings_DB".LCnv_Settings[#VTD_Control.Current_Level].ID,
                              ID_Decoded := #Cnv_ID_Decoded);
                
                // Ensure the VTD is in a state that it can perform an interlock
                IF #VTD_Control.Docked AND NOT #VTD_Control.Running AND (#VTD_Control.Shuttle_Loaded = 0 OR #VTD_Control.Shuttle_Loaded = 1) AND #VTD_Control.Error = 0 THEN
                    // Check to make sure the VTD and Shuttle are not both loaded
                    IF #VTD_Control.Pallet_Loaded = 1 THEN
                        #VTD_Control.Warning := 1; // Both the VTD and Shuttles are loaded, can't perform the interlock
                    ELSE
                        //Check that shuttle is on the correct floor, that the start location given and the shuttle actual position matches and the destination is the correct extractor barcode
                        IF (*#VTD_Control.Current_Level = "Shuttle_MQTT_DB".Shuttle_MQTT[#VTD_Control.Shuttle_Interlock.Shuttle_ID].Message.Shuttle_Status.Floor
                            AND*) #VTD_Control.Shuttle_Interlock.Shuttle_Start_Location = "Shuttle_MQTT_DB".Shuttle_MQTT[#VTD_Control.Shuttle_Interlock.Shuttle_ID].Message.Shuttle_Status.Position_ID
                            (*AND "Shuttle_MQTT_DB".Shuttle_MQTT[#VTD_Control.Shuttle_Interlock.Shuttle_ID].Message.Shuttle_Status.Destination_ID = "Settings_DB".ECnv_Settings.Barcode_ID*)THEN
                            
                            //Check in which Buffer conveyor the shuttle is located
                            IF "Settings_DB".LCnv_Settings[#VTD_Control.Current_Level].Barcode_ID =
                                #VTD_Control.Shuttle_Interlock.Shuttle_Start_Location THEN
                                #VTD_Control.Running := TRUE;
                                #I_State := 20;
                            ELSIF "Settings_DB".ECnv_Settings.Barcode_ID =
                                #VTD_Control.Shuttle_Interlock.Shuttle_Start_Location AND
                                "Control_DB"."VTD_Order Table".Destination_Location = "Settings_DB".LCnv_Settings[#VTD_Control.Current_Level].Barcode_ID THEN
                                #VTD_Control.Running := TRUE;
                                #I_State := 20;
                            ELSE
                                #VTD_Control.Warning := 2; // Shuttle interlock start location not buffer conveyor of VTD
                            END_IF;
                        ELSE
                            #VTD_Control.Warning := 3; // Cant interlock as shuttle and VTD level mismatch
                        END_IF;
                    END_IF;
                ELSE
                    #VTD_Control.Warning := 4; // VTD not ready for interlock 
                END_IF;
                
                
            20: //Drop safety stops
                IF #Cnv_ID_Decoded.Level = #VTD_Control.Current_Level THEN
                    "Control_DB".LCnv_Control[#VTD_Control.Current_Level].Safety_Stop_Cnrl.Instruction.LP_Retract := TRUE;
                    #I_State := 30;
                ELSE
                    #VTD_Control.Error := TRUE; //24:16 Cannot find the correct safety pins to drop.
                    Set_Bit_F(Bit := 1,
                                Bit_Value := 1,
                                Var := #VTD_Control.VTD_Errors.Error_Word_3);
                    // #I_State := 400;
                END_IF;
                
            //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////    
            30: //Confirm safety stops are down at the correct location
                //Send ready to interlock
                IF "Control_DB".LCnv_Control[#VTD_Control.Current_Level].Safety_Stop_Cnrl.LP_State = 0 THEN //RETRACTED
                    "Control_DB".LCnv_Control[#VTD_Control.Current_Level].Safety_Stop_Cnrl.Instruction.LP_Retract := FALSE;
                    #VTD_Control.Shuttle_Interlock.Ready_To_Interlock := TRUE;
                    #I_State := 40;
                END_IF;
                
            ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
            40: //Wait for shuttle to move in or out VTD
                //Add timer for shuttle transfer to occur
                IF "Control_DB"."VTD_Order Table".Destination_Location = "Settings_DB".ECnv_Settings.Barcode_ID THEN
                    IF "Settings_DB".ECnv_Settings.Barcode_ID = "Shuttle_MQTT_DB".Shuttle_MQTT[#VTD_Control.Shuttle_Interlock.Shuttle_ID].Message.Shuttle_Status.Position_ID
                        AND "Shuttle_MQTT_DB".Shuttle_MQTT[#VTD_Control.Shuttle_Interlock.Shuttle_ID].Message.Shuttle_Status.Operational_State = 'IDLE' THEN
                        "Control_DB".LCnv_Control[#VTD_Control.Current_Level].Safety_Stop_Cnrl.Instruction.LP_Extend := TRUE;
                        #I_State := 50;
                    END_IF;
                ELSIF "Control_DB"."VTD_Order Table".Destination_Location = "Settings_DB".LCnv_Settings[#VTD_Control.Current_Level].Barcode_ID THEN
                    IF "Settings_DB".LCnv_Settings[#VTD_Control.Current_Level].Barcode_ID = "Shuttle_MQTT_DB".Shuttle_MQTT[#VTD_Control.Shuttle_Interlock.Shuttle_ID].Message.Shuttle_Status.Position_ID
                        AND "Shuttle_MQTT_DB".Shuttle_MQTT[#VTD_Control.Shuttle_Interlock.Shuttle_ID].Message.Shuttle_Status.Operational_State = 'IDLE' THEN
                        "Control_DB".LCnv_Control[#VTD_Control.Current_Level].Safety_Stop_Cnrl.Instruction.LP_Extend := TRUE;
                        #I_State := 50;
                    END_IF;
                END_IF;
                
            //////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////  
            50: //Check own sensors for shuttle/pallet state
                #IEC_Timer_0_Instance_1(IN:=TRUE,
                                        PT:=T#5S);
                IF "Control_DB".LCnv_Control[#VTD_Control.Current_Level].Safety_Stop_Cnrl.LP_State = 1 //EXTENDED
                    AND "Control_DB".ECnv_Control.Shuttle_In_Place THEN
                    "Control_DB".LCnv_Control[#VTD_Control.Current_Level].Safety_Stop_Cnrl.Instruction.LP_Extend := FALSE;
                    #VTD_Control.Shuttle_Interlock.Interlock_Complete := TRUE;
                    #I_State := 60;
                ELSIF #IEC_Timer_0_Instance_1.Q THEN
                    #VTD_Control.Error := TRUE; //24:17 Error occured during interlock final check
                    Set_Bit_F(Bit := 2,
                                Bit_Value := 1,
                                Var := #VTD_Control.VTD_Errors.Error_Word_3);
                    #I_State := 400;
                END_IF;
                
            60://Clear Vars
                #IEC_Timer_0_Instance_1(IN := FALSE,
                                        PT := T#0s);
                #IEC_Timer_0_Instance_2(IN := FALSE,
                                        PT := T#0s);
                IF #VTD_Control.Shuttle_Interlock.Interlock_Complete_Ack THEN
                    #VTD_Control.Shuttle_Interlock.Ready_To_Interlock := FALSE;
                    #VTD_Control.Shuttle_Interlock.Interlock_Complete := FALSE;
                    #VTD_Control.Running := FALSE;
                    #I_State := 0;
                END_IF;
                
            400://ERROR MODE
                #IEC_Timer_0_Instance_1(IN := FALSE,
                                        PT := T#0s);
                #IEC_Timer_0_Instance_2(IN := FALSE,
                                        PT := T#0s);
                #Interlock_Timer(IN := FALSE,
                                 PT := T#0s);
                #VTD_Control.Running := FALSE;
                #VTD_Control.Shuttle_Interlock.Interlock_Complete := FALSE;
                #VTD_Control.Shuttle_Interlock.Ready_To_Interlock := FALSE;
                "Control_DB".LCnv_Control[#VTD_Control.Current_Level].Safety_Stop_Cnrl.Instruction.LP_Extend := FALSE;
                "Control_DB".LCnv_Control[#VTD_Control.Current_Level].Safety_Stop_Cnrl.Instruction.LP_Extend := FALSE;
                "Control_DB".LCnv_Control[#VTD_Control.Current_Level].Safety_Stop_Cnrl.Instruction.LP_Retract := FALSE;
                "Control_DB".LCnv_Control[#VTD_Control.Current_Level].Safety_Stop_Cnrl.Instruction.LP_Retract := FALSE;
                IF #VTD_Control.Instruction.Reset THEN
                    #VTD_Control.VTD_Errors.Error_Word_3 := 0;
                    #I_State := 0;
                END_IF;
            END_CASE;
        #Interlock_Timer(IN := #I_State >= 40 AND #I_State <= 50,
                         PT := UINT_TO_TIME("Settings_DB".System_Settings.Shuttle_Interlock_Timeout) * 1000);
    
END_REGION

REGION Cyclic Error Checks
    IF NOT "Main_Safety_RTG1_DB".SAFETY_OK_VTD THEN //21:1
        Set_Bit_F(Bit := 0,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_1);
    END_IF;
        
    IF "VTD_Stop_HMI_Tag" THEN //21:2
        Set_Bit_F(Bit := 1,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_1);
    END_IF;
    
    IF NOT "Overtravel Upper Limit - CH1" THEN //21:3
        Set_Bit_F(Bit := 2,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_1);
    END_IF;
    
    IF NOT "Overtravel Lower Limit - CH1" THEN //21:4
        Set_Bit_F(Bit := 3,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_1);
    END_IF;
    
    IF (#VTD_Control.Mode = 1 OR #VTD_Control.Mode = 5) AND #VTD_Control.Instruction.Manual_Up AND
        #VTD_Control.LE > #VTD_Settings.Teach_Values.Levels_LE[#VTD_Settings.Highest_Level] + #VTD_Settings.Creep_Count_LE THEN //21:5
        Set_Bit_F(Bit := 4,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_1);
    END_IF;
    
    "R_TRIG_DB_3"(CLK:=#VTD_Control.Mode = 3);
    
    IF NOT #VTD_Control.Docked AND "R_TRIG_DB_3".Q THEN //22:1
        Set_Bit_F(Bit := 8,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_1);
    END_IF;
    
    IF NOT #Level_Detect AND "R_TRIG_DB_3".Q THEN //22:2
        Set_Bit_F(Bit := 9,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_1);
    END_IF;
    
    // IF "R_TRIG_DB_3".Q AND NOT ((#VTD_Control.LE < #VTD_Settings.Teach_Values.Levels_LE[1] + #VTD_Settings.VTD_Level_Granularity
    //     AND #VTD_Control.LE > #VTD_Settings.Teach_Values.Levels_LE[1] - #VTD_Settings.VTD_Level_Granularity)
    //     OR
    //     (#VTD_Control.LE < #VTD_Settings.Teach_Values.Levels_LE[2] + #VTD_Settings.VTD_Level_Granularity
    //     AND #VTD_Control.LE > #VTD_Settings.Teach_Values.Levels_LE[2] - #VTD_Settings.VTD_Level_Granularity)
    //     OR
    //     (#VTD_Control.LE < #VTD_Settings.Teach_Values.Levels_LE[3] + #VTD_Settings.VTD_Level_Granularity
    //     AND #VTD_Control.LE > #VTD_Settings.Teach_Values.Levels_LE[3] - #VTD_Settings.VTD_Level_Granularity))
    // THEN //22:3
    //         "Set_Bit_F"(Bit := 10,
    //                     Bit_Value := 1,
    //                     Var := #VTD_Control.VTD_Errors.Error_Word_1);
    // END_IF;
    
    IF #VTD_Control.Docked AND (#LPL_Retract OR #LPR_Retract) THEN //22:5
        Set_Bit_F(Bit := 12,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_1);
    END_IF;
    
    #IEC_Timer_0_Instance(IN := #VTD_Control.LE <= (#VTD_Settings.Teach_Values.Levels_LE[#LevelBelowExtractor] + 1) AND #VTD_Control.Instruction.Manual_Down,
                          PT := t#300ms);
    
    //LINEAR ENCODER ERROR
    "IEC_Timer_0_DB_8".TON(IN := "LE_Status".%X0 OR "LE_Status".%X1 OR
                           #VTD_Control.LE < #VTD_Settings.VTD_Min_Height OR
                           #VTD_Control.LE > #VTD_Settings.VTD_Max_Heigh,
                           PT := t#500ms);
    IF NOT "LE_Bypass" AND "IEC_Timer_0_DB_8".Q THEN
        Set_Bit_F(Bit := 4,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_3);
        "IEC_Timer_0_DB_8".TON (IN := FALSE,
                                PT := T#0s);
    END_IF;
    
    // //ABSOLUTE ENCODER
    IF #VTD_Control.AE_Error > 0 THEN
        Set_Bit_F(Bit := 5,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_3);
    END_IF;
    
    //Errors while running
    IF #VTD_Control.Running THEN
        IF NOT (#VTD_Control.LP_State = 2) AND
            (#VTD_Control.LE > (#VTD_Settings.Teach_Values.Levels_LE[#LevelBelowExtractor] + #VTD_Settings.Slowdown_Count_LE) AND #VTD_Control.Instruction.Manual_Down)
            OR
            #IEC_Timer_0_Instance.Q
        THEN //22:4
            Set_Bit_F(Bit := 11,
                        Bit_Value := 1,
                        Var := #VTD_Control.VTD_Errors.Error_Word_1);
        END_IF;
        
        IF #VTD_Control.VFD_Error > 0 THEN //25:1
            Set_Bit_F(Bit := 0,
                        Bit_Value := 1,
                        Var := #VTD_Control.VTD_Errors.Error_Word_4);
        ELSIF #VTD_Control.LE_Error > 0 THEN //25:2
            Set_Bit_F(Bit := 1,
                        Bit_Value := 1,
                        Var := #VTD_Control.VTD_Errors.Error_Word_4);
        ELSIF #VTD_Control.AE_Error > 0 THEN //25:3
            Set_Bit_F(Bit := 2,
                        Bit_Value := 1,
                        Var := #VTD_Control.VTD_Errors.Error_Word_4);
        ELSIF (#LPL_Extended AND #LPL_Retracted) OR (#LPR_Extended AND #LPR_Retracted) THEN // 25:4
            Set_Bit_F(Bit := 3,
                        Bit_Value := 1,
                        Var := #VTD_Control.VTD_Errors.Error_Word_4);
        ELSIF #Lower_Limit AND NOT #Upper_limit THEN // 25:5
            Set_Bit_F(Bit := 4,
                        Bit_Value := 1,
                        Var := #VTD_Control.VTD_Errors.Error_Word_4);
        ELSIF NOT #Lower_Limit AND #Upper_limit THEN // 25:6
            Set_Bit_F(Bit := 5,
                        Bit_Value := 1,
                        Var := #VTD_Control.VTD_Errors.Error_Word_4);
        ELSIF #Lower_Limit AND #Upper_limit THEN // 25:7
            Set_Bit_F(Bit := 6,
                        Bit_Value := 1,
                        Var := #VTD_Control.VTD_Errors.Error_Word_4);
        END_IF;
    END_IF;
    
    //Check if overtravel limit switches has been hit
    IF #Upper_limit AND #Ultimate_Slow AND #Ulitmate_Creep AND #VTD_Control.Instruction.Manual_Up
    THEN //24:6 Top overtravel limit reached.
        Set_Bit_F(Bit := 7,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_2);
        IF #VTD_Control.Mode = 2 OR #VTD_Control.Mode = 3 THEN
            #State := 400;
        ELSE
            #State := 0;
        END_IF;
    ELSIF #Lower_Limit AND #Ultimate_Slow AND #Ulitmate_Creep AND #VTD_Control.Instruction.Manual_Down
    THEN //24:7 Bottom overtravel limit reached.
            #VTD_Control.Error := TRUE; 
            Set_Bit_F(Bit := 8,
                        Bit_Value := 1,
                        Var := #VTD_Control.VTD_Errors.Error_Word_2);
            IF #VTD_Control.Mode = 2 OR #VTD_Control.Mode = 3 THEN
                #State := 400;
            ELSE
                #State := 0;
            END_IF;
    // ELSIF #Lower_Limit AND #Ultimate_Slow AND #Ulitmate_Creep AND #VTD_Control.Mode <> 4 THEN
    //     #VTD_Control.Instruction.Stop := TRUE;
    //     #VTD_Control.Error := TRUE; //24:7 Bottom Overtravel limit reached.
    //     "Set_Bit_F"(Bit := 8,
    //                 Bit_Value := 1,
    //                 Var := #VTD_Control.VTD_Errors.Error_Word_2);
    //     IF #VTD_Control.Mode = 2 OR #VTD_Control.Mode = 3 THEN
    //         #State := 400;
    //     ELSE
    //         #State := 0;
    //     END_IF;
    END_IF;
    
    //Need to monitor both encoders to (Need to uncomment)
    // #VTD_Control.Encoder_Delta := (#VTD_Control.LE - ((#VTD_Control.AE * #VTD_Settings.AE_Ratio)) * #VTD_Settings.Encoder_Delta_W1) + (#VTD_Control.Encoder_Delta * #VTD_Settings.Encoder_Delta_W2);
    IF ABS(#VTD_Control.Encoder_Delta) > #VTD_Settings.Encoder_Delta_Warning THEN
        //Send warning message that encoder error is to large
        #VTD_Control.Warning := 0;
    END_IF;
    
    "IEC_Timer_0_DB_10".TON(IN:=ABS(#VTD_Control.Encoder_Delta) > #VTD_Settings.Encoder_Delta_Error,
                            PT:=t#500ms);
    
    IF "IEC_Timer_0_DB_10".Q THEN
        //Send error message that encoder error is to large
        #VTD_Control.Error := TRUE; // 24:1
        Set_Bit_F(Bit := 2,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_2);
        #State := 400;
    END_IF;
    
    // Level detect timer 
    IF #LD_Timer.Q THEN
        #LD_Timer(IN := FALSE,
                  PT := T#0s);
        #VTD_Control.Error := TRUE; // 24:10 VTD not level
        Set_Bit_F(Bit := 11,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_4);
        #State := 400;
    END_IF;
    
    //Locking pin timer
    IF #LP_Timer.Q AND (#LPL_Retract OR #LPL_Extend) THEN //24:2 Locking pins took to long to extend
        Set_Bit_F(Bit := 3,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_2);
    ELSIF #LP_Timer.Q AND (#LPR_Retract AND #LPR_Extend) THEN //24:3 Locking pins took to long to retract
        Set_Bit_F(Bit := 4,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_2);
    END_IF;
    
    IF #Interlock_Timer.Q THEN //Interlock process timed out
        Set_Bit_F(Bit := 3,
                    Bit_Value := 1,
                    Var := #VTD_Control.VTD_Errors.Error_Word_3);
        #I_State := 400;
    END_IF;
    
    // Watchdog bit
    IF #Watchdog.Q THEN
        #VTD_Control.Running := FALSE;
        IF #VTD_Control.Mode = 4 THEN //24:9 Teach timed out
            Set_Bit_F(Bit := 10,
                        Bit_Value := 1,
                        Var := #VTD_Control.VTD_Errors.Error_Word_2);
        ELSIF #VTD_Control.Mode = 3 THEN //24:9 Auto timed out
            Set_Bit_F(Bit := 10,
                        Bit_Value := 1,
                        Var := #VTD_Control.VTD_Errors.Error_Word_2);
        ELSIF #VTD_Control.Mode = 2 THEN //24:9 Semi auto timed out
            Set_Bit_F(Bit := 10,
                        Bit_Value := 1,
                        Var := #VTD_Control.VTD_Errors.Error_Word_2);
        END_IF;
    END_IF;
    
    // go to error state
    IF  #VTD_Control.VTD_Errors.Error_Word_1 <> 0 OR
        #VTD_Control.VTD_Errors.Error_Word_2 <> 0 OR
        #VTD_Control.VTD_Errors.Error_Word_3 <> 0 OR
        #VTD_Control.VTD_Errors.Error_Word_4 <> 0 THEN
        #VTD_Control.Error := TRUE;
        #State := 400;
    END_IF;
END_REGION

REGION VFD
    //Status
    #VTD_Control.Motor.Ready := #SinaSpeed.Status = 16#7002;
    #VTD_Control.Motor.Running := #SinaSpeed.AxisEnabled;
    #VTD_Control.Motor.Error := #SinaSpeed.Status > 16#8000;
   
    //SETPOINT
    IF #VTD_Control.Motor_UP THEN
        #MainSetpoint := SCALE_X(MIN := 0,
                                 VALUE := NORM_X(MIN := 0,
                                                 VALUE := #VTD_Control.Motor_Speed,
                                                 MAX := 100),
                                 MAX := 1774);
    ELSIF #VTD_Control.Motor_Down THEN
        #MainSetpoint := (SCALE_X(MIN := 0,
                                  VALUE := NORM_X(MIN := 0,
                                                  VALUE := #VTD_Control.Motor_Speed,
                                                  MAX := 100),
                                  MAX := 1774)) * -1;
    ELSE
        #MainSetpoint := 0;
    END_IF;
    
    "IEC_Timer_0_DB".TON(IN:=#MainSetpoint <> 0,
                         PT:=T#500ms);
    
    IF "IEC_Timer_0_DB".Q THEN
        #MainSetpoint1 := #MainSetpoint;
    ELSE
        #MainSetpoint1 := 0;
    END_IF;
    
    IF #VTD_Control.Instruction.Enable THEN
        #SinaSpeed(EnableAxis := #VTD_Control.Motor_UP OR #VTD_Control.Motor_Down,
                       AckError := #VTD_Control.Instruction.Reset,
                       SpeedSp := #MainSetpoint1,
                       RefSpeed := 1774,
                       HWIDSTW := ,
                       HWIDZSW := ,
                       AxisEnabled => #VTD_Control.Motor.Status.%X0,
                       Lockout => #VTD_Control.Motor.Error,
                       Error => #VTD_Control.Motor.Error);
    END_IF;
    
    REGION Actual Speed
        IF #MainSetpoint1 > 0 THEN
            #VTD_Control.Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                       VALUE := NORM_X(MIN := 0,
                                                                       VALUE := #SinaSpeed.ActVelocity,
                                                                       MAX := 1774),
                                                       MAX := 100);
        ELSIF #MainSetpoint1 < 0 THEN
            #VTD_Control.Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                       VALUE := NORM_X(MIN := 0,
                                                                       VALUE := #SinaSpeed.ActVelocity * -1,
                                                                       MAX := 1774),
                                                       MAX := 100);
        ELSE
            #VTD_Control.Motor.Speed_Actual := 0;
        END_IF;
    END_REGION
END_REGION

//Assign local vars to outputs
"Left LockingPin CMD Retract" := #LPL_Retract;
"Left LockingPin CMD Extend" := #LPL_Extend;
"Right LockingPin CMD Retract" := #LPR_Retract;
"Right LockingPin CMD Extend" := #LPR_Extend;

END_FUNCTION_BLOCK