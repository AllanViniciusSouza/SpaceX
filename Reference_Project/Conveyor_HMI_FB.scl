FUNCTION_BLOCK "Conveyor_HMI_FB"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR 
      R_Charge_Cnv_Commands {InstructionName := 'R_TRIG'; LibVersion := '1.0'} : R_TRIG;
      T_Reset_Charge {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
   END_VAR

   VAR_TEMP 
      i : UInt;
      J : UInt;
      No_Light_Guard : Bool;
   END_VAR


BEGIN
	"CNV_Selector"();
	
	REGION SEND/RECEIVE BUTTON
	    IF "CNV_System_Selected" = 1 AND NOT "Control_DB".VTD_Sys[1].Running AND "Control_DB".VTD_Sys[1].Current_Level <> 0 THEN
	        IF "CNV2_Selected" = 1 AND "HMI_DB".ScreenNo_Main = 2 THEN
	            //CNV 1
	            IF "Control_DB".ECnv_Sys[1].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv1.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[1].Running AND NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv1.Running AND
	                "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv1.Pallet_Type <> 1 AND "Control_DB".ECnv_Sys[1].Pallet_Type <> 5 THEN
	                "CNV_HMI".In_Out[1] := TRUE;
	                "CNV_In_Out" := TRUE;
	            ELSIF NOT "Control_DB".ECnv_Sys[1].Cnv_Occupied AND "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv1.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[1].Running AND NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv1.Running THEN
	                "CNV_HMI".In_Out[1] := FALSE;
	                "CNV_In_Out" := FALSE;
	            ELSE
	                ;
	            END_IF;
	            //CNV 2
	        ELSIF "CNV2_Selected" = 2 AND "HMI_DB".ScreenNo_Main = 2 THEN   //CNV 2
	            IF "Control_DB".ECnv_Sys[1].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv2.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[1].Running AND NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv2.Running AND
	                "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv2.Pallet_Type <> 1 AND "Control_DB".ECnv_Sys[1].Pallet_Type <> 5 THEN
	                "CNV_HMI".In_Out[1] := TRUE;
	                "CNV_In_Out" := TRUE;
	            ELSIF NOT "Control_DB".ECnv_Sys[1].Cnv_Occupied AND "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv2.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[1].Running AND NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv2.Running THEN
	                "CNV_HMI".In_Out[1] := FALSE;
	                "CNV_In_Out" := FALSE;
	            ELSE
	                ;
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    IF "CNV_System_Selected" = 2 AND NOT "Control_DB".VTD_Sys[2].Running AND "Control_DB".VTD_Sys[2].Current_Level <> 0 THEN
	        IF "CNV2_Selected" = 1 AND "HMI_DB".ScreenNo_Main = 2 THEN
	            //CNV 1
	            IF "Control_DB".ECnv_Sys[2].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv1.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[2].Running AND NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv1.Running AND
	                "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv1.Pallet_Type <> 1 AND "Control_DB".ECnv_Sys[2].Pallet_Type <> 5 THEN
	                "CNV_HMI".In_Out[2] := TRUE;
	                "CNV_In_Out" := TRUE;
	            ELSIF NOT "Control_DB".ECnv_Sys[2].Cnv_Occupied AND "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv1.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[2].Running AND NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv1.Running THEN
	                "CNV_HMI".In_Out[2] := FALSE;
	                "CNV_In_Out" := FALSE;
	            ELSE
	                ;
	            END_IF;
	            //CNV 2
	        ELSIF "CNV2_Selected" = 2 AND "HMI_DB".ScreenNo_Main = 2 THEN   //CNV 2
	            IF "Control_DB".ECnv_Sys[2].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv2.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[2].Running AND NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv2.Running AND
	                "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv2.Pallet_Type <> 1 AND "Control_DB".ECnv_Sys[2].Pallet_Type <> 5 THEN
	                "CNV_HMI".In_Out[2] := TRUE;
	                "CNV_In_Out" := TRUE;
	            ELSIF NOT "Control_DB".ECnv_Sys[2].Cnv_Occupied AND "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv2.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[2].Running AND NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv2.Running THEN
	                "CNV_HMI".In_Out[2] := FALSE;
	                "CNV_In_Out" := FALSE;
	            ELSE
	                ;
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    IF "CNV_System_Selected" = 3 AND NOT "Control_DB".VTD_Sys[3].Running AND "Control_DB".VTD_Sys[3].Current_Level <> 0 THEN
	        IF "CNV2_Selected" = 1 AND "HMI_DB".ScreenNo_Main = 2 THEN
	            //CNV 1
	            IF "Control_DB".ECnv_Sys[3].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[3].Cnv_Level["Control_DB".VTD_Sys[3].Current_Level].Cnv1.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[3].Running AND NOT "Control_DB".LCnv_Sys[3].Cnv_Level["Control_DB".VTD_Sys[3].Current_Level].Cnv1.Running THEN
	                "CNV_HMI".In_Out[3] := TRUE;
	                "CNV_In_Out" := TRUE;
	            ELSIF NOT "Control_DB".ECnv_Sys[3].Cnv_Occupied AND "Control_DB".LCnv_Sys[3].Cnv_Level["Control_DB".VTD_Sys[3].Current_Level].Cnv1.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[3].Running AND NOT "Control_DB".LCnv_Sys[3].Cnv_Level["Control_DB".VTD_Sys[3].Current_Level].Cnv1.Running THEN
	                "CNV_HMI".In_Out[3] := FALSE;
	                "CNV_In_Out" := FALSE;
	            ELSE
	                ;
	            END_IF;
	            //CNV 2
	        ELSIF "CNV2_Selected" = 2 AND "HMI_DB".ScreenNo_Main = 2 THEN   //CNV 2
	            IF "Control_DB".ECnv_Sys[3].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[3].Cnv_Level["Control_DB".VTD_Sys[3].Current_Level].Cnv2.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[3].Running AND NOT "Control_DB".LCnv_Sys[3].Cnv_Level["Control_DB".VTD_Sys[3].Current_Level].Cnv2.Running THEN
	                "CNV_HMI".In_Out[3] := TRUE;
	                "CNV_In_Out" := TRUE;
	            ELSIF NOT "Control_DB".ECnv_Sys[3].Cnv_Occupied AND "Control_DB".LCnv_Sys[3].Cnv_Level["Control_DB".VTD_Sys[3].Current_Level].Cnv2.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[3].Running AND NOT "Control_DB".LCnv_Sys[3].Cnv_Level["Control_DB".VTD_Sys[3].Current_Level].Cnv2.Running THEN
	                "CNV_HMI".In_Out[3] := FALSE;
	                "CNV_In_Out" := FALSE;
	            ELSE
	                ;
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    IF "CNV_System_Selected" = 4 AND NOT "Control_DB".VTD_Sys[4].Running AND "Control_DB".VTD_Sys[4].Current_Level <> 0 THEN
	        IF "CNV2_Selected" = 1 AND "HMI_DB".ScreenNo_Main = 2 THEN
	            //CNV 1
	            IF "Control_DB".ECnv_Sys[4].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[4].Cnv_Level["Control_DB".VTD_Sys[4].Current_Level].Cnv1.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[4].Running AND NOT "Control_DB".LCnv_Sys[4].Cnv_Level["Control_DB".VTD_Sys[4].Current_Level].Cnv1.Running THEN
	                "CNV_HMI".In_Out[4] := TRUE;
	                "CNV_In_Out" := TRUE;
	            ELSIF NOT "Control_DB".ECnv_Sys[4].Cnv_Occupied AND "Control_DB".LCnv_Sys[4].Cnv_Level["Control_DB".VTD_Sys[4].Current_Level].Cnv1.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[4].Running AND NOT "Control_DB".LCnv_Sys[4].Cnv_Level["Control_DB".VTD_Sys[4].Current_Level].Cnv1.Running THEN
	                "CNV_HMI".In_Out[4] := FALSE;
	                "CNV_In_Out" := FALSE;
	            ELSE
	                ;
	            END_IF;
	        END_IF;
	    END_IF;
	    
	    IF "CNV_System_Selected" = 5 AND NOT "Control_DB".VTD_Sys[5].Running AND "Control_DB".VTD_Sys[5].Current_Level <> 0 THEN
	        IF "CNV2_Selected" = 1 AND "HMI_DB".ScreenNo_Main = 2 THEN
	            //CNV 1
	            IF "Control_DB".ECnv_Sys[5].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[5].Cnv_Level["Control_DB".VTD_Sys[5].Current_Level].Cnv1.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[5].Running AND NOT "Control_DB".LCnv_Sys[5].Cnv_Level["Control_DB".VTD_Sys[5].Current_Level].Cnv1.Running THEN
	                "CNV_HMI".In_Out[5] := TRUE;
	                "CNV_In_Out" := TRUE;
	            ELSIF NOT "Control_DB".ECnv_Sys[5].Cnv_Occupied AND "Control_DB".LCnv_Sys[5].Cnv_Level["Control_DB".VTD_Sys[5].Current_Level].Cnv1.Cnv_Occupied AND
	                NOT "Control_DB".ECnv_Sys[5].Running AND NOT "Control_DB".LCnv_Sys[5].Cnv_Level["Control_DB".VTD_Sys[5].Current_Level].Cnv1.Running THEN
	                "CNV_HMI".In_Out[5] := FALSE;
	                "CNV_In_Out" := FALSE;
	            ELSE
	                ;
	            END_IF;
	        END_IF;
	    END_IF;
	END_REGION ;
	
	REGION Assign Conveyor 1
	    REGION CHARGE DATA FROM THE CORRECT CONVEYOR
	        //CHARGE DATA CHANGING CONVEYORS ID
	        IF "CNV_ID_HMI" <> "CNV_ID_HMI_Old" THEN
	            "Screen_DB".Charge_Cnv_Commands := TRUE;
	            "CNV_ID_HMI_Old" := "CNV_ID_HMI";
	        END_IF;
	        #R_Charge_Cnv_Commands(CLK := "Screen_DB".Charge_Cnv_Commands OR "HMI_DB".ScreenNo_Main = 2);
	        
	        //CHARGE ONCE THE COMMANDS STATUS
	        IF "Screen_DB".Charge_Cnv_Commands THEN
	            CASE "CNV_ID_HMI" OF
	                    //SYSTEM 1
	                120001:
	                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
	                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
	                    "Task_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Task_ID;
	                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
	                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
	                    "Pallet_Allignment_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Pallet_Allignment;
	                120101:
	                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
	                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
	                    "Task_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Task_ID;
	                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
	                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
	                    "Pallet_Allignment_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Pallet_Allignment;
	                120201:
	                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
	                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
	                    "Task_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Task_ID;
	                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
	                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
	                    "Pallet_Allignment_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Pallet_Allignment;
	                120301:
	                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
	                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
	                    "Task_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Task_ID;
	                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
	                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
	                    "Pallet_Allignment_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Pallet_Allignment;
	                120401:
	                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
	                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
	                    "Task_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Task_ID;
	                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
	                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
	                    "Pallet_Allignment_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Pallet_Allignment;
	                120501:
	                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
	                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
	                    "Task_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Task_ID;
	                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
	                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
	                    "Pallet_Allignment_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Pallet_Allignment;
	                120601:
	                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
	                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
	                    "Task_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Task_ID;
	                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
	                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
	                    "Pallet_Allignment_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Pallet_Allignment;
	                120701:
	                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
	                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
	                    "Task_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Task_ID;
	                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
	                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
	                    "Pallet_Allignment_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Pallet_Allignment;
	                120801:
	                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
	                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
	                    "Task_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Task_ID;
	                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
	                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
	                    "Pallet_Allignment_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Pallet_Allignment;
	                    
	                    //SYSTEM 2
	                120002:
	                    "Enable_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Enable;
	                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Mode_Change;
	                    "Task_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Task_ID;
	                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_To_ID;
