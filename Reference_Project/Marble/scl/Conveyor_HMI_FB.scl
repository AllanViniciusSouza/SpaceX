FUNCTION_BLOCK "Conveyor_HMI_FB"   // FB 20, author 

VAR
   R_Charge_Cnv_Commands : R_TRIG;
   T_Reset_Charge : TON_TIME;
END_VAR

VAR_TEMP
   i : UInt;
   J : UInt;
   No_Light_Guard : Bool;
END_VAR

BEGIN
CNV_Selector();

REGION SEND/RECEIVE BUTTON
    IF "CNV_System_Selected" = 1 AND NOT "Control_DB".VTD_Sys[1].Running AND "Control_DB".VTD_Sys[1].Current_Level <> 0 THEN
        IF "CVTD_CNV2_Selected" = 1 AND "HMI_DB".ScreenNo_Main = 2 THEN
            //EXTRACTOR CONVEYOR
            IF "Control_DB".ECnv_Sys[1].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv1.Cnv_Occupied AND
                NOT "Control_DB".ECnv_Sys[1].Running AND NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv1.Running THEN
                "CNV_In_Out(1)" := FALSE; //RECEIVE
            ELSIF NOT "Control_DB".ECnv_Sys[1].Cnv_Occupied AND "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv1.Cnv_Occupied AND
                NOT "Control_DB".ECnv_Sys[1].Running AND NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv1.Running THEN
                "CNV_In_Out(1)" := TRUE; //SEND
            ELSE
                ;
            END_IF;
            //CNV 2
        ELSIF "CVTD_CNV2_Selected" = 2 AND "HMI_DB".ScreenNo_Main = 2 THEN   //CNV 2
            IF "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv1.Cnv_Occupied AND
                NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv2.Cnv_Occupied AND
                NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv1.Running AND
                NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv2.Running THEN
                "CNV_In_Out(1)" := TRUE; //SEND
            ELSIF NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv1.Cnv_Occupied AND
                "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv2.Cnv_Occupied AND
                NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv1.Running AND
                NOT "Control_DB".LCnv_Sys[1].Cnv_Level["Control_DB".VTD_Sys[1].Current_Level].Cnv2.Running THEN
                "CNV_In_Out(1)" := FALSE; //RECEIVE
            ELSE
                ;
            END_IF;
        END_IF;
    END_IF;
    
    IF "CNV_System_Selected" = 2 AND NOT "Control_DB".VTD_Sys[2].Running AND "Control_DB".VTD_Sys[2].Current_Level <> 0 THEN
        IF "CVTD_CNV2_Selected" = 1 AND "HMI_DB".ScreenNo_Main = 2 THEN
            //EXTRACTOR CONVEYOR
            IF "Control_DB".ECnv_Sys[2].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv1.Cnv_Occupied AND
                NOT "Control_DB".ECnv_Sys[2].Running AND NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv1.Running THEN
                "CNV_In_Out(1)" := FALSE; //RECEIVE
            ELSIF NOT "Control_DB".ECnv_Sys[2].Cnv_Occupied AND "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv1.Cnv_Occupied AND
                NOT "Control_DB".ECnv_Sys[2].Running AND NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv1.Running THEN
                "CNV_In_Out(1)" := TRUE; //SEND
            ELSE
                ;
            END_IF;
            //CNV 2
        ELSIF "CVTD_CNV2_Selected" = 2 AND "HMI_DB".ScreenNo_Main = 2 THEN   //CNV 2
            IF "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv1.Cnv_Occupied AND
                NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv2.Cnv_Occupied AND
                NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv1.Running AND
                NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv2.Running THEN
                "CNV_In_Out(1)" := TRUE; //SEND
            ELSIF NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv1.Cnv_Occupied AND
                "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv2.Cnv_Occupied AND
                NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv1.Running AND
                NOT "Control_DB".LCnv_Sys[2].Cnv_Level["Control_DB".VTD_Sys[2].Current_Level].Cnv2.Running THEN
                "CNV_In_Out(1)" := FALSE; //RECEIVE
            ELSE
                ;
            END_IF;
        END_IF;
    END_IF;
END_REGION ;

REGION Assign Conveyor 1
    REGION CHARGE DATA FROM THE CORRECT CONVEYOR
        //CHARGE DATA CHANGING CONVEYORS ID
        IF "CNV_ID_HMI" <> "CNV_ID_HMI_Old" THEN
            "Screen_DB".Charge_Cnv_Commands := TRUE;
            "CNV_ID_HMI_Old" := "CNV_ID_HMI";
        END_IF;
        #R_Charge_Cnv_Commands(CLK := "Screen_DB".Charge_Cnv_Commands OR "HMI_DB".ScreenNo_Main = 2);
        
        //CHARGE ONCE THE COMMANDS STATUS
        IF "Screen_DB".Charge_Cnv_Commands THEN
            CASE "CNV_ID_HMI" OF
                    //SYSTEM 1
                    //ECONVEYOR
                120001:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
                120101:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
                120201:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
                120301:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
                120401:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
                120501:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
                120601:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[1].Instruction.Transfer_From_ID;
                    
                    //CNV 2
                110201:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Instruction.Transfer_From_ID;
                110301:
                    "Enable_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Instruction.Transfer_From_ID;
                110401:
                    "Enable_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Instruction.Transfer_From_ID;
                110501:
                    "Enable_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2.Instruction.Transfer_From_ID;
                110601:
                    "Enable_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv2.Instruction.Transfer_From_ID;
                    
                    //SYSTEM 2
                120002:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_From_ID;
                120102:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_From_ID;
                120202:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_From_ID;
                120302:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_From_ID;
                120402:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_From_ID;
                120502:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_From_ID;
                120602:
                    "Enable_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".ECnv_Sys[2].Instruction.Transfer_From_ID;
                    
                    //CNV 2
                110202:
                    "Enable_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv2.Instruction.Transfer_From_ID;
                110302:
                    "Enable_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv2.Instruction.Transfer_From_ID;
                110402:
                    "Enable_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv2.Instruction.Transfer_From_ID;
                110502:
                    "Enable_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv2.Instruction.Transfer_From_ID;
                110602:
                    "Enable_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv2.Instruction.Transfer_From_ID;
            END_CASE;
        END_IF;
    END_REGION
    
    REGION CHARGE DATA FROM HMI (AFTER CHARGE DATA)
        IF NOT "Screen_DB".Charge_Cnv_Commands AND "HMI_DB".ScreenNo_Main = 2 AND NOT #R_Charge_Cnv_Commands.Q THEN
            CASE "CNV_ID_HMI" OF
                    //SYSTEM 1
                    //ECONVEYOR
                120001:
                    Feed_ECNV(System_No := 1,
                                Safety_OK := "Remote_Panel_DB_1".Safety_OK,
                                System_Busy := "System_1_Busy");
                120101:
                    Feed_ECNV(System_No := 1,
                                Safety_OK := "Remote_Panel_DB_1".Safety_OK,
                                System_Busy := "System_1_Busy");
                120201:
                    Feed_ECNV(System_No := 1,
                                Safety_OK := "Remote_Panel_DB_1".Safety_OK,
                                System_Busy := "System_1_Busy");
                120301:
                    Feed_ECNV(System_No := 1,
                                Safety_OK := "Remote_Panel_DB_1".Safety_OK,
                                System_Busy := "System_1_Busy");
                120401:
                    Feed_ECNV(System_No := 1,
                                Safety_OK := "Remote_Panel_DB_1".Safety_OK,
                                System_Busy := "System_1_Busy");
                120501:
                    Feed_ECNV(System_No := 1,
                                Safety_OK := "Remote_Panel_DB_1".Safety_OK,
                                System_Busy := "System_1_Busy");
                120601:
                    Feed_ECNV(System_No := 1,
                                Safety_OK := "Remote_Panel_DB_1".Safety_OK,
                                System_Busy := "System_1_Busy");
                    
                    //CNV 2
                110201:
                    Feed_BCNV_Cnv2(System_No := 1,
                                     Level := 2,
                                     System_Busy := "System_1_Busy");
                110301:
                    Feed_BCNV_Cnv2(System_No := 1,
                                     Level := 3,
                                     System_Busy := "System_1_Busy");
                110401:
                    Feed_BCNV_Cnv2(System_No := 1,
                                     Level := 4,
                                     System_Busy := "System_1_Busy");
                110501:
                    Feed_BCNV_Cnv2(System_No := 1,
                                     Level := 5,
                                     System_Busy := "System_1_Busy");
                110601:
                    Feed_BCNV_Cnv2(System_No := 1,
                                     Level := 6,
                                     System_Busy := "System_1_Busy");
                    
                    //SYSTEM 2
                120002:
                    Feed_ECNV(System_No := 2,
                                Safety_OK := "Remote_Panel_DB_2".Safety_OK,
                                System_Busy := "System_2_Busy");
                120102:
                    Feed_ECNV(System_No := 2,
                                Safety_OK := "Remote_Panel_DB_2".Safety_OK,
                                System_Busy := "System_2_Busy");
                120202:
                    Feed_ECNV(System_No := 2,
                                Safety_OK := "Remote_Panel_DB_2".Safety_OK,
                                System_Busy := "System_2_Busy");
                120302:
                    Feed_ECNV(System_No := 2,
                                Safety_OK := "Remote_Panel_DB_2".Safety_OK,
                                System_Busy := "System_2_Busy");
                120402:
                    Feed_ECNV(System_No := 2,
                                Safety_OK := "Remote_Panel_DB_2".Safety_OK,
                                System_Busy := "System_2_Busy");
                120502:
                    Feed_ECNV(System_No := 2,
                                Safety_OK := "Remote_Panel_DB_2".Safety_OK,
                                System_Busy := "System_2_Busy");
                120602:
                    Feed_ECNV(System_No := 2,
                                Safety_OK := "Remote_Panel_DB_2".Safety_OK,
                                System_Busy := "System_2_Busy");
                    
                    //CNV 2
                110202:
                    Feed_BCNV_Cnv2(System_No := 2,
                                     Level := 2,
                                     System_Busy := "System_2_Busy");
                110302:
                    Feed_BCNV_Cnv2(System_No := 2,
                                     Level := 3,
                                     System_Busy := "System_2_Busy");
                110402:
                    Feed_BCNV_Cnv2(System_No := 2,
                                     Level := 4,
                                     System_Busy := "System_2_Busy");
                110502:
                    Feed_BCNV_Cnv2(System_No := 2,
                                     Level := 5,
                                     System_Busy := "System_2_Busy");
                110602:
                    Feed_BCNV_Cnv2(System_No := 2,
                                     Level := 6,
                                     System_Busy := "System_2_Busy");
            END_CASE;
        END_IF;
    END_REGION
END_REGION

REGION Assign Conveyor 2
    REGION CHARGE DATA FROM THE CORRECT CONVEYOR
        //CHARGE DATA CHANGING CONVEYORS ID
        IF "CNV_ID_HMI(1)" <> "CNV_ID_HM_Old(1)" THEN
            "Screen_DB".Charge_Cnv_Commands := TRUE;
            "CNV_ID_HM_Old(1)" := "CNV_ID_HMI(1)";
        END_IF;
        #R_Charge_Cnv_Commands(CLK := "Screen_DB".Charge_Cnv_Commands OR "HMI_DB".ScreenNo_Main = 2);
        
        IF "Screen_DB".Charge_Cnv_Commands THEN
            CASE "CNV_ID_HMI(1)" OF
                    //CNV 1 - SYSTEM 1
                100201:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Instruction.Transfer_From_ID;
                100301:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Instruction.Transfer_From_ID;
                100401:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Instruction.Transfer_From_ID;
                100501:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Instruction.Transfer_From_ID;
                100601:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv1.Instruction.Transfer_From_ID;
                    
                    //CNV 1 - SYSTEM 2
                100202:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv1.Instruction.Transfer_From_ID;
                100302:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv1.Instruction.Transfer_From_ID;
                100402:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv1.Instruction.Transfer_From_ID;
                100502:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv1.Instruction.Transfer_From_ID;
                100602:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv1.Instruction.Transfer_From_ID;
                    
            END_CASE;
            "Screen_DB".Charge_Cnv_Commands := 0;
        END_IF;
    END_REGION
    
    REGION CHARGE DATA FROM HMI (AFTER CHARGE DATA)
        IF NOT "Screen_DB".Charge_Cnv_Commands AND "HMI_DB".ScreenNo_Main = 2 AND NOT #R_Charge_Cnv_Commands.Q THEN
            CASE "CNV_ID_HMI(1)" OF
                    //SYSTEM 1
                    //CNV 1
                100201:
                    "Feed_BCNV_Cnv1(1)"(System_No := 1,
                                        Level := 2,
                                        System_Busy := "System_1_Busy");
                100301:
                    "Feed_BCNV_Cnv1(1)"(System_No := 1,
                                        Level := 3,
                                        System_Busy := "System_1_Busy");
                100401:
                    "Feed_BCNV_Cnv1(1)"(System_No := 1,
                                        Level := 4,
                                        System_Busy := "System_1_Busy");
                100501:
                    "Feed_BCNV_Cnv1(1)"(System_No := 1,
                                        Level := 5,
                                        System_Busy := "System_1_Busy");
                100601:
                    "Feed_BCNV_Cnv1(1)"(System_No := 1,
                                        Level := 6,
                                        System_Busy := "System_1_Busy");
                    
                    //SYSTEM 2
                    //CNV 1
                100202:
                    "Feed_BCNV_Cnv1(1)"(System_No := 2,
                                        Level := 2,
                                        System_Busy := "System_2_Busy");
                100302:
                    "Feed_BCNV_Cnv1(1)"(System_No := 2,
                                        Level := 3,
                                        System_Busy := "System_2_Busy");
                100402:
                    "Feed_BCNV_Cnv1(1)"(System_No := 2,
                                        Level := 4,
                                        System_Busy := "System_2_Busy");
                100502:
                    "Feed_BCNV_Cnv1(1)"(System_No := 2,
                                        Level := 5,
                                        System_Busy := "System_2_Busy");
                100602:
                    "Feed_BCNV_Cnv1(1)"(System_No := 2,
                                        Level := 6,
                                        System_Busy := "System_2_Busy");
            END_CASE;
        END_IF;
    END_REGION
END_REGION


//RESET CHARGE BITS
#T_Reset_Charge.TON(IN := "Screen_DB".Charge_VTD OR "Screen_DB".Charge_Cnv OR "Screen_DB".Charge_VTD_Commands OR "Screen_DB".Charge_Cnv_Commands,
                    PT := T#2S);

IF #T_Reset_Charge.Q THEN
    "Screen_DB".Charge_VTD := FALSE;
    "Screen_DB".Charge_Cnv := FALSE;
    "Screen_DB".Charge_VTD_Commands := FALSE;
    "Screen_DB".Charge_Cnv_Commands := FALSE;
END_IF;

END_FUNCTION_BLOCK