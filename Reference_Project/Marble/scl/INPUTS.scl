            "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv1.Inputs.VFD_Speed_Actual := WORD_TO_INT("C2105_ActualSpeed");
            "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv1.Inputs.VFD_ActualTorque := WORD_TO_INT("C2105_ActualTorque");
