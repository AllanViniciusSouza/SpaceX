FUNCTION "Feed_BCNV_Cnv2"   // FC 28, author 

VAR_INPUT
   System_No : UInt;
   Level : UInt;
END_VAR

VAR_IN_OUT
   System_Busy : Bool;
END_VAR

   // RETURN : Void
BEGIN
//Sensors
"HMI_CNV_Forward" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Inputs.Forward_Sensor;
"HMI_CNV_Backward" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Inputs.Backward_Sensor;

//Status
"Mode_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Mode;
"Enabled_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Enabled;
"Error_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Error;
"Warning_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Warning;
"Stopped_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Stopped;
"Running_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Running;
"Ready_For_Task_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Ready_For_Task;
"Cnv_Occupied_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Cnv_Occupied;
"SM_State_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.SM_State;
IF "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Motor.Forward THEN
    "Motor_Direction_HMI" := 1;
ELSIF "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Motor.Reverse THEN
    "Motor_Direction_HMI" := 2;
ELSE
    "Motor_Direction_HMI" := 0;
END_IF;
"Motor_Speed_Requested_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Motor.Speed;
"Motor_Speed_Actual_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Motor.Speed_Actual;
"CNV_Motor_Ready" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Motor.Ready;
"CNV_Motor_Current_Actual_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Motor.Actual_Current;
"CNV_Motor_Actual_Torque" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Motor.Actual_Torque;
"Transfer_To_ID_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Transfer_To_ID;
"Transfer_From_ID_HMI" := "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Transfer_From_ID;

IF "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Motor.Error THEN
    "CNV_Motor_Status_HMI" := 2;
ELSIF "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Motor.Enabled THEN
    "CNV_Motor_Status_HMI" := 1;
ELSIF NOT "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Motor.Enabled THEN
    "CNV_Motor_Status_HMI" := 0;
END_IF;

//Instructions
IF ("HMI_Box_Connected_1" = #System_No OR ("HMI_Box_Connected_1" >= (#System_No * 10) + 1 AND "HMI_Box_Connected_1" <= (#System_No * 10) + 8)) OR
    ("HMI_Box_Connected_2" = #System_No OR ("HMI_Box_Connected_1" >= (#System_No * 10) + 1 AND "HMI_Box_Connected_1" <= (#System_No * 10) + 8))
THEN
    #System_Busy := TRUE;
ELSE
    #System_Busy := FALSE;
    "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Stop := "Stop_HMI";
    "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Execute := "Manual_Fwd_HMI" OR "Manual_Bwd_HMI";
    "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Mode_Change := "Mode_Change_HMI";
    "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Enable := "Enable_HMI";
    
    "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Reset :=
    "Reset_HMI" OR "Reset_All" OR
    "CNV_HMI"."Reset"[1] OR "Screen_DB_1".Reset_All[1] OR
    "CNV_HMI"."Reset"[2] OR "Screen_DB_1".Reset_All[2];
    
    IF "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Mode <> 3 THEN
        "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Foward := "Manual_Fwd_HMI";
        "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Backward := "Manual_Bwd_HMI";
        "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Start_Transfer := "Start_Transfer_HMI";
        IF "CNV_In_Out(1)" THEN // 0 = ECNV RECEIVE, 1 = ECONV SEND
            "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Transfer_To_ID := 0;
            "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Transfer_From_ID := DINT#100000 + (#Level * 100) + #System_No;
        ELSE
            "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Transfer_To_ID := DINT#100000 + (#Level * 100) + #System_No;
            "Control_DB".LCnv_Sys[#System_No].Cnv_Level[#Level].Cnv2.Instruction.Transfer_From_ID := 0;
        END_IF;
    END_IF;
END_IF;

END_FUNCTION