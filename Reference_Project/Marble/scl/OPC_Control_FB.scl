                            //Conveyor It's occupied. Check the sensors on the extractor or buffer, or verify if the pallet is misaligned.
                            "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Cnv_Errors.Error_Word_1.%X1 := TRUE;
                            
                        ELSIF "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Inputs.Shuttle_High THEN
                            // The shuttle is LID high
                            "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Cnv_Errors.Error_Word_1.%X2 := TRUE;
                            #State_L5 := 400; //ERROR
                        END_IF;
                    END_IF;
                    
                101: //Set the DESTINATION conveyor variables
                    #State_Main := 0;
                    
                    //CNV 2 to CNV 1
                    IF "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Cnv_Occupied AND
                        NOT "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Cnv_Occupied
                    THEN
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Task_ID := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_ID);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Task_Metadata := "Control_DB"."Buffer_Order Table"[#Id].Task_Metadata;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Current_Task_Type := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_Type);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Transfer_From_ID := "Control_DB"."Buffer_Order Table"[#Id].Source_Location;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Transfer_To_ID := "Control_DB"."Buffer_Order Table"[#Id].Destination_Location;
                        #State_L5 := 106;
                        
                    ELSE
                        IF "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Cnv_Occupied THEN
                            //Conveyor It's occupied. Check the sensors on the extractor or buffer, or verify if the pallet is misaligned.
                            "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Cnv_Errors.Error_Word_1.%X1 := TRUE;
                            
                        ELSIF "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Inputs.Shuttle_High THEN
                            //The shuttle is LID high
                            "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Cnv_Errors.Error_Word_1.%X2 := TRUE;
                        END_IF;
                    END_IF;
                    
                105:  //Set the SOURCE conveyor variables
                    //Cnv1 to CNV 2
                    IF NOT "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Cnv_Occupied AND
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Cnv_Occupied
                    THEN
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Task_ID := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_ID);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Task_Metadata := "Control_DB"."Buffer_Order Table"[#Id].Task_Metadata;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Current_Task_Type := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_Type);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Transfer_To_ID := "Control_DB"."Buffer_Order Table"[#Id].Destination_Location;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Transfer_From_ID := "Control_DB"."Buffer_Order Table"[#Id].Source_Location;
                        #State_L5 := 110;
                        
                    ELSE
                        #State_L5 := 400; //ERROR
                    END_IF;
                    
                106:  //Set the SOURCE conveyor variables
                    //Cnv2 to CNV 1
                    IF NOT "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Cnv_Occupied AND
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Cnv_Occupied
                    THEN
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Instruction.Task_ID := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_ID);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Instruction.Task_Metadata := "Control_DB"."Buffer_Order Table"[#Id].Task_Metadata;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Current_Task_Type := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_Type);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Instruction.Transfer_To_ID := "Control_DB"."Buffer_Order Table"[#Id].Destination_Location;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Instruction.Transfer_From_ID := "Control_DB"."Buffer_Order Table"[#Id].Source_Location;
                        #State_L5 := 110;
                    ELSE
                        #State_L5 := 400; //ERROR
                    END_IF;
                    
                110: //Start the transfer
                    "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Start_Transfer := NOT "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Running;
                    "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Instruction.Start_Transfer := NOT "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Running;
                    IF "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Running AND "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Running THEN
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Start_Transfer := FALSE;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Instruction.Start_Transfer := FALSE;
                        "Control_DB"."Buffer_Order Table"[#Id].Movement_Ready := TRUE;
                        #State_L5 := 115;
                    END_IF;
                    
                115: //Wait for the transfer to complete
                    IF "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Done AND "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Done THEN
                        #State_L5 := 118;
                    END_IF;
                    
                118: //report done
                    "Control_DB".Movement_Completed.Level_5 := TRUE;
                    #State_L5 := 120;
                    
                120: //Wait for the ACK before we go back to Idle
                    IF NOT "Control_DB".Movement_Completed.Level_5 THEN
                        #State_L5 := 250;
                    END_IF;
                    
                250: //Reset all variable and return to idle
                    IF #Destination_Location_Buffers.Device_Type = 10 OR #Source_Location_Buffers.Device_Type = 10 THEN
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Reset := FALSE;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Start_Transfer := FALSE;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Task_ID := 0;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Task_Metadata := '';
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Current_Task_Type := 0;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Transfer_From_ID := 0;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv1.Instruction.Transfer_To_ID := 0;
                    ELSIF #Destination_Location_Buffers.Device_Type = 11 OR #Source_Location_Buffers.Device_Type = 11 THEN
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Instruction.Reset := FALSE;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Instruction.Start_Transfer := FALSE;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Instruction.Task_ID := 0;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Instruction.Task_Metadata := '';
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Current_Task_Type := 0;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Instruction.Transfer_From_ID := 0;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[5].Cnv2.Instruction.Transfer_To_ID := 0;
                    END_IF;
                    
                    #State_L5 := 0;
                    
                400:// Error state
                    #Error_ID.%X8 := TRUE;
                    IF "Reset_All" OR #HMI_Reset THEN
                        #Error_ID.%X8 := FALSE;
                        #State_L5 := 250;
                    END_IF;
            END_CASE;
        END_REGION

        REGION Level 6
            CASE #State_L6 OF
                0:  //Idle
                    ;
                    
                100: //Set the DESTINATION conveyor variables
                    #State_Main := 0;
                    
                    //CNV 1 to CNV 2
                    IF "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Cnv_Occupied AND
                        NOT "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Cnv_Occupied
                    THEN
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Task_ID := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_ID);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Task_Metadata := "Control_DB"."Buffer_Order Table"[#Id].Task_Metadata;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Current_Task_Type := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_Type);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Transfer_From_ID := "Control_DB"."Buffer_Order Table"[#Id].Source_Location;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Transfer_To_ID := "Control_DB"."Buffer_Order Table"[#Id].Destination_Location;
                        #State_L6 := 105;
                    ELSE
                        IF "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Cnv_Occupied THEN
                            //Conveyor It's occupied. Check the sensors on the extractor or buffer, or verify if the pallet is misaligned.
                            "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Cnv_Errors.Error_Word_1.%X1 := TRUE;
                            
                        ELSIF "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Inputs.Shuttle_High THEN
                            // The shuttle is LID high
                            "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Cnv_Errors.Error_Word_1.%X2 := TRUE;
                            #State_L6 := 400; //ERROR
                        END_IF;
                    END_IF;
                    
                101: //Set the DESTINATION conveyor variables
                    #State_Main := 0;
                    
                    //CNV 2 to CNV 1
                    IF "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Cnv_Occupied AND
                        NOT "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Cnv_Occupied
                    THEN
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Task_ID := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_ID);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Task_Metadata := "Control_DB"."Buffer_Order Table"[#Id].Task_Metadata;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Current_Task_Type := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_Type);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Transfer_From_ID := "Control_DB"."Buffer_Order Table"[#Id].Source_Location;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Transfer_To_ID := "Control_DB"."Buffer_Order Table"[#Id].Destination_Location;
                        #State_L6 := 106;
                        
                    ELSE
                        IF "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Cnv_Occupied THEN
                            //Conveyor It's occupied. Check the sensors on the extractor or buffer, or verify if the pallet is misaligned.
                            "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Cnv_Errors.Error_Word_1.%X1 := TRUE;
                            
                        ELSIF "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Inputs.Shuttle_High THEN
                            //The shuttle is LID high
                            "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Cnv_Errors.Error_Word_1.%X2 := TRUE;
                        END_IF;
                    END_IF;
                    
                105:  //Set the SOURCE conveyor variables
                    //Cnv1 to CNV 2
                    IF NOT "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Cnv_Occupied AND
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Cnv_Occupied
                    THEN
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Task_ID := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_ID);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Task_Metadata := "Control_DB"."Buffer_Order Table"[#Id].Task_Metadata;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Current_Task_Type := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_Type);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Transfer_To_ID := "Control_DB"."Buffer_Order Table"[#Id].Destination_Location;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Transfer_From_ID := "Control_DB"."Buffer_Order Table"[#Id].Source_Location;
                        #State_L6 := 110;
                        
                    ELSE
                        #State_L6 := 400; //ERROR
                    END_IF;
                    
                106:  //Set the SOURCE conveyor variables
                    //Cnv2 to CNV 1
                    IF NOT "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Cnv_Occupied AND
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Cnv_Occupied
                    THEN
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Task_ID := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_ID);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Task_Metadata := "Control_DB"."Buffer_Order Table"[#Id].Task_Metadata;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Current_Task_Type := INT_TO_UINT("Control_DB"."Buffer_Order Table"[#Id].Task_Type);
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Transfer_To_ID := "Control_DB"."Buffer_Order Table"[#Id].Destination_Location;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Transfer_From_ID := "Control_DB"."Buffer_Order Table"[#Id].Source_Location;
                        #State_L6 := 110;
                    ELSE
                        #State_L6 := 400; //ERROR
                    END_IF;
                    
                110: //Start the transfer
                    "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Start_Transfer := NOT "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Running;
                    "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Start_Transfer := NOT "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Running;
                    IF "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Running AND "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Running THEN
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Start_Transfer := FALSE;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Start_Transfer := FALSE;
                        "Control_DB"."Buffer_Order Table"[#Id].Movement_Ready := TRUE;
                        #State_L6 := 115;
                    END_IF;
                    
                115: //Wait for the transfer to complete
                    IF "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Done AND "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Done THEN
                        #State_L6 := 118;
                    END_IF;
                    
                118: //report done
                    "Control_DB".Movement_Completed.Level_6 := TRUE;
                    #State_L6 := 120;
                    
                120: //Wait for the ACK before we go back to Idle
                    IF NOT "Control_DB".Movement_Completed.Level_6 THEN
                        #State_L6 := 250;
                    END_IF;
                    
                250: //Reset all variable and return to idle
                    IF #Destination_Location_Buffers.Device_Type = 10 OR #Source_Location_Buffers.Device_Type = 10 THEN
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Reset := FALSE;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Start_Transfer := FALSE;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Task_ID := 0;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Task_Metadata := '';
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Current_Task_Type := 0;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Transfer_From_ID := 0;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv1.Instruction.Transfer_To_ID := 0;
                    ELSIF #Destination_Location_Buffers.Device_Type = 11 OR #Source_Location_Buffers.Device_Type = 11 THEN
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Reset := FALSE;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Start_Transfer := FALSE;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Task_ID := 0;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Task_Metadata := '';
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Current_Task_Type := 0;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Transfer_From_ID := 0;
                        "Control_DB".LCnv_Sys[#Id].Cnv_Level[6].Cnv2.Instruction.Transfer_To_ID := 0;
                    END_IF;
                    
                    #State_L6 := 0;
                    
                400:// Error state
                    #Error_ID.%X8 := TRUE;
                    IF "Reset_All" OR #HMI_Reset THEN
                        #Error_ID.%X8 := FALSE;
                        #State_L6 := 250;
                    END_IF;
            END_CASE;
        END_REGION
    END_REGION
    
ELSIF NOT #OPC_Enable THEN
    //Reset all variable and return to idle
    
    //Reset the OPC control variables
    "Control_DB"."VTD_Order Table"[#Id].SM_State := 0;
    "Control_DB"."VTD_Order Table"[#Id].Movement_Ready := FALSE;
    "Control_DB"."VTD_Order Table"[#Id].Movement_Request_Complete := FALSE;
    
    // Reset Order table VTD variables
    "Control_DB"."VTD_Order Table"[#Id].Task_Type := 0;
    "Control_DB"."VTD_Order Table"[#Id].Pallet_Type := 'C';
    "Control_DB"."VTD_Order Table"[#Id].Task_ID := 0;
    "Control_DB"."VTD_Order Table"[#Id].Task_Metadata := '';
    "Control_DB"."VTD_Order Table"[#Id].Source_Location := 0;
    "Control_DB"."VTD_Order Table"[#Id].Destination_Location := 0;
    #Destination_Location_VTD.Level := 0;
    #Source_Location_VTD.Level := 0;
    "Control_DB"."VTD_Order Table"[#Id].Shuttle_ID := 0;
    "Control_DB"."VTD_Order Table"[#Id].Shuttle_Loaded := FALSE;
    
    //Reset VTD variables
    "Control_DB".VTD_Sys[#Id].Instruction.Reset := FALSE;
    "Control_DB".VTD_Sys[#Id].Instruction.Pallet_Type := 0;
    "Control_DB".VTD_Sys[#Id].Instruction.Task_ID := 0;
    "Control_DB".VTD_Sys[#Id].Instruction.Task_Metadata := '';//
    "Control_DB".ECnv_Sys[#Id].Current_Task_Type := 0;
    "Control_DB".VTD_Sys[#Id].Instruction.Move_To_Level := 99;
    "Control_DB".VTD_Sys[#Id].Current_Task_Type := 0;
    
    //Reset Shuttle interlock
    "Control_DB".VTD_Sys[#Id].Shuttle_Interlock.Interlock_Request := FALSE;
    "Control_DB".VTD_Sys[#Id].Shuttle_Interlock.Shuttle_Start_Location := 0;
    "Control_DB".VTD_Sys[#Id].Shuttle_Interlock.Shuttle_Target_Location := 0;
    "Control_DB".VTD_Sys[#Id].Shuttle_Interlock.Shuttle_Loaded := 0;
    "Control_DB".VTD_Sys[#Id].Shuttle_Interlock.Shuttle_ID := 0;
    "Control_DB".VTD_Sys[#Id].Shuttle_Interlock.Shuttle_Interlock_Task_ID := 0;
    "Control_DB".VTD_Sys[#Id].Shuttle_Interlock.Shuttle_Interlock_Task_Metadata := '';//
    
    //Reset conveyor variables
    "Control_DB".ECnv_Sys[#Id].Instruction.Reset := FALSE;
    // "Control_DB".ECnv_Control.Instruction.Enable := FALSE;
    "Control_DB".ECnv_Sys[#Id].Instruction.Start_Transfer := FALSE;
    "Control_DB".ECnv_Sys[#Id].Instruction.Task_ID := 0;
    "Control_DB".ECnv_Sys[#Id].Instruction.Task_Metadata := '';//
    "Control_DB".ECnv_Sys[#Id].Instruction.Transfer_From_ID := 0;
    "Control_DB".ECnv_Sys[#Id].Instruction.Transfer_To_ID := 0;
    
    FOR #i := "Settings_DB".VTD_Sys[#Id].Lowest_Level TO "Settings_DB".VTD_Sys[#Id].Highest_Level DO
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv1.Instruction.Reset := FALSE;
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv1.Instruction.Start_Transfer := FALSE;
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv1.Instruction.Task_ID := 0;
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv1.Instruction.Task_Metadata := '';
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv1.Current_Task_Type := 0;
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv1.Instruction.Transfer_From_ID := 0;
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv1.Instruction.Transfer_To_ID := 0;
        
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv2.Instruction.Reset := FALSE;
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv2.Instruction.Start_Transfer := FALSE;
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv2.Instruction.Task_ID := 0;
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv2.Instruction.Task_Metadata := '';
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv2.Current_Task_Type := 0;
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv2.Instruction.Transfer_From_ID := 0;
        "Control_DB".LCnv_Sys[#Id].Cnv_Level[#i].Cnv2.Instruction.Transfer_To_ID := 0;
    END_FOR;
END_IF;
//////////////////////////////////////////////////////////////////////////////////////////////////////////
///////////////////////////////////////////////////////////////////////////////////////////////////////////
//
REGION Clear order table
    IF #Clear_VTD_OrderTable THEN
        #State_VTD := 250;
        "Control_DB"."VTD_Order Table"[#Id].Task_Data_Available := 0;
    END_IF;
    
    IF #Clear_Buffers_OrderTable THEN
        #State_Main := 0;
        #State_L2 := 250;
        #State_L3 := 250;
        #State_L4 := 250;
        #State_L5 := 250;
        #State_L6 := 250;
        "Control_DB"."Buffer_Order Table"[#Id].Task_Data_Available := 0;
    END_IF;
END_REGION

REGION SHUTTLES POSITION
    FOR #f := 1 TO "Settings_DB".System.Shuttle_Count DO
        "Control_DB".Shuttles_Position[#f].x := "Shuttle_MQTT_DB".Shuttle_MQTT[#f].Message.Shuttle_Status.Position_X;
        "Control_DB".Shuttles_Position[#f].y := "Shuttle_MQTT_DB".Shuttle_MQTT[#f].Message.Shuttle_Status.Position_Y;
    END_FOR;
END_REGION

#HMI_Reset := ("Screen_DB_1".Reset_All[1] AND
("HMI_Box_Connected_1" = 11 AND "KEY REMOTE/LOCAL L1 - CH1(1)") OR
("HMI_Box_Connected_1" = 12 AND "KEY REMOTE/LOCAL L2 - CH1(1)") OR
("HMI_Box_Connected_1" = 13 AND "KEY REMOTE/LOCAL L3 - CH1(1)") OR
("HMI_Box_Connected_1" = 14 AND "KEY REMOTE/LOCAL L4 - CH1(1)") OR
("HMI_Box_Connected_1" = 15 AND "KEY REMOTE/LOCAL L5 - CH1(1)") OR
("HMI_Box_Connected_1" = 16 AND "KEY REMOTE/LOCAL L6 - CH1(1)") OR
("HMI_Box_Connected_1" = 21 AND "KEY REMOTE/LOCAL L1 - CH1(2)") OR
("HMI_Box_Connected_1" = 22 AND "KEY REMOTE/LOCAL L2 - CH1(2)") OR
("HMI_Box_Connected_1" = 23 AND "KEY REMOTE/LOCAL L3 - CH1(2)") OR
("HMI_Box_Connected_1" = 24 AND "KEY REMOTE/LOCAL L4 - CH1(2)") OR
("HMI_Box_Connected_1" = 25 AND "KEY REMOTE/LOCAL L5 - CH1(2)") OR
("HMI_Box_Connected_1" = 26 AND "KEY REMOTE/LOCAL L6 - CH1(2)"));

END_FUNCTION_BLOCK