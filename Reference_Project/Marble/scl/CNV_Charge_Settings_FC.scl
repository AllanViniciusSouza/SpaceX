FUNCTION "CNV_Charge_Settings_FC"   // FC 42, author 

   // RETURN : Void
BEGIN
CASE "CNV_System_Selected" OF
    1: //SYSTEM 1
        CASE "CNV_Level_Selected" OF
            2:
                "PopUps_DB".Buffer_Cnv_Settings_1 := "Settings_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1;
                "PopUps_DB".ECnv_Settings := "Settings_DB".ECnv_Sys[1];
                "PopUps_DB".Buffer_Cnv_Settings_2 := "Settings_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2;
            3:
                "PopUps_DB".Buffer_Cnv_Settings_1 := "Settings_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1;
                "PopUps_DB".ECnv_Settings := "Settings_DB".ECnv_Sys[1];
                "PopUps_DB".Buffer_Cnv_Settings_2 := "Settings_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2;
            4:
                "PopUps_DB".Buffer_Cnv_Settings_1 := "Settings_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1;
                "PopUps_DB".ECnv_Settings := "Settings_DB".ECnv_Sys[1];
                "PopUps_DB".Buffer_Cnv_Settings_2 := "Settings_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2;
            5:
                "PopUps_DB".Buffer_Cnv_Settings_1 := "Settings_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1;
                "PopUps_DB".ECnv_Settings := "Settings_DB".ECnv_Sys[1];
                "PopUps_DB".Buffer_Cnv_Settings_2 := "Settings_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2;
            6:
                "PopUps_DB".Buffer_Cnv_Settings_1 := "Settings_DB".LCnv_Sys[1].Cnv_Level[6].Cnv1;
                "PopUps_DB".ECnv_Settings := "Settings_DB".ECnv_Sys[1];
                "PopUps_DB".Buffer_Cnv_Settings_2 := "Settings_DB".LCnv_Sys[1].Cnv_Level[6].Cnv2;
        END_CASE;
    2: //SYSTEM 2
        CASE "CNV_Level_Selected" OF
            2:
                "PopUps_DB".Buffer_Cnv_Settings_1 := "Settings_DB".LCnv_Sys[2].Cnv_Level[2].Cnv1;
                "PopUps_DB".ECnv_Settings := "Settings_DB".ECnv_Sys[2];
                "PopUps_DB".Buffer_Cnv_Settings_2 := "Settings_DB".LCnv_Sys[2].Cnv_Level[2].Cnv2;
            3:
                "PopUps_DB".Buffer_Cnv_Settings_1 := "Settings_DB".LCnv_Sys[2].Cnv_Level[3].Cnv1;
                "PopUps_DB".ECnv_Settings := "Settings_DB".ECnv_Sys[2];
                "PopUps_DB".Buffer_Cnv_Settings_2 := "Settings_DB".LCnv_Sys[2].Cnv_Level[3].Cnv2;
            4:
                "PopUps_DB".Buffer_Cnv_Settings_1 := "Settings_DB".LCnv_Sys[2].Cnv_Level[4].Cnv1;
                "PopUps_DB".ECnv_Settings := "Settings_DB".ECnv_Sys[2];
                "PopUps_DB".Buffer_Cnv_Settings_2 := "Settings_DB".LCnv_Sys[2].Cnv_Level[4].Cnv2;
            5:
                "PopUps_DB".Buffer_Cnv_Settings_1 := "Settings_DB".LCnv_Sys[2].Cnv_Level[5].Cnv1;
                "PopUps_DB".ECnv_Settings := "Settings_DB".ECnv_Sys[2];
                "PopUps_DB".Buffer_Cnv_Settings_2 := "Settings_DB".LCnv_Sys[2].Cnv_Level[5].Cnv2;
            6:
                "PopUps_DB".Buffer_Cnv_Settings_1 := "Settings_DB".LCnv_Sys[2].Cnv_Level[6].Cnv1;
                "PopUps_DB".ECnv_Settings := "Settings_DB".ECnv_Sys[2];
                "PopUps_DB".Buffer_Cnv_Settings_2 := "Settings_DB".LCnv_Sys[2].Cnv_Level[6].Cnv2;
        END_CASE;
END_CASE;
END_FUNCTION