FUNCTION_BLOCK "Auto_Test"   // FB 16, author 

VAR_INPUT
   Sys_No : UInt;
   Automatic : Bool;
   Manual : Bool;
   Level : UInt;
   Error : Bool;
   Start : Bool;
   Pause : Bool;
   Stop : Bool;
   From level : Byte;
   To level : Byte;
   Testing Time : UInt;
   Numer of cycles : Byte;
END_VAR

VAR_OUTPUT
   Running : Bool;
   Time_Runnng : Time;
   Start_Time : String;
   Stop_Time : String;
   Duration : Time;
END_VAR

VAR_IN_OUT
   VTD_Order Table_1 : "OrderTable_UDT";
   VTD_Step_Table_0 : "OrderTable_UDT";
   Buffers_Order Table_1 : "OrderTable_UDT";
   Buffers_Step_Table_0 : "OrderTable_UDT";
   VTD_System_OrderSent : Bool;
   Buffers_System_OrderSent : Bool;
   Total_Duration : Time;
END_VAR

VAR
   State : Int;
   R_Start : R_TRIG;
   Send_VTD_Order : Bool;
   Send_CNV_Order : Bool;
   T_Running : TON_TIME;
   F_TRIG : F_TRIG;
   R_TRIG : R_TRIG;
   Error_Code : Int;
   test : Bool;
   N_Cycles : UInt;
   Testing_Time : Time;
   R_Manual_Mode : R_TRIG;
END_VAR

VAR_TEMP
   Busy : Bool;
END_VAR

VAR CONSTANT
   VTD_DEVICE : String := 'VTD';
   PALLET_INOUT_DEVICE : String := 'Pallet In Out';
   SHUTTLE_INOUT_DEVICE : String := 'Shuttle In Out';
   RUNNING_STATUS : String := 'Running';
   COMPLETED_STATUS : String := 'Completed';
END_VAR

BEGIN
#R_Start(CLK:=#Start);

IF #Stop THEN
    #State := 0;
END_IF;

IF #Error THEN
    #State := 400;
END_IF;

#R_Manual_Mode(CLK:=#Automatic AND NOT #Error AND #Manual AND NOT #Running);

IF #R_Manual_Mode.Q THEN
    #State := 500;
ELSIF #Automatic AND NOT #Error AND NOT #Manual AND #State = 500 THEN
    #State := 0;
END_IF;

IF #State > 10 AND #State < 400 THEN
    #Running := TRUE;
END_IF;

//Time running
#R_TRIG(CLK:=#Running);
IF #R_TRIG.Q THEN
    #Start_Time := "Time".CurrentLocalTime;
    #Stop_Time := '';
END_IF;
#F_TRIG(CLK:=#Running);
IF #F_TRIG.Q THEN
    #Duration := #T_Running.ET;
    #Total_Duration := #Duration + #Total_Duration;
    #Stop_Time := "Time".CurrentLocalTime;
END_IF;
#T_Running(IN:=#Running AND NOT #Pause,
                      PT:=t#24h);

#Time_Runnng := #T_Running.ET;

#Testing_Time := UINT_TO_TIME(#"Testing Time") * 60000;

#Error_Code := WRIT_DBL(REQ := #test, SRCBLK := "Auto_Test_DB",BUSY=>#Busy, DSTBLK => "Auto_Test_DB");

CASE #State OF
    0://Initialization
        #Running := false;
        #State := #State + 10;
        
    10://Idle
        IF #R_Start.Q AND #Automatic AND NOT #Error AND #"From level" > 0 AND #"To level" > 0  THEN
            #N_Cycles := 0;
            #State := #State + 10;
        END_IF;
        
    20: //VTD TO START LEVEL-------------------------------------------------------------
        IF "Control_DB".VTD_Sys[#Sys_No].Current_Level <> #"From level" THEN
            VTD_Order_FC(i_Sys := #Sys_No,
                           Level := #"From level",
                           StepTable_0 := #VTD_Step_Table_0);
            #VTD_System_OrderSent := TRUE;
            #State := #State + 10;
        ELSE
            #State := #State + 10;
        END_IF;
        
    30: //Wait Order to be running
        IF #"VTD_Order Table_1".Status = #RUNNING_STATUS THEN
            #State := #State + 10;
        END_IF;
        
    40: //Wait to complete
        IF #"VTD_Order Table_1".Status = #COMPLETED_STATUS AND NOT #Pause THEN
            #State := #State + 10;
        END_IF;
        
    50: //EXTRACTOR TO CNV1-------------------------------------------------------
        CNV_Order_FC(i_Sys := #Sys_No,
                       Level := "Control_DB".VTD_Sys[#Sys_No].Current_Level,
                       Tower := 1,
                       Transfer_From_To := 1,
                       Device:=#PALLET_INOUT_DEVICE,
                       Task_Type:=4,
                       StepTable_0 := #VTD_Step_Table_0);
        #VTD_System_OrderSent := TRUE;
        #State := #State + 10;
        
    60: //Wait Order to be running
        IF #"VTD_Order Table_1".Status = #RUNNING_STATUS THEN
            #State := #State + 10;
        END_IF;
        
    70: //Wait to complete
        IF #"VTD_Order Table_1".Status = #COMPLETED_STATUS AND NOT #Pause THEN
            #State := #State + 10;
        END_IF;
        
    80: //CNV 1 TO CNV 2-----------------------------------------------------------------
        CNV_Order_FC(i_Sys := #Sys_No,
                       Level := "Control_DB".VTD_Sys[#Sys_No].Current_Level,
                       Tower := 2,
                       Transfer_From_To := 1,
                       Device := #PALLET_INOUT_DEVICE,
                       Task_Type := 4,
                       StepTable_0 := #Buffers_Step_Table_0);
        #VTD_System_OrderSent := TRUE;
        #State := #State + 10;
        
    90: //Wait Order to be running
        IF #"Buffers_Order Table_1".Status = #RUNNING_STATUS THEN
            #State := #State + 10;
        END_IF;
        
    100: //Wait to complete
        IF #"Buffers_Order Table_1".Status = #COMPLETED_STATUS AND NOT #Pause THEN
            #State := #State + 10;
        END_IF;
        
    110: //CNV 2 TO CNV 1-----------------------------------------------------------------
        CNV_Order_FC(i_Sys := #Sys_No,
                       Level := "Control_DB".VTD_Sys[#Sys_No].Current_Level,
                       Tower := 2,
                       Transfer_From_To := 2,
                       Device := #PALLET_INOUT_DEVICE,
                       Task_Type := 4,
                       StepTable_0 := #Buffers_Step_Table_0);
        #VTD_System_OrderSent := TRUE;
        #State := #State + 10;
        
    120: //Wait Order to be running
        IF #"Buffers_Order Table_1".Status = #RUNNING_STATUS THEN
            #State := #State + 10;
        END_IF;
        
    130: //Wait to complete
        IF #"Buffers_Order Table_1".Status = #COMPLETED_STATUS AND NOT #Pause THEN
            #State := #State + 10;
        END_IF;
        
    140: //CNV 1 TO EXTRACTOR------------------------------------------------------------------
        CNV_Order_FC(i_Sys := #Sys_No,
                       Level := "Control_DB".VTD_Sys[#Sys_No].Current_Level,
                       Tower := 1,
                       Transfer_From_To := 2,
                       Device := #PALLET_INOUT_DEVICE,
                       Task_Type := 4,
                       StepTable_0 := #VTD_Step_Table_0);
        #VTD_System_OrderSent := TRUE;
        #State := #State + 10;
        
    150: //Wait Order to be running
        IF #"VTD_Order Table_1".Status = #RUNNING_STATUS THEN
            #State := #State + 10;
        END_IF;
        
    160: //Wait to complete
        IF #"VTD_Order Table_1".Status = #COMPLETED_STATUS AND NOT #Pause THEN
            #State := #State + 10;
        END_IF;
        
    170: //VTD FROM START LEVEL TO FINAL LEVEL-----------------------------------------------
        IF "Control_DB".VTD_Sys[#Sys_No].Current_Level < #"To level" THEN
            VTD_Order_FC(i_Sys := #Sys_No,
                           Level := "Control_DB".VTD_Sys[#Sys_No].Current_Level + 1,
                           StepTable_0 := #VTD_Step_Table_0);
            #VTD_System_OrderSent := TRUE;
            #N_Cycles := #N_Cycles + 1;
            #State := #State + 10;
        ELSIF (
            (#"Numer of cycles" = 0 OR #N_Cycles < #"Numer of cycles")
            AND
            (#Testing_Time = T#0M OR #Time_Runnng < #Testing_Time)
            ) THEN
            #State := 200;//CONTINUE
        ELSE
            #State := 0;//FINISH
        END_IF;
        
    180: //Wait Order to be running
        IF #"VTD_Order Table_1".Status = #RUNNING_STATUS THEN
            #State := #State + 10;
        END_IF;
        
    190: //Wait to complete
        IF #"VTD_Order Table_1".Status = #COMPLETED_STATUS AND NOT #Pause THEN
            #State := #State + 10;
        END_IF;
        
    200: //VTD TO START LEVEL---------------------------------------------------------------------------------------------------
        VTD_Order_FC(i_Sys := #Sys_No,
                       Level := #"From level",
                       StepTable_0 := #VTD_Step_Table_0);
        #VTD_System_OrderSent := TRUE;
        #State := #State + 10;
        
    210: //Wait Order to be running
        IF #"VTD_Order Table_1".Status = #RUNNING_STATUS THEN
            #State := #State + 10;
        END_IF;
        
    220: //Wait to complete
        IF #"VTD_Order Table_1".Status = #COMPLETED_STATUS AND NOT #Pause THEN
            #State := 50;
        END_IF;
        
    400: //ERROR
        #Running := false;
        IF "Reset_All" OR
            ("Screen_DB_1".Reset_All[1] AND
             ("HMI_Box_Connected_1" = 11 AND "KEY REMOTE/LOCAL L1 - CH1(1)") OR
             ("HMI_Box_Connected_1" = 12 AND "KEY REMOTE/LOCAL L2 - CH1(1)") OR
             ("HMI_Box_Connected_1" = 13 AND "KEY REMOTE/LOCAL L3 - CH1(1)") OR
             ("HMI_Box_Connected_1" = 14 AND "KEY REMOTE/LOCAL L4 - CH1(1)") OR
             ("HMI_Box_Connected_1" = 15 AND "KEY REMOTE/LOCAL L5 - CH1(1)") OR
             ("HMI_Box_Connected_1" = 16 AND "KEY REMOTE/LOCAL L6 - CH1(1)") OR
             ("HMI_Box_Connected_1" = 21 AND "KEY REMOTE/LOCAL L1 - CH1(2)") OR
             ("HMI_Box_Connected_1" = 22 AND "KEY REMOTE/LOCAL L2 - CH1(2)") OR
             ("HMI_Box_Connected_1" = 23 AND "KEY REMOTE/LOCAL L3 - CH1(2)") OR
             ("HMI_Box_Connected_1" = 24 AND "KEY REMOTE/LOCAL L4 - CH1(2)") OR
             ("HMI_Box_Connected_1" = 25 AND "KEY REMOTE/LOCAL L5 - CH1(2)") OR
             ("HMI_Box_Connected_1" = 26 AND "KEY REMOTE/LOCAL L6 - CH1(2)"))
         THEN
            #State := 0;
        END_IF;
        
    500://MANUAL ORDER
        #Running := false;
        REGION VTD order table Manual Orders
            IF #Send_VTD_Order THEN
                VTD_Order_FC(i_Sys := #Sys_No,
                               Level := #Level,
                               StepTable_0 := #VTD_Step_Table_0);
                #VTD_System_OrderSent := TRUE;
                #Send_VTD_Order := FALSE;
            END_IF;
            
            IF #Send_CNV_Order AND "OrderTable_HMI".Transfer_Out_VTD THEN
                CNV_Order_FC(i_Sys := #Sys_No,
                               Level := "Control_DB".VTD_Sys[#Sys_No].Current_Level,
                               Tower := 1,
                               Transfer_From_To := 1,
                               Device := #PALLET_INOUT_DEVICE,
                               Task_Type := 4,
                               StepTable_0 := #VTD_Step_Table_0);
                #VTD_System_OrderSent := TRUE;
                #Send_CNV_Order := FALSE;
            END_IF;
            
            IF #Send_CNV_Order AND "OrderTable_HMI".Transfer_Into_VTD THEN
                CNV_Order_FC(i_Sys := #Sys_No,
                               Level := "Control_DB".VTD_Sys[#Sys_No].Current_Level,
                               Tower := 1,
                               Transfer_From_To := 2,
                               Device := #PALLET_INOUT_DEVICE,
                               Task_Type := 4,
                               StepTable_0 := #VTD_Step_Table_0);
                #VTD_System_OrderSent := TRUE;
                #Send_CNV_Order := FALSE;
            END_IF;
        END_REGION
        
        REGION BUFFERs order table Manual Orders
            REGION CNV 2 to CNV 1
                //Level 2
                IF #Send_CNV_Order AND "OrderTable_HMI".Transfer_CNV1_L2 THEN
                    CNV_Order_FC(i_Sys := #Sys_No,
                                   Level := 2,
                                   Tower := 2,
                                   Transfer_From_To := 2,
                                   Device := #PALLET_INOUT_DEVICE,
                                   Task_Type := 4,
                                   StepTable_0 := #Buffers_Step_Table_0);
                    #Buffers_System_OrderSent := TRUE;
                    #Send_CNV_Order := FALSE;
                END_IF;
                
                //Level 3
                IF #Send_CNV_Order AND "OrderTable_HMI".Transfer_CNV1_L3 THEN
                    CNV_Order_FC(i_Sys := #Sys_No,
                                   Level := 3,
                                   Tower := 2,
                                   Transfer_From_To := 2,
                                   Device := #PALLET_INOUT_DEVICE,
                                   Task_Type := 4,
                                   StepTable_0 := #Buffers_Step_Table_0);
                    #Buffers_System_OrderSent := TRUE;
                    #Send_CNV_Order := FALSE;
                END_IF;
                
                //Level 4
                IF #Send_CNV_Order AND "OrderTable_HMI".Transfer_CNV1_L4 THEN
                    CNV_Order_FC(i_Sys := #Sys_No,
                                   Level := 4,
                                   Tower := 2,
                                   Transfer_From_To := 2,
                                   Device := #PALLET_INOUT_DEVICE,
                                   Task_Type := 4,
                                   StepTable_0 := #Buffers_Step_Table_0);
                    #Buffers_System_OrderSent := TRUE;
                    #Send_CNV_Order := FALSE;
                END_IF;
                
                //Level 5
                IF #Send_CNV_Order AND "OrderTable_HMI".Transfer_CNV1_L5 THEN
                    CNV_Order_FC(i_Sys := #Sys_No,
                                   Level := 5,
                                   Tower := 2,
                                   Transfer_From_To := 2,
                                   Device := #PALLET_INOUT_DEVICE,
                                   Task_Type := 4,
                                   StepTable_0 := #Buffers_Step_Table_0);
                    #Buffers_System_OrderSent := TRUE;
                    #Send_CNV_Order := FALSE;
                END_IF;
                
                //Level 6
                IF #Send_CNV_Order AND "OrderTable_HMI".Transfer_CNV1_L6 THEN
                    CNV_Order_FC(i_Sys := #Sys_No,
                                   Level := 6,
                                   Tower := 2,
                                   Transfer_From_To := 2,
                                   Device := #PALLET_INOUT_DEVICE,
                                   Task_Type := 4,
                                   StepTable_0 := #Buffers_Step_Table_0);
                    #Buffers_System_OrderSent := TRUE;
                    #Send_CNV_Order := FALSE;
                END_IF;
            END_REGION
            
            REGION CNV 1 to CNV 2
                //Level 2
                IF #Send_CNV_Order AND "OrderTable_HMI".Transfer_CNV2_L2 THEN
                    CNV_Order_FC(i_Sys := #Sys_No,
                                   Level := 2,
                                   Tower := 2,
                                   Transfer_From_To := 1,
                                   Device := #PALLET_INOUT_DEVICE,
                                   Task_Type := 4,
                                   StepTable_0 := #Buffers_Step_Table_0);
                    #Buffers_System_OrderSent := TRUE;
                    #Send_CNV_Order := FALSE;
                END_IF;
                
                //Level 3
                IF #Send_CNV_Order AND "OrderTable_HMI".Transfer_CNV2_L3 THEN
                    CNV_Order_FC(i_Sys := #Sys_No,
                                   Level := 3,
                                   Tower := 2,
                                   Transfer_From_To := 1,
                                   Device := #PALLET_INOUT_DEVICE,
                                   Task_Type := 4,
                                   StepTable_0 := #Buffers_Step_Table_0);
                    #Buffers_System_OrderSent := TRUE;
                    #Send_CNV_Order := FALSE;
                END_IF;
                
                //Level 4
                IF #Send_CNV_Order AND "OrderTable_HMI".Transfer_CNV2_L4 THEN
                    CNV_Order_FC(i_Sys := #Sys_No,
                                   Level := 4,
                                   Tower := 2,
                                   Transfer_From_To := 1,
                                   Device := #PALLET_INOUT_DEVICE,
                                   Task_Type := 4,
                                   StepTable_0 := #Buffers_Step_Table_0);
                    #Buffers_System_OrderSent := TRUE;
                    #Send_CNV_Order := FALSE;
                END_IF;
                
                //Level 5
                IF #Send_CNV_Order AND "OrderTable_HMI".Transfer_CNV2_L5 THEN
                    CNV_Order_FC(i_Sys := #Sys_No,
                                   Level := 5,
                                   Tower := 2,
                                   Transfer_From_To := 1,
                                   Device := #PALLET_INOUT_DEVICE,
                                   Task_Type := 4,
                                   StepTable_0 := #Buffers_Step_Table_0);
                    #Buffers_System_OrderSent := TRUE;
                    #Send_CNV_Order := FALSE;
                END_IF;
                
                //Level 6
                IF #Send_CNV_Order AND "OrderTable_HMI".Transfer_CNV2_L6 THEN
                    CNV_Order_FC(i_Sys := #Sys_No,
                                   Level := 6,
                                   Tower := 2,
                                   Transfer_From_To := 1,
                                   Device := #PALLET_INOUT_DEVICE,
                                   Task_Type := 4,
                                   StepTable_0 := #Buffers_Step_Table_0);
                    #Buffers_System_OrderSent := TRUE;
                    #Send_CNV_Order := FALSE;
                END_IF;
            END_REGION
        END_REGION
END_CASE;


END_FUNCTION_BLOCK