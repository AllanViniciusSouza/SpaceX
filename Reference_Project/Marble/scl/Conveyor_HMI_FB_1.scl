FUNCTION_BLOCK "Conveyor_HMI_FB_1"   // FB 13, author 

VAR_INPUT
   HMI_No : UInt;
   Sys_No : UInt;
   Zone : UInt;
END_VAR

VAR_IN_OUT
   Enable : Bool;
   Mode_Change : UInt;
   Transfer_To_ID : DInt;
   Transfer_From_ID : DInt;
   Enable(1) : Bool;
   Mode_Change(1) : UInt;
   Transfer_To_ID(1) : DInt;
   Transfer_From_ID(1) : DInt;
END_VAR

VAR
   R_Charge_Cnv_Commands : R_TRIG;
   T_Reset_Charge : TON_TIME;
   ID : DInt;
   ID(1) : DInt;
   ID_Old : DInt;
   ID_Old(1) : DInt;
END_VAR

VAR_TEMP
   i : UInt;
   J : UInt;
   No_Light_Guard : Bool;
END_VAR

BEGIN
CNV_Selector_1(Sys_No := #Sys_No,
                 Zone:= #Zone,
                 CNV1_2_Selected := "CNV_HMI".CVTD_CNV2_Selected[#HMI_No],
                 ID => #ID,
                 ID(1) => #"ID(1)");


REGION SEND/RECEIVE BUTTON
    IF NOT "Control_DB".VTD_Sys[#Sys_No].Running AND "Control_DB".VTD_Sys[#Sys_No].Current_Level <> 0 THEN
        IF "CNV_HMI".CVTD_CNV2_Selected[#HMI_No] = 1 AND "HMI_DB".ScreenNo[#HMI_No] = 2 THEN
            //CNV 1
            IF "Control_DB".ECnv_Sys[#Sys_No].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv1.Cnv_Occupied AND
                NOT "Control_DB".ECnv_Sys[#Sys_No].Running AND NOT "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv1.Running THEN
                "CNV_HMI".In_Out[#HMI_No] := TRUE;
            ELSIF NOT "Control_DB".ECnv_Sys[#Sys_No].Cnv_Occupied AND "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv1.Cnv_Occupied AND
                NOT "Control_DB".ECnv_Sys[#Sys_No].Running AND NOT "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv1.Running THEN
                "CNV_HMI".In_Out[#HMI_No] := FALSE;
            ELSE
                ;
            END_IF;
            //CNV 2
        ELSIF "CNV_HMI".CVTD_CNV2_Selected[#HMI_No] = 2 AND "HMI_DB".ScreenNo[#HMI_No] = 2 THEN   //CNV 2
            IF "Control_DB".ECnv_Sys[#Sys_No].Cnv_Occupied AND NOT "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv2.Cnv_Occupied AND
                NOT "Control_DB".ECnv_Sys[#Sys_No].Running AND NOT "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv2.Running THEN
                "CNV_HMI".In_Out[#HMI_No] := TRUE;
            ELSIF NOT "Control_DB".ECnv_Sys[#Sys_No].Cnv_Occupied AND "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv2.Cnv_Occupied AND
                NOT "Control_DB".ECnv_Sys[#Sys_No].Running AND NOT "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level["Control_DB".VTD_Sys[#Sys_No].Current_Level].Cnv2.Running THEN
                "CNV_HMI".In_Out[#HMI_No] := FALSE;
            ELSE
                ;
            END_IF;
        END_IF;
    END_IF;
END_REGION ;

REGION Assign Conveyor 1
    REGION CHARGE DATA FROM THE CORRECT CONVEYOR
        //CHARGE DATA CHANGING CONVEYORS ID
        IF #ID <> #ID_Old THEN
            "CNV_HMI".Charge_Commands[#HMI_No] := TRUE;
            #ID_Old := #ID;
        END_IF;
        #R_Charge_Cnv_Commands();
        
        #R_Charge_Cnv_Commands(CLK := "CNV_HMI".Charge_Commands[#HMI_No]);
        
        //CHARGE ONCE THE COMMANDS
        IF "CNV_HMI".Charge_Commands[#Sys_No] THEN
            #Enable := "Control_DB".ECnv_Sys[#Sys_No].Instruction.Enable;
            #Mode_Change := "Control_DB".ECnv_Sys[#Sys_No].Instruction.Mode_Change;
            #Transfer_To_ID := "Control_DB".ECnv_Sys[#Sys_No].Instruction.Transfer_To_ID;
            #Transfer_From_ID := "Control_DB".ECnv_Sys[#Sys_No].Instruction.Transfer_From_ID;
        END_IF;
    END_REGION
    
    REGION CHARGE DATA FROM HMI (AFTER CHARGE DATA)
        IF NOT "CNV_HMI".Charge_Commands[#HMI_No] AND NOT #R_Charge_Cnv_Commands.Q THEN
            CASE #ID OF
                    //SYSTEM 1
                120101:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := #Sys_No,
                                  Safety_OK := "Remote_Panel_DB_1".Safety_OK);
                120201:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := #Sys_No,
                                  Safety_OK := "Remote_Panel_DB_1".Safety_OK);
                120301:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := #Sys_No,
                                  Safety_OK := "Remote_Panel_DB_1".Safety_OK);
                120401:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := #Sys_No,
                                  Safety_OK := "Remote_Panel_DB_1".Safety_OK);
                120501:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := #Sys_No,
                                  Safety_OK := "Remote_Panel_DB_1".Safety_OK);
                120601:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := #Sys_No,
                                  Safety_OK := "Remote_Panel_DB_1".Safety_OK);
                120701:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := #Sys_No,
                                  Safety_OK := "Remote_Panel_DB_1".Safety_OK);
                120801:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := #Sys_No,
                                  Safety_OK := "Remote_Panel_DB_1".Safety_OK);
                    
                    //SYSTEM 2
                120102:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := 2,
                                  Safety_OK := "Remote_Panel_DB_2".Safety_OK);
                120202:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := 2,
                                  Safety_OK := "Remote_Panel_DB_2".Safety_OK);
                120302:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := 2,
                                  Safety_OK := "Remote_Panel_DB_2".Safety_OK);
                120402:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := 2,
                                  Safety_OK := "Remote_Panel_DB_2".Safety_OK);
                120502:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := 2,
                                  Safety_OK := "Remote_Panel_DB_2".Safety_OK);
                120602:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := 2,
                                  Safety_OK := "Remote_Panel_DB_2".Safety_OK);
                120702:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := 2,
                                  Safety_OK := "Remote_Panel_DB_2".Safety_OK);
                120802:
                    Feed_ECNV_1(HMI_No := #HMI_No,
                                  HMI_Box:= #Zone,
                                  Sys_No := 2,
                                  Safety_OK := "Remote_Panel_DB_2".Safety_OK);
            END_CASE;
        END_IF;
    END_REGION
END_REGION

REGION Assign Conveyor 2
    REGION CHARGE DATA FROM THE CORRECT CONVEYOR
        //CHARGE DATA CHANGING CONVEYORS ID
        IF #"ID(1)" <> #"ID_Old(1)" THEN
            "CNV_HMI".Charge_Commands[#HMI_No] := TRUE;
            #"ID_Old(1)" := #"ID(1)";
        END_IF;
        #R_Charge_Cnv_Commands(CLK := "CNV_HMI".Charge_Commands[#HMI_No]);
        
        IF "CNV_HMI".Charge_Commands[#HMI_No] THEN
            CASE #"ID(1)" OF
                    //CNV 1 - SYSTEM 1
                100201:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv1.Instruction.Transfer_From_ID;
                100301:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv1.Instruction.Transfer_From_ID;
                100401:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv1.Instruction.Transfer_From_ID;
                100501:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv1.Instruction.Transfer_From_ID;
                100601:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv1.Instruction.Transfer_From_ID;
                    //CNV 2 - SYSTEM 1
                110201:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[2].Cnv2.Instruction.Transfer_From_ID;
                110301:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[3].Cnv2.Instruction.Transfer_From_ID;
                110401:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[4].Cnv2.Instruction.Transfer_From_ID;
                110501:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[5].Cnv2.Instruction.Transfer_From_ID;
                110601:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[6].Cnv2.Instruction.Transfer_From_ID;
                    //CNV 1 - SYSTEM 2
                100202:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv1.Instruction.Transfer_From_ID;
                100302:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv1.Instruction.Transfer_From_ID;
                100402:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv1.Instruction.Transfer_From_ID;
                100502:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv1.Instruction.Transfer_From_ID;
                100602:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv1.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv1.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv1.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv1.Instruction.Transfer_From_ID;
                    //CNV 2 - SYSTEM 2
                110202:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv2.Instruction.Transfer_From_ID;
                110302:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv2.Instruction.Transfer_From_ID;
                110402:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[4].Cnv2.Instruction.Transfer_From_ID;
                110502:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[5].Cnv2.Instruction.Transfer_From_ID;
                110602:
                    "Enable_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv2.Instruction.Enable;
                    "Mode_Change_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv2.Instruction.Mode_Change;
                    "Transfer_To_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv2.Instruction.Transfer_To_ID;
                    "Transfer_From_ID_HMI(1)" := "Control_DB".LCnv_Sys[2].Cnv_Level[6].Cnv2.Instruction.Transfer_From_ID;
            END_CASE;
            "CNV_HMI".Charge_Commands[#HMI_No] := 0;
        END_IF;
    END_REGION
    
    REGION CHARGE DATA FROM HMI (AFTER CHARGE DATA)
        IF NOT "CNV_HMI".Charge_Commands[#HMI_No] AND NOT #R_Charge_Cnv_Commands.Q THEN
            CASE #"ID(1)" OF
                    //SYSTEM 1
                    //CNV 1
                100201:
                    "Feed_BCNV_Cnv1(1)_1"(HMI_No := #HMI_No,
                                          System_No := #Sys_No,
                                          Level := 2);
                100301:
                    "Feed_BCNV_Cnv1(1)_1"(HMI_No := #HMI_No,
                                          System_No := #Sys_No,
                                          Level := 3);
                100401:
                    "Feed_BCNV_Cnv1(1)_1"(HMI_No := #HMI_No,
                                          System_No := #Sys_No,
                                          Level := 4);
                100501:
                    "Feed_BCNV_Cnv1(1)_1"(HMI_No := #HMI_No,
                                          System_No := #Sys_No,
                                          Level := 5);
                100601:
                    "Feed_BCNV_Cnv1(1)_1"(HMI_No := #HMI_No,
                                          System_No := #Sys_No,
                                          Level := 6);
                    //CNV 2
                110101:
                    Feed_BCNV_Cnv2_1(HMI_No := #HMI_No,
                                          System_No := #Sys_No,
                                          Level := 1);
                110201:
                    Feed_BCNV_Cnv2_1(HMI_No := #HMI_No,
                                          System_No := #Sys_No,
                                          Level := 2);
                110301:
                    Feed_BCNV_Cnv2_1(HMI_No := #HMI_No,
                                          System_No := #Sys_No,
                                          Level := 3);
                110401:
                    Feed_BCNV_Cnv2_1(HMI_No := #HMI_No,
                                          System_No := #Sys_No,
                                          Level := 4);
                110501:
                    Feed_BCNV_Cnv2_1(HMI_No := #HMI_No,
                                          System_No := #Sys_No,
                                          Level := 5);
                110601:
                    Feed_BCNV_Cnv2_1(HMI_No := #HMI_No,
                                          System_No := #Sys_No,
                                          Level := 6);
                    //SYSTEM 2
                    //CNV 1
                100202:
                    "Feed_BCNV_Cnv1(1)_1"(HMI_No := #HMI_No,
                                          System_No := 2,
                                          Level := 2);
                100302:
                    "Feed_BCNV_Cnv1(1)_1"(HMI_No := #HMI_No,
                                          System_No := 2,
                                          Level := 3);
                100402:
                    "Feed_BCNV_Cnv1(1)_1"(HMI_No := #HMI_No,
                                          System_No := 2,
                                          Level := 4);
                100502:
                    "Feed_BCNV_Cnv1(1)_1"(HMI_No := #HMI_No,
                                          System_No := 2,
                                          Level := 5);
                100602:
                    "Feed_BCNV_Cnv1(1)_1"(HMI_No := #HMI_No,
                                          System_No := 2,
                                          Level := 6);
                    //CNV 2
                110102:
                    Feed_BCNV_Cnv2_1(HMI_No := #HMI_No,
                                          System_No := 2,
                                          Level := 1);
                110202:
                    Feed_BCNV_Cnv2_1(HMI_No := #HMI_No,
                                          System_No := 2,
                                          Level := 2);
                110302:
                    Feed_BCNV_Cnv2_1(HMI_No := #HMI_No,
                                          System_No := 2,
                                          Level := 3);
                110402:
                    Feed_BCNV_Cnv2_1(HMI_No := #HMI_No,
                                          System_No := 2,
                                          Level := 4);
                110502:
                    Feed_BCNV_Cnv2_1(HMI_No := #HMI_No,
                                          System_No := 2,
                                          Level := 5);
                110602:
                    Feed_BCNV_Cnv2_1(HMI_No := #HMI_No,
                                          System_No := 2,
                                          Level := 6);
            END_CASE;
        END_IF;
    END_REGION
END_REGION


//RESET CHARGE BITS
#T_Reset_Charge.TON(IN := "VTD_HMI".Charge_VTD[#HMI_No] OR "CNV_HMI".Charge_Cnv[#HMI_No] OR "VTD_HMI".Charge_VTD_Commands[#HMI_No] OR "CNV_HMI".Charge_Commands[#HMI_No],
                    PT := T#2S);

IF #T_Reset_Charge.Q THEN
    "VTD_HMI".Charge_VTD[#HMI_No] := FALSE;
    "CNV_HMI".Charge_Cnv[#HMI_No] := FALSE;
    "VTD_HMI".Charge_VTD_Commands[#HMI_No] := FALSE;
    "CNV_HMI".Charge_Commands[#HMI_No] := FALSE;
END_IF;

END_FUNCTION_BLOCK