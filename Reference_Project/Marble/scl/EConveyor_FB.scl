FUNCTION_BLOCK "EConveyor_FB"   // FB 12, author Mertin Coetzee

VAR_INPUT
   Id : UInt;
   Safety_OK : Bool;
   Cnv_Settings : "ECnv_Settings";
   VTD_Current_Level : UInt;
   CNV_In_Out : Bool;
   Time_CheckNoPallet : Time;
   Time_CheckPallet : Time;
END_VAR

VAR_IN_OUT
   Cnv_Control : "ECnv_Control";
   SinaSpeed : SinaSpeed;
END_VAR

VAR
   State : UInt;
   Timer_Transfer : TON_TIME;
   Watchdog : TON_TIME;
   Transfer_Direction : String;
   MainSetpoint : Int;
   SinaSpeed_Instance : SinaSpeed;
   R_TRIG_Instance : R_TRIG;
   R_Start_DB : R_TRIG;
   R_Stop_DB : R_TRIG;
   ID_Decoded_From : "ID_Decoded";
   ID_Decoded_To : "ID_Decoded";
   T_Ramp : TON_TIME;
   VTD_Level : UInt;
   T_CheckNoPallet : TON_TIME;
   Time_SlowDown_Ramp : Time;
   T_CheckPallet : TON_TIME;
END_VAR

VAR_TEMP
   Execute_Old : Bool;
   Stop_Old : Bool;
   i : Int;
   Forward : Bool;
   Backward : Bool;
   HMI_Reset : Bool;
END_VAR

BEGIN
#R_Start_DB(CLK := #Cnv_Control.Instruction.Execute AND NOT #Execute_Old);
#R_Stop_DB(CLK := #Cnv_Control.Instruction.Stop AND NOT #Stop_Old);

#Execute_Old := #Cnv_Control.Instruction.Execute;
#Stop_Old := #Cnv_Control.Instruction.Stop;

#Cnv_Control.Enabled := #Cnv_Control.Instruction.Enable;


ID_Decode_F(ID := #Cnv_Control.Instruction.Transfer_From_ID,
              ID_Decoded := #ID_Decoded_From);

ID_Decode_F(ID := #Cnv_Control.Instruction.Transfer_To_ID,
              ID_Decoded := #ID_Decoded_To);

//MODES
#Cnv_Control.Mode := #Cnv_Control.Instruction.Mode_Change;
IF (#Cnv_Control.Mode = 1 OR #Cnv_Control.Mode = 5) AND NOT #Cnv_Control.Error THEN
    #State := 500;
END_IF;

#R_TRIG_Instance(CLK := #Cnv_Control.Mode = 3);
IF #R_TRIG_Instance.Q OR (NOT #Cnv_Control.Enabled AND NOT #Cnv_Control.Error) THEN
    #State := 0;
END_IF;

(*
TODO:
01. Need to add statemachine watchdog - Done
02. Extractor needs to be on same floor for pallet to be moved in manual passed Rbwd - Done
03. Complete reset state - Done
04. Add stop inputs - Done
05. Need to add variable motor speed, manual needs to be slower. - Done
06. Need to add cyclic error checking. For odd sensor combinations as well - Partially done
07. Need to add Shuttle monitor - Done
08. Need to add Task ID check and start bit check to outbound pallet move. Check direction of pallet movement based on connected Cnv.
09. Need to add checks for wrong direction of travel - Done
10. Add checks for unsafe conditions with Cnv_Inputs - Partially Done
11. Define Error codes - DOne
12. Add watchdof time to Cnv Settings - Done
13. Add self-timeout on manual 
14. For shuttle in place sensor checks take into account extractor floor and safety stopper state
15. Confirm modes and states are correct (Semi-auto and maintenance as well)
16. Add the correct transfer process for the logistex-spacemaker pallet handovers.

Mode select is done via the HMI. Might add external mode select switches.
        
        Mode select mask:
        0: Disabled
        1: Manual
        2: Semi-Auto
        3: Auto
        4: Teach - N/A for Cnv
        5: Maintenance
        
Device ID Format: XXYYZZ    
XX = Device type   
    01   VTD
    10  Cnv_Front_of_VTD
    11  Cnv_Rear_of_VTD
    12  Cnv_On_Extractor
    20  Safety_Stop_Front_of_VTD
    21  Safety_Stop_Rear_of_VTD
YY = Floor   
ZZ = VTD Connected to    
Example: 110203 Conveyor at the rear of VTD 3 on level 2


 Sensor order for the conveyor:
 Lfwd Lpd1 Lpd2
  []   []   []
 ##############################
 #        Pallet Flow         #
 #         ------->>          #
 #                            #
 #                            #
 ##############################
                  []   []   []
                 Rpd2 Rpd1 Rbwd     
                
                //  #Intructions.Pallet_Type:
                //1 = Chep
                //2 = Euro front (right)
                //3 = Euro Back (left)
                // 4 = Euro center
                // 
                //contro.Pallet_Type
                //3 - Euro front  (right)
                //4 - euro back (left)
                //5 - euro centered
                //'Euro FRONT'
                //
*)

REGION Sensor allocations
    //PALLET DETECT
    #Forward := #Cnv_Control.Inputs.Forward_Sensor;
    #Backward := #Cnv_Control.Inputs.Backward_Sensor;
END_REGION

REGION Cyclic Checks 
    // Check Pallet
    #T_CheckPallet(IN:=#Forward AND #Backward,
                   PT:=#Time_CheckPallet);
    
    
    #T_CheckNoPallet(IN:=#Cnv_Control.Running AND NOT #Forward AND NOT #Backward, //Check conveyor not occupied while running
                   PT:=#Time_CheckNoPallet);
    
    //Conditions for Conveyor occupied
  IF #T_CheckPallet.Q OR // Both sensors triggered after a timer
        (NOT #Forward AND #Backward AND NOT #Cnv_Control.Running) OR //Forward sensor triggered and not running
        (#Forward AND NOT #Backward AND NOT #Cnv_Control.Running) //Backward sensor triggered and not running
    THEN
        #Cnv_Control.Cnv_Occupied := TRUE;//Conveyor occupied
    ELSIF #T_CheckNoPallet.Q OR //Check pallet Timer
        (NOT #Cnv_Control.Running AND NOT #Forward AND NOT #Backward) //No sensor detected and Conveyor not running
    THEN
        //No Pallet
        #Cnv_Control.Cnv_Occupied := FALSE;
    END_IF;
    
    // Update the Cnv_Control opbject
    #Cnv_Control.SM_State := #State;
    #Cnv_Control.Stopped := NOT #Cnv_Control.Running;
    IF #Cnv_Control.Instruction.Inbound_Ready OR #Cnv_Control.Instruction.Outbound_Ready THEN
        #Cnv_Control.Ready_For_Task := TRUE;
    ELSE
        #Cnv_Control.Ready_For_Task := FALSE;
    END_IF;
    
END_REGION

REGION Auto/Semi/Manual mode
    CASE #State OF
        0: //IDLE MODE
            #Cnv_Control.Instruction.Inbound_Ready := FALSE;
            #Cnv_Control.Instruction.Outbound_Ready := FALSE;
            #Cnv_Control.Instruction.Transfer_Complete := 0;
            #Cnv_Control.Instruction.Transfer_in_Progress := FALSE;
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Motor.Forward := FALSE;
            #Cnv_Control.Motor.Reverse := FALSE;
            #Cnv_Control.Motor.Speed := 0;
            #Timer_Transfer(IN := FALSE,
                            PT := T#0S);
            #T_Ramp(IN := FALSE,
                    PT := t#0s);
            IF #Cnv_Control.Enabled AND (#Cnv_Control.Mode = 3 OR #Cnv_Control.Mode = 2) AND #Cnv_Control.Error = 0 THEN
                #State := 10;
            END_IF;
            
        10: //Standby - Conveyor ready to receive instruction
            IF (#R_Start_DB.Q OR #Cnv_Control.Instruction.Start_Transfer) AND #Cnv_Control.Ready_For_Task
            THEN
                #Cnv_Control.Instruction.Inbound_Ready := FALSE;
                #Cnv_Control.Instruction.Outbound_Ready := FALSE;
                #Cnv_Control.Done := FALSE;
                #Cnv_Control.Running := TRUE;
                #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                #VTD_Level := #VTD_Current_Level;
                #State := 20;
            ELSIF #Cnv_Control.Instruction.Start_Transfer
                AND "Control_DB".VTD_Sys[#Id].Current_Level = 0
            THEN
                //Extractor not at the correct level
                Set_Bit_F(Bit := 2,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_3);
            END_IF;
            
            //----------------------- Pallet Movement -----------------------
            
        20: //Set the direction of transfer
            IF #ID_Decoded_From.Device_Type = 10 AND NOT #Cnv_Control.Cnv_Occupied THEN
                IF "Control_DB".LCnv_Sys[#ID_Decoded_From.VTD].Cnv_Level[#ID_Decoded_From.Level].Cnv1.Cnv_Occupied THEN
                    #Cnv_Control.Motor.Speed := #Cnv_Settings.Full_Speed;
                    #Cnv_Control.Motor.Reverse := TRUE;
                    #Transfer_Direction := 'Backward';
                    #State := 30;
                END_IF;
            ELSIF #ID_Decoded_To.Device_Type = 10 AND #Cnv_Control.Cnv_Occupied THEN
                IF NOT "Control_DB".LCnv_Sys[#ID_Decoded_To.VTD].Cnv_Level[#ID_Decoded_To.Level].Cnv1.Cnv_Occupied AND
                    "Control_DB".LCnv_Sys[#ID_Decoded_To.VTD].Cnv_Level[#ID_Decoded_To.Level].Cnv1.SM_State = 30 THEN //Wait CNV1 to be running
                    #Cnv_Control.Motor.Speed := #Cnv_Settings.Full_Speed;
                    #Cnv_Control.Motor.Forward := TRUE;
                    #Transfer_Direction := 'Forward';
                    #State := 30;
                END_IF;
            ELSE //14:3 Cnv cannot transfer to that location
                Set_Bit_F(Bit := 5,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
            
        30: // Running 
            IF #R_Stop_DB.Q THEN
                #Cnv_Control.Motor.Forward := FALSE;
                #Cnv_Control.Motor.Reverse := FALSE;
                #Cnv_Control.Motor.Speed := 0;
                #State := 0;
            ELSE
                //Slowdown ramp
                #T_Ramp(IN := TRUE,
                        PT := #Time_SlowDown_Ramp);
                IF #T_Ramp.ET > (#Time_SlowDown_Ramp * 70) / 100 AND #T_Ramp.ET < (#Time_SlowDown_Ramp * 80) / 100 THEN
                    #Cnv_Control.Motor.Speed := #Cnv_Settings.Slow_Speed * 3;
                ELSIF #T_Ramp.ET > (#Time_SlowDown_Ramp * 80) / 100 AND #T_Ramp.ET < (#Time_SlowDown_Ramp * 90) / 100 THEN
                    #Cnv_Control.Motor.Speed := #Cnv_Settings.Slow_Speed * 2;
                ELSIF #T_Ramp.ET >= #Time_SlowDown_Ramp THEN
                    #Cnv_Control.Motor.Speed := #Cnv_Settings.Slow_Speed;
                END_IF;
            END_IF;
            
            //Check conditions to stop the motor
            IF #ID_Decoded_From.Device_Type = 10 AND #Cnv_Control.Cnv_Occupied THEN
                #State := 35;
            ELSIF #ID_Decoded_To.Device_Type = 10 AND NOT #Cnv_Control.Cnv_Occupied THEN
                #State := 35;
            END_IF;
                
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        35: //Stop Motor
                #T_Ramp(IN := FALSE,
                        PT := t#0s);
                #Cnv_Control.Motor.Forward := FALSE;
                #Cnv_Control.Motor.Reverse := FALSE;
                #Cnv_Control.Motor.Speed := 0;
                #Cnv_Control.Done := TRUE;
                #State := 0; 
            
        400: //Error state
            #Cnv_Control.Instruction.Inbound_Ready := FALSE;
            #Cnv_Control.Instruction.Outbound_Ready := FALSE;
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Motor.Speed := 0;
            #Cnv_Control.Motor.Forward := FALSE;
            #Cnv_Control.Motor.Reverse := FALSE;
            #Cnv_Control.Stopped := TRUE;
            #Cnv_Control.Instruction.Transfer_in_Progress := FALSE;
            #Watchdog(IN := FALSE,
                      PT := T#0S);
            #Timer_Transfer(IN := FALSE,
                            PT := T#0S);
            #T_Ramp(IN := FALSE,
                    PT := t#0s);
            IF #Cnv_Control.Instruction.Reset OR "Reset_All" OR #HMI_Reset THEN
                #Cnv_Control.Warning := 0;
                #Cnv_Control.Current_Task_ID := 0;
                #Cnv_Control.Error := FALSE; //Reset the conveyor
                
                #Cnv_Control.Cnv_Errors.Error_Word_1 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_2 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_3 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_4 := 0;
                #State := 0;
            END_IF;
            
        500:
            IF #Cnv_Control.Enabled THEN
                IF #"VTD_Current_Level" = #Cnv_Settings.Cnv_Level THEN
                    IF #Cnv_Control.Instruction.Foward OR (#Cnv_Control.Instruction.Start_Transfer AND #CNV_In_Out (*SEND = 1*)) THEN
                        #Cnv_Control.Motor.Speed := #Cnv_Settings.Manual_Speed;
                        #Cnv_Control.Motor.Forward := TRUE;
                        #Cnv_Control.Running := TRUE;
                    ELSIF #Cnv_Control.Instruction.Backward OR (#Cnv_Control.Instruction.Start_Transfer AND NOT #CNV_In_Out (*RECEIVE = 0*) AND NOT #Backward) THEN
                        #Cnv_Control.Motor.Speed := #Cnv_Settings.Manual_Speed;
                        #Cnv_Control.Motor.Reverse := TRUE;
                        #Cnv_Control.Running := TRUE;
                    ELSE
                        #Cnv_Control.Motor.Speed := 0;
                        #Cnv_Control.Motor.Forward := FALSE;
                        #Cnv_Control.Motor.Reverse := FALSE;
                        #Cnv_Control.Running := FALSE;
                    END_IF;
                END_IF;
            END_IF;
            IF #Cnv_Control.Mode <> 1 AND #Cnv_Control.Mode <> 5 THEN
                #State := 0;
            END_IF;
    END_CASE;
END_REGION


REGION Cyclic Error Checks
    IF NOT #Safety_OK THEN //Safety
        Set_Bit_F(Bit := 0,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_1);
    END_IF;
    
    IF #Cnv_Control.Motor.Error THEN //VFD
        Set_Bit_F(Bit := 0,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    END_IF;
    
    IF #Cnv_Control.Instruction.Stop THEN //HMI STOP
        Set_Bit_F(Bit := 1,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_1);
    END_IF;
    
    IF ((#Id = 1 AND "Errors_Profinet_1".%X8) OR
        (#Id = 2 AND "Errors_Profinet_3".%X7) OR
        (#Id = 3 AND "Errors_Profinet_5".%X4) OR
        (#Id = 4 AND "Errors_Profinet_7".%X1) OR
        (#Id = 5 AND "Errors_Profinet_8".%X6)) AND #Cnv_Control.Mode <> 1
    THEN //Profinet error
        Set_Bit_F(Bit := 3,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_3);
    END_IF;
    
    // go to error state
    IF #Cnv_Control.Cnv_Errors.Error_Word_1 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_2 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_3 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_4 <> 0
    THEN
        #Cnv_Control.Error := TRUE;
        #State := 400;
    END_IF;
END_REGION

REGION VFD
    //Status
    REGION STATUS WORD DESCRIPTION
        // Diagnostics PZD send signal ZSW1
        
        //     0  r899.0 CO/BO: Status word sequence control: Ready FOR switching on
        //     1  r899.1 CO/BO: Status word sequence control: Ready
        //     2  r899.2 CO/BO: Status word sequence control: Operation enabled
        //     3  r2139.3 CO/BO: Status word faults/alarms 1: Fault present
        //     4  r899.4 CO/BO: Status word sequence control: No coasting active
        //     5  r899.5 CO/BO: Status word sequence control: No Quick Stop active
        //     6  r899.6 CO/BO: Status word sequence control: Switching on inhibited active
        //     7  r2139.7 CO/BO: Status word faults/alarms 1: Alarm present
        //     8  r2197.7 CO/BO: Status word monitoring 1: Speed setpoint - actual value deviation in tolerance t_off
        //     9  r899.9 CO/BO: Status word sequence control: Control request
        //     10 r2199.1 CO/BO: Status word monitoring 3: f OR n comparison value reached OR exceeded
        //     11 r56.13 CO/BO: Status word, closed-loop control: Current/torque limiting (Inverted)
        //     12 Reserved
        //     13 r2135.14 CO/BO: Status word faults/alarms 2: Alarm motor overtemperature (Inverted)
        //     14 r2197.3 CO/BO: Status word monitoring 1: n_act >= 0
        //     15 r836.0 CO/BO: Command Data Set CDS selected: CDS selection bit 0
    END_REGION
    
    #Cnv_Control.Motor.Ready := (#Cnv_Control.Inputs.VFD_Status.%X0 OR #Cnv_Control.Inputs.VFD_Status.%X1) AND NOT #Cnv_Control.Motor.Error;
    #Cnv_Control.Motor.Error := #Cnv_Control.Inputs.VFD_Status.%X3 OR #Cnv_Control.Inputs.VFD_Status.%X7 OR NOT #Cnv_Control.Inputs.VFD_Status.%X13;
    #Cnv_Control.Motor.Enabled := #Cnv_Control.Inputs.VFD_Status.%X2;
    #Cnv_Control.Motor.Actual_Current := SCALE_X(MIN := 0,
                                                 VALUE := NORM_X(MIN := 0,
                                                                 VALUE := #Cnv_Control.Inputs.VFD_ActualCurrent,
                                                                 MAX := 16384),
                                                 MAX := 1.93);
    
    //Actual Speed
    IF #MainSetpoint > 0 THEN
        #Cnv_Control.Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                   VALUE := NORM_X(MIN := 0,
                                                                   VALUE := #Cnv_Control.Inputs.VFD_Speed_Actual,
                                                                   MAX := 16384),
                                                   MAX := 130);
        #Cnv_Control.Motor.Actual_Torque := SCALE_X(MIN := 0,
                                                    VALUE := NORM_X(MIN := 0,
                                                                    VALUE := #Cnv_Control.Inputs.VFD_ActualTorque,
                                                                    MAX := 16384),
                                                    MAX := 100);
    ELSIF #MainSetpoint < 0 THEN
        #Cnv_Control.Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                   VALUE := NORM_X(MIN := 0,
                                                                   VALUE := #Cnv_Control.Inputs.VFD_Speed_Actual * -1,
                                                                   MAX := 16384),
                                                   MAX := 130);
        #Cnv_Control.Motor.Actual_Torque := SCALE_X(MIN := 0,
                                                    VALUE := NORM_X(MIN := 0,
                                                                    VALUE := #Cnv_Control.Inputs.VFD_ActualTorque * -1,
                                                                    MAX := 16384),
                                                    MAX := 100);
    ELSE
        #Cnv_Control.Motor.Speed_Actual := 0;
        #Cnv_Control.Motor.Actual_Torque := 0;
    END_IF;
    
    
    
    //MAIN SETPOINT
    IF #Cnv_Control.Motor.Reverse THEN
        #MainSetpoint := (SCALE_X(MIN := 0,
                                  VALUE := NORM_X(MIN := 0,
                                                  VALUE := #Cnv_Control.Motor.Speed,
                                                  MAX := 130),
                                  MAX := 1865.0));
    ELSIF #Cnv_Control.Motor.Forward THEN
        #MainSetpoint := SCALE_X(MIN := 0,
                                 VALUE := NORM_X(MIN := 0,
                                                 VALUE := #Cnv_Control.Motor.Speed,
                                                 MAX := 130),
                                 MAX := 1865.0) * -1;
    ELSE
        #MainSetpoint := 0;
    END_IF;
    
    #SinaSpeed(EnableAxis := #Cnv_Control.Motor.Forward OR #Cnv_Control.Motor.Reverse,
               AckError := #Cnv_Control.Instruction.Reset OR "Reset_All" OR #HMI_Reset,
               SpeedSp := #MainSetpoint,
               RefSpeed := 1865.0,
               HWIDSTW := #Cnv_Settings.G120_Hardware_ID,
               HWIDZSW := #Cnv_Settings.G120_Hardware_ID);
END_REGION

#HMI_Reset := "Screen_DB_1".Reset_All[1] OR "Screen_DB_1".Reset_All[2] OR "CNV_HMI"."Reset"[1] OR "CNV_HMI"."Reset"[2];
END_FUNCTION_BLOCK