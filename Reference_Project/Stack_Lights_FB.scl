FUNCTION_BLOCK "Stack_Lights_FB"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      System_Auto : Bool;
      Fault : Bool;
   END_VAR

   VAR_OUTPUT 
      Red : Bool;
      Green : Bool;
      Yellow : Bool;
   END_VAR


BEGIN
	//Commands for Stack Light
	
	IF #Fault THEN  // Fault = Red
	    #Red := "Clock_0.5Hz";
	    #Green := FALSE;
	    #Yellow := FALSE;
	ELSIF #System_Auto THEN  // (1)Manual = Yellow
	    #Yellow := FALSE;
	    #Red := FALSE;
	    #Green := TRUE;
	ELSIF NOT #System_Auto THEN  // (2)Semi-Auto = Blue
	    #Green := FALSE;
	    #Yellow := TRUE;
	    #Red := FALSE;
	// ELSIF #System_Auto = 3 THEN  // (3)Auto = Green
	//     #Green := FALSE;
	//     #Red := FALSE;
	//     #Yellow := TRUE;
	
	ELSE
	    #Green := FALSE;
	    #Red := FALSE;
	    #Yellow := FALSE;
	END_IF;
	
END_FUNCTION_BLOCK

