FUNCTION "ByteArrayToString" : String
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Lenght : Int;
      ByteArray : Array[0..1024] of Byte;
   END_VAR

   VAR_OUTPUT 
      ByteArrayToString_1 : String;
      ByteArrayToString_2 : String;
      ByteArrayToString_3 : String;
      ByteArrayToString_4 : String;
      ByteArrayToString_5 : String;
   END_VAR

   VAR_TEMP 
      tempStr_1 : String;
      tempStr_2 : String;
      tempStr_3 : String;
      tempStr_4 : String;
      tempStr_5 : String;
      tempStr_6 : String;
      foundPos : Int;
      i : Int;
   END_VAR


BEGIN
	//STRING 1
	#tempStr_1 := '';
	FOR #i := 0 TO MIN(IN1 := #Lenght - 1, IN2 := 254) DO
	    IF #ByteArray[#i] <> 0 THEN
	        #tempStr_1 := CONCAT(IN1 := #tempStr_1, IN2 := CHAR_TO_STRING(BYTE_TO_CHAR(#ByteArray[#i])));
	    END_IF;
	END_FOR;
	
	//STRING 2
	#tempStr_2 := '';
	FOR #i := 100 TO MIN(IN1 := #Lenght - 1, IN2 := 354) DO
	    IF #ByteArray[#i] <> 0 THEN
	        #tempStr_2 := CONCAT(IN1 := #tempStr_2, IN2 := CHAR_TO_STRING(BYTE_TO_CHAR(#ByteArray[#i])));
	    END_IF;
	END_FOR;
	
	//STRING 3
	#tempStr_3 := '';
	FOR #i := 200 TO MIN(IN1 := #Lenght - 1, IN2 := 454) DO
	    IF #ByteArray[#i] <> 0 THEN
	        #tempStr_3 := CONCAT(IN1 := #tempStr_3, IN2 := CHAR_TO_STRING(BYTE_TO_CHAR(#ByteArray[#i])));
	    END_IF;
	END_FOR;
	
	//STRING 4
	#tempStr_4 := '';
	FOR #i := 300 TO MIN(IN1 := #Lenght - 1, IN2 := 554) DO
	    IF #ByteArray[#i] <> 0 THEN
	        #tempStr_4 := CONCAT(IN1 := #tempStr_4, IN2 := CHAR_TO_STRING(BYTE_TO_CHAR(#ByteArray[#i])));
	    END_IF;
	END_FOR;
	
	// //STRING 5
	#tempStr_5 := '';
	FOR #i := 400 TO MIN(IN1 := #Lenght - 1, IN2 := 654) DO
	    IF #ByteArray[#i] <> 0 THEN
	        #tempStr_5 := CONCAT(IN1 := #tempStr_5, IN2 := CHAR_TO_STRING(BYTE_TO_CHAR(#ByteArray[#i])));
	    END_IF;
	END_FOR;
	
	// //STRING 6
	#tempStr_6 := '';
	FOR #i := 500 TO MIN(IN1 := #Lenght - 1, IN2 := 763) DO
	    IF #ByteArray[#i] <> 0 THEN
	        #tempStr_6 := CONCAT(IN1 := #tempStr_6, IN2 := CHAR_TO_STRING(BYTE_TO_CHAR(#ByteArray[#i])));
	    END_IF;
	END_FOR;
	
	// Remove '$R$L'
	// string 1
	#foundPos := FIND(IN1 := #tempStr_1, IN2 := '$R$L');
	WHILE #foundPos > 0 DO
	    #tempStr_1 := REPLACE(IN1 := #tempStr_1, IN2 := '', P := #foundPos, L := 2);
	    #foundPos := FIND(IN1 := #tempStr_1, IN2 := '$R$L');
	END_WHILE;
	
	// string 2
	#foundPos := FIND(IN1 := #tempStr_2, IN2 := '$R$L');
	WHILE #foundPos > 0 DO
	    #tempStr_2 := REPLACE(IN1 := #tempStr_2, IN2 := '', P := #foundPos, L := 2);
	    #foundPos := FIND(IN1 := #tempStr_2, IN2 := '$R$L');
	END_WHILE;
	
	// string 3
	#foundPos := FIND(IN1 := #tempStr_3, IN2 := '$R$L');
	WHILE #foundPos > 0 DO
	    #tempStr_3 := REPLACE(IN1 := #tempStr_3, IN2 := '', P := #foundPos, L := 2);
	    #foundPos := FIND(IN1 := #tempStr_3, IN2 := '$R$L');
	END_WHILE;
	
	// string 4
	#foundPos := FIND(IN1 := #tempStr_4, IN2 := '$R$L');
	WHILE #foundPos > 0 DO
	    #tempStr_4 := REPLACE(IN1 := #tempStr_4, IN2 := '', P := #foundPos, L := 2);
	    #foundPos := FIND(IN1 := #tempStr_4, IN2 := '$R$L');
	END_WHILE;
	
	// string 5
	#foundPos := FIND(IN1 := #tempStr_5, IN2 := '$R$L');
	WHILE #foundPos > 0 DO
	    #tempStr_5 := REPLACE(IN1 := #tempStr_5, IN2 := '', P := #foundPos, L := 2);
	    #foundPos := FIND(IN1 := #tempStr_5, IN2 := '$R$L');
	END_WHILE;
	
	// string 6
	#foundPos := FIND(IN1 := #tempStr_6, IN2 := '$R$L');
	WHILE #foundPos > 0 DO
	    #tempStr_6 := REPLACE(IN1 := #tempStr_6, IN2 := '', P := #foundPos, L := 2);
	    #foundPos := FIND(IN1 := #tempStr_6, IN2 := '$R$L');
	END_WHILE;
	
	#ByteArrayToString := #tempStr_1;
	#ByteArrayToString_1 := #tempStr_2;
	#ByteArrayToString_2 := #tempStr_3;
	#ByteArrayToString_3 := #tempStr_4;
	#ByteArrayToString_4 := #tempStr_5;
	#ByteArrayToString_5 := #tempStr_6;
END_FUNCTION

FUNCTION "ParseShuttle_Status" : "Shuttle_MQTT_Status_Msg"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      String_1 : String;
      String_2 : String;
      String_3 : String;
      String_4 : String;
      String_5 : String;
      String_6 : String;
   END_VAR

   VAR CONSTANT 
      Empty : String;
   END_VAR


BEGIN
	#ParseShuttle_Status.Request_ID := "FindDINTFieldFragmented"(FieldName := 'requestId',
	                                                             Str1 := #String_1,
	                                                             Str2:=#Empty);
	#ParseShuttle_Status.Position_ID := "FindDINTFieldFragmented"(FieldName := 'positionId',
	                                                              Str1 := #String_1,
	                                                              Str2 := #Empty);
	#ParseShuttle_Status.Destination_ID := "FindDINTFieldFragmented"(FieldName := 'destinationId',
	                                                                 Str1 := #String_1,
	                                                                 Str2:=#Empty);
	#ParseShuttle_Status.Distance_Remaining := "FindDINTFieldFragmented"(FieldName := 'distanceRemaining',
	                                                                     Str1 := #String_1,
	                                                                     Str2 := #Empty);
	#ParseShuttle_Status.Position_X := "FindDINTFieldFragmented"(FieldName := 'positionX',
	                                                             Str1 := #String_1,
	                                                             Str2 := #Empty);
	#ParseShuttle_Status.Position_Y := "FindDINTFieldFragmented"(FieldName := 'positionY',
	                                                             Str1 := #String_1,
	                                                             Str2 := #Empty);
	#ParseShuttle_Status.Floor := "FindIntField"(FieldName := 'floor',
	                                                JsonStr := #String_1);
	#ParseShuttle_Status.Operation_Mode := "FindStringField"(FieldName := 'operationMode',
	                                                         JsonStr := #String_1);
	#ParseShuttle_Status.Operational_State := "FindStringField"(FieldName := 'operationState',
	                                                            JsonStr := #String_2);
	#ParseShuttle_Status.Load_State := "FindStringField"(FieldName := 'loadState',
	                                                     JsonStr := #String_2);
	#ParseShuttle_Status.Error_Vehicle_1 := INT_TO_UINT("FindINTFieldFragmented"(FieldName := 'errorVehicle1',
	                                                                                                                                 Str1 := #String_2,
	                                                                                                                                 Str2:=#String_2));
	#ParseShuttle_Status.Error_Vehicle_2 := INT_TO_UINT("FindIntField"(FieldName := 'errorVehicle2',
	                                                                                                                       JsonStr := #String_2));
	#ParseShuttle_Status.Error_Vehicle_3 := INT_TO_UINT("FindIntField"(FieldName := 'errorVehicle3',
	                                                                                                                       JsonStr := #String_3));
	#ParseShuttle_Status.Error_Vehicle_4 := INT_TO_UINT("FindIntField"(FieldName := 'errorVehicle4',
	                                                                                                                       JsonStr := #String_3));
	#ParseShuttle_Status.Error_Vehicle_5 := INT_TO_UINT("FindIntField"(FieldName := 'errorVehicle5',
	                                                                                                                       JsonStr := #String_3));
	#ParseShuttle_Status.Error_Vehicle_6 := INT_TO_UINT("FindIntField"(FieldName := 'errorVehicle6',
	                                                                                                                       JsonStr := #String_4));
	#ParseShuttle_Status.Sensor_Inputs := INT_TO_UINT("FindIntField"(FieldName := 'sensorInputs',
	                                                                                                                   JsonStr := #String_4));
	#ParseShuttle_Status.Sensor_Outputs := INT_TO_UINT("FindIntField"(FieldName := 'sensorOutputs',
	                                                                                                                     JsonStr := #String_4));
	#ParseShuttle_Status.Reader_Value := "FindDINTFieldFragmented"(FieldName := 'readerValue',
	                                                               Str1 := #String_4,
	                                                             Str2 := #Empty);
	#ParseShuttle_Status.Pallet_Type := "FindStringField"(FieldName := 'palletType',
	                                                      JsonStr := #String_4);
	#ParseShuttle_Status.Energy_Level := INT_TO_UINT("FindINTFieldFragmented"(FieldName := 'energyLevel',
	                                                                                                                           Str1 := #String_5,
	                                                                                                                           Str2:=#String_5));
	#ParseShuttle_Status.Battery_Voltage := INT_TO_UINT("FindIntField"(FieldName := 'batteryVoltage',
	                                                                                                                       JsonStr := #String_5));
	#ParseShuttle_Status.Paused := "FindBoolField"(FieldName := 'paused',
	                                               JsonStr := #String_5);
	#ParseShuttle_Status.Last_Received_Order_ID := "FindIntField"(FieldName := 'lastReceivedOrderId',
	                                                              JsonStr := #String_5);
	 #ParseShuttle_Status.Current_Order_ID := "FindIntField"(FieldName := 'currentOrderId',
	                                                         JsonStr := #String_6);
	       #ParseShuttle_Status.Last_Finished_Order_ID := "FindIntField"(FieldName := 'lastFinishedOrderId',
	                                                                     JsonStr := #String_6);
	
END_FUNCTION

FUNCTION "RemovePlusSign" : String
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      inString : String;
   END_VAR

   VAR_TEMP 
      tempString : String;
   END_VAR


BEGIN
	
	IF LEFT(IN := #inString, L := 1) = '+' THEN
	    #tempString := RIGHT(IN := #inString, L := LEN(#inString) - 1);
	ELSE
	    #tempString := #inString;
	END_IF;
	
	#RemovePlusSign := #tempString;
END_FUNCTION

TYPE "LStream_typeElement"
TITLE = LStream_typeElement
VERSION : 0.1
//describes the element for LStream libraries, by providing key-value pair and the depth of the element
   STRUCT
      "type" : SInt := -1;   // Type of element XML/JSON;  -1 = inital value; 0 = Element/Object; 1 = Attribute/Array; 2 = Text/String; 3 = Number; 4 = Boolean
      key : String;   // Key name of element
      value : String := 'NULL';   // Value of element, null key has no value
      depth : SInt := -1;   // Depth of the key nesting
      closingElement : Bool;   // The element is last element of an object or array; True=Closing element; Only applicable for JSON functionality
   END_STRUCT;

END_TYPE

