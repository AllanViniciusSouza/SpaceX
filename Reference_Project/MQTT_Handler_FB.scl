FUNCTION "FindDINTFieldFragmented" : DInt
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      FieldName : String;
      Str1 : String;
      Str2 : String;
   END_VAR

   VAR_TEMP 
      searchStr : String;
      iStart : Int;
      iEnd : Int;
      tempVal : String;
      fieldFound : Bool;
      loopIdx : Int;
   END_VAR


BEGIN
	// Build search string
	#searchStr := CONCAT(IN1 := '"', IN2 := #FieldName);
	#searchStr := CONCAT(IN1 := #searchStr, IN2 := '" :');
	
	// Serach for JSON field
	#iStart := FIND(IN1 := #Str1, IN2 := #searchStr);
	
	IF #iStart > 0 THEN
	    // Found full field in String_1
	    #iEnd := FIND(IN1 := MID(IN := #Str1, P := #iStart + LEN(#searchStr), L := 20), IN2 := ',');
	    IF #iEnd = 0 THEN
	        #iEnd := FIND(IN1 := MID(IN := #Str1, P := #iStart + LEN(#searchStr), L := 20), IN2 := '}');
	    END_IF;
	    IF #iEnd > 0 THEN
	        #tempVal := MID(IN := #Str1, P := #iStart + LEN(#searchStr), L := #iEnd - 1);
	        #fieldFound := TRUE;
	    END_IF;
	END_IF;
	
	// Search for full field in Str2
	IF NOT #fieldFound THEN
	    #iStart := FIND(IN1 := #Str2, IN2 := #searchStr);
	    IF #iStart > 0 THEN
	        #iEnd := FIND(IN1 := MID(IN := #Str2, P := #iStart + LEN(#searchStr), L := 20), IN2 := ',');
	        IF #iEnd = 0 THEN
	            #iEnd := FIND(IN1 := MID(IN := #Str2, P := #iStart + LEN(#searchStr), L := 20), IN2 := '}');
	        END_IF;
	        IF #iEnd > 0 THEN
	            #tempVal := MID(IN := #Str2, P := #iStart + LEN(#searchStr), L := #iEnd - 1);
	            #fieldFound := TRUE;
	        END_IF;
	    END_IF;
	END_IF;
	
	// Search for fragmented field: end of name in Str1 and beginning in Str2
	IF NOT #fieldFound THEN
	    // Examines last 10 characters of String_1
	    FOR #loopIdx := LEN(#Str1) - 15 TO LEN(#Str1) DO
	        IF MID(IN := #Str1, P := #loopIdx, L := 1) = '"' THEN
	            #tempVal := MID(IN := #Str1, P := #loopIdx, L := LEN(#Str1) - #loopIdx + 1);
	            #tempVal := CONCAT(IN1 := #tempVal, IN2 := #Str2); // concatenates piece from beginning of String_2
	            #iStart := FIND(IN1 := #tempVal, IN2 := #searchStr);
	            IF #iStart > 0 THEN
	                #iEnd := FIND(IN1 := MID(IN := #tempVal, P := #iStart + LEN(#searchStr), L := 20), IN2 := ',');
	                IF #iEnd = 0 THEN
	                    #iEnd := FIND(IN1 := MID(IN := #tempVal, P := #iStart + LEN(#searchStr), L := 20), IN2 := '}');
	                END_IF;
	                IF #iEnd > 0 THEN
	                    #tempVal := MID(IN := #tempVal, P := #iStart + LEN(#searchStr), L := #iEnd - 1);
	                    #fieldFound := TRUE;
	                END_IF;
	            END_IF;
	            EXIT; // found, you can leave
	        END_IF;
	    END_FOR;
	END_IF;
	
	// Return value
	IF #fieldFound THEN
	    #FindDINTFieldFragmented := STRING_TO_DINT(#tempVal);
	ELSE
	    #FindDINTFieldFragmented := -9999; // default value if not found
	END_IF;
	
END_FUNCTION

FUNCTION "FindStringField" : String
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      FieldName : String;
      JsonStr : String;
   END_VAR

   VAR_TEMP 
      searchStr : String;
      foundPos : Int;
      resultStr : String;
      quotePos1 : Int;
      quotePos2 : Int;
   END_VAR


BEGIN
	// Sets search pattern → ex: '"loadstate":'
	#searchStr := CONCAT(IN1 := '"', IN2 := #FieldName);
	#searchStr := CONCAT(IN1 := #searchStr, IN2 := '" :');
	
	// Search in JSON
	#foundPos := FIND(IN1 := #JsonStr, IN2 := #searchStr);
	
	IF #foundPos > 0 THEN
	    // Finds first quote after field
	    #quotePos1 := FIND(IN1 := MID(IN := #JsonStr, P := #foundPos + LEN(#searchStr), L := 20), IN2 := '"');
	    
	    IF #quotePos1 > 0 THEN
	        // Finds second quote after the first
	        #quotePos2 := FIND(
	                           IN1 := MID(IN := #JsonStr, P := #foundPos + LEN(IN := #searchStr) + #quotePos1, L := 10),
	                           IN2 := '"'
	        );
	        
	        IF #quotePos2 > 0 THEN
	            #resultStr := MID(
	                              IN := #JsonStr,
	                              P := #foundPos + LEN(#searchStr) + #quotePos1,
	                              L := #quotePos2 - 1
	            );
	            #FindStringField := #resultStr;
	            RETURN;
	        END_IF;
	    END_IF;
	END_IF;
	
	// If not found, returns empty string
	#FindStringField := '';
	
END_FUNCTION

FUNCTION "FindIntField" : Int
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      FieldName : String;
      JsonStr : String;
   END_VAR

   VAR_TEMP 
      searchStr : String;
      foundPos : Int;
      valueStr : String;
      delimPos : Int;
   END_VAR


BEGIN
	// Set up the search pattern, e.g. '"id":'
	#searchStr := CONCAT(IN1 := '"', IN2 := #FieldName);
	#searchStr := CONCAT(IN1 := #searchStr, IN2 := '" :');
	
	// Search the field
	#foundPos := FIND(IN1 := #JsonStr, IN2 := #searchStr);
	
	IF #foundPos > 0 THEN
	    // Try to find a comma after the value
	    #delimPos := FIND(
	                      IN1 := MID(IN := #JsonStr, P := #foundPos + LEN(#searchStr), L := 10),
	                      IN2 := ','
	    );
	    
	    // If there is no comma, try to find the closing brace '}'
	    IF #delimPos = 0 THEN
	        #delimPos := FIND(
	                          IN1 := MID(IN := #JsonStr, P := #foundPos + LEN(#searchStr), L := 10),
	                          IN2 := '}'
	        );
	    END_IF;
	    
	    // If you find the end of value, extract the value
	    IF #delimPos > 0 THEN
	        #valueStr := MID(
	                         IN := #JsonStr,
	                         P := #foundPos + LEN(#searchStr),
	                         L := #delimPos - 1
	        );
	        #FindIntField := STRING_TO_INT(#valueStr);
	        RETURN;
	    END_IF;
	END_IF;
	
	// Default return if not found or error
	#FindIntField := -9999;
	
END_FUNCTION

