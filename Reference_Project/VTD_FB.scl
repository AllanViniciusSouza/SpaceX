	("HMI_Box_Connected_1" = 56 AND "KEY REMOTE/LOCAL L6 - CH1(5)") OR
	("HMI_Box_Connected_1" = 57 AND "KEY REMOTE/LOCAL L7 - CH1(5)") OR
	("HMI_Box_Connected_1" = 58 AND "KEY REMOTE/LOCAL L8 - CH1(5)"))
	OR
	(("Screen_DB_1".Reset_All[2] OR "VTD_HMI".Reset[2]) AND
	("HMI_Box_Connected_2" = 11 AND "KEY REMOTE/LOCAL L1 - CH1(1)") OR
	("HMI_Box_Connected_2" = 12 AND "KEY REMOTE/LOCAL L2 - CH1(1)") OR
