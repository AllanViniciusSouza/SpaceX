FUNCTION "Set_Bit_F" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Bit : UInt;
      Bit_Value : Bool;
   END_VAR

   VAR_IN_OUT 
      "Var" : Word;
   END_VAR


BEGIN
	IF #Bit_Value THEN
	    // Set the bit
	    #Var := #Var OR SHL(IN := WORD#1, N := #Bit);
	// ELSE
	//     // Reset the bit
	//     #Var := #Var OR SHL(IN := DWORD#1, N := #Bit);
	END_IF;
	
END_FUNCTION

