TYPE "Sfts_Instruction"
VERSION : 0.1
   STRUCT
      Mode_Change : UInt;
      Enable : Bool;
      Extend : Bool;
      Retract : Bool;
      Manual_Extend : Bool;
      Manual_Retract : Bool;
   END_STRUCT;

END_TYPE

TYPE "Sfts_Inputs"
VERSION : 0.1
   STRUCT
      DP_Extended : Bool;
      DP_Retracted : Bool;
   END_STRUCT;

END_TYPE

TYPE "Shuttle_MQTT_Status_Msg"
VERSION : 0.1
   STRUCT
      Request_ID : DInt;
      Position_ID : DInt;
      Destination_ID : DInt;
      Distance_Remaining : DInt;
      Position_X : DInt;
      Position_Y : DInt;
      Floor : Int;
      Operation_Mode : String;
      Operational_State : String;
      Load_State : String;
      Error_Vehicle_1 : UInt;
      Error_Vehicle_2 : UInt;
      Error_Vehicle_3 : UInt;
      Error_Vehicle_4 : UInt;
      Error_Vehicle_5 : UInt;
      Error_Vehicle_6 : UInt;
      Sensor_Inputs : UInt;
      Sensor_Outputs : UInt;
      Reader_Value : DInt;
      Pallet_Type : String;
      Energy_Level : UInt;
      Battery_Voltage : UInt;
      Paused : Bool;
      Last_Received_Order_ID : Int;
      Current_Order_ID : Int;
      Last_Finished_Order_ID : Int;
   END_STRUCT;

END_TYPE

TYPE "Sfts_Control"
VERSION : 0.1
   STRUCT
      Mode { ExternalWritable := 'False'} : UInt;
      Error { ExternalWritable := 'False'} : Bool;
      Enabled { ExternalWritable := 'False'} : Bool;
      Running { ExternalWritable := 'False'} : Bool;
      LP_State : USInt;
      Motor_Extend { ExternalWritable := 'False'} : Bool;
      Motor_Retract { ExternalWritable := 'False'} : Bool;
      SM_State : UInt;
      Instruction { S7_SetPoint := 'False'} : "Sfts_Instruction";
      Inputs : "Sfts_Inputs";
   END_STRUCT;

END_TYPE

