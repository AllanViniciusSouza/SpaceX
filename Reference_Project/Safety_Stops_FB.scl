      Charge_OT { S7_SetPoint := 'True'} : Array[1..5] of Bool;
      OrderTable_Selected : Array[1..5] of UInt;
      Automatic_Button : Array[1..5] of Bool;
      All_In_Automatic : Array[1..5] of Bool;
      System_Error : Array[1..5] of Bool;
      Reset_Comissioning : Array[1..5] of Bool;
      Alarms_ActiveTable : Array[1..5] of USInt;
      Charger_1 : Array[1..5] of Bool;
      Charger_2 : Array[1..5] of Bool;
      Charger_3 : Array[1..5] of Bool;
      Shuttle_Charge_Buttons : Array[1..5] of Bool;
      Alarm_Current_Buttons : Array[1..5] of Bool;
      Alarm_History_Buttons : Array[1..5] of Bool;
      MainTemplate_Background : Array[1..5] of USInt;
      Settings_ActivePopUp : Array[1..5] of USInt;
      MainTemplate_ErrorActive : Array[1..5] of Bool;
      MainTemplate_ErrorCount : Array[1..5] of USInt;
      EmptyTemplate_Background : Array[1..5] of USInt;
      Charge_VTD : Array[1..5] of Bool;
      Charge_Cnv : Array[1..5] of Bool;
      Charge_Cnv_Commands : Array[1..5] of Bool;
   END_VAR


BEGIN
   Charger_1[1] := false;
   Charger_1[2] := false;
   Charger_1[3] := false;
   Charger_1[4] := false;
   Charger_1[5] := false;

END_DATA_BLOCK

