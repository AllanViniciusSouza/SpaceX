DATA_BLOCK "Time"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      CurrentLocalTime : String;
      CurrentDTL {InstructionName := 'DTL'; LibVersion := '1.0'} : DTL;
      PC_HeartBeat : Word;
      PLC_HeartBeat : Word;
   END_VAR


BEGIN
   CurrentLocalTime := '06/10/2022 09:04:28';
   CurrentDTL.YEAR := 2022;
   CurrentDTL.MONTH := 6;
   CurrentDTL.DAY := 10;
   CurrentDTL.WEEKDAY := 6;
   CurrentDTL.HOUR := 9;
   CurrentDTL.MINUTE := 4;
   CurrentDTL.SECOND := 28;
   CurrentDTL.NANOSECOND := 50899826;
   CurrentDTL := DTL#2022-06-10-09:04:28.050899826;
   PC_HeartBeat := 16#6E87;
   PLC_HeartBeat := 16#B1AA;

END_DATA_BLOCK

FUNCTION "Feed_Steptable_FC" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      CurrentTime : String;
      Task_Type : Int;
      Source_Location : DInt;
      Destination_Location : DInt;
      Pallet_Type : Char;
      Pallet_Alignment : Char;
      Shuttle_ID : Int;
   END_VAR

   VAR_IN_OUT 
      StepTable : "OrderTable_UDT";
   END_VAR


BEGIN
	#StepTable.OrderNo := "OrderNo" + 1;
	#StepTable.StepNo := "OrderNo" + 1;
	#StepTable.PlaceTime := #CurrentTime;
	
	#StepTable.OPC_Control.Task_ID := "OrderNo" + 1;
	#StepTable.OPC_Control.Task_Type := #Task_Type;
	#StepTable.OPC_Control.Source_Location := #Source_Location;
	#StepTable.OPC_Control.Destination_Location := #Destination_Location;
	#StepTable.OPC_Control.Pallet_Type := #Pallet_Type;
	#StepTable.OPC_Control.Pallet_Alignment := #Pallet_Alignment;
	#StepTable.OPC_Control.Shuttle_ID := #Shuttle_ID;
	
	
	
	
	
	
	
	
	
	
END_FUNCTION

