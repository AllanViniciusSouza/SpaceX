      Publish_Msg_Length : UDInt;
      Publish_Msg_Payload : Array[1..1] of Byte;
      Shuttle_Status { S7_SetPoint := 'False'} : "Shuttle_MQTT_Status_Msg";
   END_STRUCT;

END_TYPE

