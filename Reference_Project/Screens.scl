	                "Control_DB".LCnv_Sys[4].Cnv_Level[#i].Cnv2.Safety_Stop_Cnrl.Mode := 3;
	                
	                "Control_DB".VTD_Sys[4].Instruction.Enable :=
	                "Control_DB".ECnv_Sys[4].Instruction.Enable :=
	                "Control_DB".LCnv_Sys[4].Cnv_Level[#i].Cnv1.Instruction.Enable :=
	                "Control_DB".LCnv_Sys[4].Cnv_Level[#i].Cnv2.Instruction.Enable := TRUE;
	            END_FOR;
	        END_IF;
	    END_REGION
	    
	    REGION AUTOMATIC BUTTON - SYSTEM 5
	        IF "Automatic_Button_5" THEN
	            FOR #i := "Settings_DB".VTD_Sys[5].Lowest_Level TO "Settings_DB".VTD_Sys[5].Highest_Level DO
	                "Control_DB".VTD_Sys[5].Instruction.Mode_Change :=
	                "Control_DB".ECnv_Sys[5].Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[5].Cnv_Level[#i].Cnv1.Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[5].Cnv_Level[#i].Cnv2.Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[5].Cnv_Level[#i].Cnv1.Safety_Stop_Cnrl.Mode :=
	                "Control_DB".LCnv_Sys[5].Cnv_Level[#i].Cnv2.Safety_Stop_Cnrl.Mode := 3;
	                
	                "Control_DB".VTD_Sys[5].Instruction.Enable :=
	                "Control_DB".ECnv_Sys[5].Instruction.Enable :=
	                "Control_DB".LCnv_Sys[5].Cnv_Level[#i].Cnv1.Instruction.Enable :=
	                "Control_DB".LCnv_Sys[5].Cnv_Level[#i].Cnv2.Instruction.Enable := TRUE;
	            END_FOR;
	        END_IF;
	    END_REGION
	    
	    REGION ALL IN AUTOMATIC - SYSTEM 1
	        "All_In_Automatic_1" := "Control_DB".VTD_Sys[1].Mode = 3 AND //VTD
	        "Control_DB".ECnv_Sys[1].Mode = 3 AND //ECONVEYOR
	        //CONVEYORS
	        "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv1.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv2.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[7].Cnv1.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[7].Cnv2.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[8].Cnv1.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[8].Cnv2.Mode = 3 AND
	        //SAFETY STOP
	        "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[1].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[2].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[3].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[4].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[5].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[6].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[7].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[7].Cnv2.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[8].Cnv1.Safety_Stop_Cnrl.Mode = 3 AND
	        "Control_DB".LCnv_Sys[1].Cnv_Level[8].Cnv2.Safety_Stop_Cnrl.Mode = 3;
	    END_REGION
	    
	    REGION ALL IN AUTOMATIC - SYSTEM 2
	        "All_In_Automatic_2" := "Control_DB".VTD_Sys[2].Mode = 3 AND //VTD
	        "Control_DB".ECnv_Sys[2].Mode = 3 AND //ECONVEYOR
	        //CONVEYORS
	        "Control_DB".LCnv_Sys[2].Cnv_Level[1].Cnv1.Mode = 3 AND
	        "Control_DB".LCnv_Sys[2].Cnv_Level[1].Cnv2.Mode = 3 AND
	        "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv1.Mode = 3 AND
	        "Control_DB".LCnv_Sys[2].Cnv_Level[2].Cnv2.Mode = 3 AND
	        "Control_DB".LCnv_Sys[2].Cnv_Level[3].Cnv1.Mode = 3 AND
