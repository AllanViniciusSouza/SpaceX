      Barcode_ID : UInt;
      Cnv_Level : UInt;
      TC_Time : UInt;
      Transfer_Time : UInt;
      Pallet_Align_Time : UInt;
      Slow_Speed : UInt;
      Full_Speed : UInt;
      Manual_Speed : UInt;
      Timer_Check_Pallet_Time : UInt;
      G120_Hardware_ID { S7_SetPoint := 'True'} : HW_IO;
   END_STRUCT;

END_TYPE

TYPE "MQTT_Settings"
