   VTD_Sys[3].Manual_Speed := 15;
   VTD_Sys[3].Slowdown_Count_LE := 700;
   VTD_Sys[3].Creep_Count_LE := 60;
   VTD_Sys[3].Slowdown_Count_AE := 700;
   VTD_Sys[3].Creep_Count_AE := 60;
   VTD_Sys[3].Encoder_Delta_W1 := 0.0;
   VTD_Sys[3].Encoder_Delta_W2 := 0.0;
   VTD_Sys[3].AE_Ratio := 0.0;
   VTD_Sys[3].Encoder_Delta_Warning := 50.0;
   VTD_Sys[3].Encoder_Delta_Error := 200.0;
   VTD_Sys[3].Transfer_Timeout_Up := 50;
   VTD_Sys[3].Transfer_Timeout_Down := 45;
   VTD_Sys[3].Lockpins_Timeout_Extend := 3000;
   VTD_Sys[3].Lockpins_Timeout_Retract := 3000;
   VTD_Sys[3].Level_Detect_Timeout := 500;
   VTD_Sys[3].Teach_Timeout := 600;
   VTD_Sys[3].Chain_Slack_Timeout := 600;
   VTD_Sys[3].Level_Detect_LE := 3.0;
   VTD_Sys[3].Acc_Range_1 := 60;
