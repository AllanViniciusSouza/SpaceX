{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
"Auto_Test_1"

BEGIN

END_DATA_BLOCK

FUNCTION "Screens" : Void
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_TEMP 
      i : UInt;
      j : UInt;
      _id_decoded_OP : Array[1..5] of "ID_Decoded";
      Level_Strg : String;
      Destination_Location : Array[1..5] of DInt;
   END_VAR


BEGIN
	REGION MAIN SCREEN
	    REGION AUTOMATIC BUTTON - SYSTEM 1
	        IF "Automatic_Button_1" THEN
	            FOR #i := "Settings_DB".VTD_Sys[1].Lowest_Level TO "Settings_DB".VTD_Sys[1].Highest_Level DO
	                "Control_DB".VTD_Sys[1].Instruction.Mode_Change :=
	                "Control_DB".ECnv_Sys[1].Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[1].Cnv_Level[#i].Cnv1.Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[1].Cnv_Level[#i].Cnv2.Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[1].Cnv_Level[#i].Cnv1.Safety_Stop_Cnrl.Mode :=
	                "Control_DB".LCnv_Sys[1].Cnv_Level[#i].Cnv2.Safety_Stop_Cnrl.Mode := 3;
	                
	                "Control_DB".VTD_Sys[1].Instruction.Enable :=
	                "Control_DB".ECnv_Sys[1].Instruction.Enable :=
	                "Control_DB".LCnv_Sys[1].Cnv_Level[#i].Cnv1.Instruction.Enable :=
	                "Control_DB".LCnv_Sys[1].Cnv_Level[#i].Cnv2.Instruction.Enable := TRUE;
	            END_FOR;
	        END_IF;
	    END_REGION
	    
	    REGION AUTOMATIC BUTTON - SYSTEM 2
	        IF "Automatic_Button_2" THEN
	            FOR #i := "Settings_DB".VTD_Sys[2].Lowest_Level TO "Settings_DB".VTD_Sys[2].Highest_Level DO
	                "Control_DB".VTD_Sys[2].Instruction.Mode_Change :=
	                "Control_DB".ECnv_Sys[2].Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[2].Cnv_Level[#i].Cnv1.Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[2].Cnv_Level[#i].Cnv2.Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[2].Cnv_Level[#i].Cnv1.Safety_Stop_Cnrl.Mode :=
	                "Control_DB".LCnv_Sys[2].Cnv_Level[#i].Cnv2.Safety_Stop_Cnrl.Mode := 3;
	                
	                "Control_DB".VTD_Sys[2].Instruction.Enable :=
	                "Control_DB".ECnv_Sys[2].Instruction.Enable :=
	                "Control_DB".LCnv_Sys[2].Cnv_Level[#i].Cnv1.Instruction.Enable :=
	                "Control_DB".LCnv_Sys[2].Cnv_Level[#i].Cnv2.Instruction.Enable := TRUE;
	            END_FOR;
	        END_IF;
	    END_REGION
	    
	    REGION AUTOMATIC BUTTON - SYSTEM 3
	        IF "Automatic_Button_3" THEN
	            FOR #i := "Settings_DB".VTD_Sys[3].Lowest_Level TO "Settings_DB".VTD_Sys[3].Highest_Level DO
	                "Control_DB".VTD_Sys[3].Instruction.Mode_Change :=
	                "Control_DB".ECnv_Sys[3].Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[3].Cnv_Level[#i].Cnv1.Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[3].Cnv_Level[#i].Cnv2.Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[3].Cnv_Level[#i].Cnv1.Safety_Stop_Cnrl.Mode :=
	                "Control_DB".LCnv_Sys[3].Cnv_Level[#i].Cnv2.Safety_Stop_Cnrl.Mode := 3;
	                
	                "Control_DB".VTD_Sys[3].Instruction.Enable :=
	                "Control_DB".ECnv_Sys[3].Instruction.Enable :=
	                "Control_DB".LCnv_Sys[3].Cnv_Level[#i].Cnv1.Instruction.Enable :=
	                "Control_DB".LCnv_Sys[3].Cnv_Level[#i].Cnv2.Instruction.Enable := TRUE;
	            END_FOR;
	        END_IF;
	    END_REGION
	    
	    REGION AUTOMATIC BUTTON - SYSTEM 4
	        IF "Automatic_Button_4" THEN
	            FOR #i := "Settings_DB".VTD_Sys[4].Lowest_Level TO "Settings_DB".VTD_Sys[4].Highest_Level DO
	                "Control_DB".VTD_Sys[4].Instruction.Mode_Change :=
	                "Control_DB".ECnv_Sys[4].Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[4].Cnv_Level[#i].Cnv1.Instruction.Mode_Change :=
	                "Control_DB".LCnv_Sys[4].Cnv_Level[#i].Cnv2.Instruction.Mode_Change :=
