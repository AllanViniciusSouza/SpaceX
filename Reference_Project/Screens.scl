	                "L7_Estop" := "Shuttle_Level_EStop";
	            8:
	                "L8_Estop" := "Shuttle_Level_EStop";
	        END_CASE;
	    END_IF;
	END_REGION
	
	REGION ORDER TABLE
	    //CHARGE OT DATA
	    IF "Screen_DB".Charge_OT THEN
	        CASE "Main_OrderTable_Selected" OF
	            1:
	                "OT_Charge_Commands"("Auto_Test_1_DB");
	            2:
	                "OT_Charge_Commands"("Auto_Test_2_DB");
	            3:
	                "OT_Charge_Commands"("Auto_Test_3_DB");
	            4:
	                "OT_Charge_Commands_1"("Auto_Test_4_DB");
	            5:
	                "OT_Charge_Commands_1"("Auto_Test_5_DB");
	        END_CASE;
	        "T_Charge_OT".TON(IN := TRUE,
	                          PT := T#1000ms);
	        IF "T_Charge_OT".Q THEN
	            "T_Charge_OT".TON(IN := FALSE,
	                              PT := T#0ms);
	            "Screen_DB".Charge_OT := FALSE;
	        END_IF;
	    END_IF;
	    
	    IF NOT "Screen_DB".Charge_OT THEN
	        "T_Charge_OT".TON(IN := FALSE,
	                          PT := T#0ms);
	        
	        CASE "Main_OrderTable_Selected" OF
	            1:
	                "Clear_OT(1)" := "Clear_OT";
	                "FC_Orders"(Sys := 1,
	                            System := "System_DB_1",
	                            Auto_Test := "Auto_Test_1_DB",
	                            VTD_CurrentOrder := "Order_Table_FB_DB_1".VTD_CurrentOrder,
	                            Pallet_InOut_CurrentOrder := "Order_Table_FB_DB_1".Pallet_InOut_CurrentOrder,
	                            Shuttle_InOut_CurrentOrder := "Order_Table_FB_DB_1".Shuttle_InOut_CurrentOrder,
	                            System_Busy := "System_1_Busy");
	                
	            2:
	                "Clear_OT(2)" := "Clear_OT";
	                "FC_Orders"(Sys := 2,
	                            System := "System_DB_2",
	                            Auto_Test := "Auto_Test_2_DB",
	                            VTD_CurrentOrder := "Order_Table_FB_DB_2".VTD_CurrentOrder,
	                            Pallet_InOut_CurrentOrder := "Order_Table_FB_DB_2".Pallet_InOut_CurrentOrder,
	                            Shuttle_InOut_CurrentOrder := "Order_Table_FB_DB_2".Shuttle_InOut_CurrentOrder,
	                            System_Busy := "System_2_Busy");
	                
	            3:
	                "Clear_OT(3)" := "Clear_OT";
	                "FC_Orders"(Sys := 3,
	                            System := "System_DB_3",
	                            Auto_Test := "Auto_Test_3_DB",
	                            VTD_CurrentOrder := "Order_Table_FB_DB_3".VTD_CurrentOrder,
	                            Pallet_InOut_CurrentOrder := "Order_Table_FB_DB_3".Pallet_InOut_CurrentOrder,
	                            Shuttle_InOut_CurrentOrder := "Order_Table_FB_DB_3".Shuttle_InOut_CurrentOrder,
	                            System_Busy := "System_3_Busy");
	                
	            4:
	                "Clear_OT(4)" := "Clear_OT";
	                "FC_Orders_2"(Sys := 4,
	                            System := "System_DB_4",
	                            Auto_Test := "Auto_Test_4_DB",
	                            VTD_CurrentOrder := "Order_Table_FB_DB_4".VTD_CurrentOrder,
	                            Pallet_InOut_CurrentOrder := "Order_Table_FB_DB_4".Pallet_InOut_CurrentOrder,
	                            Shuttle_InOut_CurrentOrder := "Order_Table_FB_DB_4".Shuttle_InOut_CurrentOrder,
	                            System_Busy := "System_4_Busy");
	                
	            5:
	                "Clear_OT(5)" := "Clear_OT";
	                "FC_Orders_2"(Sys := 5,
	                            System := "System_DB_5",
	                            Auto_Test := "Auto_Test_5_DB",
	                            VTD_CurrentOrder := "Order_Table_FB_DB_5".VTD_CurrentOrder,
	                            Pallet_InOut_CurrentOrder := "Order_Table_FB_DB_5".Pallet_InOut_CurrentOrder,
	                            Shuttle_InOut_CurrentOrder := "Order_Table_FB_DB_5".Shuttle_InOut_CurrentOrder,
	                            System_Busy := "System_5_Busy");
	                
	        END_CASE;
	    END_IF;
	END_REGION
	
	"HMI_DB".Password := '12345';
	
	REGION VTD BARCODE
	    CASE "VTD_System_Selected_HMI" OF
	        1:
	            "Screen_DB".VTD_Barcode := "Control_DB".VTDBarcode_Station[1].Barcode;
	            "Screen_DB".VTD_Barcode_Visu := "Control_DB".VTDBarcode_Station[1].Barcode <> '';
	        2:
	            "Screen_DB".VTD_Barcode := "Control_DB".VTDBarcode_Station[2].Barcode;
	            "Screen_DB".VTD_Barcode_Visu := "Control_DB".VTDBarcode_Station[2].Barcode <> '';
	        3:
	            "Screen_DB".VTD_Barcode := "Control_DB".VTDBarcode_Station[3].Barcode;
	            "Screen_DB".VTD_Barcode_Visu := "Control_DB".VTDBarcode_Station[3].Barcode <> '';
	        4:
	            "Screen_DB".VTD_Barcode := "Control_DB".VTDBarcode_Station[4].Barcode;
	            "Screen_DB".VTD_Barcode_Visu := "Control_DB".VTDBarcode_Station[4].Barcode <> '';
	        5:
	            "Screen_DB".VTD_Barcode := "Control_DB".VTDBarcode_Station[5].Barcode;
	            "Screen_DB".VTD_Barcode_Visu := "Control_DB".VTDBarcode_Station[5].Barcode <> '';
	    END_CASE;
	END_REGION VTD BARCODE
	
