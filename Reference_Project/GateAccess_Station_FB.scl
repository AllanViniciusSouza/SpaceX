FUNCTION_BLOCK "ModeManager_FB"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      RTE_PB : Bool;   // Request To Enter pushbutton, rising edge triggers request
      Reset_PB : Bool;   // Reset pushbutton, rising edge triggers reset attempt
      Restart_PB : Bool;   // Restart pushbutton, rising edge triggers return to auto
      ForceRTE : Bool;   // one-scan pulse from FB_GateAccessControl.ForceRTE_Request
      GateClosed : Bool;   // TRUE = gate physically closed
      GateLockedFeedback : Bool;   // TRUE = gate lock solenoid confirmed locked
      GateFault : Bool;   // from FB_GateAccessControl - blocks Auto/Restart
      NoEStop : Bool;   // TRUE = no emergency stop active anywhere in chain
      AllDrivesHealthy : Bool;   // TRUE = no drive faults on VTD/shuttle drives
      SafetyResetDone : Bool;   // TRUE = upstream safety reset permissive satisfied
      NoVTDLocalMode : Bool;   // TRUE = no VTD station currently in Local mode
      NoCrossoverPaused : Bool;   // TRUE = no conveyor crossover currently paused
      AllDevicesStopped : Bool;   // TRUE = all VTDs confirmed at standstill
      Safe_Bypassed : Bool;
      Reset : Bool;
   END_VAR

   VAR_OUTPUT 
      CurrentState : UInt;   // current sequence state, for HMI/diagnostics
      GateUnlockPermissive : Bool;   // TRUE = safe to unlock gate solenoid (SAFE_TO_UNLOCK onwards)
      StopNewAutoCycles : Bool;   // TRUE = do not start new automatic cycles
      AutoModeAllowed : Bool;   // TRUE = auto mode is permitted (all interlocks satisfied)
      ManualModeActive : Bool;   // TRUE = system is in manual/jog/local maintenance mode
      ReqFlash_RTE_Lamp : Bool;
      ReqFlash_ResetLamp : Bool;
      ReqFlash_RestartLamp : Bool;
      RestartLampSteadyOn : Bool;
      RTE_LampSteadyOn : Bool;
   END_VAR

   VAR 
      RTE_PB_Rising : Bool;   // edge memory for RTE_PB
      Reset_PB_Rising : Bool;   // edge memory for Reset_PB
      Restart_PB_Rising : Bool;   // edge memory for Restart_PB
      T_Delay_DB {InstructionName := 'TON_TIME'; LibVersion := '1.0'} : TON_TIME;
      EStop_Pressed : Bool;
      PLCInitialization : Bool;
   END_VAR

   VAR_TEMP 
      RTE_PB_Edge_M : Bool;   // temp for R_TRIG-style edge detection
      Reset_PB_Edge_M : Bool;
      Restart_PB_Edge_M : Bool;
   END_VAR

   VAR CONSTANT 
      AUTO_RUNNING : UInt := 0;
      RTE_REQUESTED : UInt := 1;
      SAFE_BYPASS : UInt := 2;
      SAFE_TO_UNLOCK : UInt := 3;
      ACCESS_MANUAL_MODE : UInt := 4;
      READY_TO_RESET : UInt := 5;
      RESETTING : UInt := 6;
      READY_TO_RESTART : UInt := 7;
   END_VAR


BEGIN
	#RTE_PB_Rising := #RTE_PB AND NOT #RTE_PB_Edge_M;
	#Reset_PB_Rising := #Reset_PB AND NOT #Reset_PB_Edge_M;
	#Restart_PB_Rising := #Restart_PB AND NOT #Restart_PB_Edge_M;
	
	#RTE_PB_Edge_M := #RTE_PB;
	#Reset_PB_Edge_M := #Reset_PB;
	#Restart_PB_Edge_M := #Restart_PB;
	
	IF #Reset THEN
	    #CurrentState := #AUTO_RUNNING;
	END_IF;
	
	// Emergency Access
	// 
	IF "FirstScan" THEN
	    #PLCInitialization := TRUE;
	ELSIF "Reset_All" AND #NoEStop THEN
	    #PLCInitialization := FALSE;
	END_IF;
	    
	IF NOT #PLCInitialization THEN
	    IF NOT #NoEStop AND NOT #EStop_Pressed THEN
	        #CurrentState := #SAFE_TO_UNLOCK;
	        #EStop_Pressed := TRUE;
	    ELSIF #NoEStop THEN
	        #EStop_Pressed := FALSE;
	    END_IF;
	END_IF;
	
	CASE #CurrentState OF
	        
	    #AUTO_RUNNING:
	        IF #RTE_PB_Rising THEN
	            #CurrentState := #RTE_REQUESTED;
	        END_IF;
	        
	    #RTE_REQUESTED:
	        IF #AllDevicesStopped THEN
	            #CurrentState := #SAFE_BYPASS;
	        END_IF;
	        
	    #SAFE_BYPASS:
	        IF #Safe_Bypassed THEN
	            #T_Delay_DB(IN:=TRUE,
	                        PT:=T#500MS);
	            IF #T_Delay_DB.Q THEN
	                #T_Delay_DB(IN := FALSE,
	                            PT := T#0MS);
	                #CurrentState := #SAFE_TO_UNLOCK;
	            END_IF;
	        END_IF;
	        
	    #SAFE_TO_UNLOCK:
	        // Solenoid is now de-energised->energised per GateUnlockPermissive,
	        // which physically frees the mechanism so the operator can rotate
	        // the manual handle. Transition to manual mode once the gate is
	        // actually opened.
	        IF NOT #GateClosed THEN
	            #CurrentState := #ACCESS_MANUAL_MODE;
	        END_IF;
	        
	    #ACCESS_MANUAL_MODE:
	        // Gate physically closed again (handle rotated back, solenoid
	        // still energised/unlocked at this point - lock only re-engages
	        // in RESETTING once Reset is pressed).
	        IF #GateClosed THEN
	            #CurrentState := #READY_TO_RESET;
	        END_IF;
	        
	    #READY_TO_RESET:
	        IF #Reset_PB_Rising THEN
	            #CurrentState := #RESETTING;
	        END_IF;
	        
	    #RESETTING:
	        // Lock is commanded via GateUnlockPermissive=FALSE
	        // (see output mapping below); wait for GS1/GS2 to
	        // confirm locked before allowing restart readiness.
	        IF #GateLockedFeedback AND #SafetyResetDone AND #NoVTDLocalMode AND NOT #GateFault AND #AllDrivesHealthy THEN
	            #CurrentState := #READY_TO_RESTART;
	        END_IF;
	        
	    #READY_TO_RESTART:
	        IF #Restart_PB_Rising
	            AND #NoEStop
	            AND NOT #GateFault
	            AND #AllDrivesHealthy
	            AND #NoVTDLocalMode
	            AND #NoCrossoverPaused THEN
	            #CurrentState := #AUTO_RUNNING;
	        END_IF;
	        
	END_CASE;
	
	// ------------------------------------------------------
	// OUTPUT MAPPING
	// ------------------------------------------------------
	// GateUnlockPermissive drives O_S1_SolenoidEnergise (assumed
	// energise=unlock) in FB_GateAccessControl. In RESETTING /
	// READY_TO_RESTART / AUTO_RUNNING the gate must be LOCKED,
	// so permissive is FALSE (commands lock, per assumption).
	#GateUnlockPermissive := (#CurrentState = #SAFE_TO_UNLOCK)
	OR (#CurrentState = #ACCESS_MANUAL_MODE)
	// OR (#CurrentState = #READY_TO_RESET)
	;
	
	#StopNewAutoCycles := NOT (#CurrentState = #AUTO_RUNNING);
	#ManualModeActive := (#CurrentState = #ACCESS_MANUAL_MODE);
	
	#AutoModeAllowed := (#CurrentState = #AUTO_RUNNING)
	AND #GateClosed
	AND #GateLockedFeedback
	AND #NoEStop
	AND NOT #GateFault
	// AND #NoVTDLocalMode
	AND #NoCrossoverPaused
	AND #AllDrivesHealthy
	AND #SafetyResetDone;
	
	#RestartLampSteadyOn := (#CurrentState = #AUTO_RUNNING);
	#RTE_LampSteadyOn := (#CurrentState = #SAFE_TO_UNLOCK);
	#ReqFlash_RTE_Lamp := (#CurrentState = #RTE_REQUESTED) AND "Clock_1Hz";
	#ReqFlash_ResetLamp := (#CurrentState = #READY_TO_RESET);
	#ReqFlash_RestartLamp := (#CurrentState = #READY_TO_RESTART);
END_FUNCTION_BLOCK

DATA_BLOCK "Control_DB"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
NON_RETAIN
   VAR 
      ECnv_Sys : Array[1..5] of "ECnv_Control";
      LCnv_Sys : Array[1..5] of "Cnv_VTD_Control";
      VTD_Sys : Array[1..5] of "VTD_Control";
      WCS_OPC_Control : Array[1..5] of "WMS_OPC_UA";
      Shuttles_Position : Array[1..23] of Struct
         x : DInt;
         y : DInt;
         Charging : Bool;
      END_STRUCT;
      VTDBarcode_Station { S7_SetPoint := 'False'} : Array[1..5] of "Barcode_Station_UDT";
      Pallet_ID_Received : Array[1..3] of Bool;
      Gate_Station { S7_SetPoint := 'False'} : Array[1..12] of "Gate_Station_UDT";
   END_VAR


BEGIN
   LCnv_Sys[4].Cnv_Level[1].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[2].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[3].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[4].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[5].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[6].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[7].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[4].Cnv_Level[8].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[1].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[2].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[3].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[4].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[5].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[6].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[7].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;
   LCnv_Sys[5].Cnv_Level[8].Cnv2.Safety_Stop_Cnrl.Inputs.DP_Extended := TRUE;

END_DATA_BLOCK

FUNCTION_BLOCK "GateAccess_Station_FB"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1
   VAR_INPUT 
      Sys_No : UInt;
      Right_True { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      Switches { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Byte;
      GateLockedFeedback : Bool;
      NoEStop : Bool;
      I_G1_GuardOpen : Bool;
      I_L1_Unlocked : Bool;
      FaultResetCmd : Bool;
      AllDrivesHealthy : Bool;
      SafetyResetDone : Bool;
      NoVTDLocalMode : Bool;
      NoCrossoverPaused : Bool;
      Safe_Bypassed : Bool;
      LGX_Secure_Access : Bool;
      AllDevicesStopped : Bool;
   END_VAR

   VAR_OUTPUT 
      Lamps { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Byte;
      O_S1_SolenoidEnergise : Bool;
      "Lock Reset" { ExternalAccessible := 'False'; ExternalVisible := 'False'; ExternalWritable := 'False'} : Bool;
      CurrentState : UInt;
      GateFault : Bool;
   END_VAR

   VAR_IN_OUT 
      Gate_Station : "Gate_Station_UDT";
   END_VAR

   VAR 
      RTE_PB : Bool;
      Reset_PB : Bool;
      Restart_PB : Bool;
      GateAccessControl { S7_SetPoint := 'False'} : "GateAccessControl_FB";
      ModeManager { S7_SetPoint := 'False'} : "ModeManager_FB";
   END_VAR

   VAR_TEMP 
      i : UInt;
   END_VAR

   VAR CONSTANT 
      AUTO_RUNNING : UInt := 0;
      RTE_REQUESTED : UInt := 1;
      SAFE_TO_UNLOCK : UInt := 3;
      ACCESS_MANUAL_MODE : UInt := 4;
      RESETTING : UInt := 6;
   END_VAR


BEGIN
	// IF #Right_True THEN
	//     // #Switches
	//     #Reset_PB := #Switches.%X1; //Blue button - Restart_PB
	//     #Restart_PB := #Switches.%X2; //White button - Reset_PB
	//     #RTE_PB := #Switches.%X3; //Green button - RTE_PB
	// ELSE
	// //     //Switches
	//     #Restart_PB := #Switches.%X1; //White button - Reset_PB
	//     #Reset_PB := #Switches.%X2; //Blue button - Restart_PB
	//     #RTE_PB := #Switches.%X3; //Green button - RTE_PB
	// END_IF;
	IF #Right_True THEN
	    // #Switches
	    #Reset_PB := #Switches.%X1; //Blue button - Reset_PB
	    #Restart_PB := #Switches.%X3; //Green button - Restart_PB
	    #RTE_PB := #Switches.%X2; //White button - RTE_PB
	ELSE
	    //Switches
	    #Restart_PB := #Switches.%X3; //Green button - Restart_PB
	    #Reset_PB := #Switches.%X2; //Blue button - Reset_PB
	    #RTE_PB := #Switches.%X1; //White button - RTE_PB
	END_IF;
	
	// ------------------------------------------------------
	// Step 1: run the hardware interface FB, feeding it the
	// consolidated safety signals read directly from
	// DB_SafetyLogic for this gate. GateClosed and
	// ForceRTE_Request come out ready for ModeManager below.
	// ------------------------------------------------------
	#GateAccessControl(
	                   UnlockPermissive := #ModeManager.GateUnlockPermissive,
	                   FaultResetCmd := #FaultResetCmd,
	                   I_G1_GuardOpen := #I_G1_GuardOpen,
	                   I_L1_Unlocked := #I_L1_Unlocked,
	                   GateLockedFeedback := #GateLockedFeedback,
	                   NoEStop := #NoEStop
	);
	
	// ------------------------------------------------------
	// Step 2: run the mode state machine, feeding it the
	// fresh feedback from GateAccessControl plus the same
	// consolidated safety signals and cross-subsystem
	// interlocks.
	// ------------------------------------------------------
	#ModeManager(
	             RTE_PB := #RTE_PB,
	             Reset_PB := #Reset_PB,
	             Restart_PB := #Restart_PB,
	             GateClosed := #GateAccessControl.GateClosed,
	             GateLockedFeedback := #GateLockedFeedback,
	             GateFault := #GateAccessControl.GateFault,
	             NoEStop := #NoEStop,
	             AllDrivesHealthy := #AllDrivesHealthy,
	             SafetyResetDone := #SafetyResetDone,
	             NoVTDLocalMode := #NoVTDLocalMode,
	             NoCrossoverPaused := #NoCrossoverPaused,
	             AllDevicesStopped := #Gate_Station.Secure_Access AND #AllDevicesStopped AND #LGX_Secure_Access,
	             Safe_Bypassed := #Safe_Bypassed,
	             ForceRTE := #GateAccessControl.ForceRTE_Request,
	             Reset := #FaultResetCmd
	);
	
	// ------------------------------------------------------
	// Step 3: expose local outputs for the physical wiring.
	// ------------------------------------------------------
	#O_S1_SolenoidEnergise := #GateAccessControl.O_S1_SolenoidEnergise;
	#CurrentState := #ModeManager.CurrentState;
	#GateFault := #GateAccessControl.GateFault;
	
	//Send all devices to automatic mode
	IF #ModeManager.CurrentState = #RESETTING AND #Sys_No <> 0 THEN
	    FOR #i := "Settings_DB".VTD_Sys[#Sys_No].Lowest_Level TO "Settings_DB".VTD_Sys[#Sys_No].Highest_Level DO
	        "Control_DB".VTD_Sys[#Sys_No].Instruction.Reset :=
	        "Control_DB".ECnv_Sys[#Sys_No].Instruction.Reset :=
	        "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv1.Instruction.Reset :=
	        "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv2.Instruction.Reset := TRUE;
	    END_FOR;
	    
	    IF #AllDrivesHealthy THEN
	        FOR #i := "Settings_DB".VTD_Sys[#Sys_No].Lowest_Level TO "Settings_DB".VTD_Sys[#Sys_No].Highest_Level DO
	            "Control_DB".VTD_Sys[#Sys_No].Instruction.Reset :=
	            "Control_DB".ECnv_Sys[#Sys_No].Instruction.Reset :=
	            "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv1.Instruction.Reset :=
	            "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv2.Instruction.Reset := FALSE;
	        END_FOR;
	        
	        FOR #i := "Settings_DB".VTD_Sys[#Sys_No].Lowest_Level TO "Settings_DB".VTD_Sys[#Sys_No].Highest_Level DO
	            "Control_DB".VTD_Sys[#Sys_No].Instruction.Mode_Change :=
	            "Control_DB".ECnv_Sys[#Sys_No].Instruction.Mode_Change :=
	            "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv1.Instruction.Mode_Change :=
	            "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv2.Instruction.Mode_Change :=
	            "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv1.Safety_Stop_Cnrl.Mode :=
	            "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv2.Safety_Stop_Cnrl.Mode := 3;
	            
	            "Control_DB".VTD_Sys[#Sys_No].Instruction.Enable :=
	            "Control_DB".ECnv_Sys[#Sys_No].Instruction.Enable :=
	            "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv1.Instruction.Enable :=
	            "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv2.Instruction.Enable := TRUE;
	        END_FOR;
	    END_IF;
	END_IF;
	
	//Send all devices to manual mode
	IF #ModeManager.CurrentState = #ACCESS_MANUAL_MODE AND #Sys_No <> 0 THEN
	    FOR #i := "Settings_DB".VTD_Sys[#Sys_No].Lowest_Level TO "Settings_DB".VTD_Sys[#Sys_No].Highest_Level DO
	        "Control_DB".VTD_Sys[#Sys_No].Instruction.Mode_Change :=
	        "Control_DB".ECnv_Sys[#Sys_No].Instruction.Mode_Change :=
	        "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv1.Instruction.Mode_Change :=
	        "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv2.Instruction.Mode_Change :=
	        "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv1.Safety_Stop_Cnrl.Mode :=
	        "Control_DB".LCnv_Sys[#Sys_No].Cnv_Level[#i].Cnv2.Safety_Stop_Cnrl.Mode := 1;
	    END_FOR;
	END_IF;
	
	// IF #Right_True THEN
	//     #Lamps.%X0 := (NOT #NoEStop OR #GateAccessControl.GateFault) AND "Clock_1Hz"; //Estop lamp
	//     #Lamps.%X2 := #ModeManager.ReqFlash_RestartLamp AND "Clock_1Hz"; //White lamp - Restart_PB
	//     #Lamps.%X1 := #ModeManager.ReqFlash_ResetLamp AND "Clock_1Hz"; //Blue lamp - Reset_PB
	//     #Lamps.%X3 := #ModeManager.RestartLampSteadyOn OR #ModeManager.ReqFlash_RTE_Lamp; //Green lamp - RTE_PB
	// ELSE
	//     #Lamps.%X0 := (NOT #NoEStop OR #GateAccessControl.GateFault) AND "Clock_1Hz"; //Estop lamp
	//     #Lamps.%X2 := #ModeManager.ReqFlash_ResetLamp  AND "Clock_1Hz"; //Blue lamp - Reset_PB
	//     #Lamps.%X1 := #ModeManager.ReqFlash_RestartLamp AND "Clock_1Hz"; //White lamp - Restart_PB
	//     #Lamps.%X3 := #ModeManager.RestartLampSteadyOn OR #ModeManager.ReqFlash_RTE_Lamp; //Green lamp - RTE_PB
	// END_IF;
	IF #Right_True THEN
	    #Lamps.%X0 := (NOT #NoEStop OR #GateAccessControl.GateFault) AND "Clock_1Hz"; //Estop lamp
	    #Lamps.%X3 := (#ModeManager.ReqFlash_RestartLamp AND "Clock_1Hz") OR #ModeManager.RestartLampSteadyOn; //Green lamp - Restart_PB
	    #Lamps.%X1 := #ModeManager.ReqFlash_ResetLamp AND "Clock_1Hz"; //Blue lamp - Reset_PB
	    #Lamps.%X2 := #ModeManager.ReqFlash_RTE_Lamp OR (#ModeManager.CurrentState = #SAFE_TO_UNLOCK AND NOT #NoEStop) OR #ModeManager.CurrentState = #SAFE_TO_UNLOCK OR #ModeManager.CurrentState = #ACCESS_MANUAL_MODE; //White lamp - RTE_PB
	ELSE
	    #Lamps.%X0 := (NOT #NoEStop OR #GateAccessControl.GateFault) AND "Clock_1Hz"; //Estop lamp
	    #Lamps.%X2 := #ModeManager.ReqFlash_ResetLamp AND "Clock_1Hz"; //Blue lamp - Reset_PB
	    #Lamps.%X3 := (#ModeManager.ReqFlash_RestartLamp AND "Clock_1Hz") OR #ModeManager.RestartLampSteadyOn; //Green lamp - Restart_PB
	    #Lamps.%X1 := #ModeManager.ReqFlash_RTE_Lamp OR (#ModeManager.CurrentState = #SAFE_TO_UNLOCK AND NOT #NoEStop) OR #ModeManager.CurrentState = #SAFE_TO_UNLOCK OR #ModeManager.CurrentState = #ACCESS_MANUAL_MODE; //White lamp - RTE_PB
	END_IF;
	
	//Gate station control
	//
	#Gate_Station.Requested_Access := #ModeManager.CurrentState = #RTE_REQUESTED;
	#Gate_Station.Safe_To_Restart := #ModeManager.RestartLampSteadyOn;
END_FUNCTION_BLOCK

