// Dallas_Production (TIA V20) - read-only reference, converted from SimaticML by Claude 19/10/2026
// UDT layouts come from the FB interfaces (member comments are not exported there).

TYPE "Cnv_Errors"
   STRUCT
      Error_Word_1 : UInt;
      Error_Word_2 : UInt;
      Error_Word_3 : UInt;
      Error_Word_4 : UInt;
   END_STRUCT;
END_TYPE

TYPE "Cnv_Motor"
   STRUCT
      Enable : Bool;
      Enabled : Bool;
      Ready : Bool;
      Forward : Bool;
      Reverse : Bool;
      Speed : Real;
      Speed_Actual : Real;
      Actual_Current : Real;
      Config_Axis : Word;
      Error : Bool;
      Status : Word;
      Communication_Error : Word;
      Lockout : Bool;
   END_STRUCT;
END_TYPE

TYPE "PopUp_Cnv_Inputs"
   STRUCT
      "Lift Up" : Bool;
      "Lift Down" : Bool;
   END_STRUCT;
END_TYPE

TYPE "PopUp_Cnv_Instruction"
   STRUCT
      Mode_Change : UInt;
      Stop : Bool;
      Enable : Bool;
      Reset : Bool;
      Execute : Bool;
      Task_ID : UInt;
      Task_Metadata : String;
      Transfer_To_ID : DInt;
      Transfer_From_ID : DInt;
      Transfer_in_Progress : Bool;
      Inbound_Ready : Bool;
      Transfer_Complete : Bool;
      Outbound_Ready : Bool;
      Start_Transfer : Bool;
      Start_Transfer_Backward : Bool;
      Roller_Fwd : Bool;
      Roller_Bwd : Bool;
      Chain_Fwd : Bool;
      Chain_Bwd : Bool;
      Lift_Up : Bool;
      Lift_Down : Bool;
   END_STRUCT;
END_TYPE

TYPE "PopUp_Cnv_Settings"
   STRUCT
      ID : DInt;
      Roller_TC_Time : UInt;
      Roller_Transfer_Time : UInt;
      Roller_Slow_Speed : UInt;
      Roller_Full_Speed : UInt;
      Roller_Manual_Speed : UInt;
      Chain_TC_Time : UInt;
      Chain_Transfer_Time : UInt;
      Chain_Slow_Speed : UInt;
      Chain_Full_Speed : UInt;
      Chain_Manual_Speed : UInt;
      Lift_TC_Time : UInt;
      Lift_Transfer_Time : UInt;
      Lift_Slow_Speed : UInt;
      Lift_Full_Speed : UInt;
      Lift_Manual_Speed : UInt;
      Roller_G120_Hardware_ID : HW_IO;
      Chain_G120_Hardware_ID : HW_IO;
      Lift_G120_Hardware_ID : HW_IO;
   END_STRUCT;
END_TYPE

TYPE "PopUp_Cnv_Control"
   STRUCT
      Mode : UInt;
      Error : Bool;
      Warning : UInt;
      Enabled : Bool;
      Stopped : Bool;
      Done : Bool;
      Running : Bool;
      Ready_For_Task : Bool;
      Current_Task_Type : UInt;
      Current_Task_ID : UInt;
      Cnv_Occupied : Bool;
      SM_State : UInt;
      Inputs : "PopUp_Cnv_Inputs";
      Roller_Motor : "Cnv_Motor";
      Chain_Motor : "Cnv_Motor";
      Lift_Motor : "Cnv_Motor";
      Instruction : "PopUp_Cnv_Instruction";
      Cnv_Errors : "Cnv_Errors";
   END_STRUCT;
END_TYPE

// ============================================================================
FUNCTION_BLOCK "PConveyor_2_FB"

VAR_INPUT
   Cnv_Settings : "PopUp_Cnv_Settings";
   TimeStartBoost : UInt;
   TimeStartBoost_Roller : UInt;
END_VAR

VAR_IN_OUT
   Cnv_Control : "PopUp_Cnv_Control";
   SinaSpeed_Roller : SinaSpeed;
   SinaSpeed_Chain : SinaSpeed;
   SinaSpeed_Lift : SinaSpeed;
END_VAR

VAR
   State : UInt;
   Timer_TC : TON_TIME;
   Timer_Transfer : TON_TIME;
   Watchdog : TON_TIME;
   Transfer_Direction : String;
   MainSetpoint_Roller : Int;
   MainSetpoint_Chain : Int;
   MainSetpoint_Lift : Int;
   IEC_Timer_0_Instance_1 : TON_TIME;
   R_TRIG_Instance : R_TRIG;
END_VAR

VAR_TEMP
   Execute_Old : Bool;
   Stop_Old : Bool;
END_VAR

BEGIN
"R_TRIG_DB_19"(CLK := #Cnv_Control.Instruction.Execute AND NOT #Execute_Old);
"R_TRIG_DB_20"(CLK := #Cnv_Control.Instruction.Stop AND NOT #Stop_Old);

#Execute_Old := #Cnv_Control.Instruction.Execute;
#Stop_Old := #Cnv_Control.Instruction.Stop;

#Cnv_Control.Enabled := #Cnv_Control.Instruction.Enable;

//MODES
#Cnv_Control.Mode := #Cnv_Control.Instruction.Mode_Change;
IF (#Cnv_Control.Mode = 1 OR #Cnv_Control.Mode = 5) AND NOT #Cnv_Control.Error THEN
    #State := 500;
END_IF;

#R_TRIG_Instance(CLK := #Cnv_Control.Mode = 3);
IF #R_TRIG_Instance.Q THEN
    #State := 0;
END_IF;

(*
TODO:
01. Need to add statemachine watchdog - Done
02. Extractor needs to be on same floor for pallet to be moved in manual passed Rbwd - Done
03. Complete reset state - Done
04. Add stop inputs - Done
05. Need to add variable motor speed, manual needs to be slower. - Done
06. Need to add cyclic error checking. For odd sensor combinations as well - Partially done
07. Need to add Shuttle monitor - Done
08. Need to add Task ID check and start bit check to outbound pallet move. Check direction of pallet movement based on connected Cnv.
09. Need to add checks for wrong direction of travel - Done
10. Add checks for unsafe conditions with Cnv_Inputs - Partially Done
11. Define Error codes - DOne
12. Add watchdof time to Cnv Settings - Done
13. Add self-timeout on manual 
14. For shuttle in place sensor checks take into account extractor floor and safety stopper state
15. Confirm modes and states are correct (Semi-auto and maintenance as well)
16. Add the correct transfer process for the logistex-spacemaker pallet handovers.

Mode select is done via the HMI. Might add external mode select switches.
        
        Mode select mask:
        0: Disabled
        1: Manual
        2: Semi-Auto
        3: Auto
        4: Teach - N/A for Cnv
        5: Maintenance
        
Device ID Format: XXYYZZ    
XX = Device type   
    01   VTD
    10  Cnv_Front_of_VTD
    11  Cnv_Rear_of_VTD
    12  Cnv_On_Extractor
    20  Safety_Stop_Front_of_VTD
    21  Safety_Stop_Rear_of_VTD
YY = Floor   
ZZ = VTD Connected to    
Example: 110203 Conveyor at the rear of VTD 3 on level 2

Pallet Alignment
0 = no alignment
1 = center alignment
2 = Left
3 = Right

 Sensor order for the conveyor:
 Lfwd Lpd1 Lpd2
  []   []   []
 ##############################
 #        Pallet Flow         #
 #         ------->>          #
 #                            #
 #                            #
 ##############################
                  []   []   []
                 Rpd2 Rpd1 Rbwd      
*)

REGION Cyclic Checks    

    #Cnv_Control.Cnv_Occupied := "PopUp Conveyor 2 - Pallet present 4";

    
    
    // Update the Cnv_Control opbject
    #Cnv_Control.SM_State := #State;
    #Cnv_Control.Stopped := NOT #Cnv_Control.Running;
    IF #Cnv_Control.Instruction.Inbound_Ready OR #Cnv_Control.Instruction.Outbound_Ready THEN
        #Cnv_Control.Ready_For_Task := TRUE;
    ELSE
        #Cnv_Control.Ready_For_Task := FALSE;
    END_IF;
    
END_REGION

REGION Auto/Semi auto mode
    CASE #State OF
        0: //IDLE MODE
            #Cnv_Control.Instruction.Transfer_Complete := 0;
            #Cnv_Control.Instruction.Transfer_in_Progress := FALSE;
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Roller_Motor.Forward := FALSE;
            #Cnv_Control.Roller_Motor.Reverse := FALSE;
            #Cnv_Control.Roller_Motor.Speed := 0;
            #Cnv_Control.Chain_Motor.Forward := FALSE;
            #Cnv_Control.Chain_Motor.Reverse := FALSE;
            #Cnv_Control.Chain_Motor.Speed := 0;
            #Cnv_Control.Lift_Motor.Forward := FALSE;
            #Cnv_Control.Lift_Motor.Reverse := FALSE;
            #Cnv_Control.Lift_Motor.Speed := 0;
            #Transfer_Direction := '';
            #Timer_Transfer(IN := FALSE,
                            PT := T#0ms);
            "IEC_Timer_0_DB_27".TON(IN := FALSE,
                                    PT := t#0s);
            "IEC_Timer_0_DB_22".TON(IN := FALSE,
                                    PT := t#0s);
            IF #Cnv_Control.Enabled AND (#Cnv_Control.Mode = 3 OR #Cnv_Control.Mode = 2) AND #Cnv_Control.Error = 0 THEN
                #State := 10;
            END_IF;
            
        10: //Standby - Conveyor ready to receive instruction
            IF ("R_TRIG_DB_19".Q OR #Cnv_Control.Instruction.Start_Transfer) THEN
                //Inbound Transfer
                IF #Cnv_Control.Instruction.Inbound_Ready AND NOT #Cnv_Control.Running AND #Cnv_Control.Error = 0 THEN
                    //Check transfer ID FROM VTD
                    IF #Cnv_Control.Instruction.Transfer_From_ID = "Settings_DB".ECnv_Settings.ID AND #Cnv_Control.Inputs."Lift Down" AND "Control_DB".VTD_Control.Current_Level = 0 THEN
                        #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 20;
                    ELSIF #Cnv_Control.Instruction.Transfer_From_ID = "Settings_DB".PopUp_Cnv_Settings[1].ID AND #Cnv_Control.Inputs."Lift Up" THEN //FROM POPUP CONVEYOR 1
                        #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 30;
                    ELSE
                        #Cnv_Control.Warning := 1; //Cannot transfer from that conveyor
                    END_IF;
                    
                    //Outbound Transfer    
                ELSIF #Cnv_Control.Instruction.Outbound_Ready AND NOT #Cnv_Control.Running AND #Cnv_Control.Error = 0 THEN
                    //Check transfer ID TO VTD
                    IF #Cnv_Control.Instruction.Transfer_To_ID = "Settings_DB".ECnv_Settings.ID AND "Control_DB".VTD_Control.Current_Level = 0 THEN
                        #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 40;
                    ELSIF #Cnv_Control.Instruction.Transfer_To_ID = "Settings_DB".PopUp_Cnv_Settings[3].ID THEN //TO POPUP CONVEYOR 3
                        #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 50;
                    ELSE
                        #Cnv_Control.Warning := 1; //Cannot transfer TO that conveyor
                    END_IF;
                ELSE
                    #Cnv_Control.Warning := 0;// No task that can be started, yet start bit has been made true.
                END_IF;
            ELSIF #Cnv_Control.Instruction.Start_Transfer AND "Control_DB".VTD_Control.Current_Level <> 0 AND #Cnv_Control.Inputs."Lift Down" THEN
                //Extractor not at the correct level
                Set_Bit_F(Bit := 2,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_3);
            END_IF;
            IF #Cnv_Control.Instruction.Lift_Up THEN
                #Cnv_Control.Done := FALSE;
                #State := 60; // Lift UP
            ELSIF #Cnv_Control.Instruction.Lift_Down THEN
                #Cnv_Control.Done := FALSE;
                #State := 70; // Lift Down
            END_IF;
            
            //----------------------- Pallet Movement Inbound-----------------------
        20: // Chain Running (From VTD)
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Chain_Motor.Reverse := TRUE;
            #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Full_Speed;
            #Transfer_Direction := 'Backward';
            
            IF "R_TRIG_DB_20".Q OR NOT "PopUp Conveyor 2 - Pallet present 5" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Chain_Motor.Forward := FALSE;
                #Cnv_Control.Chain_Motor.Reverse := FALSE;
                #Cnv_Control.Chain_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Chain_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        30: // Roller Running (From Popup Up 1)
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Roller_Motor.Forward := TRUE;
            
            "IEC_Timer_0_DB_27".TON(IN := TRUE,
                                    PT := UINT_TO_TIME(#TimeStartBoost_Roller) * 1000);
            
            IF NOT "IEC_Timer_0_DB_27".Q THEN
                #Cnv_Control.Roller_Motor.Speed := 100.0;
            ELSE
                #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Full_Speed;
            END_IF;
            
            #Transfer_Direction := 'Foward';
            
            IF "R_TRIG_DB_20".Q OR "PopUp Conveyor 2 - Pallet present 4" THEN
                "IEC_Timer_0_DB_27".TON(IN := FALSE,
                                        PT := t#0s);
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Roller_Motor.Forward := FALSE;
                #Cnv_Control.Roller_Motor.Reverse := FALSE;
                #Cnv_Control.Roller_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Roller_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
            //----------------------- Pallet Movement Outbound -----------------------
        40: // Chain Running (Popup Down)
            IF "Control_DB".ECnv_Control.Motor.Status.%X0 THEN
                #Cnv_Control.Running := TRUE;
                #Cnv_Control.Chain_Motor.Forward := TRUE;
                #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Full_Speed;
                #Transfer_Direction := 'Foward';
            END_IF;
            
            IF "R_TRIG_DB_20".Q OR "Control_DB".ECnv_Control.Cnv_Occupied THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Chain_Motor.Forward := FALSE;
                #Cnv_Control.Chain_Motor.Reverse := FALSE;
                #Cnv_Control.Chain_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Chain_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        50: // Chain Running (Popup Down)
            IF "Control_DB".PopUp_Cnv[3].Chain_Motor.Status.%X0 THEN
                #Cnv_Control.Running := TRUE;
                #Cnv_Control.Chain_Motor.Reverse := TRUE;
                "IEC_Timer_0_DB_22".TON(IN:=TRUE,
                                        PT:=UINT_TO_TIME(#TimeStartBoost) * 1000);
                IF NOT "IEC_Timer_0_DB_22".Q THEN
                    #Cnv_Control.Chain_Motor.Speed := 100.0;
                ELSE
                    #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Full_Speed;
                END_IF;
                
                #Transfer_Direction := 'Backward';
            END_IF;
            
            IF "R_TRIG_DB_20".Q OR NOT "PopUp Conveyor 3 - Pallet present 1" THEN
                "IEC_Timer_0_DB_22".TON(IN := FALSE,
                                        PT := t#0s);
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Chain_Motor.Forward := FALSE;
                #Cnv_Control.Chain_Motor.Reverse := FALSE;
                #Cnv_Control.Chain_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Chain_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        60: // Lift Up
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Lift_Motor.Forward := TRUE;
            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Full_Speed;
            #Transfer_Direction := 'Up';
            
            IF #Cnv_Control.Inputs."Lift Up" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Lift_Motor.Forward := FALSE;
                #Cnv_Control.Lift_Motor.Reverse := FALSE;
                #Cnv_Control.Lift_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Lift_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        70: // Lift Down
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Lift_Motor.Reverse := TRUE;
            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Full_Speed;
            #Transfer_Direction := 'Down';
            
            IF #Cnv_Control.Inputs."Lift Down" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Lift_Motor.Forward := FALSE;
                #Cnv_Control.Lift_Motor.Reverse := FALSE;
                #Cnv_Control.Lift_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Lift_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        400: //Error state
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Roller_Motor.Speed := 0;
            #Cnv_Control.Chain_Motor.Speed := 0;
            #Cnv_Control.Lift_Motor.Speed := 0;
            #Cnv_Control.Roller_Motor.Forward := FALSE;
            #Cnv_Control.Chain_Motor.Forward := FALSE;
            #Cnv_Control.Lift_Motor.Forward := FALSE;
            #Cnv_Control.Roller_Motor.Reverse := FALSE;
            #Cnv_Control.Chain_Motor.Reverse := FALSE;
            #Cnv_Control.Lift_Motor.Reverse := FALSE;
            #Cnv_Control.Instruction.Stop := FALSE;
            #Cnv_Control.Instruction.Transfer_in_Progress := FALSE;
            #Watchdog(IN := FALSE,
                      PT := T#0S);
            #Timer_TC(IN := FALSE,
                      PT := T#0S);
            #Timer_Transfer(IN := FALSE,
                            PT := T#0S);
            #IEC_Timer_0_Instance_1(IN := FALSE,
                                    PT := T#0S);
            IF #Cnv_Control.Instruction.Reset THEN
                #Cnv_Control.Warning := 0;
                #Cnv_Control.Current_Task_ID := 0;
                #Cnv_Control.Error := FALSE; //Reset the conveyor
                
                #Cnv_Control.Cnv_Errors.Error_Word_1 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_2 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_3 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_4 := 0;
                #State := 0;
            END_IF;
            
        500:
            IF #Cnv_Control.Enabled THEN
                REGION ROLLER
                    IF #Cnv_Control.Inputs."Lift Up" AND NOT #Cnv_Control.Inputs."Lift Down" THEN
                        IF #Cnv_Control.Instruction.Roller_Fwd OR #Cnv_Control.Instruction.Start_Transfer THEN
                            #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Manual_Speed;
                            #Cnv_Control.Roller_Motor.Forward := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSIF #Cnv_Control.Instruction.Roller_Bwd OR #Cnv_Control.Instruction.Start_Transfer_Backward THEN
                            #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Manual_Speed;
                            #Cnv_Control.Roller_Motor.Reverse := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSE
                            #Cnv_Control.Roller_Motor.Speed := 0;
                            #Cnv_Control.Roller_Motor.Forward := FALSE;
                            #Cnv_Control.Roller_Motor.Reverse := FALSE;
                            #Cnv_Control.Running := FALSE;
                        END_IF;
                    END_IF;
                END_REGION
                
                REGION CHAIN
                    IF NOT #Cnv_Control.Inputs."Lift Up" AND #Cnv_Control.Inputs."Lift Down" THEN
                        IF #Cnv_Control.Instruction.Chain_Fwd OR #Cnv_Control.Instruction.Start_Transfer_Backward THEN
                            #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Manual_Speed;
                            #Cnv_Control.Chain_Motor.Forward := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSIF #Cnv_Control.Instruction.Chain_Bwd OR #Cnv_Control.Instruction.Start_Transfer THEN
                            #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Manual_Speed;
                            #Cnv_Control.Chain_Motor.Reverse := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSE
                            #Cnv_Control.Chain_Motor.Speed := 0;
                            #Cnv_Control.Chain_Motor.Forward := FALSE;
                            #Cnv_Control.Chain_Motor.Reverse := FALSE;
                            #Cnv_Control.Running := FALSE;
                        END_IF;
                    END_IF;
                END_REGION
                
                REGION LIFT
                    IF NOT #SinaSpeed_Roller.AxisEnabled AND NOT #SinaSpeed_Chain.AxisEnabled THEN
                        IF #Cnv_Control.Instruction.Lift_Up AND NOT #Cnv_Control.Inputs."Lift Up" THEN
                            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Manual_Speed;
                            #Cnv_Control.Lift_Motor.Forward := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSIF #Cnv_Control.Instruction.Lift_Down AND NOT #Cnv_Control.Inputs."Lift Down" THEN
                            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Manual_Speed;
                            #Cnv_Control.Lift_Motor.Reverse := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSE
                            #Cnv_Control.Lift_Motor.Speed := 0;
                            #Cnv_Control.Lift_Motor.Forward := FALSE;
                            #Cnv_Control.Lift_Motor.Reverse := FALSE;
                            #Cnv_Control.Running := FALSE;
                        END_IF;
                    END_IF;
                END_REGION
            END_IF;
            
            IF #Cnv_Control.Mode <> 1 AND #Cnv_Control.Mode <> 5 THEN
                #State := 0;
            END_IF;
    END_CASE;
END_REGION



REGION Cyclic Error Checks
    IF NOT "Main_Safety_RTG1_DB".SAFETY_OK_CAROUSEL THEN //11:1
        Set_Bit_F(Bit := 0,
                    Bit_Value := 1,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_1);
    END_IF;
    
    // IF #Cnv_Control.Instruction.Stop THEN //11:2
    //     "Set_Bit_F"(Bit := 1,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_1);
    // END_IF;
    
    IF #Cnv_Control.Roller_Motor.Error OR #Cnv_Control.Chain_Motor.Error OR #Cnv_Control.Lift_Motor.Error THEN
        Set_Bit_F(Bit := 0,
                    Bit_Value := 1,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    END_IF;
    
    // Pallet Sensor Checks
    // IF #Cnv_Control.Inputs.Lfwd AND #Cnv_Control.Inputs.Rbwd THEN
    //     #Cnv_Control.Error := TRUE; //15:2 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 1,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // IF #Cnv_Control.Inputs.Lfwd AND #Cnv_Control.Inputs.Lpd1 AND #Cnv_Control.Inputs.Rpd1 THEN
    //     #Cnv_Control.Error := TRUE; //15:3 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 2,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // ELSIF #Cnv_Control.Inputs.Rbwd AND #Cnv_Control.Inputs.Lpd1 AND #Cnv_Control.Inputs.Rpd1 THEN
    //     #Cnv_Control.Error := TRUE; //15:4 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 3,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // END_IF;
    
    // Shuttle in Place Cnv_Inputs - Need to confirm the order of these Cnv_Inputs.
    // IF (#Cnv_Settings.ID > 110000 AND #Cnv_Settings.ID < 120000 AND NOT #Cnv_Control.Inputs.Sdetect1 AND #Cnv_Control.Inputs.Sdetect2)
    //     OR (#Cnv_Settings.ID > 120000 AND #Cnv_Settings.ID < 130000 AND NOT #Cnv_Control.Inputs.Sdetect1 AND #Cnv_Control.Inputs.Sdetect2) THEN
    //     #Cnv_Control.Error := TRUE; //14:5 Shuttle is about to yeet itself down the VTD shaft
    //     "Set_Bit_F"(Bit := 7,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
    //     #State := 400;
    // END_IF;
    
    // IF (#Cnv_Settings.ID > 110000 AND #Cnv_Settings.ID < 120000 AND #Cnv_Control.Inputs.Sdetect1 AND NOT #Cnv_Control.Inputs.Sdetect2)
    //     OR (#Cnv_Settings.ID > 120000 AND #Cnv_Settings.ID < 130000 AND #Cnv_Control.Inputs.Sdetect1 AND NOT #Cnv_Control.Inputs.Sdetect2) THEN
    //     #Cnv_Control.Warning := 0; //Shuttle detected in conveyor not yet on barcode
    // END_IF;
    
    // // #Watchdog auto starts the moment Any form OF transfer occurs.
    // IF #State > 10 AND #State < 400 THEN
    //     #Watchdog(IN := TRUE,
    //               PT := T#200s);
    // ELSE
    //     #Watchdog.IN := FALSE;
    // END_IF;
    
    // IF #Watchdog.Q THEN
    //     #Watchdog.IN := FALSE;
    //     #Cnv_Control.Error := TRUE; //14:2  Watchdog bit
    //     "Set_Bit_F"(Bit := 4,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
    //     #State := 400;
    // END_IF;
    
    // go to error state
    IF #Cnv_Control.Cnv_Errors.Error_Word_1 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_2 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_3 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_4 <> 0
    THEN
        #Cnv_Control.Error := TRUE;
        #State := 400;
    END_IF;
END_REGION

REGION VFD
    REGION ROLLER
        #Cnv_Control.Roller_Motor.Ready := NOT #Cnv_Control.Roller_Motor.Error;
        
        #SinaSpeed_Roller(EnableAxis := #Cnv_Control.Roller_Motor.Forward OR #Cnv_Control.Roller_Motor.Reverse,
                          AckError := #Cnv_Control.Instruction.Reset,
                          SpeedSp := #MainSetpoint_Roller,
                          RefSpeed := 1745.0,
                          HWIDSTW := #Cnv_Settings.Roller_G120_Hardware_ID,
                          HWIDZSW := #Cnv_Settings.Roller_G120_Hardware_ID,
                          AxisEnabled => #Cnv_Control.Roller_Motor.Status.%X0,
                          Lockout => #Cnv_Control.Roller_Motor.Error,
                          Error => #Cnv_Control.Roller_Motor.Error);
        
        //MAIN SETPOINT
        IF #Cnv_Control.Roller_Motor.Reverse THEN
            #MainSetpoint_Roller := (SCALE_X(MIN := 0,
                                             VALUE := NORM_X(MIN := 0,
                                                             VALUE := #Cnv_Control.Roller_Motor.Speed,
                                                             MAX := 100),
                                             MAX := 1745.0) * -1);
        ELSIF #Cnv_Control.Roller_Motor.Forward THEN
            #MainSetpoint_Roller := SCALE_X(MIN := 0,
                                            VALUE := NORM_X(MIN := 0,
                                                            VALUE := #Cnv_Control.Roller_Motor.Speed,
                                                            MAX := 100),
                                            MAX := 1745.0);
        ELSE
            #MainSetpoint_Roller := 0;
        END_IF;
        
        REGION Actual Speed
            IF #MainSetpoint_Roller > 0 THEN
                #Cnv_Control.Roller_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                  VALUE := NORM_X(MIN := 0,
                                                                                  VALUE := #SinaSpeed_Roller.ActVelocity,
                                                                                  MAX := 1745.0),
                                                                  MAX := 100);
            ELSIF #MainSetpoint_Roller < 0 THEN
                #Cnv_Control.Roller_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                  VALUE := NORM_X(MIN := 0,
                                                                                  VALUE := #SinaSpeed_Roller.ActVelocity * -1,
                                                                                  MAX := 1745.0),
                                                                  MAX := 100);
            ELSE
                #Cnv_Control.Roller_Motor.Speed_Actual := 0;
            END_IF;
        END_REGION
    END_REGION
    
    REGION CHAIN
        #Cnv_Control.Chain_Motor.Ready := NOT #Cnv_Control.Chain_Motor.Error;
        
        #SinaSpeed_Chain(EnableAxis := #Cnv_Control.Chain_Motor.Forward OR #Cnv_Control.Chain_Motor.Reverse,
                         AckError := #Cnv_Control.Instruction.Reset,
                         SpeedSp := #MainSetpoint_Chain,
                         RefSpeed := 1745.0,
                         HWIDSTW := #Cnv_Settings.Chain_G120_Hardware_ID,
                         HWIDZSW := #Cnv_Settings.Chain_G120_Hardware_ID,
                         AxisEnabled => #Cnv_Control.Chain_Motor.Status.%X0,
                         Lockout => #Cnv_Control.Chain_Motor.Error,
                         Error => #Cnv_Control.Chain_Motor.Error);
        
        //MAIN SETPOINT
        IF #Cnv_Control.Chain_Motor.Forward THEN
            #MainSetpoint_Chain := (SCALE_X(MIN := 0,
                                            VALUE := NORM_X(MIN := 0,
                                                            VALUE := #Cnv_Control.Chain_Motor.Speed,
                                                            MAX := 100),
                                            MAX := 1745.0) * -1);
        ELSIF #Cnv_Control.Chain_Motor.Reverse THEN
            #MainSetpoint_Chain := SCALE_X(MIN := 0,
                                           VALUE := NORM_X(MIN := 0,
                                                           VALUE := #Cnv_Control.Chain_Motor.Speed,
                                                           MAX := 100),
                                           MAX := 1745.0);
        ELSE
            #MainSetpoint_Chain := 0;
        END_IF;
        
        REGION Actual Speed
            IF #MainSetpoint_Chain > 0 THEN
                #Cnv_Control.Chain_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                 VALUE := NORM_X(MIN := 0,
                                                                                 VALUE := #SinaSpeed_Chain.ActVelocity,
                                                                                 MAX := 1745.0),
                                                                 MAX := 100);
            ELSIF #MainSetpoint_Chain < 0 THEN
                #Cnv_Control.Chain_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                 VALUE := NORM_X(MIN := 0,
                                                                                 VALUE := #SinaSpeed_Chain.ActVelocity * -1,
                                                                                 MAX := 1745.0),
                                                                 MAX := 100);
            ELSE
                #Cnv_Control.Chain_Motor.Speed_Actual := 0;
            END_IF;
        END_REGION
    END_REGION
    
    REGION LIFT
        #Cnv_Control.Lift_Motor.Ready := NOT #Cnv_Control.Lift_Motor.Error;
        
        #SinaSpeed_Lift(EnableAxis := #Cnv_Control.Lift_Motor.Forward OR #Cnv_Control.Lift_Motor.Reverse,
                        AckError := #Cnv_Control.Instruction.Reset,
                        SpeedSp := #MainSetpoint_Lift,
                        RefSpeed := 1745.0,
                        HWIDSTW := #Cnv_Settings.Lift_G120_Hardware_ID,
                        HWIDZSW := #Cnv_Settings.Lift_G120_Hardware_ID,
                        AxisEnabled => #Cnv_Control.Lift_Motor.Status.%X0,
                        Lockout => #Cnv_Control.Lift_Motor.Error,
                        Error => #Cnv_Control.Lift_Motor.Error);
        
        //MAIN SETPOINT
        IF #Cnv_Control.Lift_Motor.Reverse THEN
            #MainSetpoint_Lift := (SCALE_X(MIN := 0,
                                           VALUE := NORM_X(MIN := 0,
                                                           VALUE := #Cnv_Control.Lift_Motor.Speed,
                                                           MAX := 100),
                                           MAX := 1745.0) * -1);
        ELSIF #Cnv_Control.Lift_Motor.Forward THEN
            #MainSetpoint_Lift := SCALE_X(MIN := 0,
                                          VALUE := NORM_X(MIN := 0,
                                                          VALUE := #Cnv_Control.Lift_Motor.Speed,
                                                          MAX := 100),
                                          MAX := 1745.0);
        ELSE
            #MainSetpoint_Lift := 0;
        END_IF;
        
        REGION Actual Speed
            IF #MainSetpoint_Lift > 0 THEN
                #Cnv_Control.Lift_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                VALUE := NORM_X(MIN := 0,
                                                                                VALUE := #SinaSpeed_Lift.ActVelocity,
                                                                                MAX := 1745.0),
                                                                MAX := 100);
            ELSIF #MainSetpoint_Lift < 0 THEN
                #Cnv_Control.Lift_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                VALUE := NORM_X(MIN := 0,
                                                                                VALUE := #SinaSpeed_Lift.ActVelocity * -1,
                                                                                MAX := 1745.0),
                                                                MAX := 100);
            ELSE
                #Cnv_Control.Lift_Motor.Speed_Actual := 0;
            END_IF;
        END_REGION
    END_REGION
END_REGION
END_FUNCTION_BLOCK

// ============================================================================
FUNCTION_BLOCK "PConveyor_1_FB"

VAR_INPUT
   Cnv_Settings : "PopUp_Cnv_Settings";
   TimeStartBoost_Roller : UInt;
END_VAR

VAR_IN_OUT
   Cnv_Control : "PopUp_Cnv_Control";
   SinaSpeed_Roller : SinaSpeed;
   SinaSpeed_Lift : SinaSpeed;
END_VAR

VAR
   State : UInt;
   Timer_TC : TON_TIME;
   Timer_Transfer : TON_TIME;
   Watchdog : TON_TIME;
   Transfer_Direction : String;
   MainSetpoint_Roller : Int;
   MainSetpoint_Lift : Int;
   IEC_Timer_0_Instance_1 : TON_TIME;
   R_TRIG_Instance : R_TRIG;
END_VAR

VAR_TEMP
   Execute_Old : Bool;
   Stop_Old : Bool;
END_VAR

BEGIN
"R_TRIG_DB_13"(CLK := #Cnv_Control.Instruction.Execute AND NOT #Execute_Old);
"R_TRIG_DB_14"(CLK := #Cnv_Control.Instruction.Stop AND NOT #Stop_Old);

#Execute_Old := #Cnv_Control.Instruction.Execute;
#Stop_Old := #Cnv_Control.Instruction.Stop;

#Cnv_Control.Enabled := #Cnv_Control.Instruction.Enable;

//MODES
#Cnv_Control.Mode := #Cnv_Control.Instruction.Mode_Change;
IF (#Cnv_Control.Mode = 1 OR #Cnv_Control.Mode = 5) AND NOT #Cnv_Control.Error THEN
    #State := 500;
END_IF;

#R_TRIG_Instance(CLK := #Cnv_Control.Mode = 3);
IF #R_TRIG_Instance.Q THEN
    #State := 0;
END_IF;

(*
TODO:
01. Need to add statemachine watchdog - Done
02. Extractor needs to be on same floor for pallet to be moved in manual passed Rbwd - Done
03. Complete reset state - Done
04. Add stop inputs - Done
05. Need to add variable motor speed, manual needs to be slower. - Done
06. Need to add cyclic error checking. For odd sensor combinations as well - Partially done
07. Need to add Shuttle monitor - Done
08. Need to add Task ID check and start bit check to outbound pallet move. Check direction of pallet movement based on connected Cnv.
09. Need to add checks for wrong direction of travel - Done
10. Add checks for unsafe conditions with Cnv_Inputs - Partially Done
11. Define Error codes - DOne
12. Add watchdof time to Cnv Settings - Done
13. Add self-timeout on manual 
14. For shuttle in place sensor checks take into account extractor floor and safety stopper state
15. Confirm modes and states are correct (Semi-auto and maintenance as well)
16. Add the correct transfer process for the logistex-spacemaker pallet handovers.

Mode select is done via the HMI. Might add external mode select switches.
        
        Mode select mask:
        0: Disabled
        1: Manual
        2: Semi-Auto
        3: Auto
        4: Teach - N/A for Cnv
        5: Maintenance
        
Device ID Format: XXYYZZ    
XX = Device type   
    01   VTD
    10  Cnv_Front_of_VTD
    11  Cnv_Rear_of_VTD
    12  Cnv_On_Extractor
    20  Safety_Stop_Front_of_VTD
    21  Safety_Stop_Rear_of_VTD
YY = Floor   
ZZ = VTD Connected to    
Example: 110203 Conveyor at the rear of VTD 3 on level 2

Pallet Alignment
0 = no alignment
1 = center alignment
2 = Left
3 = Right

 Sensor order for the conveyor:
 Lfwd Lpd1 Lpd2
  []   []   []
 ##############################
 #        Pallet Flow         #
 #         ------->>          #
 #                            #
 #                            #
 ##############################
                  []   []   []
                 Rpd2 Rpd1 Rbwd      
*)

REGION Cyclic Checks    
    // Update the pallet type as the Cnv_Inputs are triggered.
    #Cnv_Control.Cnv_Occupied := "PopUp Conveyor 2 - Pallet present 3";
    
    // Update the Cnv_Control opbject
    #Cnv_Control.SM_State := #State;
    #Cnv_Control.Stopped := NOT #Cnv_Control.Running;
    IF #Cnv_Control.Instruction.Inbound_Ready OR #Cnv_Control.Instruction.Outbound_Ready THEN
        #Cnv_Control.Ready_For_Task := TRUE;
    ELSE
        #Cnv_Control.Ready_For_Task := FALSE;
    END_IF;
END_REGION

REGION Auto/Semi auto mode
    CASE #State OF
        0: //Initialization
            #Cnv_Control.Instruction.Transfer_Complete := 0;
            #Cnv_Control.Instruction.Transfer_in_Progress := FALSE;
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Roller_Motor.Forward := FALSE;
            #Cnv_Control.Roller_Motor.Reverse := FALSE;
            #Cnv_Control.Roller_Motor.Speed := 0;
            #Cnv_Control.Lift_Motor.Forward := FALSE;
            #Cnv_Control.Lift_Motor.Reverse := FALSE;
            #Cnv_Control.Lift_Motor.Speed := 0;
            #Transfer_Direction := '';
            #Timer_Transfer(IN := FALSE,
                            PT := T#0ms);
            "IEC_Timer_0_DB_26".TON(IN := FALSE,
                                    PT := t#0s);
            IF #Cnv_Control.Enabled AND (#Cnv_Control.Mode = 3 OR #Cnv_Control.Mode = 2) AND #Cnv_Control.Error = 0 THEN
                #State := 10;
            END_IF;
            
        10: //Standby - Conveyor ready to receive instruction
            IF ("R_TRIG_DB_13".Q OR #Cnv_Control.Instruction.Start_Transfer) THEN
                //Inbound Transfer
                IF #Cnv_Control.Instruction.Inbound_Ready AND NOT #Cnv_Control.Running AND #Cnv_Control.Error = 0 THEN
                    //Check h
                    IF  #Cnv_Control.Inputs."Lift Up" THEN
                        #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 20;// Roller Running (Popup Up)
                    ELSE
                        #Cnv_Control.Warning := 1; //Cannot transfer from that conveyor
                    END_IF;
                    
                    //Outbound Transfer    
                ELSIF #Cnv_Control.Instruction.Outbound_Ready AND NOT #Cnv_Control.Running AND #Cnv_Control.Error = 0 THEN
                    //Check transfer ID TO popup cpnveyor 2
                    IF #Cnv_Control.Inputs."Lift Up" AND "Control_DB".PopUp_Cnv[2].Inputs."Lift Up" THEN
                        #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 50;
                    ELSE
                        #Cnv_Control.Warning := 1; //Cannot transfer TO that conveyor
                    END_IF;
                ELSE
                    #Cnv_Control.Warning := 0;// No task that can be started, yet start bit has been made true.
                END_IF;
            ELSIF #Cnv_Control.Instruction.Start_Transfer AND "Control_DB".VTD_Control.Current_Level <> 0 THEN
                //Extractor not at the correct level
                Set_Bit_F(Bit := 2,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_3);
            END_IF;
            IF #Cnv_Control.Instruction.Lift_Up THEN
                #Cnv_Control.Done := FALSE;
                #State := 60; // Lift UP
            ELSIF #Cnv_Control.Instruction.Lift_Down THEN
                #Cnv_Control.Done := FALSE;
                #State := 70; // Lift Down
            END_IF;
            
        20: // Roller Running (Popup Up)
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Roller_Motor.Forward := TRUE;
            #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Full_Speed;
            #Transfer_Direction := 'Foward';
            
            IF "R_TRIG_DB_14".Q OR "PopUp Conveyor 2 - Pallet present 3" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Roller_Motor.Forward := FALSE;
                #Cnv_Control.Roller_Motor.Reverse := FALSE;
                #Cnv_Control.Roller_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := "Control_DB".Inbound_Cnv.Running,
                            PT := UINT_TO_TIME(#Cnv_Settings.Roller_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
            
        50: // Roller Running (Popup Up)
            IF "Control_DB".PopUp_Cnv[2].Roller_Motor.Status.%X0 THEN//Is running
                #Cnv_Control.Running := TRUE;
                #Cnv_Control.Roller_Motor.Forward := TRUE;
                "IEC_Timer_0_DB_26".TON(IN := TRUE,
                                        PT := UINT_TO_TIME(#TimeStartBoost_Roller) * 1000);
                
                IF NOT "IEC_Timer_0_DB_26".Q THEN
                    #Cnv_Control.Roller_Motor.Speed := 100.0;
                ELSE
                    #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Full_Speed;
                END_IF;
                
                #Transfer_Direction := 'Foward';
            END_IF;
            
            IF "R_TRIG_DB_14".Q OR "PopUp Conveyor 2 - Pallet present 4" THEN
                "IEC_Timer_0_DB_26".TON(IN := FALSE,
                                        PT := t#0s);
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Roller_Motor.Forward := FALSE;
                #Cnv_Control.Roller_Motor.Reverse := FALSE;
                #Cnv_Control.Roller_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Roller_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        60: // Lift Up
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Lift_Motor.Forward := TRUE;
            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Full_Speed;
            #Transfer_Direction := 'Up';
            
            IF #Cnv_Control.Inputs."Lift Up" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Lift_Motor.Forward := FALSE;
                #Cnv_Control.Lift_Motor.Reverse := FALSE;
                #Cnv_Control.Lift_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := "LighGuard_Cut-Off Path 01",
                            PT := UINT_TO_TIME(#Cnv_Settings.Lift_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        70: // Lift Down
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Lift_Motor.Reverse := TRUE;
            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Full_Speed;
            #Transfer_Direction := 'Down';
            
            IF #Cnv_Control.Inputs."Lift Down" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Lift_Motor.Forward := FALSE;
                #Cnv_Control.Lift_Motor.Reverse := FALSE;
                #Cnv_Control.Lift_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := "LighGuard_Cut-Off Path 01",
                            PT := UINT_TO_TIME(#Cnv_Settings.Lift_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        400: //Error state
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Roller_Motor.Speed := 0;
            #Cnv_Control.Lift_Motor.Speed := 0;
            #Cnv_Control.Roller_Motor.Forward := FALSE;
            #Cnv_Control.Lift_Motor.Forward := FALSE;
            #Cnv_Control.Roller_Motor.Reverse := FALSE;
            #Cnv_Control.Lift_Motor.Reverse := FALSE;
            #Cnv_Control.Instruction.Stop := FALSE;
            #Cnv_Control.Instruction.Transfer_in_Progress := FALSE;
            #Watchdog(IN := FALSE,
                      PT := T#0S);
            #Timer_TC(IN := FALSE,
                      PT := T#0S);
            #Timer_Transfer(IN := FALSE,
                            PT := T#0S);
            #IEC_Timer_0_Instance_1(IN := FALSE,
                                    PT := T#0S);
            IF #Cnv_Control.Instruction.Reset THEN
                #Cnv_Control.Warning := 0;
                #Cnv_Control.Current_Task_ID := 0;
                #Cnv_Control.Error := FALSE; //Reset the conveyor
                
                #Cnv_Control.Cnv_Errors.Error_Word_1 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_2 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_3 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_4 := 0;
                #State := 0;
            END_IF;
            
        500:
            IF #Cnv_Control.Enabled THEN
                REGION ROLLER
                    IF #Cnv_Control.Inputs."Lift Up" AND NOT #Cnv_Control.Inputs."Lift Down" THEN
                        IF #Cnv_Control.Instruction.Roller_Fwd OR #Cnv_Control.Instruction.Start_Transfer THEN
                            #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Manual_Speed;
                            #Cnv_Control.Roller_Motor.Forward := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSIF #Cnv_Control.Instruction.Roller_Bwd OR #Cnv_Control.Instruction.Start_Transfer_Backward THEN
                            #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Manual_Speed;
                            #Cnv_Control.Roller_Motor.Reverse := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSE
                            #Cnv_Control.Roller_Motor.Speed := 0;
                            #Cnv_Control.Roller_Motor.Forward := FALSE;
                            #Cnv_Control.Roller_Motor.Reverse := FALSE;
                            #Cnv_Control.Running := FALSE;
                        END_IF;
                    END_IF;
                END_REGION
                
                REGION LIFT
                    IF NOT #SinaSpeed_Roller.AxisEnabled THEN
                        IF #Cnv_Control.Instruction.Lift_Up AND NOT #Cnv_Control.Inputs."Lift Up" THEN
                            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Manual_Speed;
                            #Cnv_Control.Lift_Motor.Forward := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSIF #Cnv_Control.Instruction.Lift_Down AND NOT #Cnv_Control.Inputs."Lift Down" THEN
                            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Manual_Speed;
                            #Cnv_Control.Lift_Motor.Reverse := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSE
                            #Cnv_Control.Lift_Motor.Speed := 0;
                            #Cnv_Control.Lift_Motor.Forward := FALSE;
                            #Cnv_Control.Lift_Motor.Reverse := FALSE;
                            #Cnv_Control.Running := FALSE;
                        END_IF;
                    END_IF;
                END_REGION
            END_IF;
            
            IF #Cnv_Control.Mode <> 1 AND #Cnv_Control.Mode <> 5 THEN
                #State := 0;
            END_IF;
    END_CASE;
END_REGION



REGION Cyclic Error Checks
    IF NOT "Main_Safety_RTG1_DB".SAFETY_OK_CAROUSEL THEN //11:1
        Set_Bit_F(Bit := 0,
                    Bit_Value := 1,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_1);
    END_IF;
    
    // IF #Cnv_Control.Instruction.Stop THEN //11:2
    //     "Set_Bit_F"(Bit := 1,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_1);
    // END_IF;
    
    IF #Cnv_Control.Roller_Motor.Error OR #Cnv_Control.Lift_Motor.Error THEN
        Set_Bit_F(Bit := 0,
                    Bit_Value := 1,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    END_IF;
    
    // Pallet Sensor Checks
    // IF #Cnv_Control.Inputs.Lfwd AND #Cnv_Control.Inputs.Rbwd THEN
    //     #Cnv_Control.Error := TRUE; //15:2 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 1,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // IF #Cnv_Control.Inputs.Lfwd AND #Cnv_Control.Inputs.Lpd1 AND #Cnv_Control.Inputs.Rpd1 THEN
    //     #Cnv_Control.Error := TRUE; //15:3 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 2,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // ELSIF #Cnv_Control.Inputs.Rbwd AND #Cnv_Control.Inputs.Lpd1 AND #Cnv_Control.Inputs.Rpd1 THEN
    //     #Cnv_Control.Error := TRUE; //15:4 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 3,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // END_IF;
    
    // Shuttle in Place Cnv_Inputs - Need to confirm the order of these Cnv_Inputs.
    // IF (#Cnv_Settings.ID > 110000 AND #Cnv_Settings.ID < 120000 AND NOT #Cnv_Control.Inputs.Sdetect1 AND #Cnv_Control.Inputs.Sdetect2)
    //     OR (#Cnv_Settings.ID > 120000 AND #Cnv_Settings.ID < 130000 AND NOT #Cnv_Control.Inputs.Sdetect1 AND #Cnv_Control.Inputs.Sdetect2) THEN
    //     #Cnv_Control.Error := TRUE; //14:5 Shuttle is about to yeet itself down the VTD shaft
    //     "Set_Bit_F"(Bit := 7,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
    //     #State := 400;
    // END_IF;
    
    // IF (#Cnv_Settings.ID > 110000 AND #Cnv_Settings.ID < 120000 AND #Cnv_Control.Inputs.Sdetect1 AND NOT #Cnv_Control.Inputs.Sdetect2)
    //     OR (#Cnv_Settings.ID > 120000 AND #Cnv_Settings.ID < 130000 AND #Cnv_Control.Inputs.Sdetect1 AND NOT #Cnv_Control.Inputs.Sdetect2) THEN
    //     #Cnv_Control.Warning := 0; //Shuttle detected in conveyor not yet on barcode
    // END_IF;
    
    // // #Watchdog auto starts the moment Any form OF transfer occurs.
    // IF #State > 10 AND #State < 400 THEN
    //     #Watchdog(IN := TRUE,
    //               PT := T#200s);
    // ELSE
    //     #Watchdog.IN := FALSE;
    // END_IF;
    
    // IF #Watchdog.Q THEN
    //     #Watchdog.IN := FALSE;
    //     #Cnv_Control.Error := TRUE; //14:2  Watchdog bit
    //     "Set_Bit_F"(Bit := 4,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
    //     #State := 400;
    // END_IF;
    
    // go to error state
    IF #Cnv_Control.Cnv_Errors.Error_Word_1 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_2 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_3 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_4 <> 0
    THEN
        #Cnv_Control.Error := TRUE;
        #State := 400;
    END_IF;
END_REGION

REGION VFD
    REGION ROLLER
        #Cnv_Control.Roller_Motor.Ready := NOT #Cnv_Control.Roller_Motor.Error;
        
        #SinaSpeed_Roller(EnableAxis := #Cnv_Control.Roller_Motor.Forward OR #Cnv_Control.Roller_Motor.Reverse,
                          AckError := #Cnv_Control.Instruction.Reset,
                          SpeedSp := #MainSetpoint_Roller,
                          RefSpeed := 1745.0,
                          HWIDSTW := #Cnv_Settings.Roller_G120_Hardware_ID,
                          HWIDZSW := #Cnv_Settings.Roller_G120_Hardware_ID,
                          AxisEnabled => #Cnv_Control.Roller_Motor.Status.%X0,
                          Lockout => #Cnv_Control.Roller_Motor.Error,
                          Error => #Cnv_Control.Roller_Motor.Error);
        
        //MAIN SETPOINT
        IF #Cnv_Control.Roller_Motor.Reverse THEN
            #MainSetpoint_Roller := (SCALE_X(MIN := 0,
                                             VALUE := NORM_X(MIN := 0,
                                                             VALUE := #Cnv_Control.Roller_Motor.Speed,
                                                             MAX := 100),
                                             MAX := 1745.0) * -1);
        ELSIF #Cnv_Control.Roller_Motor.Forward THEN
            #MainSetpoint_Roller := SCALE_X(MIN := 0,
                                            VALUE := NORM_X(MIN := 0,
                                                            VALUE := #Cnv_Control.Roller_Motor.Speed,
                                                            MAX := 100),
                                            MAX := 1745.0);
        ELSE
            #MainSetpoint_Roller := 0;
        END_IF;
        
        REGION Actual Speed
            IF #MainSetpoint_Roller > 0 THEN
                #Cnv_Control.Roller_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                  VALUE := NORM_X(MIN := 0,
                                                                                  VALUE := #SinaSpeed_Roller.ActVelocity,
                                                                                  MAX := 1745.0),
                                                                  MAX := 100);
            ELSIF #MainSetpoint_Roller < 0 THEN
                #Cnv_Control.Roller_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                  VALUE := NORM_X(MIN := 0,
                                                                                  VALUE := #SinaSpeed_Roller.ActVelocity * -1,
                                                                                  MAX := 1745.0),
                                                                  MAX := 100);
            ELSE
                #Cnv_Control.Roller_Motor.Speed_Actual := 0;
            END_IF;
        END_REGION
    END_REGION
    
    REGION LIFT
        #Cnv_Control.Lift_Motor.Ready := NOT #Cnv_Control.Lift_Motor.Error;
        
        #SinaSpeed_Lift(EnableAxis := (#Cnv_Control.Lift_Motor.Forward OR #Cnv_Control.Lift_Motor.Reverse) AND "LighGuard_Cut-Off Path 01",
                        AckError := #Cnv_Control.Instruction.Reset,
                        SpeedSp := #MainSetpoint_Lift,
                        RefSpeed := 1745.0,
                        HWIDSTW := #Cnv_Settings.Lift_G120_Hardware_ID,
                        HWIDZSW := #Cnv_Settings.Lift_G120_Hardware_ID,
                        AxisEnabled => #Cnv_Control.Lift_Motor.Status.%X0,
                        Lockout => #Cnv_Control.Lift_Motor.Error,
                        Error => #Cnv_Control.Lift_Motor.Error);
        
        //MAIN SETPOINT
        IF #Cnv_Control.Lift_Motor.Reverse AND "LighGuard_Cut-Off Path 01" THEN
            #MainSetpoint_Lift := (SCALE_X(MIN := 0,
                                           VALUE := NORM_X(MIN := 0,
                                                           VALUE := #Cnv_Control.Lift_Motor.Speed,
                                                           MAX := 100),
                                           MAX := 1745.0) * -1);
        ELSIF #Cnv_Control.Lift_Motor.Forward AND "LighGuard_Cut-Off Path 01" THEN
            #MainSetpoint_Lift := SCALE_X(MIN := 0,
                                          VALUE := NORM_X(MIN := 0,
                                                          VALUE := #Cnv_Control.Lift_Motor.Speed,
                                                          MAX := 100),
                                          MAX := 1745.0);
        ELSE
            #MainSetpoint_Lift := 0;
        END_IF;
        
        REGION Actual Speed
            IF #MainSetpoint_Lift > 0 THEN
                #Cnv_Control.Lift_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                VALUE := NORM_X(MIN := 0,
                                                                                VALUE := #SinaSpeed_Lift.ActVelocity,
                                                                                MAX := 1745.0),
                                                                MAX := 100);
            ELSIF #MainSetpoint_Lift < 0 THEN
                #Cnv_Control.Lift_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                VALUE := NORM_X(MIN := 0,
                                                                                VALUE := #SinaSpeed_Lift.ActVelocity * -1,
                                                                                MAX := 1745.0),
                                                                MAX := 100);
            ELSE
                #Cnv_Control.Lift_Motor.Speed_Actual := 0;
            END_IF;
        END_REGION
    END_REGION
END_REGION
END_FUNCTION_BLOCK

// ============================================================================
FUNCTION_BLOCK "PConveyor_3_FB"

VAR_INPUT
   Cnv_Settings : "PopUp_Cnv_Settings";
   TimeStartBoost_Chain : UInt;
   TimeStartBoost_Roller : UInt;
END_VAR

VAR_IN_OUT
   Cnv_Control : "PopUp_Cnv_Control";
   SinaSpeed_Roller : SinaSpeed;
   SinaSpeed_Chain : SinaSpeed;
   SinaSpeed_Lift : SinaSpeed;
END_VAR

VAR
   State : UInt;
   Timer_TC : TON_TIME;
   Timer_Transfer : TON_TIME;
   Watchdog : TON_TIME;
   Transfer_Direction : String;
   MainSetpoint_Roller : Int;
   MainSetpoint_Chain : Int;
   MainSetpoint_Lift : Int;
   IEC_Timer_0_Instance_1 : TON_TIME;
   R_TRIG_Instance : R_TRIG;
END_VAR

VAR_TEMP
   Execute_Old : Bool;
   Stop_Old : Bool;
END_VAR

BEGIN
"R_TRIG_DB_21"(CLK := #Cnv_Control.Instruction.Execute AND NOT #Execute_Old);
"R_TRIG_DB_22"(CLK := #Cnv_Control.Instruction.Stop AND NOT #Stop_Old);

#Execute_Old := #Cnv_Control.Instruction.Execute;
#Stop_Old := #Cnv_Control.Instruction.Stop;

#Cnv_Control.Enabled := #Cnv_Control.Instruction.Enable;

//MODES
#Cnv_Control.Mode := #Cnv_Control.Instruction.Mode_Change;
IF (#Cnv_Control.Mode = 1 OR #Cnv_Control.Mode = 5) AND NOT #Cnv_Control.Error THEN
    #State := 500;
END_IF;

#R_TRIG_Instance(CLK := #Cnv_Control.Mode = 3);
IF #R_TRIG_Instance.Q THEN
    #State := 0;
END_IF;

(*
TODO:
01. Need to add statemachine watchdog - Done
02. Extractor needs to be on same floor for pallet to be moved in manual passed Rbwd - Done
03. Complete reset state - Done
04. Add stop inputs - Done
05. Need to add variable motor speed, manual needs to be slower. - Done
06. Need to add cyclic error checking. For odd sensor combinations as well - Partially done
07. Need to add Shuttle monitor - Done
08. Need to add Task ID check and start bit check to outbound pallet move. Check direction of pallet movement based on connected Cnv.
09. Need to add checks for wrong direction of travel - Done
10. Add checks for unsafe conditions with Cnv_Inputs - Partially Done
11. Define Error codes - DOne
12. Add watchdof time to Cnv Settings - Done
13. Add self-timeout on manual 
14. For shuttle in place sensor checks take into account extractor floor and safety stopper state
15. Confirm modes and states are correct (Semi-auto and maintenance as well)
16. Add the correct transfer process for the logistex-spacemaker pallet handovers.

Mode select is done via the HMI. Might add external mode select switches.
        
        Mode select mask:
        0: Disabled
        1: Manual
        2: Semi-Auto
        3: Auto
        4: Teach - N/A for Cnv
        5: Maintenance
        
Device ID Format: XXYYZZ    
XX = Device type   
    01   VTD
    10  Cnv_Front_of_VTD
    11  Cnv_Rear_of_VTD
    12  Cnv_On_Extractor
    20  Safety_Stop_Front_of_VTD
    21  Safety_Stop_Rear_of_VTD
YY = Floor   
ZZ = VTD Connected to    
Example: 110203 Conveyor at the rear of VTD 3 on level 2

Pallet Alignment
0 = no alignment
1 = center alignment
2 = Left
3 = Right

 Sensor order for the conveyor:
 Lfwd Lpd1 Lpd2
  []   []   []
 ##############################
 #        Pallet Flow         #
 #         ------->>          #
 #                            #
 #                            #
 ##############################
                  []   []   []
                 Rpd2 Rpd1 Rbwd      
*)


REGION Cyclic Checks    
    #Cnv_Control.Cnv_Occupied := NOT "PopUp Conveyor 3 - Pallet present 1";
        
    // Update the Cnv_Control opbject
    #Cnv_Control.SM_State := #State;
    #Cnv_Control.Stopped := NOT #Cnv_Control.Running;
    IF #Cnv_Control.Instruction.Inbound_Ready OR #Cnv_Control.Instruction.Outbound_Ready THEN
        #Cnv_Control.Ready_For_Task := TRUE;
    ELSE
        #Cnv_Control.Ready_For_Task := FALSE;
    END_IF;
    
END_REGION

REGION Auto/Semi auto mode
    CASE #State OF
        0: //IDLE MODE
            #Cnv_Control.Instruction.Transfer_Complete := 0;
            #Cnv_Control.Instruction.Transfer_in_Progress := FALSE;
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Roller_Motor.Forward := FALSE;
            #Cnv_Control.Roller_Motor.Reverse := FALSE;
            #Cnv_Control.Roller_Motor.Speed := 0;
            #Cnv_Control.Chain_Motor.Forward := FALSE;
            #Cnv_Control.Chain_Motor.Reverse := FALSE;
            #Cnv_Control.Chain_Motor.Speed := 0;
            #Cnv_Control.Lift_Motor.Forward := FALSE;
            #Cnv_Control.Lift_Motor.Reverse := FALSE;
            #Cnv_Control.Lift_Motor.Speed := 0;
            #Transfer_Direction := '';
            #Timer_Transfer(IN := FALSE,
                            PT := T#0ms);
            "IEC_Timer_0_DB_24".TON(IN := FALSE,
                                    PT := t#0s);
            "IEC_Timer_0_DB_23".TON(IN := FALSE,
                                    PT := t#0s);
            IF #Cnv_Control.Enabled AND (#Cnv_Control.Mode = 3 OR #Cnv_Control.Mode = 2) AND #Cnv_Control.Error = 0 THEN
                #State := 10;
            END_IF;
            
        10: //Standby - Conveyor ready to receive instruction
            IF ("R_TRIG_DB_21".Q OR #Cnv_Control.Instruction.Start_Transfer) THEN
                //Inbound Transfer
                IF #Cnv_Control.Instruction.Inbound_Ready AND NOT #Cnv_Control.Running AND #Cnv_Control.Error = 0 THEN
                    //Check transfer ID FROM CHAIN 2
                    // IF #Cnv_Control.Instruction.Transfer_From_ID = "Settings_DB".PopUp_Cnv_Settings[2].ID AND #Cnv_Control.Inputs."Lift Down" THEN
                    #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 20;
                    // ELSE
                    //     #Cnv_Control.Warning := 1; //Cannot transfer from that conveyor
                    // END_IF;
                    
                    //Outbound Transfer    
                ELSIF #Cnv_Control.Instruction.Outbound_Ready AND NOT #Cnv_Control.Running AND #Cnv_Control.Error = 0 THEN
                    //Check transfer ID TO popup conveyor 4
                    // IF #Cnv_Control.Instruction.Transfer_To_ID = "Settings_DB".PopUp_Cnv_Settings[4].ID AND #Cnv_Control.Inputs."Lift Up" THEN
                    #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 40;
                    // ELSE
                    //     #Cnv_Control.Warning := 1; //Cannot transfer TO that conveyor
                    // END_IF;
                ELSE
                    #Cnv_Control.Warning := 0;// No task that can be started, yet start bit has been made true.
                END_IF;
            ELSIF #Cnv_Control.Instruction.Start_Transfer AND "Control_DB".VTD_Control.Current_Level <> 0 THEN
                //Extractor not at the correct level
                Set_Bit_F(Bit := 2,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_3);
            END_IF;
            IF #Cnv_Control.Instruction.Lift_Up THEN
                #Cnv_Control.Done := FALSE;
                #State := 60; // Lift UP
            ELSIF #Cnv_Control.Instruction.Lift_Down THEN
                #Cnv_Control.Done := FALSE;
                #State := 70; // Lift Down
            END_IF;
            
        20: // Chain Running (Popup Down)
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Chain_Motor.Forward := TRUE;
            
            #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Full_Speed;
            #Transfer_Direction := 'Foward';
            "IEC_Timer_0_DB_23".TON(IN:=TRUE,
                                    PT:=UINT_TO_TIME(#TimeStartBoost_Chain) * 1000);
            
            // IF NOT "IEC_Timer_0_DB_23".Q THEN
            //     #Cnv_Control.Chain_Motor.Speed := 100.0;
            // ELSE
            //     #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Full_Speed;
            // END_IF;
            
            IF "IEC_Timer_0_DB_23".ET < T#16S THEN
                #Cnv_Control.Chain_Motor.Speed := 100.0;
            ELSIF "IEC_Timer_0_DB_23".ET >= T#16S AND "IEC_Timer_0_DB_23".ET < T#18S THEN
                #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Full_Speed;
            ELSE
                #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Slow_Speed;
            END_IF;
            
            IF "R_TRIG_DB_22".Q OR NOT "PopUp Conveyor 3 - Pallet present 1" THEN
                "IEC_Timer_0_DB_23".TON(IN := FALSE,
                                        PT := t#0s);
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Chain_Motor.Forward := FALSE;
                #Cnv_Control.Chain_Motor.Reverse := FALSE;
                #Cnv_Control.Chain_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Chain_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        40: // Roller Running (Popup Up)
            IF "Control_DB".PopUp_Cnv[4].Roller_Motor.Status.%X0 THEN
                #Cnv_Control.Running := TRUE;
                #Cnv_Control.Roller_Motor.Forward := TRUE;
                "IEC_Timer_0_DB_24".TON(IN:=TRUE,
                                        PT:=UINT_TO_TIME(#TimeStartBoost_Roller) * 1000);
                
                IF NOT "IEC_Timer_0_DB_24".Q THEN
                    #Cnv_Control.Roller_Motor.Speed := 100.0;
                ELSE
                    #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Full_Speed;
                END_IF;
                
                #Transfer_Direction := 'Foward';
            END_IF;
            
            IF "R_TRIG_DB_22".Q OR "PopUp Conveyor 4 - Pallet present 1" THEN
                "IEC_Timer_0_DB_24".TON(IN := FALSE,
                                        PT := t#0s);
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Roller_Motor.Forward := FALSE;
                #Cnv_Control.Roller_Motor.Reverse := FALSE;
                #Cnv_Control.Roller_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Roller_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        60: // Lift Up
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Lift_Motor.Forward := TRUE;
            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Full_Speed;
            #Transfer_Direction := 'Up';
            
            IF #Cnv_Control.Inputs."Lift Up" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Lift_Motor.Forward := FALSE;
                #Cnv_Control.Lift_Motor.Reverse := FALSE;
                #Cnv_Control.Lift_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Lift_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        70: // Lift Down
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Lift_Motor.Reverse := TRUE;
            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Full_Speed;
            #Transfer_Direction := 'Down';
            
            IF #Cnv_Control.Inputs."Lift Down" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Lift_Motor.Forward := FALSE;
                #Cnv_Control.Lift_Motor.Reverse := FALSE;
                #Cnv_Control.Lift_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Lift_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        400: //Error state
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Roller_Motor.Speed := 0;
            #Cnv_Control.Chain_Motor.Speed := 0;
            #Cnv_Control.Lift_Motor.Speed := 0;
            #Cnv_Control.Roller_Motor.Forward := FALSE;
            #Cnv_Control.Chain_Motor.Forward := FALSE;
            #Cnv_Control.Lift_Motor.Forward := FALSE;
            #Cnv_Control.Roller_Motor.Reverse := FALSE;
            #Cnv_Control.Chain_Motor.Reverse := FALSE;
            #Cnv_Control.Lift_Motor.Reverse := FALSE;
            #Cnv_Control.Instruction.Stop := FALSE;
            #Cnv_Control.Instruction.Transfer_in_Progress := FALSE;
            #Watchdog(IN := FALSE,
                      PT := T#0S);
            #Timer_TC(IN := FALSE,
                      PT := T#0S);
            #Timer_Transfer(IN := FALSE,
                            PT := T#0S);
            #IEC_Timer_0_Instance_1(IN := FALSE,
                                    PT := T#0S);
            IF #Cnv_Control.Instruction.Reset THEN
                #Cnv_Control.Warning := 0;
                #Cnv_Control.Current_Task_ID := 0;
                #Cnv_Control.Error := FALSE; //Reset the conveyor
                
                #Cnv_Control.Cnv_Errors.Error_Word_1 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_2 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_3 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_4 := 0;
                #State := 0;
            END_IF;
            
        500:
            IF #Cnv_Control.Enabled THEN
                REGION ROLLER
                    IF #Cnv_Control.Inputs."Lift Up" AND NOT #Cnv_Control.Inputs."Lift Down" THEN
                        IF #Cnv_Control.Instruction.Roller_Fwd OR #Cnv_Control.Instruction.Start_Transfer THEN
                            #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Manual_Speed;
                            #Cnv_Control.Roller_Motor.Forward := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSIF #Cnv_Control.Instruction.Roller_Bwd OR #Cnv_Control.Instruction.Start_Transfer_Backward THEN
                            #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Manual_Speed;
                            #Cnv_Control.Roller_Motor.Reverse := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSE
                            #Cnv_Control.Roller_Motor.Speed := 0;
                            #Cnv_Control.Roller_Motor.Forward := FALSE;
                            #Cnv_Control.Roller_Motor.Reverse := FALSE;
                            #Cnv_Control.Running := FALSE;
                        END_IF;
                    END_IF;
                END_REGION
                
                REGION CHAIN
                    IF NOT #Cnv_Control.Inputs."Lift Up" AND #Cnv_Control.Inputs."Lift Down" THEN
                        IF #Cnv_Control.Instruction.Chain_Fwd OR #Cnv_Control.Instruction.Start_Transfer THEN
                            #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Manual_Speed;
                            #Cnv_Control.Chain_Motor.Forward := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSIF #Cnv_Control.Instruction.Chain_Bwd OR #Cnv_Control.Instruction.Start_Transfer_Backward THEN
                            #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Manual_Speed;
                            #Cnv_Control.Chain_Motor.Reverse := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSE
                            #Cnv_Control.Chain_Motor.Speed := 0;
                            #Cnv_Control.Chain_Motor.Forward := FALSE;
                            #Cnv_Control.Chain_Motor.Reverse := FALSE;
                            #Cnv_Control.Running := FALSE;
                        END_IF;
                    END_IF;
                END_REGION
                
                REGION LIFT
                    IF NOT #SinaSpeed_Roller.AxisEnabled AND NOT #SinaSpeed_Chain.AxisEnabled THEN
                        IF #Cnv_Control.Instruction.Lift_Up AND NOT #Cnv_Control.Inputs."Lift Up" THEN
                            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Manual_Speed;
                            #Cnv_Control.Lift_Motor.Forward := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSIF #Cnv_Control.Instruction.Lift_Down AND NOT #Cnv_Control.Inputs."Lift Down" THEN
                            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Manual_Speed;
                            #Cnv_Control.Lift_Motor.Reverse := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSE
                            #Cnv_Control.Lift_Motor.Speed := 0;
                            #Cnv_Control.Lift_Motor.Forward := FALSE;
                            #Cnv_Control.Lift_Motor.Reverse := FALSE;
                            #Cnv_Control.Running := FALSE;
                        END_IF;
                    END_IF;
                END_REGION
            END_IF;
            
            IF #Cnv_Control.Mode <> 1 AND #Cnv_Control.Mode <> 5 THEN
                #State := 0;
            END_IF;
    END_CASE;
END_REGION



REGION Cyclic Error Checks
    IF NOT "Main_Safety_RTG1_DB".SAFETY_OK_CAROUSEL THEN //11:1
        Set_Bit_F(Bit := 0,
                    Bit_Value := 1,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_1);
    END_IF;
    
    // IF #Cnv_Control.Instruction.Stop THEN //11:2
    //     "Set_Bit_F"(Bit := 1,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_1);
    // END_IF;
    
    IF #Cnv_Control.Roller_Motor.Error OR #Cnv_Control.Chain_Motor.Error OR #Cnv_Control.Lift_Motor.Error THEN
        Set_Bit_F(Bit := 0,
                    Bit_Value := 1,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    END_IF;
    
    // Pallet Sensor Checks
    // IF #Cnv_Control.Inputs.Lfwd AND #Cnv_Control.Inputs.Rbwd THEN
    //     #Cnv_Control.Error := TRUE; //15:2 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 1,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // IF #Cnv_Control.Inputs.Lfwd AND #Cnv_Control.Inputs.Lpd1 AND #Cnv_Control.Inputs.Rpd1 THEN
    //     #Cnv_Control.Error := TRUE; //15:3 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 2,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // ELSIF #Cnv_Control.Inputs.Rbwd AND #Cnv_Control.Inputs.Lpd1 AND #Cnv_Control.Inputs.Rpd1 THEN
    //     #Cnv_Control.Error := TRUE; //15:4 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 3,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // END_IF;
    
    // Shuttle in Place Cnv_Inputs - Need to confirm the order of these Cnv_Inputs.
    // IF (#Cnv_Settings.ID > 110000 AND #Cnv_Settings.ID < 120000 AND NOT #Cnv_Control.Inputs.Sdetect1 AND #Cnv_Control.Inputs.Sdetect2)
    //     OR (#Cnv_Settings.ID > 120000 AND #Cnv_Settings.ID < 130000 AND NOT #Cnv_Control.Inputs.Sdetect1 AND #Cnv_Control.Inputs.Sdetect2) THEN
    //     #Cnv_Control.Error := TRUE; //14:5 Shuttle is about to yeet itself down the VTD shaft
    //     "Set_Bit_F"(Bit := 7,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
    //     #State := 400;
    // END_IF;
    
    // IF (#Cnv_Settings.ID > 110000 AND #Cnv_Settings.ID < 120000 AND #Cnv_Control.Inputs.Sdetect1 AND NOT #Cnv_Control.Inputs.Sdetect2)
    //     OR (#Cnv_Settings.ID > 120000 AND #Cnv_Settings.ID < 130000 AND #Cnv_Control.Inputs.Sdetect1 AND NOT #Cnv_Control.Inputs.Sdetect2) THEN
    //     #Cnv_Control.Warning := 0; //Shuttle detected in conveyor not yet on barcode
    // END_IF;
    
    // // #Watchdog auto starts the moment Any form OF transfer occurs.
    // IF #State > 10 AND #State < 400 THEN
    //     #Watchdog(IN := TRUE,
    //               PT := T#200s);
    // ELSE
    //     #Watchdog.IN := FALSE;
    // END_IF;
    
    // IF #Watchdog.Q THEN
    //     #Watchdog.IN := FALSE;
    //     #Cnv_Control.Error := TRUE; //14:2  Watchdog bit
    //     "Set_Bit_F"(Bit := 4,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
    //     #State := 400;
    // END_IF;
    
    // go to error state
    IF #Cnv_Control.Cnv_Errors.Error_Word_1 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_2 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_3 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_4 <> 0
    THEN
        #Cnv_Control.Error := TRUE;
        #State := 400;
    END_IF;
END_REGION

REGION VFD
    REGION ROLLER
        #Cnv_Control.Roller_Motor.Ready := NOT #Cnv_Control.Roller_Motor.Error;
        
        #SinaSpeed_Roller(EnableAxis := #Cnv_Control.Roller_Motor.Forward OR #Cnv_Control.Roller_Motor.Reverse,
                          AckError := #Cnv_Control.Instruction.Reset,
                          SpeedSp := #MainSetpoint_Roller,
                          RefSpeed := 1745.0,
                          HWIDSTW := #Cnv_Settings.Roller_G120_Hardware_ID,
                          HWIDZSW := #Cnv_Settings.Roller_G120_Hardware_ID,
                          AxisEnabled => #Cnv_Control.Roller_Motor.Status.%X0,
                          Lockout => #Cnv_Control.Roller_Motor.Error,
                          Error => #Cnv_Control.Roller_Motor.Error);
        
        //MAIN SETPOINT
        IF #Cnv_Control.Roller_Motor.Reverse THEN
            #MainSetpoint_Roller := (SCALE_X(MIN := 0,
                                             VALUE := NORM_X(MIN := 0,
                                                             VALUE := #Cnv_Control.Roller_Motor.Speed,
                                                             MAX := 100),
                                             MAX := 1745.0) * -1);
        ELSIF #Cnv_Control.Roller_Motor.Forward THEN
            #MainSetpoint_Roller := SCALE_X(MIN := 0,
                                            VALUE := NORM_X(MIN := 0,
                                                            VALUE := #Cnv_Control.Roller_Motor.Speed,
                                                            MAX := 100),
                                            MAX := 1745.0);
        ELSE
            #MainSetpoint_Roller := 0;
        END_IF;
        
        REGION Actual Speed
            IF #MainSetpoint_Roller > 0 THEN
                #Cnv_Control.Roller_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                  VALUE := NORM_X(MIN := 0,
                                                                                  VALUE := #SinaSpeed_Roller.ActVelocity,
                                                                                  MAX := 1745.0),
                                                                  MAX := 100);
            ELSIF #MainSetpoint_Roller < 0 THEN
                #Cnv_Control.Roller_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                  VALUE := NORM_X(MIN := 0,
                                                                                  VALUE := #SinaSpeed_Roller.ActVelocity * -1,
                                                                                  MAX := 1745.0),
                                                                  MAX := 100);
            ELSE
                #Cnv_Control.Roller_Motor.Speed_Actual := 0;
            END_IF;
        END_REGION
    END_REGION
    
    REGION CHAIN
        #Cnv_Control.Chain_Motor.Ready := NOT #Cnv_Control.Chain_Motor.Error;
        
        #SinaSpeed_Chain(EnableAxis := #Cnv_Control.Chain_Motor.Forward OR #Cnv_Control.Chain_Motor.Reverse,
                         AckError := #Cnv_Control.Instruction.Reset,
                         SpeedSp := #MainSetpoint_Chain,
                         RefSpeed := 1745.0,
                         HWIDSTW := #Cnv_Settings.Chain_G120_Hardware_ID,
                         HWIDZSW := #Cnv_Settings.Chain_G120_Hardware_ID,
                         AxisEnabled => #Cnv_Control.Chain_Motor.Status.%X0,
                         Lockout => #Cnv_Control.Chain_Motor.Error,
                         Error => #Cnv_Control.Chain_Motor.Error);
        
        //MAIN SETPOINT
        IF #Cnv_Control.Chain_Motor.Reverse THEN
            #MainSetpoint_Chain := (SCALE_X(MIN := 0,
                                            VALUE := NORM_X(MIN := 0,
                                                            VALUE := #Cnv_Control.Chain_Motor.Speed,
                                                            MAX := 100),
                                            MAX := 1745.0) * -1);
        ELSIF #Cnv_Control.Chain_Motor.Forward THEN
            #MainSetpoint_Chain := SCALE_X(MIN := 0,
                                           VALUE := NORM_X(MIN := 0,
                                                           VALUE := #Cnv_Control.Chain_Motor.Speed,
                                                           MAX := 100),
                                           MAX := 1745.0);
        ELSE
            #MainSetpoint_Chain := 0;
        END_IF;
        
        REGION Actual Speed
            IF #MainSetpoint_Chain > 0 THEN
                #Cnv_Control.Chain_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                 VALUE := NORM_X(MIN := 0,
                                                                                 VALUE := #SinaSpeed_Chain.ActVelocity,
                                                                                 MAX := 1745.0),
                                                                 MAX := 100);
            ELSIF #MainSetpoint_Chain < 0 THEN
                #Cnv_Control.Chain_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                 VALUE := NORM_X(MIN := 0,
                                                                                 VALUE := #SinaSpeed_Chain.ActVelocity * -1,
                                                                                 MAX := 1745.0),
                                                                 MAX := 100);
            ELSE
                #Cnv_Control.Chain_Motor.Speed_Actual := 0;
            END_IF;
        END_REGION
    END_REGION
    
    REGION LIFT
        #Cnv_Control.Lift_Motor.Ready := NOT #Cnv_Control.Lift_Motor.Error;
        
        #SinaSpeed_Lift(EnableAxis := #Cnv_Control.Lift_Motor.Forward OR #Cnv_Control.Lift_Motor.Reverse,
                        AckError := #Cnv_Control.Instruction.Reset,
                        SpeedSp := #MainSetpoint_Lift,
                        RefSpeed := 1745.0,
                        HWIDSTW := #Cnv_Settings.Lift_G120_Hardware_ID,
                        HWIDZSW := #Cnv_Settings.Lift_G120_Hardware_ID,
                        AxisEnabled => #Cnv_Control.Lift_Motor.Status.%X0,
                        Lockout => #Cnv_Control.Lift_Motor.Error,
                        Error => #Cnv_Control.Lift_Motor.Error);
        
        //MAIN SETPOINT
        IF #Cnv_Control.Lift_Motor.Reverse THEN
            #MainSetpoint_Lift := (SCALE_X(MIN := 0,
                                           VALUE := NORM_X(MIN := 0,
                                                           VALUE := #Cnv_Control.Lift_Motor.Speed,
                                                           MAX := 100),
                                           MAX := 1745.0) * -1);
        ELSIF #Cnv_Control.Lift_Motor.Forward THEN
            #MainSetpoint_Lift := SCALE_X(MIN := 0,
                                          VALUE := NORM_X(MIN := 0,
                                                          VALUE := #Cnv_Control.Lift_Motor.Speed,
                                                          MAX := 100),
                                          MAX := 1745.0);
        ELSE
            #MainSetpoint_Lift := 0;
        END_IF;
        
        REGION Actual Speed
            IF #MainSetpoint_Lift > 0 THEN
                #Cnv_Control.Lift_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                VALUE := NORM_X(MIN := 0,
                                                                                VALUE := #SinaSpeed_Lift.ActVelocity,
                                                                                MAX := 1745.0),
                                                                MAX := 100);
            ELSIF #MainSetpoint_Lift < 0 THEN
                #Cnv_Control.Lift_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                VALUE := NORM_X(MIN := 0,
                                                                                VALUE := #SinaSpeed_Lift.ActVelocity * -1,
                                                                                MAX := 1745.0),
                                                                MAX := 100);
            ELSE
                #Cnv_Control.Lift_Motor.Speed_Actual := 0;
            END_IF;
        END_REGION
    END_REGION
END_REGION
END_FUNCTION_BLOCK

// ============================================================================
FUNCTION_BLOCK "PConveyor_4_FB"

VAR_INPUT
   Cnv_Settings : "PopUp_Cnv_Settings";
   TimeStartBoost_Roller : UInt;
END_VAR

VAR_IN_OUT
   Cnv_Control : "PopUp_Cnv_Control";
   SinaSpeed_Roller : SinaSpeed;
   SinaSpeed_Lift : SinaSpeed;
END_VAR

VAR
   State : UInt;
   Timer_TC : TON_TIME;
   Timer_Transfer : TON_TIME;
   Watchdog : TON_TIME;
   Transfer_Direction : String;
   MainSetpoint_Roller : Int;
   MainSetpoint_Lift : Int;
   IEC_Timer_0_Instance_1 : TON_TIME;
   R_TRIG_Instance : R_TRIG;
END_VAR

VAR_TEMP
   Execute_Old : Bool;
   Stop_Old : Bool;
END_VAR

BEGIN
"R_TRIG_DB_23"(CLK := #Cnv_Control.Instruction.Execute AND NOT #Execute_Old);
"R_TRIG_DB_24"(CLK := #Cnv_Control.Instruction.Stop AND NOT #Stop_Old);

#Execute_Old := #Cnv_Control.Instruction.Execute;
#Stop_Old := #Cnv_Control.Instruction.Stop;

#Cnv_Control.Enabled := #Cnv_Control.Instruction.Enable;

//MODES
#Cnv_Control.Mode := #Cnv_Control.Instruction.Mode_Change;
IF (#Cnv_Control.Mode = 1 OR #Cnv_Control.Mode = 5) AND NOT #Cnv_Control.Error THEN
    #State := 500;
END_IF;

#R_TRIG_Instance(CLK := #Cnv_Control.Mode = 3);
IF #R_TRIG_Instance.Q THEN
    #State := 0;
END_IF;

(*
TODO:
01. Need to add statemachine watchdog - Done
02. Extractor needs to be on same floor for pallet to be moved in manual passed Rbwd - Done
03. Complete reset state - Done
04. Add stop inputs - Done
05. Need to add variable motor speed, manual needs to be slower. - Done
06. Need to add cyclic error checking. For odd sensor combinations as well - Partially done
07. Need to add Shuttle monitor - Done
08. Need to add Task ID check and start bit check to outbound pallet move. Check direction of pallet movement based on connected Cnv.
09. Need to add checks for wrong direction of travel - Done
10. Add checks for unsafe conditions with Cnv_Inputs - Partially Done
11. Define Error codes - DOne
12. Add watchdof time to Cnv Settings - Done
13. Add self-timeout on manual 
14. For shuttle in place sensor checks take into account extractor floor and safety stopper state
15. Confirm modes and states are correct (Semi-auto and maintenance as well)
16. Add the correct transfer process for the logistex-spacemaker pallet handovers.

Mode select is done via the HMI. Might add external mode select switches.
        
        Mode select mask:
        0: Disabled
        1: Manual
        2: Semi-Auto
        3: Auto
        4: Teach - N/A for Cnv
        5: Maintenance
        
Device ID Format: XXYYZZ    
XX = Device type   
    01   VTD
    10  Cnv_Front_of_VTD
    11  Cnv_Rear_of_VTD
    12  Cnv_On_Extractor
    20  Safety_Stop_Front_of_VTD
    21  Safety_Stop_Rear_of_VTD
YY = Floor   
ZZ = VTD Connected to    
Example: 110203 Conveyor at the rear of VTD 3 on level 2

Pallet Alignment
0 = no alignment
1 = center alignment
2 = Left
3 = Right

 Sensor order for the conveyor:
 Lfwd Lpd1 Lpd2
  []   []   []
 ##############################
 #        Pallet Flow         #
 #         ------->>          #
 #                            #
 #                            #
 ##############################
                  []   []   []
                 Rpd2 Rpd1 Rbwd      
*)


REGION Cyclic Checks    
    #Cnv_Control.Cnv_Occupied := "PopUp Conveyor 4 - Pallet present 1";
    
    // Update the Cnv_Control opbject
    #Cnv_Control.SM_State := #State;
    #Cnv_Control.Stopped := NOT #Cnv_Control.Running;
    IF #Cnv_Control.Instruction.Inbound_Ready OR #Cnv_Control.Instruction.Outbound_Ready THEN
        #Cnv_Control.Ready_For_Task := TRUE;
    ELSE
        #Cnv_Control.Ready_For_Task := FALSE;
    END_IF;
    
END_REGION

REGION Auto/Semi auto mode
    CASE #State OF
        0: //IDLE MODE
            #Cnv_Control.Instruction.Transfer_Complete := 0;
            #Cnv_Control.Instruction.Transfer_in_Progress := FALSE;
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Roller_Motor.Forward := FALSE;
            #Cnv_Control.Roller_Motor.Reverse := FALSE;
            #Cnv_Control.Roller_Motor.Speed := 0;
            #Cnv_Control.Chain_Motor.Forward := FALSE;
            #Cnv_Control.Chain_Motor.Reverse := FALSE;
            #Cnv_Control.Chain_Motor.Speed := 0;
            #Cnv_Control.Lift_Motor.Forward := FALSE;
            #Cnv_Control.Lift_Motor.Reverse := FALSE;
            #Cnv_Control.Lift_Motor.Speed := 0;
            #Transfer_Direction := '';
            #Timer_Transfer(IN := FALSE,
                            PT := T#0ms);
            "IEC_Timer_0_DB_25".TON(IN := FALSE,
                                    PT := t#0s);
            IF #Cnv_Control.Enabled AND (#Cnv_Control.Mode = 3 OR #Cnv_Control.Mode = 2) AND #Cnv_Control.Error = 0 THEN
                #State := 10;
            END_IF;
            
        10: //Standby - Conveyor ready to receive instruction
            IF ("R_TRIG_DB_23".Q OR #Cnv_Control.Instruction.Start_Transfer) THEN
                //Inbound Transfer
                IF #Cnv_Control.Instruction.Inbound_Ready AND NOT #Cnv_Control.Running AND #Cnv_Control.Error = 0 THEN
                    IF #Cnv_Control.Inputs."Lift Up" THEN
                        #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 20;
                    END_IF;
                    //Outbound Transfer    
                ELSIF #Cnv_Control.Instruction.Outbound_Ready AND NOT #Cnv_Control.Running AND #Cnv_Control.Error = 0 THEN
                    IF #Cnv_Control.Inputs."Lift Up" THEN
                        #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 30;
                    END_IF;
                END_IF;
            END_IF;
                
            IF #Cnv_Control.Instruction.Lift_Up THEN
                #Cnv_Control.Done := FALSE;
                #State := 60; // Lift UP
            ELSIF #Cnv_Control.Instruction.Lift_Down THEN
                #Cnv_Control.Done := FALSE;
                #State := 70; // Lift Down
            END_IF;
            
        20: // Roller Running (Popup Up)
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Roller_Motor.Forward := TRUE;
            "IEC_Timer_0_DB_25".TON(IN := TRUE,
                                    PT := UINT_TO_TIME(#TimeStartBoost_Roller) * 1000);
            
            IF NOT "IEC_Timer_0_DB_25".Q THEN
                #Cnv_Control.Roller_Motor.Speed := 100.0;
            ELSE
                #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Full_Speed;
            END_IF;
            
            #Transfer_Direction := 'Foward';
            
            IF "R_TRIG_DB_24".Q OR "PopUp Conveyor 4 - Pallet present 1" THEN
                "IEC_Timer_0_DB_25".TON(IN := FALSE,
                                        PT := t#0s);
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Roller_Motor.Forward := FALSE;
                #Cnv_Control.Roller_Motor.Reverse := FALSE;
                #Cnv_Control.Roller_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Roller_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        30: // Roller Running (Popup Up)
            IF "Control_DB".Outbound_Cnv.Motor.Status.%X0 THEN
                #Cnv_Control.Running := TRUE;
                #Cnv_Control.Roller_Motor.Forward := TRUE;
                #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Full_Speed;
                #Transfer_Direction := 'Foward';
            END_IF;
            
            IF "R_TRIG_DB_24".Q OR NOT "Outbound Conveyor" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Roller_Motor.Forward := FALSE;
                #Cnv_Control.Roller_Motor.Reverse := FALSE;
                #Cnv_Control.Roller_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Roller_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        60: // Lift Up
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Lift_Motor.Forward := TRUE;
            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Full_Speed;
            #Transfer_Direction := 'Up';
            
            IF #Cnv_Control.Inputs."Lift Up" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Lift_Motor.Forward := FALSE;
                #Cnv_Control.Lift_Motor.Reverse := FALSE;
                #Cnv_Control.Lift_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Lift_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        70: // Lift Down
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Lift_Motor.Reverse := TRUE;
            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Full_Speed;
            #Transfer_Direction := 'Down';
            
            IF #Cnv_Control.Inputs."Lift Down" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Lift_Motor.Forward := FALSE;
                #Cnv_Control.Lift_Motor.Reverse := FALSE;
                #Cnv_Control.Lift_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Lift_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        400: //Error state
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Roller_Motor.Speed := 0;
            #Cnv_Control.Chain_Motor.Speed := 0;
            #Cnv_Control.Lift_Motor.Speed := 0;
            #Cnv_Control.Roller_Motor.Forward := FALSE;
            #Cnv_Control.Chain_Motor.Forward := FALSE;
            #Cnv_Control.Lift_Motor.Forward := FALSE;
            #Cnv_Control.Roller_Motor.Reverse := FALSE;
            #Cnv_Control.Chain_Motor.Reverse := FALSE;
            #Cnv_Control.Lift_Motor.Reverse := FALSE;
            #Cnv_Control.Instruction.Stop := FALSE;
            #Cnv_Control.Instruction.Transfer_in_Progress := FALSE;
            #Watchdog(IN := FALSE,
                      PT := T#0S);
            #Timer_TC(IN := FALSE,
                      PT := T#0S);
            #Timer_Transfer(IN := FALSE,
                            PT := T#0S);
            #IEC_Timer_0_Instance_1(IN := FALSE,
                                    PT := T#0S);
            IF #Cnv_Control.Instruction.Reset THEN
                #Cnv_Control.Warning := 0;
                #Cnv_Control.Current_Task_ID := 0;
                #Cnv_Control.Error := FALSE; //Reset the conveyor
                
                #Cnv_Control.Cnv_Errors.Error_Word_1 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_2 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_3 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_4 := 0;
                #State := 0;
            END_IF;
            
        500:
            IF #Cnv_Control.Enabled THEN
                REGION ROLLER
                    IF #Cnv_Control.Inputs."Lift Up" AND NOT #Cnv_Control.Inputs."Lift Down" THEN
                        IF #Cnv_Control.Instruction.Roller_Fwd OR #Cnv_Control.Instruction.Start_Transfer THEN
                            #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Manual_Speed;
                            #Cnv_Control.Roller_Motor.Forward := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSIF #Cnv_Control.Instruction.Roller_Bwd OR #Cnv_Control.Instruction.Start_Transfer_Backward THEN
                            #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Manual_Speed;
                            #Cnv_Control.Roller_Motor.Reverse := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSE
                            #Cnv_Control.Roller_Motor.Speed := 0;
                            #Cnv_Control.Roller_Motor.Forward := FALSE;
                            #Cnv_Control.Roller_Motor.Reverse := FALSE;
                            #Cnv_Control.Running := FALSE;
                        END_IF;
                    END_IF;
                END_REGION
                
                REGION LIFT
                    IF NOT #SinaSpeed_Roller.AxisEnabled THEN
                        IF #Cnv_Control.Instruction.Lift_Up AND NOT #Cnv_Control.Inputs."Lift Up" THEN
                            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Manual_Speed;
                            #Cnv_Control.Lift_Motor.Forward := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSIF #Cnv_Control.Instruction.Lift_Down AND NOT #Cnv_Control.Inputs."Lift Down" THEN
                            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Manual_Speed;
                            #Cnv_Control.Lift_Motor.Reverse := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSE
                            #Cnv_Control.Lift_Motor.Speed := 0;
                            #Cnv_Control.Lift_Motor.Forward := FALSE;
                            #Cnv_Control.Lift_Motor.Reverse := FALSE;
                            #Cnv_Control.Running := FALSE;
                        END_IF;
                    END_IF;
                END_REGION
            END_IF;
            
            IF #Cnv_Control.Mode <> 1 AND #Cnv_Control.Mode <> 5 THEN
                #State := 0;
            END_IF;
    END_CASE;
END_REGION



REGION Cyclic Error Checks
    IF NOT "Main_Safety_RTG1_DB".SAFETY_OK_CAROUSEL THEN //11:1
        Set_Bit_F(Bit := 0,
                    Bit_Value := 1,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_1);
    END_IF;
    
    // IF #Cnv_Control.Instruction.Stop THEN //11:2
    //     "Set_Bit_F"(Bit := 1,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_1);
    // END_IF;
    
    IF #Cnv_Control.Roller_Motor.Error OR #Cnv_Control.Chain_Motor.Error OR #Cnv_Control.Lift_Motor.Error THEN
        Set_Bit_F(Bit := 0,
                    Bit_Value := 1,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    END_IF;
    
    // Pallet Sensor Checks
    // IF #Cnv_Control.Inputs.Lfwd AND #Cnv_Control.Inputs.Rbwd THEN
    //     #Cnv_Control.Error := TRUE; //15:2 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 1,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // IF #Cnv_Control.Inputs.Lfwd AND #Cnv_Control.Inputs.Lpd1 AND #Cnv_Control.Inputs.Rpd1 THEN
    //     #Cnv_Control.Error := TRUE; //15:3 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 2,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // ELSIF #Cnv_Control.Inputs.Rbwd AND #Cnv_Control.Inputs.Lpd1 AND #Cnv_Control.Inputs.Rpd1 THEN
    //     #Cnv_Control.Error := TRUE; //15:4 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 3,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // END_IF;
    
    // Shuttle in Place Cnv_Inputs - Need to confirm the order of these Cnv_Inputs.
    // IF (#Cnv_Settings.ID > 110000 AND #Cnv_Settings.ID < 120000 AND NOT #Cnv_Control.Inputs.Sdetect1 AND #Cnv_Control.Inputs.Sdetect2)
    //     OR (#Cnv_Settings.ID > 120000 AND #Cnv_Settings.ID < 130000 AND NOT #Cnv_Control.Inputs.Sdetect1 AND #Cnv_Control.Inputs.Sdetect2) THEN
    //     #Cnv_Control.Error := TRUE; //14:5 Shuttle is about to yeet itself down the VTD shaft
    //     "Set_Bit_F"(Bit := 7,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
    //     #State := 400;
    // END_IF;
    
    // IF (#Cnv_Settings.ID > 110000 AND #Cnv_Settings.ID < 120000 AND #Cnv_Control.Inputs.Sdetect1 AND NOT #Cnv_Control.Inputs.Sdetect2)
    //     OR (#Cnv_Settings.ID > 120000 AND #Cnv_Settings.ID < 130000 AND #Cnv_Control.Inputs.Sdetect1 AND NOT #Cnv_Control.Inputs.Sdetect2) THEN
    //     #Cnv_Control.Warning := 0; //Shuttle detected in conveyor not yet on barcode
    // END_IF;
    
    // // #Watchdog auto starts the moment Any form OF transfer occurs.
    // IF #State > 10 AND #State < 400 THEN
    //     #Watchdog(IN := TRUE,
    //               PT := T#200s);
    // ELSE
    //     #Watchdog.IN := FALSE;
    // END_IF;
    
    // IF #Watchdog.Q THEN
    //     #Watchdog.IN := FALSE;
    //     #Cnv_Control.Error := TRUE; //14:2  Watchdog bit
    //     "Set_Bit_F"(Bit := 4,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
    //     #State := 400;
    // END_IF;
    
    // go to error state
    IF #Cnv_Control.Cnv_Errors.Error_Word_1 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_2 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_3 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_4 <> 0
    THEN
        #Cnv_Control.Error := TRUE;
        #State := 400;
    END_IF;
END_REGION

REGION VFD
    REGION ROLLER
        #Cnv_Control.Roller_Motor.Ready := NOT #Cnv_Control.Roller_Motor.Error;
        
        #SinaSpeed_Roller(EnableAxis := #Cnv_Control.Roller_Motor.Forward OR #Cnv_Control.Roller_Motor.Reverse,
                          AckError := #Cnv_Control.Instruction.Reset,
                          SpeedSp := #MainSetpoint_Roller,
                          RefSpeed := 1745.0,
                          HWIDSTW := #Cnv_Settings.Roller_G120_Hardware_ID,
                          HWIDZSW := #Cnv_Settings.Roller_G120_Hardware_ID,
                          AxisEnabled => #Cnv_Control.Roller_Motor.Status.%X0,
                          Lockout => #Cnv_Control.Roller_Motor.Error,
                          Error => #Cnv_Control.Roller_Motor.Error);
        
        //MAIN SETPOINT
        IF #Cnv_Control.Roller_Motor.Reverse THEN
            #MainSetpoint_Roller := (SCALE_X(MIN := 0,
                                             VALUE := NORM_X(MIN := 0,
                                                             VALUE := #Cnv_Control.Roller_Motor.Speed,
                                                             MAX := 100),
                                             MAX := 1745.0) * -1);
        ELSIF #Cnv_Control.Roller_Motor.Forward THEN
            #MainSetpoint_Roller := SCALE_X(MIN := 0,
                                            VALUE := NORM_X(MIN := 0,
                                                            VALUE := #Cnv_Control.Roller_Motor.Speed,
                                                            MAX := 100),
                                            MAX := 1745.0);
        ELSE
            #MainSetpoint_Roller := 0;
        END_IF;
        
        REGION Actual Speed
            IF #MainSetpoint_Roller > 0 THEN
                #Cnv_Control.Roller_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                  VALUE := NORM_X(MIN := 0,
                                                                                  VALUE := #SinaSpeed_Roller.ActVelocity,
                                                                                  MAX := 1745.0),
                                                                  MAX := 100);
            ELSIF #MainSetpoint_Roller < 0 THEN
                #Cnv_Control.Roller_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                  VALUE := NORM_X(MIN := 0,
                                                                                  VALUE := #SinaSpeed_Roller.ActVelocity * -1,
                                                                                  MAX := 1745.0),
                                                                  MAX := 100);
            ELSE
                #Cnv_Control.Roller_Motor.Speed_Actual := 0;
            END_IF;
        END_REGION
    END_REGION
    
    REGION LIFT
        #Cnv_Control.Lift_Motor.Ready := NOT #Cnv_Control.Lift_Motor.Error;
        
        #SinaSpeed_Lift(EnableAxis := #Cnv_Control.Lift_Motor.Forward OR #Cnv_Control.Lift_Motor.Reverse,
                        AckError := #Cnv_Control.Instruction.Reset,
                        SpeedSp := #MainSetpoint_Lift,
                        RefSpeed := 1745.0,
                        HWIDSTW := #Cnv_Settings.Lift_G120_Hardware_ID,
                        HWIDZSW := #Cnv_Settings.Lift_G120_Hardware_ID,
                        AxisEnabled => #Cnv_Control.Lift_Motor.Status.%X0,
                        Lockout => #Cnv_Control.Lift_Motor.Error,
                        Error => #Cnv_Control.Lift_Motor.Error);
        
        //MAIN SETPOINT
        IF #Cnv_Control.Lift_Motor.Reverse THEN
            #MainSetpoint_Lift := (SCALE_X(MIN := 0,
                                           VALUE := NORM_X(MIN := 0,
                                                           VALUE := #Cnv_Control.Lift_Motor.Speed,
                                                           MAX := 100),
                                           MAX := 1745.0) * -1);
        ELSIF #Cnv_Control.Lift_Motor.Forward THEN
            #MainSetpoint_Lift := SCALE_X(MIN := 0,
                                          VALUE := NORM_X(MIN := 0,
                                                          VALUE := #Cnv_Control.Lift_Motor.Speed,
                                                          MAX := 100),
                                          MAX := 1745.0);
        ELSE
            #MainSetpoint_Lift := 0;
        END_IF;
        
        REGION Actual Speed
            IF #MainSetpoint_Lift > 0 THEN
                #Cnv_Control.Lift_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                VALUE := NORM_X(MIN := 0,
                                                                                VALUE := #SinaSpeed_Lift.ActVelocity,
                                                                                MAX := 1745.0),
                                                                MAX := 100);
            ELSIF #MainSetpoint_Lift < 0 THEN
                #Cnv_Control.Lift_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                VALUE := NORM_X(MIN := 0,
                                                                                VALUE := #SinaSpeed_Lift.ActVelocity * -1,
                                                                                MAX := 1745.0),
                                                                MAX := 100);
            ELSE
                #Cnv_Control.Lift_Motor.Speed_Actual := 0;
            END_IF;
        END_REGION
    END_REGION
END_REGION
END_FUNCTION_BLOCK

// ============================================================================
FUNCTION_BLOCK "PConveyor_1_FB_1"

VAR_INPUT
   Cnv_Settings : "PopUp_Cnv_Settings";
END_VAR

VAR_IN_OUT
   Cnv_Control : "PopUp_Cnv_Control";
   SinaSpeed_Roller : SinaSpeed;
   SinaSpeed_Chain : SinaSpeed;
   SinaSpeed_Lift : SinaSpeed;
END_VAR

VAR
   State : UInt;
   Timer_TC : TON_TIME;
   Timer_Transfer : TON_TIME;
   Watchdog : TON_TIME;
   Transfer_Direction : String;
   MainSetpoint_Roller : Int;
   MainSetpoint_Chain : Int;
   MainSetpoint_Lift : Int;
   IEC_Timer_0_Instance_1 : TON_TIME;
   R_TRIG_Instance : R_TRIG;
END_VAR

VAR_TEMP
   Execute_Old : Bool;
   Stop_Old : Bool;
END_VAR

BEGIN
"R_TRIG_DB_13"(CLK := #Cnv_Control.Instruction.Execute AND NOT #Execute_Old);
"R_TRIG_DB_14"(CLK := #Cnv_Control.Instruction.Stop AND NOT #Stop_Old);

#Execute_Old := #Cnv_Control.Instruction.Execute;
#Stop_Old := #Cnv_Control.Instruction.Stop;

#Cnv_Control.Enabled := #Cnv_Control.Instruction.Enable;

//MODES
#Cnv_Control.Mode := #Cnv_Control.Instruction.Mode_Change;
IF (#Cnv_Control.Mode = 1 OR #Cnv_Control.Mode = 5) AND NOT #Cnv_Control.Error THEN
    #State := 500;
END_IF;

#R_TRIG_Instance(CLK := #Cnv_Control.Mode = 3);
IF #R_TRIG_Instance.Q THEN
    #State := 0;
END_IF;

(*
TODO:
01. Need to add statemachine watchdog - Done
02. Extractor needs to be on same floor for pallet to be moved in manual passed Rbwd - Done
03. Complete reset state - Done
04. Add stop inputs - Done
05. Need to add variable motor speed, manual needs to be slower. - Done
06. Need to add cyclic error checking. For odd sensor combinations as well - Partially done
07. Need to add Shuttle monitor - Done
08. Need to add Task ID check and start bit check to outbound pallet move. Check direction of pallet movement based on connected Cnv.
09. Need to add checks for wrong direction of travel - Done
10. Add checks for unsafe conditions with Cnv_Inputs - Partially Done
11. Define Error codes - DOne
12. Add watchdof time to Cnv Settings - Done
13. Add self-timeout on manual 
14. For shuttle in place sensor checks take into account extractor floor and safety stopper state
15. Confirm modes and states are correct (Semi-auto and maintenance as well)
16. Add the correct transfer process for the logistex-spacemaker pallet handovers.

Mode select is done via the HMI. Might add external mode select switches.
        
        Mode select mask:
        0: Disabled
        1: Manual
        2: Semi-Auto
        3: Auto
        4: Teach - N/A for Cnv
        5: Maintenance
        
Device ID Format: XXYYZZ    
XX = Device type   
    01   VTD
    10  Cnv_Front_of_VTD
    11  Cnv_Rear_of_VTD
    12  Cnv_On_Extractor
    20  Safety_Stop_Front_of_VTD
    21  Safety_Stop_Rear_of_VTD
YY = Floor   
ZZ = VTD Connected to    
Example: 110203 Conveyor at the rear of VTD 3 on level 2

Pallet Alignment
0 = no alignment
1 = center alignment
2 = Left
3 = Right

 Sensor order for the conveyor:
 Lfwd Lpd1 Lpd2
  []   []   []
 ##############################
 #        Pallet Flow         #
 #         ------->>          #
 #                            #
 #                            #
 ##############################
                  []   []   []
                 Rpd2 Rpd1 Rbwd      
*)

REGION Cyclic Checks    
    // Update the pallet type as the Cnv_Inputs are triggered.
    #Cnv_Control.Cnv_Occupied := "PopUp Conveyor 2 - Pallet present 3";
    
    // Update the Cnv_Control opbject
    #Cnv_Control.SM_State := #State;
    #Cnv_Control.Stopped := NOT #Cnv_Control.Running;
    IF #Cnv_Control.Instruction.Inbound_Ready OR #Cnv_Control.Instruction.Outbound_Ready THEN
        #Cnv_Control.Ready_For_Task := TRUE;
    ELSE
        #Cnv_Control.Ready_For_Task := FALSE;
    END_IF;
END_REGION

REGION Auto/Semi auto mode
    CASE #State OF
        0: //Initialization
            #Cnv_Control.Instruction.Transfer_Complete := 0;
            #Cnv_Control.Instruction.Transfer_in_Progress := FALSE;
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Roller_Motor.Forward := FALSE;
            #Cnv_Control.Roller_Motor.Reverse := FALSE;
            #Cnv_Control.Roller_Motor.Speed := 0;
            #Cnv_Control.Chain_Motor.Forward := FALSE;
            #Cnv_Control.Chain_Motor.Reverse := FALSE;
            #Cnv_Control.Chain_Motor.Speed := 0;
            #Cnv_Control.Lift_Motor.Forward := FALSE;
            #Cnv_Control.Lift_Motor.Reverse := FALSE;
            #Cnv_Control.Lift_Motor.Speed := 0;
            #Transfer_Direction := '';
            #Timer_Transfer(IN := FALSE,
                            PT := T#0ms);
            IF #Cnv_Control.Enabled AND (#Cnv_Control.Mode = 3 OR #Cnv_Control.Mode = 2) AND #Cnv_Control.Error = 0 THEN
                #State := 10;
            END_IF;
            
        10: //Standby - Conveyor ready to receive instruction
            IF ("R_TRIG_DB_13".Q OR #Cnv_Control.Instruction.Start_Transfer) THEN
                //Inbound Transfer
                IF #Cnv_Control.Instruction.Inbound_Ready AND NOT #Cnv_Control.Running AND #Cnv_Control.Error = 0 THEN
                    //Check transfer ID FROM Inbound conveyor
                    IF  #Cnv_Control.Inputs."Lift Up" THEN
                        #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 20;// Roller Running (Popup Up)
                    ELSIF "Pick Station" AND
                        #Cnv_Control.Inputs."Lift Down" (*AND "Control_DB".PopUp_Cnv[4].Inputs."Lift Down"*) THEN //TO pick station
                        #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 30;// Chain Running (Popup Down) 
                    ELSIF NOT "Pick Station" (*AND "Control_DB".PopUp_Cnv[4].Inputs."Lift Down"*) THEN //FROM pick station
                        #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 40;
                    ELSE
                        #Cnv_Control.Warning := 1; //Cannot transfer from that conveyor
                    END_IF;
                    
                    //Outbound Transfer    
                ELSIF #Cnv_Control.Instruction.Outbound_Ready AND NOT #Cnv_Control.Running AND #Cnv_Control.Error = 0 THEN
                    //Check transfer ID TO popup cpnveyor 2
                    IF #Cnv_Control.Inputs."Lift Up" AND "Control_DB".PopUp_Cnv[2].Inputs."Lift Up" THEN
                        #Cnv_Control.Done := FALSE;
                        #Cnv_Control.Instruction.Transfer_in_Progress := TRUE;
                        #Cnv_Control.Current_Task_ID := #Cnv_Control.Instruction.Task_ID;
                        #State := 50;
                    ELSE
                        #Cnv_Control.Warning := 1; //Cannot transfer TO that conveyor
                    END_IF;
                ELSE
                    #Cnv_Control.Warning := 0;// No task that can be started, yet start bit has been made true.
                END_IF;
            ELSIF #Cnv_Control.Instruction.Start_Transfer AND "Control_DB".VTD_Control.Current_Level <> 0 THEN
                //Extractor not at the correct level
                Set_Bit_F(Bit := 2,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_3);
            END_IF;
            IF #Cnv_Control.Instruction.Lift_Up THEN
                #Cnv_Control.Done := FALSE;
                #State := 60; // Lift UP
            ELSIF #Cnv_Control.Instruction.Lift_Down THEN
                #Cnv_Control.Done := FALSE;
                #State := 70; // Lift Down
            END_IF;
            
        20: // Roller Running (Popup Up)
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Roller_Motor.Forward := TRUE;
            #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Full_Speed;
            #Transfer_Direction := 'Foward';
            
            IF "R_TRIG_DB_14".Q OR "PopUp Conveyor 2 - Pallet present 3" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Roller_Motor.Forward := FALSE;
                #Cnv_Control.Roller_Motor.Reverse := FALSE;
                #Cnv_Control.Roller_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := "Control_DB".Inbound_Cnv.Running,
                            PT := UINT_TO_TIME(#Cnv_Settings.Roller_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        30: // Chain Running (Popup Down)
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Chain_Motor.Forward := TRUE;
            #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Full_Speed;
            #Transfer_Direction := 'Foward';
            
            IF "R_TRIG_DB_14".Q OR NOT "Pick Station" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Chain_Motor.Forward := FALSE;
                #Cnv_Control.Chain_Motor.Reverse := FALSE;
                #Cnv_Control.Chain_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := "LighGuard_Cut-Off Path 01",
                            PT := UINT_TO_TIME(#Cnv_Settings.Chain_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        40: // Chain Running (Popup Down)
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Chain_Motor.Forward := TRUE;
            #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Full_Speed;
            #Transfer_Direction := 'Foward';
            
            IF "R_TRIG_DB_14".Q OR "PopUp Conveyor 1 - Pallet sensor" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Chain_Motor.Forward := FALSE;
                #Cnv_Control.Chain_Motor.Reverse := FALSE;
                #Cnv_Control.Chain_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := "LighGuard_Cut-Off Path 01",
                            PT := UINT_TO_TIME(#Cnv_Settings.Chain_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        50: // Roller Running (Popup Up)
            IF "Control_DB".PopUp_Cnv[2].Roller_Motor.Status.%X0 THEN//Is running
                #Cnv_Control.Running := TRUE;
                #Cnv_Control.Roller_Motor.Forward := TRUE;
                #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Full_Speed;
                #Transfer_Direction := 'Foward';
            END_IF;
            
            IF "R_TRIG_DB_14".Q OR "PopUp Conveyor 2 - Pallet present 4" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Roller_Motor.Forward := FALSE;
                #Cnv_Control.Roller_Motor.Reverse := FALSE;
                #Cnv_Control.Roller_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := TRUE,
                            PT := UINT_TO_TIME(#Cnv_Settings.Roller_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        60: // Lift Up
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Lift_Motor.Forward := TRUE;
            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Full_Speed;
            #Transfer_Direction := 'Up';
            
            IF #Cnv_Control.Inputs."Lift Up" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Lift_Motor.Forward := FALSE;
                #Cnv_Control.Lift_Motor.Reverse := FALSE;
                #Cnv_Control.Lift_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := "LighGuard_Cut-Off Path 01",
                            PT := UINT_TO_TIME(#Cnv_Settings.Lift_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        70: // Lift Down
            #Cnv_Control.Running := TRUE;
            #Cnv_Control.Lift_Motor.Reverse := TRUE;
            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Full_Speed;
            #Transfer_Direction := 'Down';
            
            IF #Cnv_Control.Inputs."Lift Down" THEN
                #Cnv_Control.Done := TRUE;
                #Cnv_Control.Lift_Motor.Forward := FALSE;
                #Cnv_Control.Lift_Motor.Reverse := FALSE;
                #Cnv_Control.Lift_Motor.Speed := 0;
                #Transfer_Direction := '';
                #State := 0;
            END_IF;
            
            //Monitor the transfer progress
            #Timer_Transfer(IN := "LighGuard_Cut-Off Path 01",
                            PT := UINT_TO_TIME(#Cnv_Settings.Lift_Transfer_Time) * 1000);
            //If the watchdog bites, kill the process
            IF #Timer_Transfer.Q THEN //14:1 Transfer timed out
                Set_Bit_F(Bit := 3,
                            Bit_Value := 1,
                            Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
            END_IF;
            
        400: //Error state
            #Cnv_Control.Running := FALSE;
            #Cnv_Control.Roller_Motor.Speed := 0;
            #Cnv_Control.Chain_Motor.Speed := 0;
            #Cnv_Control.Lift_Motor.Speed := 0;
            #Cnv_Control.Roller_Motor.Forward := FALSE;
            #Cnv_Control.Chain_Motor.Forward := FALSE;
            #Cnv_Control.Lift_Motor.Forward := FALSE;
            #Cnv_Control.Roller_Motor.Reverse := FALSE;
            #Cnv_Control.Chain_Motor.Reverse := FALSE;
            #Cnv_Control.Lift_Motor.Reverse := FALSE;
            #Cnv_Control.Instruction.Stop := FALSE;
            #Cnv_Control.Instruction.Transfer_in_Progress := FALSE;
            #Watchdog(IN := FALSE,
                      PT := T#0S);
            #Timer_TC(IN := FALSE,
                      PT := T#0S);
            #Timer_Transfer(IN := FALSE,
                            PT := T#0S);
            #IEC_Timer_0_Instance_1(IN := FALSE,
                                    PT := T#0S);
            IF #Cnv_Control.Instruction.Reset THEN
                #Cnv_Control.Warning := 0;
                #Cnv_Control.Current_Task_ID := 0;
                #Cnv_Control.Error := FALSE; //Reset the conveyor
                
                #Cnv_Control.Cnv_Errors.Error_Word_1 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_2 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_3 := 0;
                #Cnv_Control.Cnv_Errors.Error_Word_4 := 0;
                #State := 0;
            END_IF;
            
        500:
            IF #Cnv_Control.Enabled THEN
                REGION ROLLER
                    IF #Cnv_Control.Inputs."Lift Up" AND NOT #Cnv_Control.Inputs."Lift Down" THEN
                        IF #Cnv_Control.Instruction.Roller_Fwd OR #Cnv_Control.Instruction.Start_Transfer THEN
                            #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Manual_Speed;
                            #Cnv_Control.Roller_Motor.Forward := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSIF #Cnv_Control.Instruction.Roller_Bwd OR #Cnv_Control.Instruction.Start_Transfer_Backward THEN
                            #Cnv_Control.Roller_Motor.Speed := #Cnv_Settings.Roller_Manual_Speed;
                            #Cnv_Control.Roller_Motor.Reverse := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSE
                            #Cnv_Control.Roller_Motor.Speed := 0;
                            #Cnv_Control.Roller_Motor.Forward := FALSE;
                            #Cnv_Control.Roller_Motor.Reverse := FALSE;
                            #Cnv_Control.Running := FALSE;
                        END_IF;
                    END_IF;
                END_REGION
                
                REGION CHAIN
                    IF NOT #Cnv_Control.Inputs."Lift Up" AND #Cnv_Control.Inputs."Lift Down"
                        AND "Control_DB".PopUp_Cnv[4].Inputs."Lift Down" AND NOT "Control_DB".PopUp_Cnv[4].Inputs."Lift Up" THEN
                        IF #Cnv_Control.Instruction.Chain_Fwd OR #Cnv_Control.Instruction.Start_Transfer THEN
                            #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Manual_Speed;
                            #Cnv_Control.Chain_Motor.Forward := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSIF #Cnv_Control.Instruction.Chain_Bwd OR #Cnv_Control.Instruction.Start_Transfer_Backward THEN
                            #Cnv_Control.Chain_Motor.Speed := #Cnv_Settings.Chain_Manual_Speed;
                            #Cnv_Control.Chain_Motor.Reverse := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSE
                            #Cnv_Control.Chain_Motor.Speed := 0;
                            #Cnv_Control.Chain_Motor.Forward := FALSE;
                            #Cnv_Control.Chain_Motor.Reverse := FALSE;
                            #Cnv_Control.Running := FALSE;
                        END_IF;
                    END_IF;
                END_REGION
                
                REGION LIFT
                    IF NOT #SinaSpeed_Roller.AxisEnabled AND NOT #SinaSpeed_Chain.AxisEnabled THEN
                        IF #Cnv_Control.Instruction.Lift_Up AND NOT #Cnv_Control.Inputs."Lift Up" THEN
                            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Manual_Speed;
                            #Cnv_Control.Lift_Motor.Forward := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSIF #Cnv_Control.Instruction.Lift_Down AND NOT #Cnv_Control.Inputs."Lift Down" THEN
                            #Cnv_Control.Lift_Motor.Speed := #Cnv_Settings.Lift_Manual_Speed;
                            #Cnv_Control.Lift_Motor.Reverse := TRUE;
                            #Cnv_Control.Running := TRUE;
                        ELSE
                            #Cnv_Control.Lift_Motor.Speed := 0;
                            #Cnv_Control.Lift_Motor.Forward := FALSE;
                            #Cnv_Control.Lift_Motor.Reverse := FALSE;
                            #Cnv_Control.Running := FALSE;
                        END_IF;
                    END_IF;
                END_REGION
            END_IF;
            
            IF #Cnv_Control.Mode <> 1 AND #Cnv_Control.Mode <> 5 THEN
                #State := 0;
            END_IF;
    END_CASE;
END_REGION



REGION Cyclic Error Checks
    IF NOT "Main_Safety_RTG1_DB".SAFETY_OK_CAROUSEL THEN //11:1
        Set_Bit_F(Bit := 0,
                    Bit_Value := 1,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_1);
    END_IF;
    
    // IF #Cnv_Control.Instruction.Stop THEN //11:2
    //     "Set_Bit_F"(Bit := 1,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_1);
    // END_IF;
    
    IF #Cnv_Control.Roller_Motor.Error OR #Cnv_Control.Chain_Motor.Error OR #Cnv_Control.Lift_Motor.Error THEN
        Set_Bit_F(Bit := 0,
                    Bit_Value := 1,
                    Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    END_IF;
    
    // Pallet Sensor Checks
    // IF #Cnv_Control.Inputs.Lfwd AND #Cnv_Control.Inputs.Rbwd THEN
    //     #Cnv_Control.Error := TRUE; //15:2 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 1,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // IF #Cnv_Control.Inputs.Lfwd AND #Cnv_Control.Inputs.Lpd1 AND #Cnv_Control.Inputs.Rpd1 THEN
    //     #Cnv_Control.Error := TRUE; //15:3 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 2,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // ELSIF #Cnv_Control.Inputs.Rbwd AND #Cnv_Control.Inputs.Lpd1 AND #Cnv_Control.Inputs.Rpd1 THEN
    //     #Cnv_Control.Error := TRUE; //15:4 Combination of Cnv_Inputs indicates issue in conveyor
    //     "Set_Bit_F"(Bit := 3,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_4);
    //     #State := 400;
    // END_IF;
    
    // Shuttle in Place Cnv_Inputs - Need to confirm the order of these Cnv_Inputs.
    // IF (#Cnv_Settings.ID > 110000 AND #Cnv_Settings.ID < 120000 AND NOT #Cnv_Control.Inputs.Sdetect1 AND #Cnv_Control.Inputs.Sdetect2)
    //     OR (#Cnv_Settings.ID > 120000 AND #Cnv_Settings.ID < 130000 AND NOT #Cnv_Control.Inputs.Sdetect1 AND #Cnv_Control.Inputs.Sdetect2) THEN
    //     #Cnv_Control.Error := TRUE; //14:5 Shuttle is about to yeet itself down the VTD shaft
    //     "Set_Bit_F"(Bit := 7,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
    //     #State := 400;
    // END_IF;
    
    // IF (#Cnv_Settings.ID > 110000 AND #Cnv_Settings.ID < 120000 AND #Cnv_Control.Inputs.Sdetect1 AND NOT #Cnv_Control.Inputs.Sdetect2)
    //     OR (#Cnv_Settings.ID > 120000 AND #Cnv_Settings.ID < 130000 AND #Cnv_Control.Inputs.Sdetect1 AND NOT #Cnv_Control.Inputs.Sdetect2) THEN
    //     #Cnv_Control.Warning := 0; //Shuttle detected in conveyor not yet on barcode
    // END_IF;
    
    // // #Watchdog auto starts the moment Any form OF transfer occurs.
    // IF #State > 10 AND #State < 400 THEN
    //     #Watchdog(IN := TRUE,
    //               PT := T#200s);
    // ELSE
    //     #Watchdog.IN := FALSE;
    // END_IF;
    
    // IF #Watchdog.Q THEN
    //     #Watchdog.IN := FALSE;
    //     #Cnv_Control.Error := TRUE; //14:2  Watchdog bit
    //     "Set_Bit_F"(Bit := 4,
    //                 Bit_Value := 1,
    //                 Var := #Cnv_Control.Cnv_Errors.Error_Word_2);
    //     #State := 400;
    // END_IF;
    
    // go to error state
    IF #Cnv_Control.Cnv_Errors.Error_Word_1 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_2 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_3 <> 0 OR
        #Cnv_Control.Cnv_Errors.Error_Word_4 <> 0
    THEN
        #Cnv_Control.Error := TRUE;
        #State := 400;
    END_IF;
END_REGION

REGION VFD
    REGION ROLLER
        #Cnv_Control.Roller_Motor.Ready := NOT #Cnv_Control.Roller_Motor.Error;
        
        #SinaSpeed_Roller(EnableAxis := #Cnv_Control.Roller_Motor.Forward OR #Cnv_Control.Roller_Motor.Reverse,
                          AckError := #Cnv_Control.Instruction.Reset,
                          SpeedSp := #MainSetpoint_Roller,
                          RefSpeed := 1745.0,
                          HWIDSTW := #Cnv_Settings.Roller_G120_Hardware_ID,
                          HWIDZSW := #Cnv_Settings.Roller_G120_Hardware_ID,
                          AxisEnabled => #Cnv_Control.Roller_Motor.Status.%X0,
                          Lockout => #Cnv_Control.Roller_Motor.Error,
                          Error => #Cnv_Control.Roller_Motor.Error);
        
        //MAIN SETPOINT
        IF #Cnv_Control.Roller_Motor.Reverse THEN
            #MainSetpoint_Roller := (SCALE_X(MIN := 0,
                                             VALUE := NORM_X(MIN := 0,
                                                             VALUE := #Cnv_Control.Roller_Motor.Speed,
                                                             MAX := 100),
                                             MAX := 1745.0) * -1);
        ELSIF #Cnv_Control.Roller_Motor.Forward THEN
            #MainSetpoint_Roller := SCALE_X(MIN := 0,
                                            VALUE := NORM_X(MIN := 0,
                                                            VALUE := #Cnv_Control.Roller_Motor.Speed,
                                                            MAX := 100),
                                            MAX := 1745.0);
        ELSE
            #MainSetpoint_Roller := 0;
        END_IF;
        
        REGION Actual Speed
            IF #MainSetpoint_Roller > 0 THEN
                #Cnv_Control.Roller_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                  VALUE := NORM_X(MIN := 0,
                                                                                  VALUE := #SinaSpeed_Roller.ActVelocity,
                                                                                  MAX := 1745.0),
                                                                  MAX := 100);
            ELSIF #MainSetpoint_Roller < 0 THEN
                #Cnv_Control.Roller_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                  VALUE := NORM_X(MIN := 0,
                                                                                  VALUE := #SinaSpeed_Roller.ActVelocity * -1,
                                                                                  MAX := 1745.0),
                                                                  MAX := 100);
            ELSE
                #Cnv_Control.Roller_Motor.Speed_Actual := 0;
            END_IF;
        END_REGION
    END_REGION
    
    REGION CHAIN
        #Cnv_Control.Chain_Motor.Ready := NOT #Cnv_Control.Chain_Motor.Error;
        
        #SinaSpeed_Chain(EnableAxis := (#Cnv_Control.Chain_Motor.Forward OR #Cnv_Control.Chain_Motor.Reverse) AND "LighGuard_Cut-Off Path 01",
                         AckError := #Cnv_Control.Instruction.Reset,
                         SpeedSp := #MainSetpoint_Chain,
                         RefSpeed := 1745.0,
                         HWIDSTW := #Cnv_Settings.Chain_G120_Hardware_ID,
                         HWIDZSW := #Cnv_Settings.Chain_G120_Hardware_ID,
                         AxisEnabled => #Cnv_Control.Chain_Motor.Status.%X0,
                         Lockout => #Cnv_Control.Chain_Motor.Error,
                         Error => #Cnv_Control.Chain_Motor.Error);
        
        //MAIN SETPOINT
        IF #Cnv_Control.Chain_Motor.Reverse AND "LighGuard_Cut-Off Path 01" THEN
            #MainSetpoint_Chain := (SCALE_X(MIN := 0,
                                            VALUE := NORM_X(MIN := 0,
                                                            VALUE := #Cnv_Control.Chain_Motor.Speed,
                                                            MAX := 100),
                                            MAX := 1745.0) * -1);
        ELSIF #Cnv_Control.Chain_Motor.Forward AND "LighGuard_Cut-Off Path 01" THEN
            #MainSetpoint_Chain := SCALE_X(MIN := 0,
                                           VALUE := NORM_X(MIN := 0,
                                                           VALUE := #Cnv_Control.Chain_Motor.Speed,
                                                           MAX := 100),
                                           MAX := 1745.0);
        ELSE
            #MainSetpoint_Chain := 0;
        END_IF;
        
        REGION Actual Speed
            IF #MainSetpoint_Chain > 0 THEN
                #Cnv_Control.Chain_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                 VALUE := NORM_X(MIN := 0,
                                                                                 VALUE := #SinaSpeed_Chain.ActVelocity,
                                                                                 MAX := 1745.0),
                                                                 MAX := 100);
            ELSIF #MainSetpoint_Chain < 0 THEN
                #Cnv_Control.Chain_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                 VALUE := NORM_X(MIN := 0,
                                                                                 VALUE := #SinaSpeed_Chain.ActVelocity * -1,
                                                                                 MAX := 1745.0),
                                                                 MAX := 100);
            ELSE
                #Cnv_Control.Chain_Motor.Speed_Actual := 0;
            END_IF;
        END_REGION
    END_REGION
    
    REGION LIFT
        #Cnv_Control.Lift_Motor.Ready := NOT #Cnv_Control.Lift_Motor.Error;
        
        #SinaSpeed_Lift(EnableAxis := (#Cnv_Control.Lift_Motor.Forward OR #Cnv_Control.Lift_Motor.Reverse) AND "LighGuard_Cut-Off Path 01",
                        AckError := #Cnv_Control.Instruction.Reset,
                        SpeedSp := #MainSetpoint_Lift,
                        RefSpeed := 1745.0,
                        HWIDSTW := #Cnv_Settings.Lift_G120_Hardware_ID,
                        HWIDZSW := #Cnv_Settings.Lift_G120_Hardware_ID,
                        AxisEnabled => #Cnv_Control.Lift_Motor.Status.%X0,
                        Lockout => #Cnv_Control.Lift_Motor.Error,
                        Error => #Cnv_Control.Lift_Motor.Error);
        
        //MAIN SETPOINT
        IF #Cnv_Control.Lift_Motor.Reverse AND "LighGuard_Cut-Off Path 01" THEN
            #MainSetpoint_Lift := (SCALE_X(MIN := 0,
                                           VALUE := NORM_X(MIN := 0,
                                                           VALUE := #Cnv_Control.Lift_Motor.Speed,
                                                           MAX := 100),
                                           MAX := 1745.0) * -1);
        ELSIF #Cnv_Control.Lift_Motor.Forward AND "LighGuard_Cut-Off Path 01" THEN
            #MainSetpoint_Lift := SCALE_X(MIN := 0,
                                          VALUE := NORM_X(MIN := 0,
                                                          VALUE := #Cnv_Control.Lift_Motor.Speed,
                                                          MAX := 100),
                                          MAX := 1745.0);
        ELSE
            #MainSetpoint_Lift := 0;
        END_IF;
        
        REGION Actual Speed
            IF #MainSetpoint_Lift > 0 THEN
                #Cnv_Control.Lift_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                VALUE := NORM_X(MIN := 0,
                                                                                VALUE := #SinaSpeed_Lift.ActVelocity,
                                                                                MAX := 1745.0),
                                                                MAX := 100);
            ELSIF #MainSetpoint_Lift < 0 THEN
                #Cnv_Control.Lift_Motor.Speed_Actual := SCALE_X(MIN := 0,
                                                                VALUE := NORM_X(MIN := 0,
                                                                                VALUE := #SinaSpeed_Lift.ActVelocity * -1,
                                                                                MAX := 1745.0),
                                                                MAX := 100);
            ELSE
                #Cnv_Control.Lift_Motor.Speed_Actual := 0;
            END_IF;
        END_REGION
    END_REGION
END_REGION
END_FUNCTION_BLOCK

// ============================================================================
FUNCTION "Conveyors_Transfer"

VAR_TEMP
   i : Int;
END_VAR

   // RETURN : Void
BEGIN
//ID OF THE VTD CONVEYOR
IF "Control_DB".VTD_Control.Current_Level = 0 THEN
    "Settings_DB".ECnv_Settings.ID := 120001;
    "Settings_DB".ECnv_Settings.Cnv_Level := 0;
ELSIF "Control_DB".VTD_Control.Current_Level = 1 THEN
    "Settings_DB".ECnv_Settings.ID := 120101;
    "Settings_DB".ECnv_Settings.Cnv_Level := 1;
ELSIF "Control_DB".VTD_Control.Current_Level = 2 THEN
    "Settings_DB".ECnv_Settings.ID := 120201;
    "Settings_DB".ECnv_Settings.Cnv_Level := 2;
ELSIF "Control_DB".VTD_Control.Current_Level = 3 THEN
    "Settings_DB".ECnv_Settings.ID := 120301;
    "Settings_DB".ECnv_Settings.Cnv_Level := 3;
ELSE
    "Settings_DB".ECnv_Settings.ID := 129901;
    "Settings_DB".ECnv_Settings.Cnv_Level := 99;
END_IF;

REGION READY TO RECEIVE
    //EXTRACTOR CONVEYOR
    "Control_DB".ECnv_Control.Instruction.Inbound_Ready :=
    ("Settings_DB".ECnv_Settings.ID = 120001 OR
    "Settings_DB".ECnv_Settings.ID = 120101 OR
    "Settings_DB".ECnv_Settings.ID = 120201 OR
    "Settings_DB".ECnv_Settings.ID = 120301)
    AND NOT "Control_DB".ECnv_Control.Cnv_Occupied AND NOT "Control_DB".ECnv_Control.Instruction.Outbound_Ready AND
    ("Control_DB".ECnv_Control.Mode = 2 OR "Control_DB".ECnv_Control.Mode = 3);
    
    //BUFFER CONVEYORS
    FOR #i := 1 TO 3 DO
        "Control_DB".LCnv_Control[#i].Instruction.Inbound_Ready :=
        NOT "Control_DB".LCnv_Control[#i].Running AND
        NOT "Control_DB".LCnv_Control[#i].Cnv_Occupied AND NOT "Control_DB".LCnv_Control[#i].Instruction.Outbound_Ready AND
        ("Control_DB".LCnv_Control[#i].Mode = 2 OR "Control_DB".LCnv_Control[#i].Mode = 3);
    END_FOR;
    
    //POPUP CONVEYORS
    FOR #i := 1 TO 4 DO
        "Control_DB".PopUp_Cnv[#i].Instruction.Inbound_Ready :=
        NOT "Control_DB".PopUp_Cnv[#i].Running AND
        NOT "Control_DB".PopUp_Cnv[#i].Cnv_Occupied AND NOT "Control_DB".PopUp_Cnv[#i].Instruction.Outbound_Ready AND
        ("Control_DB".PopUp_Cnv[#i].Mode = 2 OR "Control_DB".PopUp_Cnv[#i].Mode = 3);
    END_FOR;
    
    //INBOUND CONVEYOR
    "Control_DB".Inbound_Cnv.Instruction.Inbound_Ready := NOT "Control_DB".Inbound_Cnv.Cnv_Occupied;
    
    //OUTBOUND CONVEYOR
    "Control_DB".Outbound_Cnv.Instruction.Inbound_Ready :=
    NOT "Control_DB".Outbound_Cnv.Running AND
    NOT "Control_DB".Outbound_Cnv.Cnv_Occupied AND NOT "Control_DB".Outbound_Cnv.Instruction.Outbound_Ready AND
    ("Control_DB".Outbound_Cnv.Mode = 2 OR "Control_DB".Outbound_Cnv.Mode = 3);
    
    //PICK CONVEYOR
    "Control_DB".Pick_Station.Instruction.Inbound_Ready :=
    NOT "Control_DB".Pick_Station.Running AND
    NOT "Control_DB".Pick_Station.Cnv_Occupied AND NOT "Control_DB".Pick_Station.Instruction.Outbound_Ready AND
    ("Control_DB".Pick_Station.Mode = 2 OR "Control_DB".Pick_Station.Mode = 3);
END_REGION

REGION READY TO SEND
    //EXTRACTOR CONVEYOR
    "Control_DB".ECnv_Control.Instruction.Outbound_Ready :=
    (("Settings_DB".ECnv_Settings.ID = 120001 AND "Control_DB".ECnv_Control.Cnv_Occupied AND
    NOT "Control_DB".PopUp_Cnv[2].Cnv_Occupied AND ("Control_DB".PopUp_Cnv[2].Mode = 2 OR "Control_DB".PopUp_Cnv[2].Mode = 3)
    AND NOT "Control_DB".PopUp_Cnv[2].Error)
    OR
    ("Settings_DB".ECnv_Settings.ID = 120101 AND "Control_DB".ECnv_Control.Cnv_Occupied AND
    NOT "Control_DB".LCnv_Control[1].Cnv_Occupied AND ("Control_DB".LCnv_Control[1].Mode = 2 OR "Control_DB".LCnv_Control[1].Mode = 3)
    AND NOT "Control_DB".LCnv_Control[1].Error)
    OR
    ("Settings_DB".ECnv_Settings.ID = 120201 AND "Control_DB".ECnv_Control.Cnv_Occupied AND
    NOT "Control_DB".LCnv_Control[2].Cnv_Occupied AND ("Control_DB".LCnv_Control[2].Mode = 2 OR "Control_DB".LCnv_Control[2].Mode = 3)
    AND NOT "Control_DB".LCnv_Control[2].Error)
    OR
    ("Settings_DB".ECnv_Settings.ID = 120301 AND "Control_DB".ECnv_Control.Cnv_Occupied AND
    NOT "Control_DB".LCnv_Control[3].Cnv_Occupied AND ("Control_DB".LCnv_Control[3].Mode = 2 OR "Control_DB".LCnv_Control[3].Mode = 3)
    AND NOT "Control_DB".LCnv_Control[3].Error));
    
    //BUFFER CONVEYORS
    FOR #i := 1 TO 3 DO
        "Control_DB".LCnv_Control[#i].Instruction.Outbound_Ready :=
        "Control_DB".ECnv_Control.Instruction.Inbound_Ready AND
        "Control_DB".VTD_Control.Current_Level = #i AND
        NOT "Control_DB".LCnv_Control[#i].Instruction.Transfer_in_Progress AND
        "Control_DB".LCnv_Control[#i].Cnv_Occupied AND
        ("Control_DB".LCnv_Control[#i].Mode = 2 OR "Control_DB".LCnv_Control[#i].Mode = 3);
    END_FOR;
    
    //INBOUND CONVEYOR
    "Control_DB".Inbound_Cnv.Instruction.Outbound_Ready := "Control_DB".Inbound_Cnv.Cnv_Occupied;
    
    //POPUP CONVEYORS
    FOR #i := 1 TO 4 DO
        "Control_DB".PopUp_Cnv[#i].Instruction.Outbound_Ready :=
        ((#i = 1 AND "Control_DB".PopUp_Cnv[2].Instruction.Inbound_Ready AND "Control_DB".PopUp_Cnv[1].Inputs."Lift Up") OR
        (#i = 2 AND "Control_DB".PopUp_Cnv[2].Inputs."Lift Down" AND ("Control_DB".PopUp_Cnv[3].Instruction.Inbound_Ready OR "Control_DB".ECnv_Control.Instruction.Inbound_Ready)) OR
        (#i = 3 AND "Control_DB".PopUp_Cnv[4].Instruction.Inbound_Ready AND "Control_DB".PopUp_Cnv[3].Inputs."Lift Up") OR
        (#i = 4 AND ("Control_DB".Outbound_Cnv.Instruction.Inbound_Ready OR "Control_DB".PopUp_Cnv[1].Instruction.Inbound_Ready) AND ("Control_DB".PopUp_Cnv[4].Inputs."Lift Up" OR "Control_DB".PopUp_Cnv[4].Inputs."Lift Down"))) AND
        (*("Control_DB".VTD_Control.Current_Level = 0 AND #i = 2) AND*)
        NOT "Control_DB".PopUp_Cnv[#i].Instruction.Transfer_in_Progress AND
        "Control_DB".PopUp_Cnv[#i].Cnv_Occupied = TRUE AND
        ("Control_DB".PopUp_Cnv[#i].Mode = 2 OR "Control_DB".PopUp_Cnv[#i].Mode = 3);
    END_FOR;
    
    //PICK CONVEYOR
    "Control_DB".Pick_Station.Instruction.Outbound_Ready := "Control_DB".Pick_Station.Cnv_Occupied;
END_REGION

REGION TRANSFER IN PROGRESS FOR VTD
    "Cnv_TIP_For_VTD" :=
    ("Settings_DB".ECnv_Settings.ID = 120001 AND
    "Control_DB".PopUp_Cnv[2].Instruction.Transfer_in_Progress)
    OR
    ("Settings_DB".ECnv_Settings.ID = 120101 AND
    "Control_DB".LCnv_Control[1].Instruction.Transfer_in_Progress)
    OR
    ("Settings_DB".ECnv_Settings.ID = 120201 AND
    "Control_DB".LCnv_Control[2].Instruction.Transfer_in_Progress)
    OR
    ("Settings_DB".ECnv_Settings.ID = 120301 AND
    "Control_DB".LCnv_Control[3].Instruction.Transfer_in_Progress);
END_REGION

END_FUNCTION
